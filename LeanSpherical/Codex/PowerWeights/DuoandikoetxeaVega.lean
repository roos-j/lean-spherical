/-- Each multiplier is globally bounded: it is continuous with compact
space-time support. -/
theorem exists_dvMul_bound {phi : SchwartzMap (Euclidean 2) ℂ}
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) (j : ℕ)
    (M : ℝ → Euclidean 2 → ℂ)
    (hMc : Continuous fun p : ℝ × Euclidean 2 => M p.1 p.2)
    (hMt : ∀ (t : ℝ) (ξ : Euclidean 2), t < 1 / 8 ∨ 6 < t → M t ξ = 0)
    (hMs : ∀ (t : ℝ) (ξ : Euclidean 2),
      ξ ∉ Metric.closedBall (0 : Euclidean 2) ((2 : ℝ) ^ (j + 7)) → M t ξ = 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ (t : ℝ) (ξ : Euclidean 2), ‖M t ξ‖ ≤ C := by
  have hcs : HasCompactSupport fun p : ℝ × Euclidean 2 => M p.1 p.2 := by
    apply HasCompactSupport.intro
      ((isCompact_Icc (a := (1 / 8 : ℝ)) (b := 6)).prod
        (isCompact_closedBall (0 : Euclidean 2) ((2 : ℝ) ^ (j + 7))))
    intro p hp
    by_cases hs : p.2 ∈ Metric.closedBall (0 : Euclidean 2) ((2 : ℝ) ^ (j + 7))
    · refine hMt p.1 p.2 ?_
      by_contra hcon
      push_neg at hcon
      exact hp ⟨⟨hcon.1, hcon.2⟩, hs⟩
    · exact hMs p.1 p.2 hs
  obtain ⟨C, hC⟩ := hMc.bounded_above_of_compact_support hcs
  refine ⟨C + 1, ?_, fun t ξ => le_trans (hC (t, ξ)) (by linarith)⟩
  have h0 : (0 : ℝ) ≤ C := le_trans (norm_nonneg _) (hC (0, 0))
  linarith

theorem dvMulA_kernel (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (η ξ : Euclidean 2) :
    (∫ t in (1 / 4 : ℝ)..5, dvMulA phi j t η * (starRingEnd ℂ) (dvMulA phi j t ξ)) =
      dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ) *
        ∫ t in (1 / 4 : ℝ)..5, dvSig phi j ‖η‖ t * (starRingEnd ℂ) (dvSig phi j ‖ξ‖ t) := by
  rw [← intervalIntegral.integral_const_mul]
  refine intervalIntegral.integral_congr fun t ht => ?_
  rw [Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)] at ht
  have hone : dvTcut t = 1 := dvTcut_eq_one ht.1 ht.2
  unfold dvMulA
  simp only [map_mul, Complex.conj_ofReal, hone, Complex.ofReal_one, one_mul]
  ring

theorem dvMulB_kernel (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (η ξ : Euclidean 2) :
    (∫ t in (1 / 4 : ℝ)..5, dvMulB phi j t η * (starRingEnd ℂ) (dvMulB phi j t ξ)) =
      dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ) *
        ∫ t in (1 / 4 : ℝ)..5, (dvWeight t : ℂ) * dvSig phi j ‖η‖ t *
          (starRingEnd ℂ) (dvSig phi j ‖ξ‖ t) := by
  rw [← intervalIntegral.integral_const_mul]
  refine intervalIntegral.integral_congr fun t ht => ?_
  rw [Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)] at ht
  have hsq : dvSqrtW t * dvSqrtW t = dvWeight t := dvSqrtW_sq ht.1 ht.2
  unfold dvMulB
  simp only [map_mul, Complex.conj_ofReal]
  have hcast : ((dvSqrtW t : ℝ) : ℂ) * ((dvSqrtW t : ℝ) : ℂ) = ((dvWeight t : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul, hsq]
  calc ((dvSqrtW t : ℝ) : ℂ) * dvSig phi j ‖η‖ t * dvFreqCut phi j η *
        (((dvSqrtW t : ℝ) : ℂ) * (starRingEnd ℂ) (dvSig phi j ‖ξ‖ t) *
          (starRingEnd ℂ) (dvFreqCut phi j ξ)) =
      (((dvSqrtW t : ℝ) : ℂ) * ((dvSqrtW t : ℝ) : ℂ)) *
        (dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ) *
          (dvSig phi j ‖η‖ t * (starRingEnd ℂ) (dvSig phi j ‖ξ‖ t))) := by ring
    _ = dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ) *
        ((dvWeight t : ℂ) * dvSig phi j ‖η‖ t *
          (starRingEnd ℂ) (dvSig phi j ‖ξ‖ t)) := by
        rw [hcast]
        ring

theorem dvMulC_kernel (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (η ξ : Euclidean 2) :
    (∫ t in (1 / 4 : ℝ)..5, dvMulC phi j t η * (starRingEnd ℂ) (dvMulC phi j t ξ)) =
      dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ) *
        (((‖η‖ : ℝ) : ℂ) * ((‖ξ‖ : ℝ) : ℂ)) *
        ∫ t in (1 / 4 : ℝ)..5, (dvWeight t : ℂ) * dvSigD phi j ‖η‖ t *
          (starRingEnd ℂ) (dvSigD phi j ‖ξ‖ t) := by
  rw [← intervalIntegral.integral_const_mul]
  refine intervalIntegral.integral_congr fun t ht => ?_
  rw [Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)] at ht
  have hsq : dvSqrtW t * dvSqrtW t = dvWeight t := dvSqrtW_sq ht.1 ht.2
  have hcast : ((dvSqrtW t : ℝ) : ℂ) * ((dvSqrtW t : ℝ) : ℂ) = ((dvWeight t : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul, hsq]
  have hnum1 : dvSigDnum phi j ‖η‖ t = ((‖η‖ : ℝ) : ℂ) * dvSigD phi j ‖η‖ t :=
    dvSigDnum_eq phi j ‖η‖ t
  have hnum2 : dvSigDnum phi j ‖ξ‖ t = ((‖ξ‖ : ℝ) : ℂ) * dvSigD phi j ‖ξ‖ t :=
    dvSigDnum_eq phi j ‖ξ‖ t
  unfold dvMulC
  rw [hnum1, hnum2]
  simp only [map_mul, Complex.conj_ofReal]
  calc ((dvSqrtW t : ℝ) : ℂ) * (((‖η‖ : ℝ) : ℂ) * dvSigD phi j ‖η‖ t) *
        dvFreqCut phi j η *
        (((dvSqrtW t : ℝ) : ℂ) * (((‖ξ‖ : ℝ) : ℂ) *
          (starRingEnd ℂ) (dvSigD phi j ‖ξ‖ t)) *
          (starRingEnd ℂ) (dvFreqCut phi j ξ)) =
      (((dvSqrtW t : ℝ) : ℂ) * ((dvSqrtW t : ℝ) : ℂ)) *
        (dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ) *
          (((‖η‖ : ℝ) : ℂ) * ((‖ξ‖ : ℝ) : ℂ)) *
          (dvSigD phi j ‖η‖ t * (starRingEnd ℂ) (dvSigD phi j ‖ξ‖ t))) := by ring
    _ = dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ) *
        (((‖η‖ : ℝ) : ℂ) * ((‖ξ‖ : ℝ) : ℂ)) *
        ((dvWeight t : ℂ) * dvSigD phi j ‖η‖ t *
          (starRingEnd ℂ) (dvSigD phi j ‖ξ‖ t)) := by
        rw [hcast]
        ring
/-! ### The band support and the three space-time kernel bounds -/

theorem dvSig_zero_on_interval {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) (j : ℕ) {s : ℝ} (hs : 0 ≤ s)
    (hout : s * 5 < (2 : ℝ) ^ j ∨ (2 : ℝ) ^ (j + 4) < s) :
    ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 → dvSig phi j s r = 0 := by
  intro r hr1 hr2
  rcases hout with h | h
  · exact dvSig_eq_zero_of_small hone j hs (by linarith) hr2 h
  · exact dvSig_eq_zero_of_large hzero j hs hr1 h

theorem dvBandDeriv_eq_zero_of_abs_lt {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1) (j : ℕ) {v : ℝ}
    (hv : |v| < (2 : ℝ) ^ j) : dvBandDeriv phi j v = 0 := by
  have hgen : ∀ n : ℕ, |(((2 : ℝ) ^ (j + n))⁻¹) * v| < 1 := by
    intro n
    have hc : (0 : ℝ) < (2 : ℝ) ^ (j + n) := by positivity
    have hmono : (2 : ℝ) ^ j ≤ (2 : ℝ) ^ (j + n) := by
      apply pow_le_pow_right₀ (by norm_num)
      omega
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (((2 : ℝ) ^ (j + n))⁻¹))]
    calc ((2 : ℝ) ^ (j + n))⁻¹ * |v| < ((2 : ℝ) ^ (j + n))⁻¹ * (2 : ℝ) ^ (j + n) := by
          apply mul_lt_mul_of_pos_left _ (by positivity)
          exact lt_of_lt_of_le hv hmono
      _ = 1 := inv_mul_cancel₀ hc.ne'
  unfold dvBandDeriv
  rw [dvProfileDeriv_eq_zero_of_abs_lt_one hone (hgen 1),
    dvProfileDeriv_eq_zero_of_abs_lt_one hone (by simpa using hgen 0)]
  simp

theorem dvBandDeriv_eq_zero_of_lt_abs {phi : SchwartzMap (Euclidean 2) ℂ}
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) (j : ℕ) {v : ℝ}
    (hv : (2 : ℝ) ^ (j + 2) < |v|) : dvBandDeriv phi j v = 0 := by
  have hgen : ∀ n : ℕ, n ≤ 1 → 2 < |(((2 : ℝ) ^ (j + n))⁻¹) * v| := by
    intro n hn
    have hc : (0 : ℝ) < (2 : ℝ) ^ (j + n) := by positivity
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (((2 : ℝ) ^ (j + n))⁻¹))]
    have hstep : (2 : ℝ) = ((2 : ℝ) ^ (j + n))⁻¹ * (2 : ℝ) ^ (j + n + 1) := by
      rw [pow_succ]
      field_simp
    have hnn : (0 : ℝ) < ((2 : ℝ) ^ (j + n))⁻¹ := by positivity
    have hpow : (2 : ℝ) ^ (j + n + 1) ≤ (2 : ℝ) ^ (j + 2) := by
      apply pow_le_pow_right₀ (by norm_num)
      omega
    calc (2 : ℝ) = ((2 : ℝ) ^ (j + n))⁻¹ * (2 : ℝ) ^ (j + n + 1) := hstep
      _ < ((2 : ℝ) ^ (j + n))⁻¹ * |v| :=
          mul_lt_mul_of_pos_left (lt_of_le_of_lt hpow hv) hnn
  unfold dvBandDeriv
  rw [dvProfileDeriv_eq_zero_of_two_lt_abs hzero (hgen 1 (by norm_num)),
    dvProfileDeriv_eq_zero_of_two_lt_abs hzero (by simpa using hgen 0 (by norm_num))]
  simp

theorem dvSigD_zero_on_interval {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) (j : ℕ) {s : ℝ} (hs : 0 ≤ s)
    (hout : s * 5 < (2 : ℝ) ^ j ∨ (2 : ℝ) ^ (j + 4) < s) :
    ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 → dvSigD phi j s r = 0 := by
  intro r hr1 hr2
  have hband : dvBand phi j (s * r) = 0 := by
    rcases hout with h | h
    · refine dvBand_eq_zero_of_abs_le hone j ?_
      rw [abs_of_nonneg (by positivity)]
      calc s * r ≤ s * 5 := by nlinarith
        _ ≤ (2 : ℝ) ^ j := le_of_lt h
    · refine dvBand_eq_zero_of_le_abs hzero j ?_
      rw [abs_of_nonneg (by positivity)]
      have hpow : (2 : ℝ) ^ (j + 4) = (2 : ℝ) ^ (j + 2) * 4 := by ring
      have hp0 : (0 : ℝ) < (2 : ℝ) ^ (j + 2) := by positivity
      nlinarith
  have hbandD : dvBandDeriv phi j (s * r) = 0 := by
    rcases hout with h | h
    · refine dvBandDeriv_eq_zero_of_abs_lt hone j ?_
      rw [abs_of_nonneg (by positivity)]
      calc s * r ≤ s * 5 := by nlinarith
        _ < (2 : ℝ) ^ j := h
    · refine dvBandDeriv_eq_zero_of_lt_abs hzero j ?_
      rw [abs_of_nonneg (by positivity)]
      have hpow : (2 : ℝ) ^ (j + 4) = (2 : ℝ) ^ (j + 2) * 4 := by ring
      have hp0 : (0 : ℝ) < (2 : ℝ) ^ (j + 2) := by positivity
      nlinarith
  unfold dvSigD dvDAmp dvBandAmpDeriv dvBandAmp
  rw [hband, hbandD]
  simp

private theorem aux_supp_facts {j : ℕ} (hj : 3 ≤ j) {s : ℝ} (hs0 : 0 ≤ s)
    (h1 : ¬(s * 5 < (2 : ℝ) ^ j)) (h2 : ¬((2 : ℝ) ^ (j + 4) < s)) :
    1 ≤ s ∧ s⁻¹ ≤ 5 * ((2 : ℝ) ^ j)⁻¹ ∧ s ≤ 16 * (2 : ℝ) ^ j := by
  push_neg at h1 h2
  have hpow : (8 : ℝ) ≤ (2 : ℝ) ^ j := by
    calc (8 : ℝ) = (2 : ℝ) ^ 3 := by norm_num
      _ ≤ (2 : ℝ) ^ j := by
          apply pow_le_pow_right₀ (by norm_num)
          omega
  have hspos : (0 : ℝ) < s := by nlinarith
  refine ⟨by nlinarith, ?_, ?_⟩
  · have hp0 : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
    rw [inv_le_iff_one_le_mul₀ hspos]
    have hkey : (2 : ℝ) ^ j * 1 ≤ (2 : ℝ) ^ j * (5 * ((2 : ℝ) ^ j)⁻¹ * s) := by
      have hrw : (2 : ℝ) ^ j * (5 * ((2 : ℝ) ^ j)⁻¹ * s) = s * 5 := by
        field_simp
      rw [hrw, mul_one]
      exact h1
    exact le_of_mul_le_mul_left hkey hp0
  · have hpow4 : (2 : ℝ) ^ (j + 4) = 16 * (2 : ℝ) ^ j := by ring
    rw [hpow4] at h2
    exact h2

private theorem aux_int_zero {F : ℝ → ℂ} (hF : ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 → F r = 0) :
    (∫ r in (1 / 4 : ℝ)..5, F r) = 0 := by
  have hcongr : (∫ r in (1 / 4 : ℝ)..5, F r) = ∫ r in (1 / 4 : ℝ)..5, (0 : ℂ) := by
    refine intervalIntegral.integral_congr fun r hr => ?_
    rw [Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)] at hr
    exact hF r hr.1 hr.2
  rw [hcongr]
  simp

set_option maxHeartbeats 800000 in
theorem dvKerA_bound {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1)
    {CA : ℝ} (hCA : 0 < CA)
    (hker : ∀ (j : ℕ) (s t : ℝ), 1 ≤ s → 1 ≤ t →
      ‖∫ r in (1 / 4 : ℝ)..5, dvSig phi j s r * (starRingEnd ℂ) (dvSig phi j t r)‖ ≤
        CA * (s⁻¹ + t⁻¹))
    (j : ℕ) (hj : 3 ≤ j) (η ξ : Euclidean 2) :
    ‖∫ t in (1 / 4 : ℝ)..5, dvMulA phi j t η * (starRingEnd ℂ) (dvMulA phi j t ξ)‖ ≤
      10 * CA * ((2 : ℝ) ^ j)⁻¹ := by
  have hRHS : (0 : ℝ) ≤ 10 * CA * ((2 : ℝ) ^ j)⁻¹ := by positivity
  rw [dvMulA_kernel]
  have hcut : ‖dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ)‖ ≤ 1 := by
    rw [norm_mul, RCLike.norm_conj]
    calc ‖dvFreqCut phi j η‖ * ‖dvFreqCut phi j ξ‖ ≤ 1 * 1 :=
          mul_le_mul (norm_dvFreqCut_le hnorm j η) (norm_dvFreqCut_le hnorm j ξ)
            (norm_nonneg _) (by norm_num)
      _ = 1 := by norm_num
  by_cases hη : (‖η‖ * 5 < (2 : ℝ) ^ j) ∨ ((2 : ℝ) ^ (j + 4) < ‖η‖)
  · have hzeroInt : (∫ r in (1 / 4 : ℝ)..5,
        dvSig phi j ‖η‖ r * (starRingEnd ℂ) (dvSig phi j ‖ξ‖ r)) = 0 := by
      refine aux_int_zero fun r hr1 hr2 => ?_
      rw [dvSig_zero_on_interval hone hzero j (norm_nonneg η) hη r hr1 hr2, zero_mul]
    rw [hzeroInt, mul_zero, norm_zero]
    exact hRHS
  by_cases hξ : (‖ξ‖ * 5 < (2 : ℝ) ^ j) ∨ ((2 : ℝ) ^ (j + 4) < ‖ξ‖)
  · have hzeroInt : (∫ r in (1 / 4 : ℝ)..5,
        dvSig phi j ‖η‖ r * (starRingEnd ℂ) (dvSig phi j ‖ξ‖ r)) = 0 := by
      refine aux_int_zero fun r hr1 hr2 => ?_
      rw [dvSig_zero_on_interval hone hzero j (norm_nonneg ξ) hξ r hr1 hr2]
      simp
    rw [hzeroInt, mul_zero, norm_zero]
    exact hRHS
  · push_neg at hη hξ
    obtain ⟨hη1, hη2, _⟩ := aux_supp_facts hj (norm_nonneg η) (by linarith [hη.1]) (by
      simp only [not_lt]
      exact hη.2)
    obtain ⟨hξ1, hξ2, _⟩ := aux_supp_facts hj (norm_nonneg ξ) (by linarith [hξ.1]) (by
      simp only [not_lt]
      exact hξ.2)
    have hk := hker j ‖η‖ ‖ξ‖ hη1 hξ1
    rw [norm_mul]
    calc ‖dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ)‖ *
          ‖∫ r in (1 / 4 : ℝ)..5, dvSig phi j ‖η‖ r *
            (starRingEnd ℂ) (dvSig phi j ‖ξ‖ r)‖ ≤
        1 * (CA * (‖η‖⁻¹ + ‖ξ‖⁻¹)) :=
          mul_le_mul hcut hk (norm_nonneg _) (by norm_num)
      _ ≤ 10 * CA * ((2 : ℝ) ^ j)⁻¹ := by
          rw [one_mul]
          nlinarith [hCA.le, hη2, hξ2]

set_option maxHeartbeats 800000 in
theorem dvKerB_bound {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1)
    {CB : ℝ} (hCB : 0 < CB)
    (hker : ∀ (j : ℕ) (s t : ℝ), 1 ≤ s → 1 ≤ t → t ≤ 100 * s → s ≤ 100 * t →
      ‖∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) * dvSig phi j s r *
          (starRingEnd ℂ) (dvSig phi j t r)‖ ≤ CB * ((s⁻¹ + t⁻¹) / (1 + |s - t|)))
    (j : ℕ) (hj : 3 ≤ j) (η ξ : Euclidean 2) :
    ‖∫ t in (1 / 4 : ℝ)..5, dvMulB phi j t η * (starRingEnd ℂ) (dvMulB phi j t ξ)‖ ≤
      (10 * CB * ((2 : ℝ) ^ j)⁻¹) * (1 + |‖ξ‖ - ‖η‖|)⁻¹ := by
  have hd0 : (0 : ℝ) < 1 + |‖ξ‖ - ‖η‖| := by positivity
  have hRHS : (0 : ℝ) ≤ (10 * CB * ((2 : ℝ) ^ j)⁻¹) * (1 + |‖ξ‖ - ‖η‖|)⁻¹ := by positivity
  rw [dvMulB_kernel]
  have hcut : ‖dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ)‖ ≤ 1 := by
    rw [norm_mul, RCLike.norm_conj]
    calc ‖dvFreqCut phi j η‖ * ‖dvFreqCut phi j ξ‖ ≤ 1 * 1 :=
          mul_le_mul (norm_dvFreqCut_le hnorm j η) (norm_dvFreqCut_le hnorm j ξ)
            (norm_nonneg _) (by norm_num)
      _ = 1 := by norm_num
  by_cases hη : (‖η‖ * 5 < (2 : ℝ) ^ j) ∨ ((2 : ℝ) ^ (j + 4) < ‖η‖)
  · have hzeroInt : (∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) * dvSig phi j ‖η‖ r *
        (starRingEnd ℂ) (dvSig phi j ‖ξ‖ r)) = 0 := by
      refine aux_int_zero fun r hr1 hr2 => ?_
      rw [dvSig_zero_on_interval hone hzero j (norm_nonneg η) hη r hr1 hr2]
      simp
    rw [hzeroInt, mul_zero, norm_zero]
    exact hRHS
  by_cases hξ : (‖ξ‖ * 5 < (2 : ℝ) ^ j) ∨ ((2 : ℝ) ^ (j + 4) < ‖ξ‖)
  · have hzeroInt : (∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) * dvSig phi j ‖η‖ r *
        (starRingEnd ℂ) (dvSig phi j ‖ξ‖ r)) = 0 := by
      refine aux_int_zero fun r hr1 hr2 => ?_
      rw [dvSig_zero_on_interval hone hzero j (norm_nonneg ξ) hξ r hr1 hr2]
      simp
    rw [hzeroInt, mul_zero, norm_zero]
    exact hRHS
  · push_neg at hη hξ
    obtain ⟨hη1, hη2, hη3⟩ := aux_supp_facts hj (norm_nonneg η) (by linarith [hη.1])
      (by simp only [not_lt]; exact hη.2)
    obtain ⟨hξ1, hξ2, hξ3⟩ := aux_supp_facts hj (norm_nonneg ξ) (by linarith [hξ.1])
      (by simp only [not_lt]; exact hξ.2)
    have hp0 : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
    have hrat1 : ‖ξ‖ ≤ 100 * ‖η‖ := by
      have h5 : (2 : ℝ) ^ j ≤ ‖η‖ * 5 := by linarith [hη.1]
      nlinarith
    have hrat2 : ‖η‖ ≤ 100 * ‖ξ‖ := by
      have h5 : (2 : ℝ) ^ j ≤ ‖ξ‖ * 5 := by linarith [hξ.1]
      nlinarith
    have hk := hker j ‖η‖ ‖ξ‖ hη1 hξ1 hrat1 hrat2
    have habs : |‖η‖ - ‖ξ‖| = |‖ξ‖ - ‖η‖| := abs_sub_comm _ _
    rw [habs] at hk
    rw [norm_mul]
    calc ‖dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ)‖ *
          ‖∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) * dvSig phi j ‖η‖ r *
            (starRingEnd ℂ) (dvSig phi j ‖ξ‖ r)‖ ≤
        1 * (CB * ((‖η‖⁻¹ + ‖ξ‖⁻¹) / (1 + |‖ξ‖ - ‖η‖|))) :=
          mul_le_mul hcut hk (norm_nonneg _) (by norm_num)
      _ = CB * (‖η‖⁻¹ + ‖ξ‖⁻¹) * (1 + |‖ξ‖ - ‖η‖|)⁻¹ := by
          rw [one_mul, div_eq_mul_inv]
          ring
      _ ≤ (10 * CB * ((2 : ℝ) ^ j)⁻¹) * (1 + |‖ξ‖ - ‖η‖|)⁻¹ := by
          apply mul_le_mul_of_nonneg_right _ (by positivity)
          nlinarith [hCB.le, hη2, hξ2]

set_option maxHeartbeats 800000 in
theorem dvKerC_bound {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1)
    {CD : ℝ} (hCD : 0 < CD)
    (hker : ∀ (j : ℕ) (s t : ℝ), 1 ≤ s → 1 ≤ t → t ≤ 100 * s → s ≤ 100 * t →
      ‖∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) * dvSigD phi j s r *
          (starRingEnd ℂ) (dvSigD phi j t r)‖ ≤ CD * ((s⁻¹ + t⁻¹) / (1 + |s - t|)))
    (j : ℕ) (hj : 3 ≤ j) (η ξ : Euclidean 2) :
    ‖∫ t in (1 / 4 : ℝ)..5, dvMulC phi j t η * (starRingEnd ℂ) (dvMulC phi j t ξ)‖ ≤
      (32 * CD * (2 : ℝ) ^ j) * (1 + |‖ξ‖ - ‖η‖|)⁻¹ := by
  have hd0 : (0 : ℝ) < 1 + |‖ξ‖ - ‖η‖| := by positivity
  have hRHS : (0 : ℝ) ≤ (32 * CD * (2 : ℝ) ^ j) * (1 + |‖ξ‖ - ‖η‖|)⁻¹ := by positivity
  rw [dvMulC_kernel]
  have hcut : ‖dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ)‖ ≤ 1 := by
    rw [norm_mul, RCLike.norm_conj]
    calc ‖dvFreqCut phi j η‖ * ‖dvFreqCut phi j ξ‖ ≤ 1 * 1 :=
          mul_le_mul (norm_dvFreqCut_le hnorm j η) (norm_dvFreqCut_le hnorm j ξ)
            (norm_nonneg _) (by norm_num)
      _ = 1 := by norm_num
  by_cases hη : (‖η‖ * 5 < (2 : ℝ) ^ j) ∨ ((2 : ℝ) ^ (j + 4) < ‖η‖)
  · have hzeroInt : (∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) * dvSigD phi j ‖η‖ r *
        (starRingEnd ℂ) (dvSigD phi j ‖ξ‖ r)) = 0 := by
      refine aux_int_zero fun r hr1 hr2 => ?_
      rw [dvSigD_zero_on_interval hone hzero j (norm_nonneg η) hη r hr1 hr2]
      simp
    rw [hzeroInt, mul_zero, norm_zero]
    exact hRHS
  by_cases hξ : (‖ξ‖ * 5 < (2 : ℝ) ^ j) ∨ ((2 : ℝ) ^ (j + 4) < ‖ξ‖)
  · have hzeroInt : (∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) * dvSigD phi j ‖η‖ r *
        (starRingEnd ℂ) (dvSigD phi j ‖ξ‖ r)) = 0 := by
      refine aux_int_zero fun r hr1 hr2 => ?_
      rw [dvSigD_zero_on_interval hone hzero j (norm_nonneg ξ) hξ r hr1 hr2]
      simp
    rw [hzeroInt, mul_zero, norm_zero]
    exact hRHS
  · push_neg at hη hξ
    obtain ⟨hη1, hη2, hη3⟩ := aux_supp_facts hj (norm_nonneg η) (by linarith [hη.1])
      (by simp only [not_lt]; exact hη.2)
    obtain ⟨hξ1, hξ2, hξ3⟩ := aux_supp_facts hj (norm_nonneg ξ) (by linarith [hξ.1])
      (by simp only [not_lt]; exact hξ.2)
    have hp0 : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
    have hηpos : (0 : ℝ) < ‖η‖ := by linarith
    have hξpos : (0 : ℝ) < ‖ξ‖ := by linarith
    have hrat1 : ‖ξ‖ ≤ 100 * ‖η‖ := by
      have h5 : (2 : ℝ) ^ j ≤ ‖η‖ * 5 := by linarith [hη.1]
      nlinarith
    have hrat2 : ‖η‖ ≤ 100 * ‖ξ‖ := by
      have h5 : (2 : ℝ) ^ j ≤ ‖ξ‖ * 5 := by linarith [hξ.1]
      nlinarith
    have hk := hker j ‖η‖ ‖ξ‖ hη1 hξ1 hrat1 hrat2
    have habs : |‖η‖ - ‖ξ‖| = |‖ξ‖ - ‖η‖| := abs_sub_comm _ _
    rw [habs] at hk
    have hnormprod : ‖dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ) *
        (((‖η‖ : ℝ) : ℂ) * ((‖ξ‖ : ℝ) : ℂ))‖ ≤ ‖η‖ * ‖ξ‖ := by
      have hpr : ‖(((‖η‖ : ℝ) : ℂ) * ((‖ξ‖ : ℝ) : ℂ))‖ = ‖η‖ * ‖ξ‖ := by
        rw [norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
          Real.norm_eq_abs, abs_of_pos hηpos, abs_of_pos hξpos]
      rw [norm_mul, hpr]
      calc ‖dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ)‖ * (‖η‖ * ‖ξ‖) ≤
          1 * (‖η‖ * ‖ξ‖) :=
            mul_le_mul_of_nonneg_right hcut (by positivity)
        _ = ‖η‖ * ‖ξ‖ := by ring
    rw [norm_mul]
    calc ‖dvFreqCut phi j η * (starRingEnd ℂ) (dvFreqCut phi j ξ) *
          (((‖η‖ : ℝ) : ℂ) * ((‖ξ‖ : ℝ) : ℂ))‖ *
          ‖∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) * dvSigD phi j ‖η‖ r *
            (starRingEnd ℂ) (dvSigD phi j ‖ξ‖ r)‖ ≤
        (‖η‖ * ‖ξ‖) * (CD * ((‖η‖⁻¹ + ‖ξ‖⁻¹) / (1 + |‖ξ‖ - ‖η‖|))) :=
          mul_le_mul hnormprod hk (norm_nonneg _) (by positivity)
      _ = (CD * (‖ξ‖ + ‖η‖)) * (1 + |‖ξ‖ - ‖η‖|)⁻¹ := by
          rw [div_eq_mul_inv]
          field_simp
      _ ≤ (32 * CD * (2 : ℝ) ^ j) * (1 + |‖ξ‖ - ‖η‖|)⁻¹ := by
          apply mul_le_mul_of_nonneg_right _ (by positivity)
          nlinarith [hCD.le, hη3, hξ3]
/-! ### The Schur row bound and the weight arithmetic -/

set_option maxHeartbeats 1000000 in
/-- The Schur row bound for a dyadic shell weight and a space-time
multiplier with a gap-decaying radial kernel. -/
theorem dvRowBound {Cc : ℝ≥0∞}
    (hrow : ∀ (Th : Euclidean 2 → ℂ) (Q : Euclidean 2 → ℝ≥0∞) (P R T : ℝ)
      (ξ : Euclidean 2), 0 ≤ P → 0 ≤ R → 0 ≤ T → Measurable Th → Measurable Q →
      (∀ ζ, ‖Th ζ‖ ≤ P) → (∀ ζ : Euclidean 2, R ≤ ‖ζ‖ → Th ζ = 0) →
      (∀ η : Euclidean 2, Q η ≤ ENNReal.ofReal ((1 + |‖ξ‖ - ‖η‖|)⁻¹)) →
      (∀ η : Euclidean 2, T < ‖η‖ → Q η = 0) →
      (∫⁻ η : Euclidean 2, ENNReal.ofReal ‖Th (ξ - η)‖ * Q η) ≤
        Cc * ENNReal.ofReal (P * min R T * (2 * Real.log (1 + T))))
    {Gb : Euclidean 2 → ℝ} {Th : Euclidean 2 → ℂ} {A : ℝ}
    (hGc : Continuous Gb) (hG : Integrable Gb volume)
    (hThdef : 𝓕⁻ (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ)) = Th)
    (hAbd : ∀ ζ, ‖Th ζ‖ ≤ A) (hA0 : 0 ≤ A)
    (hThsupp : ∀ ζ : Euclidean 2, 1 / 32 ≤ ‖ζ‖ → Th ζ = 0)
    (k : ℕ) {T : ℝ} (hT : 0 ≤ T)
    (M : ℝ → Euclidean 2 → ℂ)
    (hMc : Continuous fun p : ℝ × Euclidean 2 => M p.1 p.2)
    (hMsupp : ∀ (t : ℝ) (η : Euclidean 2), T < ‖η‖ → M t η = 0)
    {kapR : ℝ} (hkap : 0 ≤ kapR) (ξ : Euclidean 2)
    (hker : ∀ η : Euclidean 2,
      ‖∫ t in (1 / 4 : ℝ)..5, M t η * (starRingEnd ℂ) (M t ξ)‖ ≤
        kapR * (1 + |‖ξ‖ - ‖η‖|)⁻¹) :
    (∫⁻ η : Euclidean 2,
        ENNReal.ofReal ‖𝓕⁻ (fun x : Euclidean 2 => ((dvGk Gb k x : ℝ) : ℂ)) (η - ξ)‖ *
          ENNReal.ofReal ‖∫ t in (1 / 4 : ℝ)..5, M t η * (starRingEnd ℂ) (M t ξ)‖) ≤
      ENNReal.ofReal kapR *
        (Cc * ENNReal.ofReal ((((2 : ℝ) ^ k)⁻¹ * A) * min ((2 : ℝ) ^ k / 32) T *
          (2 * Real.log (1 + T)))) := by
  classical
  set ThK : Euclidean 2 → ℂ :=
    fun ζ => 𝓕⁻ (fun x : Euclidean 2 => ((dvGk Gb k x : ℝ) : ℂ)) ζ with hThKdef
  have hkpos : (0 : ℝ) < ((2 : ℝ) ^ k)⁻¹ := by positivity
  have hThKval : ∀ ζ : Euclidean 2, ThK ζ =
      (((2 : ℝ) ^ k)⁻¹ : ℝ) • Th ((((2 : ℝ) ^ k)⁻¹) • ζ) := by
    intro ζ
    simp only [hThKdef]
    exact fourierInv_dvGk hThdef k ζ
  have hThKbd : ∀ ζ, ‖ThK ζ‖ ≤ ((2 : ℝ) ^ k)⁻¹ * A := by
    intro ζ
    rw [hThKval ζ, norm_smul, Real.norm_eq_abs, abs_of_pos hkpos]
    exact mul_le_mul_of_nonneg_left (hAbd _) hkpos.le
  have hThKsupp : ∀ ζ : Euclidean 2, (2 : ℝ) ^ k / 32 ≤ ‖ζ‖ → ThK ζ = 0 := by
    intro ζ hζ
    rw [hThKval ζ]
    have harg : (1 : ℝ) / 32 ≤ ‖(((2 : ℝ) ^ k)⁻¹) • ζ‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hkpos]
      rw [le_inv_mul_iff₀ (by positivity)]
      calc (2 : ℝ) ^ k * (1 / 32) = (2 : ℝ) ^ k / 32 := by ring
        _ ≤ ‖ζ‖ := hζ
    rw [hThsupp _ harg, smul_zero]
  have hThKmeas : Measurable ThK := by
    have hint : Integrable (fun x : Euclidean 2 => ((dvGk Gb k x : ℝ) : ℂ)) volume :=
      (integrable_dvGk hG k).ofReal
    exact (dvContinuous_fourierInv hint).measurable
  set Q : Euclidean 2 → ℝ≥0∞ := fun η =>
    ENNReal.ofReal ‖∫ t in (1 / 4 : ℝ)..5, M t η * (starRingEnd ℂ) (M t ξ)‖ with hQdef
  have hQmeas : Measurable Q := by
    simp only [hQdef]
    have hcont : Continuous fun η : Euclidean 2 =>
        ∫ t in (1 / 4 : ℝ)..5, M t η * (starRingEnd ℂ) (M t ξ) := by
      have hunc : Continuous (Function.uncurry fun (η : Euclidean 2) (t : ℝ) =>
          M t η * (starRingEnd ℂ) (M t ξ)) := by
        have h1 : Continuous fun q : Euclidean 2 × ℝ => M q.2 q.1 :=
          hMc.comp (Continuous.prodMk continuous_snd continuous_fst)
        have h2 : Continuous fun q : Euclidean 2 × ℝ => M q.2 ξ :=
          hMc.comp (Continuous.prodMk continuous_snd continuous_const)
        exact h1.mul (Complex.continuous_conj.comp h2)
      exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        hunc (1 / 4 : ℝ) 5
    exact hcont.norm.measurable.ennreal_ofReal
  have hQle : ∀ η : Euclidean 2, ‖η‖ ≤ T →
      Q η ≤ ENNReal.ofReal kapR * ENNReal.ofReal ((1 + |‖ξ‖ - ‖η‖|)⁻¹) := by
    intro η _
    simp only [hQdef]
    rw [← ENNReal.ofReal_mul hkap]
    exact ENNReal.ofReal_le_ofReal (hker η)
  have hQ0 : ∀ η : Euclidean 2, T < ‖η‖ → Q η = 0 := by
    intro η hη
    simp only [hQdef]
    have hzeroInt : (∫ t in (1 / 4 : ℝ)..5, M t η * (starRingEnd ℂ) (M t ξ)) = 0 := by
      have hcongr : (∫ t in (1 / 4 : ℝ)..5, M t η * (starRingEnd ℂ) (M t ξ)) =
          ∫ _t in (1 / 4 : ℝ)..5, (0 : ℂ) := by
        refine intervalIntegral.integral_congr fun t _ => ?_
        rw [hMsupp t η hη, zero_mul]
      rw [hcongr]
      simp
    rw [hzeroInt, norm_zero, ENNReal.ofReal_zero]
  have hflip : ∀ η : Euclidean 2, ENNReal.ofReal ‖ThK (η - ξ)‖ =
      ENNReal.ofReal ‖ThK (ξ - η)‖ := by
    intro η
    congr 1
    have hneg : η - ξ = -(ξ - η) := by abel
    rw [hneg]
    simp only [hThKdef]
    exact dvNorm_fourierInv_neg (Gb := dvGk Gb k) (ξ - η)
  have hmain := dvRow_le_const hrow ThK Q (((2 : ℝ) ^ k)⁻¹ * A) ((2 : ℝ) ^ k / 32) T
    (ENNReal.ofReal kapR) ξ (by positivity) (by positivity) hT hThKmeas hQmeas
    hThKbd hThKsupp hQle hQ0
  calc (∫⁻ η : Euclidean 2, ENNReal.ofReal ‖ThK (η - ξ)‖ * Q η) =
      ∫⁻ η : Euclidean 2, ENNReal.ofReal ‖ThK (ξ - η)‖ * Q η := by
        refine lintegral_congr fun η => ?_
        rw [hflip η]
    _ ≤ _ := hmain

theorem dvWeight_eq_inv {x : Euclidean 2} (hx : x ≠ 0) :
    radialPowerWeight 2 (-1) x = ENNReal.ofReal (‖x‖⁻¹) := by
  have hpos : (0 : ℝ) < ‖x‖ := norm_pos_iff.mpr hx
  unfold radialPowerWeight
  rw [ENNReal.rpow_neg_one, ← ENNReal.ofReal_inv_of_pos hpos]

/-- The dyadic shell domination of the critical weight. -/
theorem dvWeight_le_shells {Gb : Euclidean 2 → ℝ}
    (hGlow : ∀ x : Euclidean 2, ‖x‖ ≤ 1 → (1 : ℝ) / 2 ≤ Gb x)
    (hGnn : ∀ x, 0 ≤ Gb x) (j : ℕ) {x : Euclidean 2} (hx : x ≠ 0)
    (hxb : ‖x‖ ≤ 1 / 32) (hxj : ((2 : ℝ) ^ j)⁻¹ ≤ ‖x‖) :
    radialPowerWeight 2 (-1) x ≤
      ENNReal.ofReal 4 * ∑ k ∈ Finset.range (j + 1), ENNReal.ofReal (dvGk Gb k x) := by
  have hpos : (0 : ℝ) < ‖x‖ := norm_pos_iff.mpr hx
  set n : ℕ := ⌊(‖x‖)⁻¹⌋₊ with hndef
  have hinv32 : (32 : ℝ) ≤ (‖x‖)⁻¹ := by
    rw [le_inv_comm₀ (by norm_num) hpos]
    calc ‖x‖ ≤ 1 / 32 := hxb
      _ = (32 : ℝ)⁻¹ := by norm_num
  have hn32 : 32 ≤ n := by
    simp only [hndef]
    exact Nat.le_floor (by exact_mod_cast hinv32)
  have hn0 : n ≠ 0 := by omega
  set k : ℕ := Nat.log 2 n with hkdef
  have hpowk : (2 : ℕ) ^ k ≤ n := Nat.pow_log_le_self 2 hn0
  have hnlt : n < 2 ^ (k + 1) := Nat.lt_pow_succ_log_self (by norm_num) n
  have hfloorle : (n : ℝ) ≤ (‖x‖)⁻¹ := by
    simp only [hndef]
    exact Nat.floor_le (le_of_lt (inv_pos.mpr hpos))
  have hpowkR : ((2 : ℝ) ^ k) ≤ (‖x‖)⁻¹ := by
    calc ((2 : ℝ) ^ k) = ((2 ^ k : ℕ) : ℝ) := by push_cast; ring
      _ ≤ (n : ℝ) := by exact_mod_cast hpowk
      _ ≤ (‖x‖)⁻¹ := hfloorle
  have hltR : (‖x‖)⁻¹ < (2 : ℝ) ^ (k + 1) := by
    have h1 : (‖x‖)⁻¹ < (n : ℝ) + 1 := by
      simp only [hndef]
      exact Nat.lt_floor_add_one _
    have h2 : ((n : ℝ) + 1) ≤ ((2 : ℝ) ^ (k + 1)) := by
      have : (n : ℕ) + 1 ≤ 2 ^ (k + 1) := by omega
      calc ((n : ℝ) + 1) = (((n + 1 : ℕ)) : ℝ) := by push_cast; ring
        _ ≤ (((2 ^ (k + 1) : ℕ)) : ℝ) := by exact_mod_cast this
        _ = ((2 : ℝ) ^ (k + 1)) := by push_cast; ring
    linarith
  have hkj : k ≤ j := by
    have h2 : ((2 : ℝ) ^ k) ≤ ((2 : ℝ) ^ j) := by
      refine hpowkR.trans ?_
      rw [inv_le_iff_one_le_mul₀ hpos]
      rw [mul_comm]
      have := hxj
      rw [inv_le_iff_one_le_mul₀ (by positivity : (0:ℝ) < (2:ℝ)^j)] at this
      nlinarith [this]
    have := (pow_le_pow_iff_right₀ (by norm_num : (1:ℝ) < 2)).mp h2
    exact this
  have hxk : ‖((2 : ℝ) ^ k) • x‖ ≤ 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity : (0:ℝ) < (2:ℝ)^k)]
    rw [← le_div_iff₀ hpos] at *
    calc ((2 : ℝ) ^ k) ≤ (‖x‖)⁻¹ := hpowkR
      _ = 1 / ‖x‖ := by rw [one_div]
  have hGk : (1 : ℝ) / (4 * ‖x‖) ≤ dvGk Gb k x := by
    have hlow := hGlow _ hxk
    unfold dvGk
    have hstep : ((2 : ℝ) ^ k) * (1 / 2) ≤ ((2 : ℝ) ^ k) * Gb (((2 : ℝ) ^ k) • x) :=
      mul_le_mul_of_nonneg_left hlow (by positivity)
    have hkey : (1 : ℝ) / (4 * ‖x‖) ≤ ((2 : ℝ) ^ k) * (1 / 2) := by
      rw [div_le_iff₀ (by positivity)]
      have h1 : (1 : ℝ) < (2 : ℝ) ^ (k + 1) * ‖x‖ := by
        rw [inv_lt_iff_one_lt_mul₀ hpos] at hltR
        linarith [hltR]
      have hrw : (2 : ℝ) ^ (k + 1) = (2 : ℝ) ^ k * 2 := by ring
      rw [hrw] at h1
      nlinarith
    linarith
  have hmem : k ∈ Finset.range (j + 1) := by
    rw [Finset.mem_range]
    omega
  have hsum : ENNReal.ofReal (dvGk Gb k x) ≤
      ∑ k' ∈ Finset.range (j + 1), ENNReal.ofReal (dvGk Gb k' x) :=
    Finset.single_le_sum (f := fun k' => ENNReal.ofReal (dvGk Gb k' x))
      (fun k' _ => bot_le) hmem
  rw [dvWeight_eq_inv hx]
  calc ENNReal.ofReal (‖x‖⁻¹) ≤ ENNReal.ofReal (4 * dvGk Gb k x) := by
        refine ENNReal.ofReal_le_ofReal ?_
        have h4 : ‖x‖⁻¹ = 4 * ((1 : ℝ) / (4 * ‖x‖)) := by
          field_simp
        rw [h4]
        exact mul_le_mul_of_nonneg_left hGk (by norm_num)
    _ = ENNReal.ofReal 4 * ENNReal.ofReal (dvGk Gb k x) := by
        rw [← ENNReal.ofReal_mul (by norm_num)]
    _ ≤ ENNReal.ofReal 4 * ∑ k' ∈ Finset.range (j + 1),
          ENNReal.ofReal (dvGk Gb k' x) := mul_le_mul' le_rfl hsum

set_option maxHeartbeats 1000000 in
/-- The critical weight has linear mass on small balls. -/
theorem dvBallWeight_le {ρ : ℝ} (hρ : 0 < ρ) :
    (∫⁻ x in Metric.ball (0 : Euclidean 2) ρ, radialPowerWeight 2 (-1) x) ≤
      ENNReal.ofReal (surfaceMass 2 * ρ) := by
  classical
  set F : ℝ → ℝ≥0∞ := fun r =>
    Set.indicator (Iio ρ) (fun r => (ENNReal.ofReal r)⁻¹) r with hFdef
  have hFmeas : Measurable F := by
    simp only [hFdef]
    refine Measurable.indicator ?_ measurableSet_Iio
    have hm : Measurable fun r : ℝ => (ENNReal.ofReal r)⁻¹ := by
      exact (ENNReal.measurable_ofReal).inv
    exact hm
  have hind : ∀ x : Euclidean 2,
      (Metric.ball (0 : Euclidean 2) ρ).indicator (radialPowerWeight 2 (-1)) x = F ‖x‖ := by
    intro x
    by_cases hx : x ∈ Metric.ball (0 : Euclidean 2) ρ
    · rw [Set.indicator_of_mem hx]
      have hxlt : ‖x‖ < ρ := by
        rw [Metric.mem_ball, dist_zero_right] at hx
        exact hx
      simp only [hFdef]
      rw [Set.indicator_of_mem (show ‖x‖ ∈ Iio ρ from hxlt)]
      unfold radialPowerWeight
      rw [ENNReal.rpow_neg_one]
    · rw [Set.indicator_of_notMem hx]
      have hxge : ρ ≤ ‖x‖ := by
        rw [Metric.mem_ball, dist_zero_right] at hx
        exact le_of_not_gt hx
      simp only [hFdef]
      rw [Set.indicator_of_notMem (by simpa using hxge)]
  have hstep1 : (∫⁻ x in Metric.ball (0 : Euclidean 2) ρ, radialPowerWeight 2 (-1) x) =
      ∫⁻ x : Euclidean 2, F ‖x‖ := by
    rw [← lintegral_indicator measurableSet_ball]
    exact lintegral_congr hind
  rw [hstep1, lintegral_euclidean_radial (d := 2) (by norm_num) F hFmeas]
  have hinner : (∫⁻ r in Ioi (0 : ℝ), ENNReal.ofReal r ^ (2 - 1) * F r) ≤
      ENNReal.ofReal ρ := by
    have hcongr : ∀ r ∈ Ioi (0 : ℝ), ENNReal.ofReal r ^ (2 - 1) * F r =
        Set.indicator (Iio ρ) (fun _ => (1 : ℝ≥0∞)) r := by
      intro r hr
      have hr0 : (0 : ℝ) < r := hr
      by_cases hrρ : r < ρ
      · simp only [hFdef]
        rw [Set.indicator_of_mem (show r ∈ Iio ρ from hrρ),
          Set.indicator_of_mem (show r ∈ Iio ρ from hrρ), pow_one]
        exact ENNReal.mul_inv_cancel (by simpa using hr0) (by simp)
      · simp only [hFdef]
        rw [Set.indicator_of_notMem (by simpa using le_of_not_gt hrρ),
          Set.indicator_of_notMem (by simpa using le_of_not_gt hrρ), mul_zero]
    calc (∫⁻ r in Ioi (0 : ℝ), ENNReal.ofReal r ^ (2 - 1) * F r) =
        ∫⁻ r in Ioi (0 : ℝ), Set.indicator (Iio ρ) (fun _ => (1 : ℝ≥0∞)) r :=
          setLIntegral_congr_fun measurableSet_Ioi hcongr
      _ = volume (Iio ρ ∩ Ioi (0 : ℝ)) := by
          rw [lintegral_indicator measurableSet_Iio, Measure.restrict_restrict measurableSet_Iio]
          simp
      _ = ENNReal.ofReal ρ := by
          have hset : Iio ρ ∩ Ioi (0 : ℝ) = Ioo (0 : ℝ) ρ := by
            ext y
            simp only [Set.mem_inter_iff, Set.mem_Iio, Set.mem_Ioi, Set.mem_Ioo]
            tauto
          rw [hset, Real.volume_Ioo]
          congr 1
          ring
      _ ≤ ENNReal.ofReal ρ := le_rfl
  calc ENNReal.ofReal (surfaceMass 2) *
      ∫⁻ r in Ioi (0 : ℝ), ENNReal.ofReal r ^ (2 - 1) * F r ≤
      ENNReal.ofReal (surfaceMass 2) * ENNReal.ofReal ρ := mul_le_mul' le_rfl hinner
    _ = ENNReal.ofReal (surfaceMass 2 * ρ) := by
        rw [← ENNReal.ofReal_mul]
        exact le_of_lt (surfaceMass_pos (by norm_num))
/-! ### The `L²`-to-`L∞` bound for the band maximal operator -/

set_option maxHeartbeats 1000000 in
/-- Cauchy--Schwarz bound for the inverse transform of a compactly supported
bounded multiplier applied to Schwartz data. -/
theorem dvSupCauchySchwarz {m : Euclidean 2 → ℂ} (hmc : Continuous m)
    {β R : ℝ} (hβ : 0 ≤ β) (hR : 0 ≤ R)
    (hbd : ∀ ξ : Euclidean 2, ‖m ξ‖ ≤ β * (Metric.closedBall (0 : Euclidean 2) R).indicator
      (fun _ => (1 : ℝ)) ξ)
    (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2) :
    ‖𝓕⁻ (fun ξ => m ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x‖ ≤
      β * Real.sqrt ((volume (Metric.closedBall (0 : Euclidean 2) R)).toReal) *
        Real.sqrt (∫ y : Euclidean 2, ‖f y‖ ^ 2) := by
  classical
  set S : Set (Euclidean 2) := Metric.closedBall (0 : Euclidean 2) R with hSdef
  have hSmeas : MeasurableSet S := measurableSet_closedBall
  have hSfin : volume S ≠ ⊤ := measure_closedBall_lt_top.ne
  set g : Euclidean 2 → ℝ := fun ξ => S.indicator (fun _ => (1 : ℝ)) ξ with hgdef
  set h : Euclidean 2 → ℝ := fun ξ => ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖ with hhdef
  have hFcont : Continuous (𝓕 (f : Euclidean 2 → ℂ)) := by
    have hcoe : 𝓕 (f : Euclidean 2 → ℂ) =
        ((𝓕 f : SchwartzMap (Euclidean 2) ℂ) : Euclidean 2 → ℂ) := by
      rw [SchwartzMap.fourier_coe]
    rw [hcoe]
    exact (𝓕 f : SchwartzMap (Euclidean 2) ℂ).continuous
  have hgL2 : MemLp g 2 volume := by
    simp only [hgdef]
    refine memLp_indicator_const 2 hSmeas (1 : ℝ) ?_
    right
    exact hSfin
  have hhL2 : MemLp h 2 volume := by
    simp only [hhdef]
    have hmem : MemLp ((𝓕 f : SchwartzMap (Euclidean 2) ℂ) : Euclidean 2 → ℂ) 2 volume :=
      (𝓕 f : SchwartzMap (Euclidean 2) ℂ).memLp 2 volume
    have hcoe : 𝓕 (f : Euclidean 2 → ℂ) =
        ((𝓕 f : SchwartzMap (Euclidean 2) ℂ) : Euclidean 2 → ℂ) := by
      rw [SchwartzMap.fourier_coe]
    rw [hcoe]
    exact hmem.norm
  have hgnn : 0 ≤ᵐ[volume] g := Filter.Eventually.of_forall fun ξ => by
    simp only [hgdef]
    exact Set.indicator_nonneg (fun _ _ => zero_le_one) ξ
  have hhnn : 0 ≤ᵐ[volume] h := Filter.Eventually.of_forall fun ξ => norm_nonneg _
  have hCS := integral_mul_le_Lp_mul_Lq_of_nonneg (μ := (volume : Measure (Euclidean 2)))
    (p := 2) (q := 2) (Real.HolderConjugate.two_two) hgnn hhnn (by simpa using hgL2)
    (by simpa using hhL2)
  -- the two factors
  have hgsq : (∫ ξ : Euclidean 2, g ξ ^ (2 : ℝ)) = (volume S).toReal := by
    have hpt : ∀ ξ : Euclidean 2, g ξ ^ (2 : ℝ) = g ξ := by
      intro ξ
      simp only [hgdef]
      by_cases hξ : ξ ∈ S
      · rw [Set.indicator_of_mem hξ]
        norm_num
      · rw [Set.indicator_of_notMem hξ]
        rw [Real.zero_rpow (by norm_num)]
    rw [integral_congr_ae (Filter.Eventually.of_forall hpt)]
    simp only [hgdef]
    rw [integral_indicator hSmeas, setIntegral_const]
    simp [Measure.real]
  have hhsq : (∫ ξ : Euclidean 2, h ξ ^ (2 : ℝ)) = ∫ y : Euclidean 2, ‖f y‖ ^ 2 := by
    have hpt : ∀ ξ : Euclidean 2, h ξ ^ (2 : ℝ) = h ξ ^ (2 : ℕ) := by
      intro ξ
      rw [← Real.rpow_natCast (h ξ) 2]
      norm_num
    rw [integral_congr_ae (Filter.Eventually.of_forall hpt)]
    simp only [hhdef]
    exact Codex.Spherical.FourierRadius.integral_norm_sq_fourier_schwartz_eq f
  -- assemble
  have hstep : (∫ ξ : Euclidean 2, ‖m ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ‖) ≤
      β * ∫ ξ : Euclidean 2, g ξ * h ξ := by
    have hint1 : Integrable (fun ξ : Euclidean 2 => β * (g ξ * h ξ)) volume := by
      refine Integrable.const_mul ?_ β
      exact (hgL2.integrable_mul hhL2)
    refine integral_mono ?_ hint1 ?_ |>.trans (by rw [integral_const_mul])
    · refine Integrable.mono' hint1 ((hmc.mul hFcont).norm.aestronglyMeasurable) ?_
      refine Filter.Eventually.of_forall fun ξ => ?_
      rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _), norm_mul]
      calc ‖m ξ‖ * ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖ ≤ (β * g ξ) * h ξ :=
            mul_le_mul_of_nonneg_right (hbd ξ) (norm_nonneg _)
        _ = β * (g ξ * h ξ) := by ring
    · intro ξ
      simp only []
      rw [norm_mul]
      calc ‖m ξ‖ * ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖ ≤ (β * g ξ) * h ξ :=
            mul_le_mul_of_nonneg_right (hbd ξ) (norm_nonneg _)
        _ = β * (g ξ * h ξ) := by ring
  calc ‖𝓕⁻ (fun ξ => m ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x‖ ≤
      ∫ ξ : Euclidean 2, ‖m ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ‖ := dvNorm_fourierInv_le x
    _ ≤ β * ∫ ξ : Euclidean 2, g ξ * h ξ := hstep
    _ ≤ β * ((∫ ξ : Euclidean 2, g ξ ^ (2:ℝ)) ^ ((1:ℝ)/2) *
        (∫ ξ : Euclidean 2, h ξ ^ (2:ℝ)) ^ ((1:ℝ)/2)) :=
        mul_le_mul_of_nonneg_left hCS hβ
    _ = β * Real.sqrt ((volume S).toReal) *
        Real.sqrt (∫ y : Euclidean 2, ‖f y‖ ^ 2) := by
        rw [hgsq, hhsq, Real.sqrt_eq_rpow, Real.sqrt_eq_rpow]
        ring

set_option maxHeartbeats 1000000 in
/-- The `L²`-to-`L∞` bound for the frequency-localized maximal operator. -/
theorem dvSupBound {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1)
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) {C : ℝ} (hC : 0 < C)
    (hb : ∀ (j : ℕ) (p : CoordinateWavePart) (u : ℝ), 1 ≤ u →
      ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
        ‖dvBandAmp phi j p u r‖ ≤ C / Real.sqrt u ∧
        ‖dvBandAmpDeriv phi j p u r‖ ≤ C / Real.sqrt u ∧
        ‖dvBandAmpDeriv2 phi j p u r‖ ≤ C / Real.sqrt u)
    (j : ℕ) (hj : 3 ≤ j) {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2) :
    restrictedRelativeBandpassSphericalMaximal 2 E phi j f x ≤
      ENNReal.ofReal ((48 * C * Real.sqrt 5 *
          Real.sqrt ((volume (Metric.ball (0 : Euclidean 2) 1)).toReal)) *
        Real.sqrt ((2 : ℝ) ^ j) * Real.sqrt (∫ y : Euclidean 2, ‖f y‖ ^ 2)) := by
  classical
  set V0 : ℝ := (volume (Metric.ball (0 : Euclidean 2) 1)).toReal with hV0def
  have hV0 : 0 ≤ V0 := ENNReal.toReal_nonneg
  set R : ℝ := (2 : ℝ) ^ (j + 4) with hRdef
  have hR0 : (0 : ℝ) ≤ R := by positivity
  have hpowj : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hsqj : (0 : ℝ) < Real.sqrt ((2 : ℝ) ^ j) := Real.sqrt_pos.mpr hpowj
  set β : ℝ := 3 * C * Real.sqrt 5 / Real.sqrt ((2 : ℝ) ^ j) with hβdef
  have hβ0 : (0 : ℝ) ≤ β := by
    simp only [hβdef]
    positivity
  -- the volume factor
  have hvol : (volume (Metric.closedBall (0 : Euclidean 2) R)).toReal = R ^ 2 * V0 := by
    rw [Measure.addHaar_closedBall (volume : Measure (Euclidean 2)) (0 : Euclidean 2) hR0]
    have hrank : Module.finrank ℝ (Euclidean 2) = 2 := by simp [Euclidean]
    rw [hrank, hV0def, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]
  have hsqrtvol : Real.sqrt ((volume (Metric.closedBall (0 : Euclidean 2) R)).toReal) =
      R * Real.sqrt V0 := by
    rw [hvol, Real.sqrt_mul (by positivity), Real.sqrt_sq hR0]
  -- the pointwise multiplier bound
  have hmbd : ∀ r : ℝ, 1 ≤ r → r ≤ 2 → ∀ ξ : Euclidean 2,
      ‖dvSig phi j ‖ξ‖ r‖ ≤ β * (Metric.closedBall (0 : Euclidean 2) R).indicator
        (fun _ => (1 : ℝ)) ξ := by
    intro r hr1 hr2 ξ
    have hr14 : (1 : ℝ) / 4 ≤ r := by linarith
    have hr5 : r ≤ 5 := by linarith
    by_cases hξ : ξ ∈ Metric.closedBall (0 : Euclidean 2) R
    · rw [Set.indicator_of_mem hξ, mul_one]
      by_cases hsmall : ‖ξ‖ * 5 < (2 : ℝ) ^ j
      · rw [dvSig_eq_zero_of_small hone j (norm_nonneg ξ) (by linarith) hr5 hsmall,
          norm_zero]
        exact hβ0
      · push_neg at hsmall
        have hlow : (2 : ℝ) ^ j / 5 ≤ ‖ξ‖ := by
          rw [div_le_iff₀ (by norm_num)]
          exact hsmall
        have hpow8 : (8 : ℝ) ≤ (2 : ℝ) ^ j := by
          calc (8 : ℝ) = (2 : ℝ) ^ 3 := by norm_num
            _ ≤ (2 : ℝ) ^ j := by
                apply pow_le_pow_right₀ (by norm_num)
                omega
        have hξ1 : (1 : ℝ) ≤ ‖ξ‖ := by
          have : (8 : ℝ) / 5 ≤ ‖ξ‖ := le_trans (by linarith) hlow
          linarith
        have hstep := norm_dvSig_le hb j hξ1 hr14 hr5
        refine hstep.trans ?_
        simp only [hβdef]
        have hsqξ : (0 : ℝ) < Real.sqrt ‖ξ‖ :=
          Real.sqrt_pos.mpr (by linarith : (0:ℝ) < ‖ξ‖)
        have hsq : Real.sqrt ((2 : ℝ) ^ j) ≤ Real.sqrt 5 * Real.sqrt ‖ξ‖ := by
          rw [← Real.sqrt_mul (by norm_num)]
          apply Real.sqrt_le_sqrt
          nlinarith [hlow]
        rw [show (3 : ℝ) * (C / Real.sqrt ‖ξ‖) = (3 * C) / Real.sqrt ‖ξ‖ by ring,
          div_le_div_iff₀ hsqξ hsqj]
        nlinarith [hC.le, Real.sqrt_nonneg ‖ξ‖, Real.sqrt_nonneg (5 : ℝ), hsqj.le]
    · have hbig : R < ‖ξ‖ := by
        rw [Metric.mem_closedBall, dist_zero_right] at hξ
        exact lt_of_not_ge hξ
      rw [dvSig_eq_zero_of_large hzero j (norm_nonneg ξ) hr14 (by simpa [hRdef] using hbig),
        norm_zero, Set.indicator_of_notMem hξ]
      simp
  -- take the supremum over the radius set
  refine iSup_le fun r => ?_
  have hrE : r.1 ∈ Icc (1 : ℝ) 2 := hE r.2.1
  have hr1 : (1 : ℝ) ≤ r.1 := hrE.1
  have hr2 : r.1 ≤ 2 := hrE.2
  have hrpos : (0 : ℝ) < r.1 := by linarith
  have hmult : (fun ξ : Euclidean 2 => surfaceFourier 2 (-r.1 • ξ) *
      (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (r.1 • ξ)) -
        phi ((((2 : ℝ) ^ j)⁻¹) • (r.1 • ξ))) * 𝓕 (f : Euclidean 2 → ℂ) ξ) =
      fun ξ : Euclidean 2 => dvSig phi j ‖ξ‖ r.1 * 𝓕 (f : Euclidean 2 → ℂ) ξ := by
    funext ξ
    rw [dvSig_eq_multiplier hrad j hrpos ξ]
  have hcont : Continuous fun ξ : Euclidean 2 => dvSig phi j ‖ξ‖ r.1 := by
    have hmap : Continuous fun ξ : Euclidean 2 => ((‖ξ‖ : ℝ), r.1) :=
      Continuous.prodMk continuous_norm continuous_const
    have h := (continuous_uncurry_dvSig phi j).comp hmap
    simpa [Function.comp_def] using h
  have hcs := dvSupCauchySchwarz hcont hβ0 hR0 (hmbd r.1 hr1 hr2) f x
  rw [hmult]
  refine ENNReal.ofReal_le_ofReal ?_
  refine hcs.trans ?_
  rw [hsqrtvol]
  have hβR : β * (R * Real.sqrt V0) =
      (48 * C * Real.sqrt 5 * Real.sqrt V0) * Real.sqrt ((2 : ℝ) ^ j) := by
    simp only [hβdef, hRdef]
    have hrw : (2 : ℝ) ^ (j + 4) = 16 * (2 : ℝ) ^ j := by ring
    rw [hrw]
    have hdiv : (2 : ℝ) ^ j / Real.sqrt ((2 : ℝ) ^ j) = Real.sqrt ((2 : ℝ) ^ j) :=
      Real.div_sqrt
    field_simp
    nlinarith [hdiv, Real.sq_sqrt (le_of_lt hpowj), Real.sqrt_nonneg ((2:ℝ)^j),
      Real.sqrt_nonneg V0, Real.sqrt_nonneg (5:ℝ)]
  calc β * (R * Real.sqrt V0) * Real.sqrt (∫ y : Euclidean 2, ‖f y‖ ^ 2) =
      ((48 * C * Real.sqrt 5 * Real.sqrt V0) * Real.sqrt ((2 : ℝ) ^ j)) *
        Real.sqrt (∫ y : Euclidean 2, ‖f y‖ ^ 2) := by rw [hβR]
    _ = 48 * C * Real.sqrt 5 * Real.sqrt V0 * Real.sqrt ((2 : ℝ) ^ j) *
        Real.sqrt (∫ y : Euclidean 2, ‖f y‖ ^ 2) := by ring
    _ ≤ 48 * C * Real.sqrt 5 * Real.sqrt V0 * Real.sqrt ((2 : ℝ) ^ j) *
        Real.sqrt (∫ y : Euclidean 2, ‖f y‖ ^ 2) := le_rfl
/-! ### The derivative normal form, the maximal interface and the Sobolev step -/

set_option maxHeartbeats 1000000 in
/-- The radial normal form of the derivative multiplier agrees with the
product-rule expression. -/
theorem dvSigDnum_eq_productRule {phi : SchwartzMap (Euclidean 2) ℂ}
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ) {t : ℝ} (ht : 0 < t)
    (ξ : Euclidean 2) :
    dvSigDnum phi j ‖ξ‖ t =
      deriv (fun u : ℝ => surfaceFourier 2 (-u • ξ)) t *
          (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) -
            phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) +
        surfaceFourier 2 (-t • ξ) *
          deriv (fun u : ℝ => phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • ξ)) -
            phi ((((2 : ℝ) ^ j)⁻¹) • (u • ξ))) t := by
  -- the surface factor is differentiable in the radius
  have hsurf : HasDerivAt (fun u : ℝ => surfaceFourier 2 (-u • ξ))
      (deriv (fun u : ℝ => surfaceFourier 2 (-u • ξ)) t) t := by
    have hcd : ContDiff ℝ (⊤ : ℕ∞) fun u : ℝ => surfaceFourier 2 (-u • ξ) := by
      refine (contDiff_surfaceFourier 2).comp ?_
      have : ContDiff ℝ (⊤ : ℕ∞) fun u : ℝ => -u • ξ := by fun_prop
      exact this
    exact ((hcd.differentiable (by simp)) t).hasDerivAt
  have hband : HasDerivAt (fun u : ℝ => phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • ξ)) -
      phi ((((2 : ℝ) ^ j)⁻¹) • (u • ξ)))
      (deriv (fun u : ℝ => phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • ξ)) -
        phi ((((2 : ℝ) ^ j)⁻¹) • (u • ξ))) t) t := by
    have hcd : ContDiff ℝ (⊤ : ℕ∞) fun u : ℝ =>
        phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • ξ)) - phi ((((2 : ℝ) ^ j)⁻¹) • (u • ξ)) := by
      refine ContDiff.sub ?_ ?_
      · refine (phi.smooth (⊤ : ℕ∞)).comp ?_
        have : ContDiff ℝ (⊤ : ℕ∞) fun u : ℝ => (((2 : ℝ) ^ (j + 1))⁻¹) • (u • ξ) := by
          fun_prop
        exact this
      · refine (phi.smooth (⊤ : ℕ∞)).comp ?_
        have : ContDiff ℝ (⊤ : ℕ∞) fun u : ℝ => (((2 : ℝ) ^ j)⁻¹) • (u • ξ) := by
          fun_prop
        exact this
    exact ((hcd.differentiable (by simp)) t).hasDerivAt
  have hprod := hsurf.mul hband
  by_cases hξ : ξ = 0
  · subst hξ
    have hband0 : ∀ u : ℝ, (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • (0 : Euclidean 2))) -
        phi ((((2 : ℝ) ^ j)⁻¹) • (u • (0 : Euclidean 2)))) = 0 := by
      intro u
      simp
    have hderivband : deriv (fun u : ℝ => phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • (0 : Euclidean 2))) -
        phi ((((2 : ℝ) ^ j)⁻¹) • (u • (0 : Euclidean 2)))) t = 0 := by
      have hfun : (fun u : ℝ => phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • (0 : Euclidean 2))) -
          phi ((((2 : ℝ) ^ j)⁻¹) • (u • (0 : Euclidean 2)))) = fun _ => (0 : ℂ) := by
        funext u
        exact hband0 u
      rw [hfun]
      simp
    have hdvSigDnum0 : dvSigDnum phi j ‖(0 : Euclidean 2)‖ t = 0 := by
      have hband00 : dvBand phi j (‖(0 : Euclidean 2)‖ * t) = 0 := by
        unfold dvBand
        norm_num
      unfold dvSigDnum dvBandAmpDeriv dvBandAmp
      rw [hband00]
      simp
    rw [hdvSigDnum0, hderivband, hband0 t]
    simp
  · have hnormpos : (0 : ℝ) < ‖ξ‖ := norm_pos_iff.mpr hξ
    have hev : (fun u : ℝ => dvSig phi j ‖ξ‖ u) =ᶠ[nhds t]
        fun u : ℝ => surfaceFourier 2 (-u • ξ) *
          (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • ξ)) -
            phi ((((2 : ℝ) ^ j)⁻¹) • (u • ξ))) := by
      have hnb : Ioi (0 : ℝ) ∈ nhds t := isOpen_Ioi.mem_nhds ht
      filter_upwards [hnb] with u hu
      exact (dvSig_eq_multiplier hrad j hu ξ).symm
    have hd1 : HasDerivAt (fun u : ℝ => dvSig phi j ‖ξ‖ u)
        ((‖ξ‖ : ℂ) * dvSigD phi j ‖ξ‖ t) t :=
      hasDerivAt_dvSig phi j (ne_of_gt hnormpos) t
    have hd2 := hd1.congr_of_eventuallyEq hev.symm
    have huniq := hd2.unique hprod
    rw [dvSigDnum_eq]
    exact huniq

set_option maxHeartbeats 1000000 in
/-- The localized band maximal function is bounded by any uniform bound for
the frequency-localized radius slices. -/
theorem dvMaximal_le_of_pointwise {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2)
    (Y : ℝ≥0∞)
    (hbd : ∀ r : ℝ, 1 ≤ r → r ≤ 2 → ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean 2 =>
        surfaceFourier 2 (-r • ξ) * (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (r • ξ)) -
          phi ((((2 : ℝ) ^ j)⁻¹) • (r • ξ))) * dvFreqCut phi j ξ *
        𝓕 (f : Euclidean 2 → ℂ) ξ) x‖ ≤ Y) :
    restrictedRelativeBandpassSphericalMaximal 2 E phi j f x ≤ Y := by
  refine iSup_le fun r => ?_
  have hrE : r.1 ∈ Icc (1 : ℝ) 2 := hE r.2.1
  have hr1 : (1 : ℝ) ≤ r.1 := hrE.1
  have hr2 : r.1 ≤ 2 := hrE.2
  have hr14 : (1 : ℝ) / 4 ≤ r.1 := by linarith
  have hrpos : (0 : ℝ) < r.1 := by linarith
  have hint : (fun ξ : Euclidean 2 => surfaceFourier 2 (-r.1 • ξ) *
      (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (r.1 • ξ)) -
        phi ((((2 : ℝ) ^ j)⁻¹) • (r.1 • ξ))) * 𝓕 (f : Euclidean 2 → ℂ) ξ) =
      fun ξ : Euclidean 2 => surfaceFourier 2 (-r.1 • ξ) *
        (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (r.1 • ξ)) -
          phi ((((2 : ℝ) ^ j)⁻¹) • (r.1 • ξ))) * dvFreqCut phi j ξ *
        𝓕 (f : Euclidean 2 → ℂ) ξ := by
    funext ξ
    rw [dvSig_eq_multiplier hrad j hrpos ξ,
      dvSig_mul_dvFreqCut hone hzero j hr14 ξ]
  rw [hint]
  exact hbd r.1 hr1 hr2

set_option maxHeartbeats 1000000 in
/-- **The radial Sobolev estimate with a doubly vanishing weight.**  Every
term on the right carries the smooth radial weight. -/
theorem dvSobolev2 {F FD : ℝ → ℂ} (hFcont : Continuous F) (hFDcont : Continuous FD)
    (hderiv : ∀ t : ℝ, HasDerivAt F (FD t) t) (lam : ℝ) (hlam : 0 < lam)
    {r₀ : ℝ} (h1 : 1 ≤ r₀) (h2 : r₀ ≤ 2) :
    ‖F r₀‖ ^ 2 ≤ (120 + 36 * lam) * (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖F t‖ ^ 2) +
      36 * lam⁻¹ * (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖FD t‖ ^ 2) := by
  set G : ℝ → ℝ := fun t => (dvWeight t) ^ 2 * ‖F t‖ ^ 2 with hGdef
  set G' : ℝ → ℝ := fun t =>
    2 * dvWeight t * dvWeightDeriv t * ‖F t‖ ^ 2 +
      (dvWeight t) ^ 2 * (2 * (inner ℝ (F t) (FD t) : ℝ)) with hG'def
  have hnormsq : ∀ t : ℝ, HasDerivAt (fun s : ℝ => ‖F s‖ ^ 2)
      (2 * (inner ℝ (F t) (FD t) : ℝ)) t := by
    intro t
    simpa using (hderiv t).norm_sq
  have hwsq : ∀ t : ℝ, HasDerivAt (fun s : ℝ => (dvWeight s) ^ 2)
      (2 * dvWeight t * dvWeightDeriv t) t := by
    intro t
    have h := (hasDerivAt_dvWeight t).pow 2
    refine h.congr_deriv ?_
    ring
  have hGderiv : ∀ t : ℝ, HasDerivAt G (G' t) t := fun t => (hwsq t).mul (hnormsq t)
  have hG'cont : Continuous G' := by
    simp only [hG'def]
    exact ((continuous_const.mul continuous_dvWeight).mul continuous_dvWeightDeriv).mul
      (hFcont.norm.pow 2) |>.add
      ((continuous_dvWeight.pow 2).mul (continuous_const.mul (hFcont.inner hFDcont)))
  have hFTC : G r₀ - G (1 / 4) = ∫ t in (1 / 4 : ℝ)..r₀, G' t := by
    refine (intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hGderiv t) ?_).symm
    exact hG'cont.intervalIntegrable _ _
  have hG0 : G (1 / 4) = 0 := by
    simp only [hGdef, dvWeight_left]
    norm_num
  have hlow : ‖F r₀‖ ^ 2 ≤ G r₀ := by
    simp only [hGdef]
    have hw : 1 ≤ dvWeight r₀ := one_le_dvWeight (by linarith) (by linarith)
    have hw2 : (1 : ℝ) ≤ dvWeight r₀ ^ 2 := by nlinarith
    nlinarith [sq_nonneg ‖F r₀‖]
  have hptwise : ∀ t ∈ Set.uIcc (1 / 4 : ℝ) 5, G' t ≤
      (120 + 36 * lam) * (dvWeight t * ‖F t‖ ^ 2) +
        36 * lam⁻¹ * (dvWeight t * ‖FD t‖ ^ 2) := by
    intro t ht
    rw [Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)] at ht
    have hd : |dvWeightDeriv t| ≤ 60 := abs_dvWeightDeriv_le ht.1 ht.2
    have hw0 : 0 ≤ dvWeight t := dvWeight_nonneg t
    have hwle : dvWeight t ≤ 36 := dvWeight_le ht.1 ht.2
    have hinner : (inner ℝ (F t) (FD t) : ℝ) ≤ ‖F t‖ * ‖FD t‖ := real_inner_le_norm _ _
    have hyoung : 2 * (‖F t‖ * ‖FD t‖) ≤ lam * ‖F t‖ ^ 2 + lam⁻¹ * ‖FD t‖ ^ 2 := by
      have h0 : 0 ≤ (lam * ‖F t‖ - ‖FD t‖) ^ 2 := sq_nonneg _
      have hinvl : lam⁻¹ * lam = 1 := inv_mul_cancel₀ hlam.ne'
      have hmul : 2 * (‖F t‖ * ‖FD t‖) * lam ≤
          (lam * ‖F t‖ ^ 2 + lam⁻¹ * ‖FD t‖ ^ 2) * lam := by
        nlinarith [h0, hinvl]
      exact le_of_mul_le_mul_right hmul hlam
    have hterm1 : 2 * dvWeight t * dvWeightDeriv t * ‖F t‖ ^ 2 ≤
        120 * (dvWeight t * ‖F t‖ ^ 2) := by
      have habs := abs_le.mp hd
      nlinarith [sq_nonneg ‖F t‖, hw0, habs.1, habs.2,
        mul_nonneg hw0 (sq_nonneg ‖F t‖)]
    have hterm2 : (dvWeight t) ^ 2 * (2 * (inner ℝ (F t) (FD t) : ℝ)) ≤
        36 * dvWeight t * (lam * ‖F t‖ ^ 2 + lam⁻¹ * ‖FD t‖ ^ 2) := by
      have hstep : (dvWeight t) ^ 2 * (2 * (inner ℝ (F t) (FD t) : ℝ)) ≤
          (dvWeight t) ^ 2 * (lam * ‖F t‖ ^ 2 + lam⁻¹ * ‖FD t‖ ^ 2) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        nlinarith
      refine hstep.trans ?_
      have hnn : 0 ≤ lam * ‖F t‖ ^ 2 + lam⁻¹ * ‖FD t‖ ^ 2 := by
        have : (0:ℝ) < lam⁻¹ := inv_pos.mpr hlam
        positivity
      have hsq : (dvWeight t) ^ 2 ≤ 36 * dvWeight t := by nlinarith
      exact mul_le_mul_of_nonneg_right hsq hnn
    simp only [hG'def]
    nlinarith [hterm1, hterm2, hw0]
  have hRint : IntervalIntegrable (fun t : ℝ =>
      (120 + 36 * lam) * (dvWeight t * ‖F t‖ ^ 2) +
        36 * lam⁻¹ * (dvWeight t * ‖FD t‖ ^ 2)) volume (1 / 4 : ℝ) 5 := by
    refine Continuous.intervalIntegrable ?_ _ _
    exact (continuous_const.mul (continuous_dvWeight.mul (hFcont.norm.pow 2))).add
      (continuous_const.mul (continuous_dvWeight.mul (hFDcont.norm.pow 2)))
  have hmono : (∫ t in (1 / 4 : ℝ)..r₀, G' t) ≤
      ∫ t in (1 / 4 : ℝ)..5, ((120 + 36 * lam) * (dvWeight t * ‖F t‖ ^ 2) +
        36 * lam⁻¹ * (dvWeight t * ‖FD t‖ ^ 2)) := by
    have hstep1 : (∫ t in (1 / 4 : ℝ)..r₀, G' t) ≤
        ∫ t in (1 / 4 : ℝ)..r₀, ((120 + 36 * lam) * (dvWeight t * ‖F t‖ ^ 2) +
          36 * lam⁻¹ * (dvWeight t * ‖FD t‖ ^ 2)) := by
      refine intervalIntegral.integral_mono_on (by linarith) (hG'cont.intervalIntegrable _ _)
        (hRint.mono_set ?_) ?_
      · rw [Set.uIcc_of_le (by linarith : (1 / 4 : ℝ) ≤ r₀),
          Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)]
        exact Set.Icc_subset_Icc le_rfl (by linarith)
      · intro t ht
        refine hptwise t ?_
        rw [Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)]
        exact ⟨ht.1, by linarith [ht.2]⟩
    refine hstep1.trans ?_
    refine intervalIntegral.integral_mono_interval le_rfl (by linarith) (by linarith) ?_ hRint
    refine Filter.Eventually.of_forall fun t => ?_
    have hw0 : 0 ≤ dvWeight t := dvWeight_nonneg t
    have hlam0 : (0:ℝ) < lam⁻¹ := inv_pos.mpr hlam
    positivity
  have hsplit : (∫ t in (1 / 4 : ℝ)..5, ((120 + 36 * lam) * (dvWeight t * ‖F t‖ ^ 2) +
      36 * lam⁻¹ * (dvWeight t * ‖FD t‖ ^ 2))) =
      (120 + 36 * lam) * (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖F t‖ ^ 2) +
        36 * lam⁻¹ * (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖FD t‖ ^ 2) := by
    have hi2 : IntervalIntegrable (fun t : ℝ => dvWeight t * ‖F t‖ ^ 2) volume (1 / 4 : ℝ) 5 :=
      (continuous_dvWeight.mul (hFcont.norm.pow 2)).intervalIntegrable _ _
    have hi3 : IntervalIntegrable (fun t : ℝ => dvWeight t * ‖FD t‖ ^ 2) volume (1 / 4 : ℝ) 5 :=
      (continuous_dvWeight.mul (hFDcont.norm.pow 2)).intervalIntegrable _ _
    rw [intervalIntegral.integral_add (hi2.const_mul _) (hi3.const_mul _),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
  rw [hG0, sub_zero] at hFTC
  rw [← hsplit]
  exact le_trans hlow (le_trans (le_of_eq hFTC) hmono)
/-! ### The pointwise Sobolev bound for the band maximal function -/

set_option maxHeartbeats 1000000 in
/-- **The pointwise Sobolev bound for the localized band maximal function.**
The two space-time energies both carry the smooth radial weight. -/
theorem dvSobolevPointwise {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2)
    (FF DD : ℝ → Euclidean 2 → ℂ)
    (hFF : ∀ (t : ℝ) (y : Euclidean 2), FF t y =
      𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-t • ξ) *
        (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) - phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) *
        dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) y)
    (hFc : Continuous (Function.uncurry FF)) (hDc : Continuous (Function.uncurry DD))
    (hderiv : ∀ (t : ℝ) (y : Euclidean 2), HasDerivAt (fun s : ℝ => FF s y) (DD t y) t) :
    (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ 2 ≤
      ENNReal.ofReal ((120 + 36 * (2 : ℝ) ^ j) *
          (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖FF t x‖ ^ 2) +
        36 * (((2 : ℝ) ^ j)⁻¹) * (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖DD t x‖ ^ 2)) := by
  have hFcx : Continuous fun t : ℝ => FF t x :=
    hFc.comp (Continuous.prodMk continuous_id continuous_const)
  have hDcx : Continuous fun t : ℝ => DD t x :=
    hDc.comp (Continuous.prodMk continuous_id continuous_const)
  have hdx : ∀ t : ℝ, HasDerivAt (fun s : ℝ => FF s x) (DD t x) t := fun t => hderiv t x
  set Z : ℝ := (120 + 36 * (2 : ℝ) ^ j) *
      (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖FF t x‖ ^ 2) +
    36 * (((2 : ℝ) ^ j)⁻¹) * (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖DD t x‖ ^ 2) with hZdef
  have hpowj : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hslice : ∀ r : ℝ, 1 ≤ r → r ≤ 2 → ‖FF r x‖ ^ 2 ≤ Z :=
    fun r hr1 hr2 => dvSobolev2 hFcx hDcx hdx ((2 : ℝ) ^ j) hpowj hr1 hr2
  have hZ0 : 0 ≤ Z := le_trans (sq_nonneg _) (hslice 1 le_rfl (by norm_num))
  have hM : restrictedRelativeBandpassSphericalMaximal 2 E phi j f x ≤
      ENNReal.ofReal (Real.sqrt Z) := by
    refine dvMaximal_le_of_pointwise hone hzero hrad j hE f x _ ?_
    intro r hr1 hr2
    refine ENNReal.ofReal_le_ofReal ?_
    rw [← hFF r x]
    have h := hslice r hr1 hr2
    calc ‖FF r x‖ = Real.sqrt (‖FF r x‖ ^ 2) := by rw [Real.sqrt_sq (norm_nonneg _)]
      _ ≤ Real.sqrt Z := Real.sqrt_le_sqrt h
  calc (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ 2 ≤
      (ENNReal.ofReal (Real.sqrt Z)) ^ 2 := pow_le_pow_left' hM 2
    _ = ENNReal.ofReal Z := by
        rw [← ENNReal.ofReal_pow (Real.sqrt_nonneg Z), Real.sq_sqrt hZ0]
/-! ### The shell energy bound and the multiplier slice identities -/

set_option maxHeartbeats 1000000 in
/-- The weighted energy of one dyadic shell. -/
theorem dvShellEnergy {Cc : ℝ≥0∞}
    (hrow : ∀ (Th : Euclidean 2 → ℂ) (Q : Euclidean 2 → ℝ≥0∞) (P R T : ℝ)
      (ξ : Euclidean 2), 0 ≤ P → 0 ≤ R → 0 ≤ T → Measurable Th → Measurable Q →
      (∀ ζ, ‖Th ζ‖ ≤ P) → (∀ ζ : Euclidean 2, R ≤ ‖ζ‖ → Th ζ = 0) →
      (∀ η : Euclidean 2, Q η ≤ ENNReal.ofReal ((1 + |‖ξ‖ - ‖η‖|)⁻¹)) →
      (∀ η : Euclidean 2, T < ‖η‖ → Q η = 0) →
      (∫⁻ η : Euclidean 2, ENNReal.ofReal ‖Th (ξ - η)‖ * Q η) ≤
        Cc * ENNReal.ofReal (P * min R T * (2 * Real.log (1 + T))))
    {Gb : Euclidean 2 → ℝ} {Th : Euclidean 2 → ℂ} {A : ℝ}
    (hGnn : ∀ x, 0 ≤ Gb x) (hGc : Continuous Gb) (hG : Integrable Gb volume)
    (hThdef : 𝓕⁻ (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ)) = Th)
    (hAbd : ∀ ζ, ‖Th ζ‖ ≤ A) (hA0 : 0 ≤ A)
    (hThsupp : ∀ ζ : Euclidean 2, 1 / 32 ≤ ‖ζ‖ → Th ζ = 0)
    (j k : ℕ) (M : ℝ → Euclidean 2 → ℂ)
    (hMc : Continuous fun p : ℝ × Euclidean 2 => M p.1 p.2)
    (hMt : ∀ (t : ℝ) (ξ : Euclidean 2), t < 1 / 8 ∨ 6 < t → M t ξ = 0)
    (hMs : ∀ (t : ℝ) (ξ : Euclidean 2),
      ξ ∉ Metric.closedBall (0 : Euclidean 2) ((2 : ℝ) ^ (j + 7)) → M t ξ = 0)
    {kapR : ℝ} (hkap : 0 ≤ kapR)
    (hker : ∀ η ξ : Euclidean 2,
      ‖∫ t in (1 / 4 : ℝ)..5, M t η * (starRingEnd ℂ) (M t ξ)‖ ≤
        kapR * (1 + |‖ξ‖ - ‖η‖|)⁻¹)
    (f : SchwartzMap (Euclidean 2) ℂ)
    (hjoint : Continuous fun p : ℝ × Euclidean 2 =>
      𝓕⁻ (fun ξ => M p.1 ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) p.2) :
    (∫⁻ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x *
        ∫ t in (1 / 4 : ℝ)..5, ‖𝓕⁻ (fun ξ => M t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x‖ ^ 2)) ≤
      ENNReal.ofReal kapR * (Cc * ENNReal.ofReal ((((2 : ℝ) ^ k)⁻¹ * A) *
          min ((2 : ℝ) ^ k / 32) ((2 : ℝ) ^ (j + 7)) *
          (2 * Real.log (1 + (2 : ℝ) ^ (j + 7))))) *
        ∫⁻ ξ : Euclidean 2, (ENNReal.ofReal ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖) ^ 2 := by
  obtain ⟨Cm, hCm, hmbd⟩ := exists_dvMul_bound (phi := (0 : SchwartzMap (Euclidean 2) ℂ))
    (by intro ξ _; rfl) j M hMc hMt hMs
  have hFcont : Continuous (𝓕 (f : Euclidean 2 → ℂ)) := by
    have hcoe : 𝓕 (f : Euclidean 2 → ℂ) =
        ((𝓕 f : SchwartzMap (Euclidean 2) ℂ) : Euclidean 2 → ℂ) := by
      rw [SchwartzMap.fourier_coe]
    rw [hcoe]
    exact (𝓕 f : SchwartzMap (Euclidean 2) ℂ).continuous
  have hFbd : ∀ ξ : Euclidean 2, ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖ ≤
      ∫ y : Euclidean 2, ‖(f : Euclidean 2 → ℂ) y‖ := by
    intro ξ
    have h : 𝓕 (f : Euclidean 2 → ℂ) ξ =
        VectorFourier.fourierIntegral 𝐞 volume (innerₗ (Euclidean 2))
          (f : Euclidean 2 → ℂ) ξ := rfl
    rw [h]
    exact VectorFourier.norm_fourierIntegral_le_integral_norm _ _ _ _ _
  refine dvWeightedSquare_lintegral_le (dvGk_nonneg hGnn k) (continuous_dvGk hGc k)
    (integrable_dvGk hG k) (by norm_num : (1 / 4 : ℝ) ≤ 5) hMc
    (measurableSet_closedBall) (measure_closedBall_lt_top.ne) hmbd hMs hFcont hFbd
    hjoint ?_
  intro ξ
  exact dvRowBound hrow hGc hG hThdef hAbd hA0 hThsupp k
    (by positivity : (0:ℝ) ≤ (2 : ℝ) ^ (j + 7)) M hMc
    (fun t η hη => hMs t η (by
      rw [Metric.mem_closedBall, dist_zero_right]
      exact not_le.mpr hη)) hkap ξ (fun η => hker η ξ)

theorem dvFourierInv_const_mul (c : ℂ) (g : Euclidean 2 → ℂ) (x : Euclidean 2) :
    𝓕⁻ (fun ξ : Euclidean 2 => c * g ξ) x = c * 𝓕⁻ g x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
  simp only [Circle.smul_def, smul_eq_mul]
  ring

theorem dvMulB_fourierInv {phi : SchwartzMap (Euclidean 2) ℂ}
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ)
    (f : SchwartzMap (Euclidean 2) ℂ) (t : ℝ) (x : Euclidean 2) :
    𝓕⁻ (fun ξ : Euclidean 2 => dvMulB phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x =
      ((dvSqrtW t : ℝ) : ℂ) *
        𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-t • ξ) *
          (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) -
            phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) *
          dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x := by
  by_cases ht : 0 < t
  · have hfun : (fun ξ : Euclidean 2 => dvMulB phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) =
        fun ξ : Euclidean 2 => ((dvSqrtW t : ℝ) : ℂ) *
          (surfaceFourier 2 (-t • ξ) *
            (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) -
              phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) *
            dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) := by
      funext ξ
      unfold dvMulB
      rw [dvSig_eq_multiplier hrad j ht ξ]
      ring
    rw [hfun, dvFourierInv_const_mul]
  · have hzeroW : dvSqrtW t = 0 := by
      refine dvSqrtW_eq_zero_of_lt ?_
      by_contra hc
      push_neg at hc ht
      linarith
    have hfun : (fun ξ : Euclidean 2 => dvMulB phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) =
        fun _ : Euclidean 2 => (0 : ℂ) := by
      funext ξ
      unfold dvMulB
      rw [hzeroW]
      simp
    rw [hfun, hzeroW, Real.fourierInv_eq]
    simp

theorem dvMulC_fourierInv {phi : SchwartzMap (Euclidean 2) ℂ}
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ)
    (f : SchwartzMap (Euclidean 2) ℂ) (t : ℝ) (x : Euclidean 2) :
    𝓕⁻ (fun ξ : Euclidean 2 => dvMulC phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x =
      ((dvSqrtW t : ℝ) : ℂ) *
        𝓕⁻ (fun ξ : Euclidean 2 => (deriv (fun u : ℝ => surfaceFourier 2 (-u • ξ)) t *
            (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) -
              phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) +
            surfaceFourier 2 (-t • ξ) * deriv (fun u : ℝ =>
              phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • ξ)) -
                phi ((((2 : ℝ) ^ j)⁻¹) • (u • ξ))) t) *
          dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x := by
  by_cases ht : 0 < t
  · have hfun : (fun ξ : Euclidean 2 => dvMulC phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) =
        fun ξ : Euclidean 2 => ((dvSqrtW t : ℝ) : ℂ) *
          ((deriv (fun u : ℝ => surfaceFourier 2 (-u • ξ)) t *
            (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) -
              phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) +
            surfaceFourier 2 (-t • ξ) * deriv (fun u : ℝ =>
              phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • ξ)) -
                phi ((((2 : ℝ) ^ j)⁻¹) • (u • ξ))) t) *
            dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) := by
      funext ξ
      unfold dvMulC
      rw [dvSigDnum_eq_productRule hrad j ht ξ]
      ring
    rw [hfun, dvFourierInv_const_mul]
  · have hzeroW : dvSqrtW t = 0 := by
      refine dvSqrtW_eq_zero_of_lt ?_
      by_contra hc
      push_neg at hc ht
      linarith
    have hfun : (fun ξ : Euclidean 2 => dvMulC phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) =
        fun _ : Euclidean 2 => (0 : ℂ) := by
      funext ξ
      unfold dvMulC
      rw [hzeroW]
      simp
    rw [hfun, hzeroW, Real.fourierInv_eq]
    simp
/-! ### The contribution of one dyadic shell -/

/-- The two weighted space-time energies written through the space-time
multipliers. -/
theorem dvEnergyB_eq {phi : SchwartzMap (Euclidean 2) ℂ}
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ)
    (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2)
    (FF : ℝ → Euclidean 2 → ℂ)
    (hFF : ∀ (t : ℝ) (y : Euclidean 2), FF t y =
      𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-t • ξ) *
        (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) - phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) *
        dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) y) :
    (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖FF t x‖ ^ 2) =
      ∫ t in (1 / 4 : ℝ)..5,
        ‖𝓕⁻ (fun ξ => dvMulB phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x‖ ^ 2 := by
  refine intervalIntegral.integral_congr fun t ht => ?_
  rw [Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)] at ht
  rw [dvMulB_fourierInv hrad j f t x, ← hFF t x, norm_mul, Complex.norm_real,
    Real.norm_eq_abs]
  have hsq : dvSqrtW t * dvSqrtW t = dvWeight t := dvSqrtW_sq ht.1 ht.2
  have habs : |dvSqrtW t| ^ 2 = dvWeight t := by
    rw [sq_abs, ← hsq]
    ring
  rw [mul_pow, habs]

theorem dvEnergyC_eq {phi : SchwartzMap (Euclidean 2) ℂ}
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ)
    (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2)
    (DD : ℝ → Euclidean 2 → ℂ)
    (hDD : ∀ (t : ℝ) (y : Euclidean 2), DD t y =
      𝓕⁻ (fun ξ : Euclidean 2 => (deriv (fun u : ℝ => surfaceFourier 2 (-u • ξ)) t *
          (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) -
            phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) +
          surfaceFourier 2 (-t • ξ) * deriv (fun u : ℝ =>
            phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • ξ)) -
              phi ((((2 : ℝ) ^ j)⁻¹) • (u • ξ))) t) *
        dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) y) :
    (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖DD t x‖ ^ 2) =
      ∫ t in (1 / 4 : ℝ)..5,
        ‖𝓕⁻ (fun ξ => dvMulC phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x‖ ^ 2 := by
  refine intervalIntegral.integral_congr fun t ht => ?_
  rw [Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)] at ht
  rw [dvMulC_fourierInv hrad j f t x, ← hDD t x, norm_mul, Complex.norm_real,
    Real.norm_eq_abs]
  have hsq : dvSqrtW t * dvSqrtW t = dvWeight t := dvSqrtW_sq ht.1 ht.2
  have habs : |dvSqrtW t| ^ 2 = dvWeight t := by
    rw [sq_abs, ← hsq]
    ring
  rw [mul_pow, habs]

theorem dvMulB_time_supp {phi : SchwartzMap (Euclidean 2) ℂ} (j : ℕ) (t : ℝ)
    (ξ : Euclidean 2) (ht : t < 1 / 8 ∨ 6 < t) : dvMulB phi j t ξ = 0 := by
  unfold dvMulB
  rcases ht with h | h
  · rw [dvSqrtW_eq_zero_of_lt h]
    simp
  · rw [dvSqrtW_eq_zero_of_gt h]
    simp

theorem dvMulC_time_supp {phi : SchwartzMap (Euclidean 2) ℂ} (j : ℕ) (t : ℝ)
    (ξ : Euclidean 2) (ht : t < 1 / 8 ∨ 6 < t) : dvMulC phi j t ξ = 0 := by
  unfold dvMulC
  rcases ht with h | h
  · rw [dvSqrtW_eq_zero_of_lt h]
    simp
  · rw [dvSqrtW_eq_zero_of_gt h]
    simp

set_option maxHeartbeats 2000000 in
/-- The contribution of one dyadic shell to the weighted square. -/
theorem dvShellBound {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1)
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ))
    {Cc : ℝ≥0∞}
    (hrow : ∀ (Th : Euclidean 2 → ℂ) (Q : Euclidean 2 → ℝ≥0∞) (P R T : ℝ)
      (ξ : Euclidean 2), 0 ≤ P → 0 ≤ R → 0 ≤ T → Measurable Th → Measurable Q →
      (∀ ζ, ‖Th ζ‖ ≤ P) → (∀ ζ : Euclidean 2, R ≤ ‖ζ‖ → Th ζ = 0) →
      (∀ η : Euclidean 2, Q η ≤ ENNReal.ofReal ((1 + |‖ξ‖ - ‖η‖|)⁻¹)) →
      (∀ η : Euclidean 2, T < ‖η‖ → Q η = 0) →
      (∫⁻ η : Euclidean 2, ENNReal.ofReal ‖Th (ξ - η)‖ * Q η) ≤
        Cc * ENNReal.ofReal (P * min R T * (2 * Real.log (1 + T))))
    {Gb : Euclidean 2 → ℝ} {Th : Euclidean 2 → ℂ} {A : ℝ}
    (hGnn : ∀ x, 0 ≤ Gb x) (hGc : Continuous Gb) (hG : Integrable Gb volume)
    (hThdef : 𝓕⁻ (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ)) = Th)
    (hAbd : ∀ ζ, ‖Th ζ‖ ≤ A) (hA0 : 0 ≤ A)
    (hThsupp : ∀ ζ : Euclidean 2, 1 / 32 ≤ ‖ζ‖ → Th ζ = 0)
    {CB CD : ℝ} (hCB : 0 < CB) (hCD : 0 < CD)
    (hkerB : ∀ (j : ℕ) (s t : ℝ), 1 ≤ s → 1 ≤ t → t ≤ 100 * s → s ≤ 100 * t →
      ‖∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) * dvSig phi j s r *
          (starRingEnd ℂ) (dvSig phi j t r)‖ ≤ CB * ((s⁻¹ + t⁻¹) / (1 + |s - t|)))
    (hkerD : ∀ (j : ℕ) (s t : ℝ), 1 ≤ s → 1 ≤ t → t ≤ 100 * s → s ≤ 100 * t →
      ‖∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) * dvSigD phi j s r *
          (starRingEnd ℂ) (dvSigD phi j t r)‖ ≤ CD * ((s⁻¹ + t⁻¹) / (1 + |s - t|)))
    (j : ℕ) (hj : 3 ≤ j) {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (f : SchwartzMap (Euclidean 2) ℂ) (k : ℕ) :
    (∫⁻ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x) *
        (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ 2) ≤
      Cc * ENNReal.ofReal ((1560 * CB + 1152 * CD) * (A / 32) *
          (2 * Real.log (1 + (2 : ℝ) ^ (j + 7)))) *
        ∫⁻ ξ : Euclidean 2, (ENNReal.ofReal ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖) ^ 2 := by
  have hpowj : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  set FF : ℝ → Euclidean 2 → ℂ := fun t y =>
    𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-t • ξ) *
      (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) - phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) *
      dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) y with hFFdef
  set DD : ℝ → Euclidean 2 → ℂ := fun t y =>
    𝓕⁻ (fun ξ : Euclidean 2 => (deriv (fun u : ℝ => surfaceFourier 2 (-u • ξ)) t *
        (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) -
          phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) +
        surfaceFourier 2 (-t • ξ) * deriv (fun u : ℝ =>
          phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • ξ)) -
            phi ((((2 : ℝ) ^ j)⁻¹) • (u • ξ))) t) *
      dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) y with hDDdef
  have hrepo :=
    Codex.Spherical.SphericalMaximalL2.continuous_and_hasDerivAt_fourierInv_relative_dyadic_bandpass
      phi (dvFreqCut phi j) f (hasCompactSupport_dvFreqCut hzero j) j
  have hFc : Continuous (Function.uncurry FF) := hrepo.1
  have hDc : Continuous (Function.uncurry DD) := hrepo.2.1
  have hderiv : ∀ (t : ℝ) (y : Euclidean 2), HasDerivAt (fun s : ℝ => FF s y) (DD t y) t :=
    hrepo.2.2
  have hFF : ∀ (t : ℝ) (y : Euclidean 2), FF t y =
      𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-t • ξ) *
        (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) - phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) *
        dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) y := fun t y => rfl
  have hDD : ∀ (t : ℝ) (y : Euclidean 2), DD t y =
      𝓕⁻ (fun ξ : Euclidean 2 => (deriv (fun u : ℝ => surfaceFourier 2 (-u • ξ)) t *
          (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) -
            phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) +
          surfaceFourier 2 (-t • ξ) * deriv (fun u : ℝ =>
            phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (u • ξ)) -
              phi ((((2 : ℝ) ^ j)⁻¹) • (u • ξ))) t) *
        dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) y := fun t y => rfl
  set EB : Euclidean 2 → ℝ := fun x =>
    ∫ t in (1 / 4 : ℝ)..5,
      ‖𝓕⁻ (fun ξ => dvMulB phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x‖ ^ 2 with hEBdef
  set EC : Euclidean 2 → ℝ := fun x =>
    ∫ t in (1 / 4 : ℝ)..5,
      ‖𝓕⁻ (fun ξ => dvMulC phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x‖ ^ 2 with hECdef
  -- the pointwise Sobolev bound in terms of the space-time multipliers
  have hptw : ∀ x : Euclidean 2,
      (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ 2 ≤
        ENNReal.ofReal ((120 + 36 * (2 : ℝ) ^ j) * EB x +
          36 * (((2 : ℝ) ^ j)⁻¹) * EC x) := by
    intro x
    have h := dvSobolevPointwise hone hzero hrad j hE f x FF DD hFF hFc hDc hderiv
    rw [dvEnergyB_eq hrad j f x FF hFF, dvEnergyC_eq hrad j f x DD hDD] at h
    exact h
  -- joint continuity of the two slice families
  have hjB : Continuous fun p : ℝ × Euclidean 2 =>
      𝓕⁻ (fun ξ => dvMulB phi j p.1 ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) p.2 := by
    have hfun : (fun p : ℝ × Euclidean 2 =>
        𝓕⁻ (fun ξ => dvMulB phi j p.1 ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) p.2) =
        fun p : ℝ × Euclidean 2 => ((dvSqrtW p.1 : ℝ) : ℂ) * FF p.1 p.2 := by
      funext p
      exact dvMulB_fourierInv hrad j f p.1 p.2
    rw [hfun]
    exact (Complex.continuous_ofReal.comp (continuous_dvSqrtW.comp continuous_fst)).mul hFc
  have hjC : Continuous fun p : ℝ × Euclidean 2 =>
      𝓕⁻ (fun ξ => dvMulC phi j p.1 ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) p.2 := by
    have hfun : (fun p : ℝ × Euclidean 2 =>
        𝓕⁻ (fun ξ => dvMulC phi j p.1 ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) p.2) =
        fun p : ℝ × Euclidean 2 => ((dvSqrtW p.1 : ℝ) : ℂ) * DD p.1 p.2 := by
      funext p
      exact dvMulC_fourierInv hrad j f p.1 p.2
    rw [hfun]
    exact (Complex.continuous_ofReal.comp (continuous_dvSqrtW.comp continuous_fst)).mul hDc
  have hEBc : Continuous EB := by
    have hunc : Continuous (Function.uncurry fun (x : Euclidean 2) (t : ℝ) =>
        ‖𝓕⁻ (fun ξ => dvMulB phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x‖ ^ 2) := by
      have hsw : Continuous fun q : Euclidean 2 × ℝ => (q.2, q.1) :=
        Continuous.prodMk continuous_snd continuous_fst
      exact ((hjB.comp hsw).norm.pow 2)
    exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hunc _ _
  have hECc : Continuous EC := by
    have hunc : Continuous (Function.uncurry fun (x : Euclidean 2) (t : ℝ) =>
        ‖𝓕⁻ (fun ξ => dvMulC phi j t ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x‖ ^ 2) := by
      have hsw : Continuous fun q : Euclidean 2 × ℝ => (q.2, q.1) :=
        Continuous.prodMk continuous_snd continuous_fst
      exact ((hjC.comp hsw).norm.pow 2)
    exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hunc _ _
  have hEB0 : ∀ x, 0 ≤ EB x := by
    intro x
    simp only [hEBdef]
    rw [intervalIntegral.integral_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)]
    exact integral_nonneg fun t => sq_nonneg _
  have hEC0 : ∀ x, 0 ≤ EC x := by
    intro x
    simp only [hECdef]
    rw [intervalIntegral.integral_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)]
    exact integral_nonneg fun t => sq_nonneg _
  set aB : ℝ := 120 + 36 * (2 : ℝ) ^ j with haBdef
  set aC : ℝ := 36 * (((2 : ℝ) ^ j)⁻¹) with haCdef
  have haB0 : 0 ≤ aB := by simp only [haBdef]; positivity
  have haC0 : 0 ≤ aC := by simp only [haCdef]; positivity
  have hmB : Measurable fun x : Euclidean 2 => ENNReal.ofReal (dvGk Gb k x * EB x) := by
    have h : Continuous fun x : Euclidean 2 => dvGk Gb k x * EB x :=
      (continuous_dvGk hGc k).mul hEBc
    exact h.measurable.ennreal_ofReal
  have hmC : Measurable fun x : Euclidean 2 => ENNReal.ofReal (dvGk Gb k x * EC x) := by
    have h : Continuous fun x : Euclidean 2 => dvGk Gb k x * EC x :=
      (continuous_dvGk hGc k).mul hECc
    exact h.measurable.ennreal_ofReal
  have hmeasB : Measurable fun x : Euclidean 2 =>
      ENNReal.ofReal aB * ENNReal.ofReal (dvGk Gb k x * EB x) := hmB.const_mul _
  have hstep1 : (∫⁻ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x) *
      (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ 2) ≤
      ENNReal.ofReal aB * (∫⁻ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x * EB x)) +
        ENNReal.ofReal aC * (∫⁻ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x * EC x)) := by
    have hpt : ∀ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x) *
        (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ 2 ≤
        ENNReal.ofReal aB * ENNReal.ofReal (dvGk Gb k x * EB x) +
          ENNReal.ofReal aC * ENNReal.ofReal (dvGk Gb k x * EC x) := by
      intro x
      have hg0 : 0 ≤ dvGk Gb k x := dvGk_nonneg hGnn k x
      calc ENNReal.ofReal (dvGk Gb k x) *
            (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ 2 ≤
          ENNReal.ofReal (dvGk Gb k x) * ENNReal.ofReal (aB * EB x + aC * EC x) :=
            mul_le_mul' le_rfl (hptw x)
        _ = ENNReal.ofReal (dvGk Gb k x * (aB * EB x + aC * EC x)) := by
            rw [← ENNReal.ofReal_mul hg0]
        _ = ENNReal.ofReal (aB * (dvGk Gb k x * EB x) + aC * (dvGk Gb k x * EC x)) := by
            congr 1
            ring
        _ = ENNReal.ofReal aB * ENNReal.ofReal (dvGk Gb k x * EB x) +
              ENNReal.ofReal aC * ENNReal.ofReal (dvGk Gb k x * EC x) := by
            rw [ENNReal.ofReal_add (mul_nonneg haB0 (mul_nonneg hg0 (hEB0 x)))
                (mul_nonneg haC0 (mul_nonneg hg0 (hEC0 x))),
              ENNReal.ofReal_mul haB0, ENNReal.ofReal_mul haC0]
    calc (∫⁻ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x) *
          (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ 2) ≤
        ∫⁻ x : Euclidean 2, (ENNReal.ofReal aB * ENNReal.ofReal (dvGk Gb k x * EB x) +
          ENNReal.ofReal aC * ENNReal.ofReal (dvGk Gb k x * EC x)) := lintegral_mono hpt
      _ = (∫⁻ x : Euclidean 2, ENNReal.ofReal aB * ENNReal.ofReal (dvGk Gb k x * EB x)) +
          ∫⁻ x : Euclidean 2, ENNReal.ofReal aC * ENNReal.ofReal (dvGk Gb k x * EC x) :=
            lintegral_add_left hmeasB _
      _ = ENNReal.ofReal aB * (∫⁻ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x * EB x)) +
          ENNReal.ofReal aC * (∫⁻ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x * EC x)) := by
            rw [lintegral_const_mul (ENNReal.ofReal aB) hmB,
              lintegral_const_mul (ENNReal.ofReal aC) hmC]
  -- the two shell energies
  set T : ℝ := (2 : ℝ) ^ (j + 7) with hTdef
  set L : ℝ := 2 * Real.log (1 + T) with hLdef
  set Aterm : ℝ := (((2 : ℝ) ^ k)⁻¹ * A) * min ((2 : ℝ) ^ k / 32) T * L with hAtermdef
  set kB : ℝ := 10 * CB * (((2 : ℝ) ^ j)⁻¹) with hkBdef
  set kC : ℝ := 32 * CD * (2 : ℝ) ^ j with hkCdef
  have hkB0 : 0 ≤ kB := by simp only [hkBdef]; positivity
  have hkC0 : 0 ≤ kC := by simp only [hkCdef]; positivity
  have hEB := dvShellEnergy hrow hGnn hGc hG hThdef hAbd hA0 hThsupp j k
    (dvMulB phi j) (continuous_dvMulB phi j)
    (fun t ξ ht => dvMulB_time_supp j t ξ ht)
    (fun t ξ hξ => dvMulB_supp hzero j t hξ) hkB0
    (fun η ξ => dvKerB_bound hone hzero hnorm hCB hkerB j hj η ξ) f hjB
  have hEC := dvShellEnergy hrow hGnn hGc hG hThdef hAbd hA0 hThsupp j k
    (dvMulC phi j) (continuous_dvMulC phi j)
    (fun t ξ ht => dvMulC_time_supp j t ξ ht)
    (fun t ξ hξ => dvMulC_supp hzero j t hξ) hkC0
    (fun η ξ => dvKerC_bound hone hzero hnorm hCD hkerD j hj η ξ) f hjC
  -- the arithmetic
  have hL0 : 0 ≤ L := by
    simp only [hLdef]
    have h1 : (1 : ℝ) ≤ 1 + T := by
      have hT0 : (0 : ℝ) < T := by
        simp only [hTdef]
        positivity
      linarith
    have := Real.log_nonneg h1
    linarith
  have hAterm : Aterm ≤ (A / 32) * L := by
    simp only [hAtermdef]
    have hmin : min ((2 : ℝ) ^ k / 32) T ≤ (2 : ℝ) ^ k / 32 := min_le_left _ _
    have hpk : (0 : ℝ) < (2 : ℝ) ^ k := by positivity
    have hprod : (((2 : ℝ) ^ k)⁻¹ * A) * min ((2 : ℝ) ^ k / 32) T ≤ A / 32 := by
      calc (((2 : ℝ) ^ k)⁻¹ * A) * min ((2 : ℝ) ^ k / 32) T ≤
          (((2 : ℝ) ^ k)⁻¹ * A) * ((2 : ℝ) ^ k / 32) :=
            mul_le_mul_of_nonneg_left hmin (by positivity)
        _ = A / 32 := by field_simp
    exact mul_le_mul_of_nonneg_right hprod hL0
  have hcoef : aB * kB + aC * kC ≤ 1560 * CB + 1152 * CD := by
    have hinv : (((2 : ℝ) ^ j)⁻¹) ≤ 1 := by
      rw [inv_le_one_iff₀]
      right
      calc (1 : ℝ) = (2 : ℝ) ^ 0 := by norm_num
        _ ≤ (2 : ℝ) ^ j := by
            apply pow_le_pow_right₀ (by norm_num)
            omega
    have hinvpos : (0 : ℝ) < (((2 : ℝ) ^ j)⁻¹) := by positivity
    have hcancel : (((2 : ℝ) ^ j)⁻¹) * (2 : ℝ) ^ j = 1 := inv_mul_cancel₀ hpowj.ne'
    simp only [haBdef, haCdef, hkBdef, hkCdef]
    nlinarith [hCB.le, hCD.le, hinv, hcancel, hinvpos]
  have hfinal : ENNReal.ofReal aB * (ENNReal.ofReal kB * (Cc * ENNReal.ofReal Aterm) *
        ∫⁻ ξ : Euclidean 2, (ENNReal.ofReal ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖) ^ 2) +
      ENNReal.ofReal aC * (ENNReal.ofReal kC * (Cc * ENNReal.ofReal Aterm) *
        ∫⁻ ξ : Euclidean 2, (ENNReal.ofReal ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖) ^ 2) ≤
      Cc * ENNReal.ofReal ((1560 * CB + 1152 * CD) * (A / 32) * L) *
        ∫⁻ ξ : Euclidean 2, (ENNReal.ofReal ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖) ^ 2 := by
    have hA0' : 0 ≤ Aterm := by
      simp only [hAtermdef]
      have hmin0 : (0 : ℝ) ≤ min ((2 : ℝ) ^ k / 32) T := by
        refine le_min (by positivity) ?_
        simp only [hTdef]
        positivity
      have : (0 : ℝ) ≤ ((2 : ℝ) ^ k)⁻¹ * A := by positivity
      exact mul_nonneg (mul_nonneg this hmin0) hL0
    have hrw : ENNReal.ofReal aB * (ENNReal.ofReal kB * (Cc * ENNReal.ofReal Aterm) *
          ∫⁻ ξ : Euclidean 2, (ENNReal.ofReal ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖) ^ 2) +
        ENNReal.ofReal aC * (ENNReal.ofReal kC * (Cc * ENNReal.ofReal Aterm) *
          ∫⁻ ξ : Euclidean 2, (ENNReal.ofReal ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖) ^ 2) =
        Cc * (ENNReal.ofReal (aB * kB * Aterm) + ENNReal.ofReal (aC * kC * Aterm)) *
          ∫⁻ ξ : Euclidean 2, (ENNReal.ofReal ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖) ^ 2 := by
      rw [ENNReal.ofReal_mul (mul_nonneg haB0 hkB0), ENNReal.ofReal_mul haB0,
        ENNReal.ofReal_mul (mul_nonneg haC0 hkC0), ENNReal.ofReal_mul haC0]
      ring
    rw [hrw]
    refine mul_le_mul' (mul_le_mul' le_rfl ?_) le_rfl
    rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
    refine ENNReal.ofReal_le_ofReal ?_
    have hstep : aB * kB * Aterm + aC * kC * Aterm =
        (aB * kB + aC * kC) * Aterm := by ring
    rw [hstep]
    calc (aB * kB + aC * kC) * Aterm ≤ (1560 * CB + 1152 * CD) * Aterm := by
          refine mul_le_mul_of_nonneg_right hcoef hA0'
      _ ≤ (1560 * CB + 1152 * CD) * ((A / 32) * L) := by
          refine mul_le_mul_of_nonneg_left hAterm (by positivity)
      _ = (1560 * CB + 1152 * CD) * (A / 32) * L := by ring
  refine hstep1.trans (le_trans ?_ hfinal)
  exact add_le_add (mul_le_mul' le_rfl hEB) (mul_le_mul' le_rfl hEC)
/-! ### The weighted `L²` core estimate -/

theorem dvLintegralSq_eq (g : SchwartzMap (Euclidean 2) ℂ) :
    (∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(g : Euclidean 2 → ℂ) x‖) ^ 2) =
      ENNReal.ofReal (∫ x : Euclidean 2, ‖(g : Euclidean 2 → ℂ) x‖ ^ 2) := by
  have hint : Integrable (fun x : Euclidean 2 => ‖(g : Euclidean 2 → ℂ) x‖ ^ 2) volume := by
    have hmem : MemLp ((g : Euclidean 2 → ℂ)) 2 volume := g.memLp 2 volume
    exact (memLp_two_iff_integrable_sq_norm hmem.aestronglyMeasurable).mp hmem
  have hnn : 0 ≤ᵐ[volume] fun x : Euclidean 2 => ‖(g : Euclidean 2 → ℂ) x‖ ^ 2 :=
    Filter.Eventually.of_forall fun x => sq_nonneg _
  have hstep : (∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(g : Euclidean 2 → ℂ) x‖) ^ 2) =
      ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖(g : Euclidean 2 → ℂ) x‖ ^ 2) := by
    refine lintegral_congr fun x => ?_
    rw [← ENNReal.ofReal_pow (norm_nonneg _)]
  rw [hstep, ← ofReal_integral_eq_lintegral_ofReal hint hnn]

theorem dvPlancherelENN (f : SchwartzMap (Euclidean 2) ℂ) :
    (∫⁻ ξ : Euclidean 2, (ENNReal.ofReal ‖𝓕 (f : Euclidean 2 → ℂ) ξ‖) ^ 2) =
      ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(f : Euclidean 2 → ℂ) x‖) ^ 2 := by
  have hcoe : 𝓕 (f : Euclidean 2 → ℂ) =
      ((𝓕 f : SchwartzMap (Euclidean 2) ℂ) : Euclidean 2 → ℂ) := by
    rw [SchwartzMap.fourier_coe]
  rw [hcoe, dvLintegralSq_eq, dvLintegralSq_eq]
  congr 1
  rw [← hcoe]
  exact Codex.Spherical.FourierRadius.integral_norm_sq_fourier_schwartz_eq f

theorem dvLogBound (j : ℕ) :
    2 * Real.log (1 + (2 : ℝ) ^ (j + 7)) ≤ 12 * ((j : ℝ) + 1) := by
  have h1 : (1 : ℝ) ≤ (2 : ℝ) ^ (j + 7) := one_le_pow₀ (by norm_num)
  have h2 : (1 : ℝ) + (2 : ℝ) ^ (j + 7) ≤ (2 : ℝ) ^ (j + 8) := by
    have hrw : (2 : ℝ) ^ (j + 8) = 2 * (2 : ℝ) ^ (j + 7) := by ring
    rw [hrw]
    linarith
  have h3 : Real.log (1 + (2 : ℝ) ^ (j + 7)) ≤ Real.log ((2 : ℝ) ^ (j + 8)) :=
    Real.log_le_log (by positivity) h2
  have h4 : Real.log ((2 : ℝ) ^ (j + 8)) = ((j : ℝ) + 8) * Real.log 2 := by
    rw [Real.log_pow]
    push_cast
    ring
  have h5 : Real.log 2 < 0.7 := by
    have := Real.log_two_lt_d9
    linarith
  have h6 : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
  rw [h4] at h3
  nlinarith [Real.log_nonneg (by norm_num : (1:ℝ) ≤ 2)]

set_option maxHeartbeats 2000000 in
/-- **The weighted `L²` core estimate.**  This is the blueprint's
`prop:critical-loss` at the exponent two. -/
theorem dvWeightedL2Core {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1)
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ), 3 ≤ j → ∀ E : Set ℝ, E ⊆ Icc (1 : ℝ) 2 →
      ∀ f : SchwartzMap (Euclidean 2) ℂ,
        (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ),
            radialPowerWeight 2 (-1) x *
              (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ 2) ≤
          ENNReal.ofReal (C * ((j : ℝ) + 1) ^ 2) *
            ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(f : Euclidean 2 → ℂ) x‖) ^ 2 := by
  obtain ⟨Gb, Th, A, hA, hGnn, hGc, hG, hGlow, hThdef, hAbd, hThsupp⟩ := exists_dvProfile
  obtain ⟨Cc, hCctop, hrow⟩ := exists_dvRow_bound
  obtain ⟨CB, hCB, hkerB⟩ := exists_dvBandKernel_bound hone hzero hnorm
  obtain ⟨CD, hCD, hkerD⟩ := exists_dvBandDerivKernel_bound hone hzero hnorm
  obtain ⟨Cb, hCb, hb⟩ := exists_dvBandAmp_bounds hone hzero hnorm
  set Bsup : ℝ := 48 * Cb * Real.sqrt 5 *
    Real.sqrt ((volume (Metric.ball (0 : Euclidean 2) 1)).toReal) with hBsupdef
  set Ccr : ℝ := Cc.toReal with hCcrdef
  have hCcr0 : 0 ≤ Ccr := ENNReal.toReal_nonneg
  have hCceq : Cc = ENNReal.ofReal Ccr := by
    rw [hCcrdef, ENNReal.ofReal_toReal hCctop]
  have hBsup0 : 0 ≤ Bsup := by
    simp only [hBsupdef]
    positivity
  set K1 : ℝ := 48 * Ccr * ((1560 * CB + 1152 * CD) * (A / 32)) with hK1def
  set K2 : ℝ := Bsup ^ 2 * surfaceMass 2 with hK2def
  have hK10 : 0 ≤ K1 := by
    simp only [hK1def]
    have : (0:ℝ) ≤ (1560 * CB + 1152 * CD) * (A / 32) := by positivity
    positivity
  have hK20 : 0 ≤ K2 := by
    simp only [hK2def]
    have := surfaceMass_pos (d := 2) (by norm_num)
    positivity
  refine ⟨K1 + K2 + 1, by linarith, ?_⟩
  intro j hj E hE f
  set M : Euclidean 2 → ℝ≥0∞ :=
    restrictedRelativeBandpassSphericalMaximal 2 E phi j f with hMdef
  have hMmeas : Measurable M :=
    measurable_restrictedRelativeBandpassSphericalMaximal_global E phi f hone hzero j
  set X : ℝ≥0∞ := ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(f : Euclidean 2 → ℂ) x‖) ^ 2 with hXdef
  set I : ℝ := ∫ y : Euclidean 2, ‖(f : Euclidean 2 → ℂ) y‖ ^ 2 with hIdef
  have hI0 : 0 ≤ I := integral_nonneg fun y => sq_nonneg _
  have hXI : X = ENNReal.ofReal I := dvLintegralSq_eq f
  have hpowj : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  -- the uniform sup bound
  have hsupsq : ∀ x : Euclidean 2, (M x) ^ 2 ≤
      ENNReal.ofReal (Bsup ^ 2 * (2 : ℝ) ^ j * I) := by
    intro x
    have hsup : M x ≤ ENNReal.ofReal (Bsup * Real.sqrt ((2 : ℝ) ^ j) * Real.sqrt I) :=
      dvSupBound hone hzero hnorm hrad hCb hb j hj hE f x
    calc (M x) ^ 2 ≤ (ENNReal.ofReal (Bsup * Real.sqrt ((2 : ℝ) ^ j) * Real.sqrt I)) ^ 2 :=
          pow_le_pow_left' hsup 2
      _ = ENNReal.ofReal ((Bsup * Real.sqrt ((2 : ℝ) ^ j) * Real.sqrt I) ^ 2) := by
          rw [← ENNReal.ofReal_pow (by positivity)]
      _ = ENNReal.ofReal (Bsup ^ 2 * (2 : ℝ) ^ j * I) := by
          congr 1
          rw [mul_pow, mul_pow, Real.sq_sqrt hpowj.le, Real.sq_sqrt hI0]
  -- the pointwise weight domination
  have hnull : ∀ᵐ x : Euclidean 2, x ≠ 0 := by
    rw [Filter.eventually_iff, mem_ae_iff]
    have hcompl : {x : Euclidean 2 | x ≠ 0}ᶜ = {(0 : Euclidean 2)} := by
      ext y
      simp
    rw [hcompl]
    exact measure_singleton 0
  have hdom : ∀ᵐ x : Euclidean 2,
      (Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ)).indicator
        (fun y => radialPowerWeight 2 (-1) y * (M y) ^ 2) x ≤
      (ENNReal.ofReal 4 * ∑ k ∈ Finset.range (j + 1), ENNReal.ofReal (dvGk Gb k x)) *
          (M x) ^ 2 +
        (Metric.ball (0 : Euclidean 2) (((2 : ℝ) ^ j)⁻¹)).indicator
          (fun y => radialPowerWeight 2 (-1) y * (M y) ^ 2) x := by
    filter_upwards [hnull] with x hx
    by_cases hxb : x ∈ Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ)
    · rw [Set.indicator_of_mem hxb]
      have hxle : ‖x‖ ≤ 1 / 32 := by
        rw [Metric.mem_closedBall, dist_zero_right] at hxb
        exact hxb
      by_cases hxj : (((2 : ℝ) ^ j)⁻¹) ≤ ‖x‖
      · have hw := dvWeight_le_shells hGlow hGnn j hx hxle hxj
        calc radialPowerWeight 2 (-1) x * (M x) ^ 2 ≤
            (ENNReal.ofReal 4 * ∑ k ∈ Finset.range (j + 1),
              ENNReal.ofReal (dvGk Gb k x)) * (M x) ^ 2 := mul_le_mul' hw le_rfl
          _ ≤ _ := le_self_add
      · have hmem : x ∈ Metric.ball (0 : Euclidean 2) (((2 : ℝ) ^ j)⁻¹) := by
          rw [Metric.mem_ball, dist_zero_right]
          exact lt_of_not_ge hxj
        rw [Set.indicator_of_mem hmem]
        exact le_add_self
    · rw [Set.indicator_of_notMem hxb]
      exact bot_le
  -- measurability facts
  have hwmeas : Measurable fun x : Euclidean 2 => radialPowerWeight 2 (-1) x * (M x) ^ 2 :=
    (measurable_radialPowerWeight 2 (-1)).mul (hMmeas.pow_const 2)
  have hmeas2 : AEMeasurable (fun x : Euclidean 2 =>
      (Metric.ball (0 : Euclidean 2) (((2 : ℝ) ^ j)⁻¹)).indicator
        (fun y => radialPowerWeight 2 (-1) y * (M y) ^ 2) x) volume :=
    (hwmeas.indicator measurableSet_ball).aemeasurable
  have hmeask : ∀ k : ℕ, Measurable fun x : Euclidean 2 =>
      ENNReal.ofReal (dvGk Gb k x) * (M x) ^ 2 := by
    intro k
    exact ((continuous_dvGk hGc k).measurable.ennreal_ofReal).mul (hMmeas.pow_const 2)
  -- pull the shell sum out
  set W : ℝ := (1560 * CB + 1152 * CD) * (A / 32) *
    (2 * Real.log (1 + (2 : ℝ) ^ (j + 7))) with hWdef
  have hpull : (∫⁻ x : Euclidean 2,
      (ENNReal.ofReal 4 * ∑ k ∈ Finset.range (j + 1), ENNReal.ofReal (dvGk Gb k x)) *
        (M x) ^ 2) =
      ENNReal.ofReal 4 * ∑ k ∈ Finset.range (j + 1),
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x) * (M x) ^ 2 := by
    have hptw : ∀ x : Euclidean 2,
        (ENNReal.ofReal 4 * ∑ k ∈ Finset.range (j + 1), ENNReal.ofReal (dvGk Gb k x)) *
          (M x) ^ 2 =
        ENNReal.ofReal 4 * ∑ k ∈ Finset.range (j + 1),
          (ENNReal.ofReal (dvGk Gb k x) * (M x) ^ 2) := by
      intro x
      rw [mul_assoc, Finset.sum_mul]
    rw [lintegral_congr hptw,
      lintegral_const_mul _ (Finset.measurable_sum _ fun k _ => hmeask k),
      lintegral_finsetSum _ fun k _ => hmeask k]
  have hshell : ∀ k ∈ Finset.range (j + 1),
      (∫⁻ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x) * (M x) ^ 2) ≤
        Cc * ENNReal.ofReal W * X := by
    intro k _
    have h := dvShellBound hone hzero hnorm hrad hrow hGnn hGc hG hThdef hAbd hA.le
      hThsupp hCB hCD hkerB hkerD j hj hE f k
    rw [dvPlancherelENN f] at h
    exact h
  have hfirst : (∫⁻ x : Euclidean 2,
      (ENNReal.ofReal 4 * ∑ k ∈ Finset.range (j + 1), ENNReal.ofReal (dvGk Gb k x)) *
        (M x) ^ 2) ≤
      ENNReal.ofReal 4 * ((j + 1 : ℕ) * (Cc * ENNReal.ofReal W * X)) := by
    rw [hpull]
    refine mul_le_mul' le_rfl ?_
    calc (∑ k ∈ Finset.range (j + 1),
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (dvGk Gb k x) * (M x) ^ 2) ≤
        ∑ _k ∈ Finset.range (j + 1), Cc * ENNReal.ofReal W * X :=
          Finset.sum_le_sum hshell
      _ = ((j + 1 : ℕ) : ℝ≥0∞) * (Cc * ENNReal.ofReal W * X) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  have hsecond : (∫⁻ x : Euclidean 2,
      (Metric.ball (0 : Euclidean 2) (((2 : ℝ) ^ j)⁻¹)).indicator
        (fun y => radialPowerWeight 2 (-1) y * (M y) ^ 2) x) ≤
      ENNReal.ofReal (Bsup ^ 2 * surfaceMass 2) * X := by
    rw [lintegral_indicator measurableSet_ball]
    have hstep : (∫⁻ x in Metric.ball (0 : Euclidean 2) (((2 : ℝ) ^ j)⁻¹),
        radialPowerWeight 2 (-1) x * (M x) ^ 2) ≤
        ∫⁻ x in Metric.ball (0 : Euclidean 2) (((2 : ℝ) ^ j)⁻¹),
          radialPowerWeight 2 (-1) x * ENNReal.ofReal (Bsup ^ 2 * (2 : ℝ) ^ j * I) := by
      refine lintegral_mono fun x => mul_le_mul' le_rfl (hsupsq x)
    refine hstep.trans ?_
    rw [lintegral_mul_const _ (measurable_radialPowerWeight 2 (-1))]
    calc (∫⁻ x in Metric.ball (0 : Euclidean 2) (((2 : ℝ) ^ j)⁻¹),
        radialPowerWeight 2 (-1) x) * ENNReal.ofReal (Bsup ^ 2 * (2 : ℝ) ^ j * I) ≤
        ENNReal.ofReal (surfaceMass 2 * (((2 : ℝ) ^ j)⁻¹)) *
          ENNReal.ofReal (Bsup ^ 2 * (2 : ℝ) ^ j * I) :=
          mul_le_mul' (dvBallWeight_le (by positivity)) le_rfl
      _ = ENNReal.ofReal (Bsup ^ 2 * surfaceMass 2 * I) := by
          rw [← ENNReal.ofReal_mul (by
            have := surfaceMass_pos (d := 2) (by norm_num)
            positivity)]
          congr 1
          field_simp
      _ = ENNReal.ofReal (Bsup ^ 2 * surfaceMass 2) * ENNReal.ofReal I := by
          rw [← ENNReal.ofReal_mul (by
            have := surfaceMass_pos (d := 2) (by norm_num)
            positivity)]
      _ = ENNReal.ofReal (Bsup ^ 2 * surfaceMass 2) * X := by rw [hXI]
  -- final arithmetic
  have hjcast : ((j + 1 : ℕ) : ℝ≥0∞) = ENNReal.ofReal ((j : ℝ) + 1) := by
    rw [show ((j : ℝ) + 1) = ((j + 1 : ℕ) : ℝ) by push_cast; ring,
      ENNReal.ofReal_natCast]
  have hW0 : 0 ≤ W := by
    simp only [hWdef]
    have hL0 : (0 : ℝ) ≤ 2 * Real.log (1 + (2 : ℝ) ^ (j + 7)) := by
      have hT0 : (0 : ℝ) < (2 : ℝ) ^ (j + 7) := by positivity
      have := Real.log_nonneg (by linarith : (1 : ℝ) ≤ 1 + (2 : ℝ) ^ (j + 7))
      linarith
    have : (0 : ℝ) ≤ (1560 * CB + 1152 * CD) * (A / 32) := by positivity
    positivity
  have hjge : (1 : ℝ) ≤ ((j : ℝ) + 1) ^ 2 := by
    have h : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
    nlinarith
  have hcombine : ENNReal.ofReal 4 * (((j + 1 : ℕ) : ℝ≥0∞) *
        (Cc * ENNReal.ofReal W * X)) +
      ENNReal.ofReal (Bsup ^ 2 * surfaceMass 2) * X ≤
      ENNReal.ofReal ((K1 + K2 + 1) * ((j : ℝ) + 1) ^ 2) * X := by
    have hrw1 : ENNReal.ofReal 4 * (((j + 1 : ℕ) : ℝ≥0∞) *
        (Cc * ENNReal.ofReal W * X)) =
        ENNReal.ofReal (4 * ((j : ℝ) + 1) * Ccr * W) * X := by
      have hne2 : (0 : ℝ) ≤ 4 * ((j : ℝ) + 1) := by positivity
      have hne1 : (0 : ℝ) ≤ 4 * ((j : ℝ) + 1) * Ccr := mul_nonneg hne2 hCcr0
      have hexp : ENNReal.ofReal (4 * ((j : ℝ) + 1) * Ccr * W) =
          ENNReal.ofReal (4 * ((j : ℝ) + 1)) * ENNReal.ofReal Ccr * ENNReal.ofReal W := by
        rw [ENNReal.ofReal_mul hne1, ENNReal.ofReal_mul hne2]
      have hexp2 : ENNReal.ofReal (4 * ((j : ℝ) + 1)) =
          ENNReal.ofReal 4 * ENNReal.ofReal ((j : ℝ) + 1) :=
        ENNReal.ofReal_mul (by norm_num)
      rw [hjcast, hCceq, hexp, hexp2]
      ring
    rw [hrw1]
    have hb1 : ENNReal.ofReal (4 * ((j : ℝ) + 1) * Ccr * W) ≤
        ENNReal.ofReal (K1 * ((j : ℝ) + 1) ^ 2) := by
      refine ENNReal.ofReal_le_ofReal ?_
      have hL := dvLogBound j
      have hjnn : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
      have hstep : W ≤ (1560 * CB + 1152 * CD) * (A / 32) * (12 * ((j : ℝ) + 1)) := by
        simp only [hWdef]
        exact mul_le_mul_of_nonneg_left hL (by positivity)
      have hK1eq : K1 * ((j : ℝ) + 1) ^ 2 =
          4 * ((j : ℝ) + 1) * Ccr * ((1560 * CB + 1152 * CD) * (A / 32) *
            (12 * ((j : ℝ) + 1))) := by
        simp only [hK1def]
        ring
      rw [hK1eq]
      refine mul_le_mul_of_nonneg_left hstep ?_
      positivity
    have hb2 : ENNReal.ofReal (Bsup ^ 2 * surfaceMass 2) ≤
        ENNReal.ofReal (K2 * ((j : ℝ) + 1) ^ 2) := by
      refine ENNReal.ofReal_le_ofReal ?_
      simp only [hK2def]
      nlinarith [hK20, hjge]
    calc ENNReal.ofReal (4 * ((j : ℝ) + 1) * Ccr * W) * X +
        ENNReal.ofReal (Bsup ^ 2 * surfaceMass 2) * X ≤
        ENNReal.ofReal (K1 * ((j : ℝ) + 1) ^ 2) * X +
          ENNReal.ofReal (K2 * ((j : ℝ) + 1) ^ 2) * X :=
          add_le_add (mul_le_mul' hb1 le_rfl) (mul_le_mul' hb2 le_rfl)
      _ = ENNReal.ofReal (K1 * ((j : ℝ) + 1) ^ 2 + K2 * ((j : ℝ) + 1) ^ 2) * X := by
          rw [← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity)]
      _ ≤ ENNReal.ofReal ((K1 + K2 + 1) * ((j : ℝ) + 1) ^ 2) * X := by
          refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
          nlinarith [hjge]
  calc (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ),
      radialPowerWeight 2 (-1) x * (M x) ^ 2) =
      ∫⁻ x : Euclidean 2, (Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ)).indicator
        (fun y => radialPowerWeight 2 (-1) y * (M y) ^ 2) x :=
        (lintegral_indicator (μ := (volume : Measure (Euclidean 2)))
          (f := fun y => radialPowerWeight 2 (-1) y * (M y) ^ 2)
          measurableSet_closedBall).symm
    _ ≤ ∫⁻ x : Euclidean 2,
        ((ENNReal.ofReal 4 * ∑ k ∈ Finset.range (j + 1), ENNReal.ofReal (dvGk Gb k x)) *
            (M x) ^ 2 +
          (Metric.ball (0 : Euclidean 2) (((2 : ℝ) ^ j)⁻¹)).indicator
            (fun y => radialPowerWeight 2 (-1) y * (M y) ^ 2) x) := lintegral_mono_ae hdom
    _ = (∫⁻ x : Euclidean 2,
          (ENNReal.ofReal 4 * ∑ k ∈ Finset.range (j + 1),
            ENNReal.ofReal (dvGk Gb k x)) * (M x) ^ 2) +
        ∫⁻ x : Euclidean 2,
          (Metric.ball (0 : Euclidean 2) (((2 : ℝ) ^ j)⁻¹)).indicator
            (fun y => radialPowerWeight 2 (-1) y * (M y) ^ 2) x :=
        lintegral_add_right' _ hmeas2
    _ ≤ ENNReal.ofReal 4 * (((j + 1 : ℕ) : ℝ≥0∞) * (Cc * ENNReal.ofReal W * X)) +
        ENNReal.ofReal (Bsup ^ 2 * surfaceMass 2) * X := add_le_add hfirst hsecond
    _ ≤ ENNReal.ofReal ((K1 + K2 + 1) * ((j : ℝ) + 1) ^ 2) * X := hcombine
/-! ### Phase E: the physical form of the band operator -/

/-- The relative band profile `Ψ(ξ) = phi(ξ/2) - phi(ξ)` as a Schwartz map. -/
def dvPsiS (phi : SchwartzMap (Euclidean 2) ℂ) : SchwartzMap (Euclidean 2) ℂ :=
  dyadicBandpassMultiplier phi 0

theorem dvPsiS_apply (phi : SchwartzMap (Euclidean 2) ℂ) (ξ : Euclidean 2) :
    dvPsiS phi ξ = phi (((2 : ℝ))⁻¹ • ξ) - phi ξ := by
  rw [dvPsiS, dyadicBandpassMultiplier_apply]
  norm_num

/-- The relative frequency scale attached to the index `j` and radius `r`. -/
def dvA (j : ℕ) (r : ℝ) : ℝ := (((2 : ℝ)) ^ j)⁻¹ * max r 1

theorem dvA_pos (j : ℕ) (r : ℝ) : 0 < dvA j r := by
  have h1 : (0 : ℝ) < max r 1 := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  have h2 : (0 : ℝ) < (((2 : ℝ)) ^ j)⁻¹ := by positivity
  exact mul_pos h2 h1

theorem dvA_eq (j : ℕ) {r : ℝ} (hr : 1 ≤ r) : dvA j r = (((2 : ℝ)) ^ j)⁻¹ * r := by
  rw [dvA, max_eq_left hr]

/-- The literal band appearing in the relative bandpass maximal function is the
`dvA`-dilate of the band profile. -/
theorem dvPsiS_dvA (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) {r : ℝ} (hr : 1 ≤ r)
    (ξ : Euclidean 2) :
    dvPsiS phi (dvA j r • ξ) =
      phi ((((2 : ℝ)) ^ (j + 1))⁻¹ • (r • ξ)) - phi ((((2 : ℝ)) ^ j)⁻¹ • (r • ξ)) := by
  rw [dvPsiS_apply, dvA_eq j hr]
  congr 2
  · rw [smul_smul, smul_smul]
    congr 1
    rw [pow_succ]
    field_simp
  · rw [smul_smul]

/-- The physical kernel of the relative band multiplier at index `j` and radius
`r`, packaged as a Schwartz map. -/
def dvKerS (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ) :
    SchwartzMap (Euclidean 2) ℂ :=
  ((dvA j r)⁻¹ ^ 2) •
    (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
      (ContinuousLinearEquiv.smulLeft
        (Units.mk0 ((dvA j r)⁻¹) (inv_ne_zero (dvA_pos j r).ne'))))
      (𝓕⁻ (dvPsiS phi))

theorem dvKerS_apply (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ)
    (y : Euclidean 2) :
    dvKerS phi j r y =
      relativeSchwartzMultiplierKernel (dvPsiS phi) (dvA j r) y := by
  change ((dvA j r)⁻¹ ^ 2) •
      (𝓕⁻ (dvPsiS phi) : SchwartzMap (Euclidean 2) ℂ)
        ((ContinuousLinearEquiv.smulLeft
          (Units.mk0 ((dvA j r)⁻¹) (inv_ne_zero (dvA_pos j r).ne'))) y) = _
  simp [relativeSchwartzMultiplierKernel]

/-- The relative band multiplier is convolution with `dvKerS`. -/
theorem dvKerS_conv (phi f : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) {r : ℝ}
    (hr : 1 ≤ r) (x : Euclidean 2) :
    𝓕⁻ (fun ξ : Euclidean 2 =>
        (phi ((((2 : ℝ)) ^ (j + 1))⁻¹ • (r • ξ)) -
          phi ((((2 : ℝ)) ^ j)⁻¹ • (r • ξ))) *
          𝓕 (f : Euclidean 2 → ℂ) ξ) x =
      ((dvKerS phi j r : Euclidean 2 → ℂ)
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : Euclidean 2 → ℂ)) x := by
  have hcong : (fun ξ : Euclidean 2 =>
      (phi ((((2 : ℝ)) ^ (j + 1))⁻¹ • (r • ξ)) -
        phi ((((2 : ℝ)) ^ j)⁻¹ • (r • ξ))) * 𝓕 (f : Euclidean 2 → ℂ) ξ) =
      fun ξ : Euclidean 2 => dvPsiS phi (dvA j r • ξ) * 𝓕 (f : Euclidean 2 → ℂ) ξ := by
    funext ξ
    rw [dvPsiS_dvA phi j hr ξ]
  rw [hcong, fourierInv_relative_lowpass_eq_convolution (dvPsiS phi) f (dvA_pos j r) x]
  have hk : (fun y : Euclidean 2 => (dvA j r)⁻¹ ^ 2 •
      (𝓕⁻ (dvPsiS phi) : SchwartzMap (Euclidean 2) ℂ) ((dvA j r)⁻¹ • y)) =
      (dvKerS phi j r : Euclidean 2 → ℂ) := by
    funext y
    rw [dvKerS_apply, relativeSchwartzMultiplierKernel]
  rw [hk]

/-- The `L¹` size of the band kernel: it is independent of the index and the
radius, by dilation invariance. -/
def dvPsiL1 (phi : SchwartzMap (Euclidean 2) ℂ) : ℝ :=
  ∫ y : Euclidean 2, ‖(𝓕⁻ (dvPsiS phi) : SchwartzMap (Euclidean 2) ℂ) y‖

theorem dvPsiL1_nonneg (phi : SchwartzMap (Euclidean 2) ℂ) : 0 ≤ dvPsiL1 phi :=
  integral_nonneg fun _ => norm_nonneg _

theorem integral_norm_dvKerS (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ) :
    (∫ y : Euclidean 2, ‖dvKerS phi j r y‖) = dvPsiL1 phi := by
  set a : ℝ := dvA j r with ha
  have hapos : 0 < a := dvA_pos j r
  set k : Euclidean 2 → ℝ :=
    fun z => ‖(𝓕⁻ (dvPsiS phi) : SchwartzMap (Euclidean 2) ℂ) z‖ with hk
  have h1 : (fun y : Euclidean 2 => ‖dvKerS phi j r y‖) =
      fun y : Euclidean 2 => (a⁻¹) ^ 2 * k (a⁻¹ • y) := by
    funext y
    rw [dvKerS_apply, relativeSchwartzMultiplierKernel, norm_smul, hk]
    congr 1
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  rw [h1, integral_const_mul, Measure.integral_comp_inv_smul volume k a,
    finrank_euclideanSpace_fin, abs_of_nonneg (by positivity : (0:ℝ) ≤ a ^ 2),
    smul_eq_mul, dvPsiL1]
  have : (a⁻¹) ^ 2 * (a ^ 2 * ∫ z : Euclidean 2, k z) = ∫ z : Euclidean 2, k z := by
    field_simp
  simpa [hk] using this

theorem integrable_dvKerS (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ) :
    Integrable (dvKerS phi j r : Euclidean 2 → ℂ) volume :=
  (dvKerS phi j r).integrable

theorem continuous_dvKerS (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ) :
    Continuous (dvKerS phi j r : Euclidean 2 → ℂ) :=
  (dvKerS phi j r).continuous

/-- The band multiplier at index `j` and radius `r`, as a Schwartz map. -/
def dvBandS (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ) :
    SchwartzMap (Euclidean 2) ℂ :=
  (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
    (ContinuousLinearEquiv.smulLeft (Units.mk0 (dvA j r) (dvA_pos j r).ne')))
    (dvPsiS phi)

theorem dvBandS_apply (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ)
    (ξ : Euclidean 2) : dvBandS phi j r ξ = dvPsiS phi (dvA j r • ξ) := by
  change (dvPsiS phi) ((ContinuousLinearEquiv.smulLeft
    (Units.mk0 (dvA j r) (dvA_pos j r).ne')) ξ) = _
  simp

/-- The band projection at index `j` and radius `r`, as a Schwartz map. -/
def dvProjS (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ)
    (f : SchwartzMap (Euclidean 2) ℂ) : SchwartzMap (Euclidean 2) ℂ :=
  𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (dvBandS phi j r : Euclidean 2 → ℂ) (𝓕 f))

theorem dvProjS_apply (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ)
    (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2) :
    dvProjS phi j r f x =
      𝓕⁻ (fun ξ : Euclidean 2 =>
        dvBandS phi j r ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) x := by
  unfold dvProjS
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun h : Euclidean 2 → ℂ => 𝓕⁻ h x)
  funext ξ
  simp only [SchwartzMap.smulLeftCLM_apply (dvBandS phi j r).hasTemperateGrowth,
    SchwartzMap.fourier_coe, smul_eq_mul]

theorem fourier_dvProjS (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ)
    (f : SchwartzMap (Euclidean 2) ℂ) (ξ : Euclidean 2) :
    𝓕 ((dvProjS phi j r f : SchwartzMap (Euclidean 2) ℂ) : Euclidean 2 → ℂ) ξ =
      dvBandS phi j r ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ := by
  unfold dvProjS
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [SchwartzMap.smulLeftCLM_apply (dvBandS phi j r).hasTemperateGrowth,
    SchwartzMap.fourier_coe]
  simp only [smul_eq_mul]

/-- The convolution form of one relative band spherical average.  It makes
sense for every integrable input, not only for Schwartz data. -/
def dvOp (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ)
    (u : Euclidean 2 → ℂ) (x : Euclidean 2) : ℂ :=
  sphericalAverage 2
    ((dvKerS phi j r : Euclidean 2 → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) r x

/-- On Schwartz data the convolution form agrees with the literal Fourier
multiplier form appearing in the relative bandpass maximal function. -/
theorem dvOp_schwartz (phi f : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) {r : ℝ}
    (hr : 1 ≤ r) (x : Euclidean 2) :
    dvOp phi j r (f : Euclidean 2 → ℂ) x =
      𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-r • ξ) *
        (phi ((((2 : ℝ)) ^ (j + 1))⁻¹ • (r • ξ)) -
          phi ((((2 : ℝ)) ^ j)⁻¹ • (r • ξ))) *
        𝓕 (f : Euclidean 2 → ℂ) ξ) x := by
  have hg : ((dvKerS phi j r : Euclidean 2 → ℂ)
      ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : Euclidean 2 → ℂ)) =
      (dvProjS phi j r f : Euclidean 2 → ℂ) := by
    funext y
    rw [dvProjS_apply, ← dvKerS_conv phi f j hr y]
    apply congrArg (fun h : Euclidean 2 → ℂ => 𝓕⁻ h y)
    funext ξ
    rw [dvBandS_apply, dvPsiS_dvA phi j hr]
  rw [dvOp, hg, sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz]
  apply congrArg (fun h : Euclidean 2 → ℂ => 𝓕⁻ h x)
  funext ξ
  rw [fourier_dvProjS, dvBandS_apply, dvPsiS_dvA phi j hr]
  ring

/-- Sup bound for a spherical average. -/
theorem norm_sphericalAverage_le {d : ℕ} (g : Euclidean d → ℂ) (r : ℝ) (x : Euclidean d)
    {M : ℝ} (hM : ∀ y, ‖g y‖ ≤ M) :
    ‖sphericalAverage d g r x‖ ≤ surfaceMass d * M := by
  have h := norm_integral_le_of_norm_le_const
    (μ := unitSurfaceMeasure d) (C := M)
    (f := fun ω : Metric.sphere (0 : Euclidean d) 1 => g (x + r • (ω : Euclidean d)))
    (Filter.Eventually.of_forall fun ω => hM _)
  rw [mul_comm]
  simpa [Codex.Spherical.SurfaceCore.sphericalAverage, surfaceMass, Measure.real] using h

/-- The essential sup bound for a convolution against an `L¹` kernel. -/
theorem norm_convolution_le_of_ae_bound (κ u : Euclidean 2 → ℂ)
    (hκ : Integrable κ volume) {M : ℝ}
    (hM : ∀ᵐ y : Euclidean 2, ‖u y‖ ≤ M) (x : Euclidean 2) :
    ‖(κ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) x‖ ≤
      (∫ t : Euclidean 2, ‖κ t‖) * M := by
  have hM0 : 0 ≤ M := by
    obtain ⟨y, hy⟩ := hM.exists
    exact le_trans (norm_nonneg _) hy
  have hmp : MeasurePreserving (fun t : Euclidean 2 => x - t) volume volume :=
    Measure.measurePreserving_sub_left volume x
  have hae : ∀ᵐ t : Euclidean 2, ‖u (x - t)‖ ≤ M := hmp.quasiMeasurePreserving.ae hM
  have hstep : ‖(κ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) x‖ ≤
      ∫ t : Euclidean 2, ‖κ t‖ * ‖u (x - t)‖ := by
    have h1 : (κ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) x =
        ∫ t : Euclidean 2, κ t * u (x - t) := by
      rw [convolution]
      simp
    rw [h1]
    refine le_trans (norm_integral_le_integral_norm _) ?_
    exact le_of_eq (integral_congr_ae (Filter.Eventually.of_forall fun t => norm_mul _ _))
  refine le_trans hstep ?_
  have hint : Integrable (fun t : Euclidean 2 => ‖κ t‖ * M) volume :=
    hκ.norm.mul_const M
  have hle : ∫ t : Euclidean 2, ‖κ t‖ * ‖u (x - t)‖ ≤
      ∫ t : Euclidean 2, ‖κ t‖ * M := by
    refine integral_mono_of_nonneg ?_ hint ?_
    · filter_upwards with t using by positivity
    · filter_upwards [hae] with t ht
      exact mul_le_mul_of_nonneg_left ht (norm_nonneg _)
  refine le_trans hle (le_of_eq ?_)
  simp [MeasureTheory.integral_mul_const]

/-- The Cauchy--Schwarz bound for a convolution, in extended-norm form. -/
theorem enorm_convolution_le_l2 (κ u : Euclidean 2 → ℂ)
    (hκ : Measurable κ) (hu : Measurable u) (x : Euclidean 2) :
    ‖(κ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) x‖ₑ ≤
      eLpNorm κ 2 volume * eLpNorm u 2 volume := by
  have hcong : (κ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) x =
      ∫ t : Euclidean 2, κ t * u (x - t) := by
    rw [convolution]; simp
  have hhc : Real.HolderConjugate 2 2 :=
    Real.holderConjugate_iff.mpr ⟨by norm_num, by norm_num⟩
  have hmp : MeasurePreserving (fun t : Euclidean 2 => x - t) volume volume :=
    Measure.measurePreserving_sub_left volume x
  have hsq : ∀ v : Euclidean 2 → ℂ,
      (∫⁻ y : Euclidean 2, ‖v y‖ₑ ^ (2 : ℝ)) = ∫⁻ y : Euclidean 2, ‖v y‖ₑ ^ (2 : ℕ) := by
    intro v
    refine lintegral_congr fun y => ?_
    rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast]
  have htrans0 : (∫⁻ t : Euclidean 2, ‖u (x - t)‖ₑ ^ (2 : ℕ)) =
      ∫⁻ y : Euclidean 2, ‖u y‖ₑ ^ (2 : ℕ) :=
    hmp.lintegral_comp (f := fun y : Euclidean 2 => ‖u y‖ₑ ^ (2 : ℕ))
      (hu.enorm.pow_const 2)
  have htrans : (∫⁻ t : Euclidean 2, ‖u (x - t)‖ₑ ^ (2 : ℝ)) =
      ∫⁻ y : Euclidean 2, ‖u y‖ₑ ^ (2 : ℝ) := by
    rw [hsq (fun t => u (x - t)), hsq u, htrans0]
  have hkey : (∫⁻ t : Euclidean 2, ‖κ t‖ₑ * ‖u (x - t)‖ₑ) ≤
      (∫⁻ t : Euclidean 2, ‖κ t‖ₑ ^ (2 : ℝ)) ^ ((2 : ℝ)⁻¹) *
        (∫⁻ t : Euclidean 2, ‖u (x - t)‖ₑ ^ (2 : ℝ)) ^ ((2 : ℝ)⁻¹) := by
    have h := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hhc
      (f := fun t : Euclidean 2 => ‖κ t‖ₑ) (g := fun t : Euclidean 2 => ‖u (x - t)‖ₑ)
      hκ.enorm.aemeasurable
      ((hu.comp (measurable_const_sub x)).enorm.aemeasurable)
    simpa [one_div] using h
  have hnorm1 : eLpNorm κ 2 volume =
      (∫⁻ t : Euclidean 2, ‖κ t‖ₑ ^ (2 : ℝ)) ^ ((2 : ℝ)⁻¹) := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
    norm_num
  have hnorm2 : eLpNorm u 2 volume =
      (∫⁻ y : Euclidean 2, ‖u y‖ₑ ^ (2 : ℝ)) ^ ((2 : ℝ)⁻¹) := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
    norm_num
  calc ‖(κ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) x‖ₑ
      = ‖∫ t : Euclidean 2, κ t * u (x - t)‖ₑ := by rw [hcong]
    _ ≤ ∫⁻ t : Euclidean 2, ‖κ t * u (x - t)‖ₑ := enorm_integral_le_lintegral_enorm _
    _ = ∫⁻ t : Euclidean 2, ‖κ t‖ₑ * ‖u (x - t)‖ₑ := by
        refine lintegral_congr fun t => ?_
        rw [enorm_mul]
    _ ≤ (∫⁻ t : Euclidean 2, ‖κ t‖ₑ ^ (2 : ℝ)) ^ ((2 : ℝ)⁻¹) *
          (∫⁻ t : Euclidean 2, ‖u (x - t)‖ₑ ^ (2 : ℝ)) ^ ((2 : ℝ)⁻¹) := hkey
    _ = eLpNorm κ 2 volume * eLpNorm u 2 volume := by
        rw [hnorm1, hnorm2, htrans]

/-- Uniform sup bound for the band kernel. -/
theorem dvKerS_bound (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ) (y : Euclidean 2) :
    ‖dvKerS phi j r y‖ ≤ SchwartzMap.seminorm ℝ 0 0 (dvKerS phi j r) :=
  SchwartzMap.norm_le_seminorm ℝ _ y

theorem dvKerS_bddAbove (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ) :
    BddAbove (Set.range fun y : Euclidean 2 => ‖dvKerS phi j r y‖) := by
  refine ⟨SchwartzMap.seminorm ℝ 0 0 (dvKerS phi j r), ?_⟩
  rintro z ⟨y, rfl⟩
  exact dvKerS_bound phi j r y

/-- The convolution defining `dvOp` exists for every integrable input. -/
theorem dvConvExists (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ)
    {u : Euclidean 2 → ℂ} (hu : Integrable u volume) :
    ConvolutionExists (dvKerS phi j r : Euclidean 2 → ℂ) u
      (ContinuousLinearMap.mul ℂ ℂ) volume := by
  intro x
  have hmp : MeasurePreserving (fun t : Euclidean 2 => x - t) volume volume :=
    Measure.measurePreserving_sub_left volume x
  have hu' : Integrable (fun t : Euclidean 2 => u (x - t)) volume :=
    (hmp.integrable_comp hu.aestronglyMeasurable).mpr hu
  have hb : Integrable
      (fun t : Euclidean 2 => (dvKerS phi j r : Euclidean 2 → ℂ) t * u (x - t)) volume := by
    refine Integrable.bdd_mul hu' ((continuous_dvKerS phi j r).aestronglyMeasurable)
      (c := SchwartzMap.seminorm ℝ 0 0 (dvKerS phi j r)) ?_
    filter_upwards with t using dvKerS_bound phi j r t
  simpa [ConvolutionExistsAt] using hb

/-- `dvOp` is continuous for every integrable input. -/
theorem continuous_dvOp (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ)
    {u : Euclidean 2 → ℂ} (hu : Integrable u volume) :
    Continuous (dvOp phi j r u) := by
  have hconv : Continuous ((dvKerS phi j r : Euclidean 2 → ℂ)
      ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) :=
    BddAbove.continuous_convolution_left_of_integrable _ (dvKerS_bddAbove phi j r)
      (continuous_dvKerS phi j r) hu
  have h := continuous_sphericalAverage
    ((dvKerS phi j r : Euclidean 2 → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) hconv
  have h2 := h.comp
    ((continuous_const : Continuous fun _ : Euclidean 2 => r).prodMk continuous_id)
  have hdef : dvOp phi j r u = fun x : Euclidean 2 =>
      sphericalAverage 2 ((dvKerS phi j r : Euclidean 2 → ℂ)
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) r x := rfl
  rw [hdef]
  simpa [Function.comp_def] using h2

theorem sphericalAverage_addition {d : ℕ} (g h : Euclidean d → ℂ) (hg : Continuous g)
    (hh : Continuous h) (r : ℝ) (x : Euclidean d) :
    sphericalAverage d (g + h) r x =
      sphericalAverage d g r x + sphericalAverage d h r x := by
  have hint (k : Euclidean d → ℂ) (hk : Continuous k) : Integrable
      (fun ω : Metric.sphere (0 : Euclidean d) 1 => k (x + r • (ω : Euclidean d)))
      (unitSurfaceMeasure d) := by
    apply Continuous.integrable_of_hasCompactSupport
    · exact hk.comp
        ((continuous_const : Continuous fun _ : Metric.sphere (0 : Euclidean d) 1 => x).add
          ((continuous_const : Continuous fun _ : Metric.sphere (0 : Euclidean d) 1 => r).smul
            continuous_subtype_val))
    · exact HasCompactSupport.of_compactSpace _
  unfold Codex.Spherical.SurfaceCore.sphericalAverage
  change ∫ ω : Metric.sphere (0 : Euclidean d) 1,
    (g (x + r • (ω : Euclidean d)) + h (x + r • (ω : Euclidean d)))
    ∂unitSurfaceMeasure d = _
  rw [MeasureTheory.integral_add (hint g hg) (hint h hh)]

theorem sphericalAverage_scalar {d : ℕ} (c : ℂ) (g : Euclidean d → ℂ) (r : ℝ)
    (x : Euclidean d) :
    sphericalAverage d (c • g) r x = c * sphericalAverage d g r x := by
  unfold Codex.Spherical.SurfaceCore.sphericalAverage
  change ∫ ω : Metric.sphere (0 : Euclidean d) 1, c • g (x + r • (ω : Euclidean d))
    ∂unitSurfaceMeasure d = _
  rw [integral_smul]
  simp

theorem dvOp_add (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ)
    {u v : Euclidean 2 → ℂ} (hu : Integrable u volume) (hv : Integrable v volume) :
    dvOp phi j r (u + v) = dvOp phi j r u + dvOp phi j r v := by
  have hconv : ((dvKerS phi j r : Euclidean 2 → ℂ)
      ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (u + v)) =
      ((dvKerS phi j r : Euclidean 2 → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) +
        ((dvKerS phi j r : Euclidean 2 → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] v) :=
    (dvConvExists phi j r hu).distrib_add (dvConvExists phi j r hv)
  funext x
  have hcu : Continuous ((dvKerS phi j r : Euclidean 2 → ℂ)
      ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) :=
    BddAbove.continuous_convolution_left_of_integrable _ (dvKerS_bddAbove phi j r)
      (continuous_dvKerS phi j r) hu
  have hcv : Continuous ((dvKerS phi j r : Euclidean 2 → ℂ)
      ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] v) :=
    BddAbove.continuous_convolution_left_of_integrable _ (dvKerS_bddAbove phi j r)
      (continuous_dvKerS phi j r) hv
  show sphericalAverage 2 _ r x = sphericalAverage 2 _ r x + sphericalAverage 2 _ r x
  rw [hconv, sphericalAverage_addition _ _ hcu hcv]

theorem dvOp_smul (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ) (c : ℂ)
    (u : Euclidean 2 → ℂ) : dvOp phi j r (c • u) = c • dvOp phi j r u := by
  funext x
  show sphericalAverage 2 _ r x = c • sphericalAverage 2 _ r x
  rw [convolution_smul, sphericalAverage_scalar]
  simp
/-! ### Phase E: linearization and interpolation -/

/-- The linearized relative band maximal operator attached to a finite radius
set and a family of selection sets. -/
def dvT (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (S : ℝ → Set (Euclidean 2)) (u : Euclidean 2 → ℂ) (x : Euclidean 2) : ℂ :=
  ∑ r ∈ R, (S r).indicator (fun y => dvOp phi j r u y) x

theorem dvT_add (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (S : ℝ → Set (Euclidean 2)) {u v : Euclidean 2 → ℂ}
    (hu : Integrable u volume) (hv : Integrable v volume) :
    dvT phi j R S (u + v) = dvT phi j R S u + dvT phi j R S v := by
  funext x
  simp only [dvT, Pi.add_apply, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun r _ => ?_
  rw [dvOp_add phi j r hu hv]
  by_cases hx : x ∈ S r
  · simp [Set.indicator_of_mem hx]
  · simp [Set.indicator_of_notMem hx]

theorem dvT_smul (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (S : ℝ → Set (Euclidean 2)) (c : ℂ) (u : Euclidean 2 → ℂ) :
    dvT phi j R S (c • u) = c • dvT phi j R S u := by
  funext x
  simp only [dvT, Pi.smul_apply, Finset.smul_sum]
  refine Finset.sum_congr rfl fun r _ => ?_
  rw [dvOp_smul phi j r c u]
  by_cases hx : x ∈ S r
  · simp [Set.indicator_of_mem hx]
  · simp [Set.indicator_of_notMem hx]

theorem measurable_dvT (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    {S : ℝ → Set (Euclidean 2)} (hS : ∀ r ∈ R, MeasurableSet (S r))
    {u : Euclidean 2 → ℂ} (hu : Integrable u volume) :
    Measurable (dvT phi j R S u) := by
  refine Finset.measurable_sum R fun r hr => ?_
  exact (Measurable.indicator (continuous_dvOp phi j r hu).measurable (hS r hr))

/-- With disjoint selection sets, the linearized operator agrees at every point
with one of the band averages, or vanishes. -/
theorem dvT_eq_of_disjoint (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    {S : ℝ → Set (Euclidean 2)}
    (hdisj : ∀ r ∈ R, ∀ r' ∈ R, r ≠ r' → Disjoint (S r) (S r'))
    (u : Euclidean 2 → ℂ) (x : Euclidean 2) :
    dvT phi j R S u x = 0 ∨ ∃ r ∈ R, dvT phi j R S u x = dvOp phi j r u x := by
  classical
  by_cases h : ∃ r ∈ R, x ∈ S r
  · obtain ⟨r₀, hr₀, hx⟩ := h
    refine Or.inr ⟨r₀, hr₀, ?_⟩
    rw [dvT, Finset.sum_eq_single_of_mem r₀ hr₀ ?_]
    · exact Set.indicator_of_mem hx _
    · intro r hr hne
      refine Set.indicator_of_notMem ?_ _
      intro hxr
      exact (Set.disjoint_left.mp (hdisj r hr r₀ hr₀ hne)) hxr hx
  · left
    rw [dvT]
    refine Finset.sum_eq_zero fun r hr => ?_
    refine Set.indicator_of_notMem ?_ _
    intro hxr
    exact h ⟨r, hr, hxr⟩

/-- Each band average is dominated by the restricted maximal function. -/
theorem enorm_dvOp_le_maximal (phi f : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) {E : Set ℝ}
    {r : ℝ} (hr : r ∈ E) (hr1 : 1 ≤ r) (x : Euclidean 2) :
    ENNReal.ofReal ‖dvOp phi j r (f : Euclidean 2 → ℂ) x‖ ≤
      restrictedRelativeBandpassSphericalMaximal 2 E phi j f x := by
  unfold restrictedRelativeBandpassSphericalMaximal
  refine le_iSup_of_le
    (⟨r, hr, lt_of_lt_of_le zero_lt_one hr1⟩ : ↥(E ∩ Ioi (0 : ℝ))) ?_
  rw [dvOp_schwartz phi f j hr1 x]

/-- The tie-broken maximizing selection sets for a finite radius set. -/
def dvSel (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (f : SchwartzMap (Euclidean 2) ℂ) (r : ℝ) : Set (Euclidean 2) :=
  {x | (∀ q ∈ R, ‖dvOp phi j q (f : Euclidean 2 → ℂ) x‖ ≤
          ‖dvOp phi j r (f : Euclidean 2 → ℂ) x‖) ∧
    ∀ q ∈ R, q < r → ‖dvOp phi j q (f : Euclidean 2 → ℂ) x‖ <
      ‖dvOp phi j r (f : Euclidean 2 → ℂ) x‖}

theorem measurableSet_dvSel (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (f : SchwartzMap (Euclidean 2) ℂ) (r : ℝ) :
    MeasurableSet (dvSel phi j R f r) := by
  classical
  have hcont : ∀ q : ℝ, Measurable
      fun x : Euclidean 2 => ‖dvOp phi j q (f : Euclidean 2 → ℂ) x‖ :=
    fun q => (continuous_dvOp phi j q f.integrable).norm.measurable
  have heq : dvSel phi j R f r =
      (⋂ q ∈ (R : Set ℝ), {x : Euclidean 2 |
          ‖dvOp phi j q (f : Euclidean 2 → ℂ) x‖ ≤
            ‖dvOp phi j r (f : Euclidean 2 → ℂ) x‖}) ∩
      (⋂ q ∈ (R : Set ℝ), {x : Euclidean 2 | q < r →
          ‖dvOp phi j q (f : Euclidean 2 → ℂ) x‖ <
            ‖dvOp phi j r (f : Euclidean 2 → ℂ) x‖}) := by
    ext x
    simp only [dvSel, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter, Finset.mem_coe]
    try tauto
  rw [heq]
  refine MeasurableSet.inter ?_ ?_
  · refine MeasurableSet.biInter (Set.Finite.countable R.finite_toSet) fun q _ => ?_
    exact measurableSet_le (hcont q) (hcont r)
  · refine MeasurableSet.biInter (Set.Finite.countable R.finite_toSet) fun q _ => ?_
    by_cases hq : q < r
    · have : {x : Euclidean 2 | q < r →
          ‖dvOp phi j q (f : Euclidean 2 → ℂ) x‖ <
            ‖dvOp phi j r (f : Euclidean 2 → ℂ) x‖} =
          {x : Euclidean 2 | ‖dvOp phi j q (f : Euclidean 2 → ℂ) x‖ <
            ‖dvOp phi j r (f : Euclidean 2 → ℂ) x‖} := by
        ext x; simp [hq]
      rw [this]
      exact measurableSet_lt (hcont q) (hcont r)
    · have : {x : Euclidean 2 | q < r →
          ‖dvOp phi j q (f : Euclidean 2 → ℂ) x‖ <
            ‖dvOp phi j r (f : Euclidean 2 → ℂ) x‖} = Set.univ := by
        ext x; simp [hq]
      rw [this]
      exact MeasurableSet.univ

theorem dvSel_disjoint (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (f : SchwartzMap (Euclidean 2) ℂ) :
    ∀ r ∈ R, ∀ r' ∈ R, r ≠ r' →
      Disjoint (dvSel phi j R f r) (dvSel phi j R f r') := by
  intro r hr r' hr' hne
  rw [Set.disjoint_left]
  intro x hx hx'
  rcases lt_or_gt_of_ne hne with h | h
  · exact absurd (hx'.2 r hr h) (not_lt.mpr (hx.1 r' hr'))
  · exact absurd (hx.2 r' hr' h) (not_lt.mpr (hx'.1 r hr))

theorem dvSel_exists (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (hRne : R.Nonempty) (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2) :
    ∃ r₀ ∈ R, x ∈ dvSel phi j R f r₀ := by
  classical
  set g : ℝ → ℝ := fun q => ‖dvOp phi j q (f : Euclidean 2 → ℂ) x‖ with hg
  obtain ⟨r₁, hr₁, hmax⟩ := R.exists_max_image g hRne
  set T : Finset ℝ := R.filter (fun q => ∀ q' ∈ R, g q' ≤ g q) with hT
  have hTne : T.Nonempty := ⟨r₁, by
    refine Finset.mem_filter.mpr ⟨hr₁, ?_⟩
    exact hmax⟩
  set r₀ : ℝ := T.min' hTne with hr₀
  have hr₀T : r₀ ∈ T := T.min'_mem hTne
  have hr₀R : r₀ ∈ R := (Finset.mem_filter.mp hr₀T).1
  have hr₀max : ∀ q' ∈ R, g q' ≤ g r₀ := (Finset.mem_filter.mp hr₀T).2
  refine ⟨r₀, hr₀R, hr₀max, ?_⟩
  intro q hq hlt
  rcases lt_or_eq_of_le (hr₀max q hq) with h | h
  · exact h
  · exfalso
    have hqT : q ∈ T := by
      refine Finset.mem_filter.mpr ⟨hq, ?_⟩
      intro q' hq'
      rw [h]
      exact hr₀max q' hq'
    exact absurd (T.min'_le q hqT) (not_le.mpr hlt)

/-- With the tie-broken selection, the linearized operator realizes the maximum. -/
theorem dvT_dvSel_eq (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (hRne : R.Nonempty) (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2) :
    ∀ q ∈ R, ‖dvOp phi j q (f : Euclidean 2 → ℂ) x‖ ≤
      ‖dvT phi j R (dvSel phi j R f) (f : Euclidean 2 → ℂ) x‖ := by
  classical
  obtain ⟨r₀, hr₀, hx⟩ := dvSel_exists phi j R hRne f x
  have hval : dvT phi j R (dvSel phi j R f) (f : Euclidean 2 → ℂ) x =
      dvOp phi j r₀ (f : Euclidean 2 → ℂ) x := by
    rw [dvT, Finset.sum_eq_single_of_mem r₀ hr₀ ?_]
    · exact Set.indicator_of_mem hx _
    · intro r hr hne
      refine Set.indicator_of_notMem ?_ _
      intro hxr
      exact (Set.disjoint_left.mp
        (dvSel_disjoint phi j R f r hr r₀ hr₀ hne)) hxr hx
  rw [hval]
  exact hx.1

/-- Sup bound for one band average in terms of an essential bound of the input. -/
theorem dvOp_sup_bound (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ)
    {u : Euclidean 2 → ℂ} {M : ℝ} (hM : ∀ᵐ y : Euclidean 2, ‖u y‖ ≤ M)
    (x : Euclidean 2) :
    ‖dvOp phi j r u x‖ ≤ surfaceMass 2 * (dvPsiL1 phi * M) := by
  rw [dvOp]
  refine norm_sphericalAverage_le _ _ _ (fun y => ?_)
  have h := norm_convolution_le_of_ae_bound (dvKerS phi j r : Euclidean 2 → ℂ) u
    (integrable_dvKerS phi j r) hM y
  rwa [integral_norm_dvKerS] at h

/-- The `L^∞` endpoint bound for the linearized operator. -/
theorem dvT_eLpNorm_top (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    {S : ℝ → Set (Euclidean 2)}
    (hdisj : ∀ r ∈ R, ∀ r' ∈ R, r ≠ r' → Disjoint (S r) (S r'))
    (ν : Measure (Euclidean 2)) {C : ℝ} (hC0 : 0 < C)
    (hC : surfaceMass 2 * dvPsiL1 phi ≤ C) (u : Euclidean 2 → ℂ) :
    eLpNorm (dvT phi j R S u) ⊤ ν ≤
      ENNReal.ofReal C * eLpNorm u ⊤ volume := by
  by_cases htop : eLpNorm u ⊤ volume = ⊤
  · rw [htop, ENNReal.mul_top (by simp [hC0])]
    exact le_top
  · set M : ℝ := (eLpNorm u ⊤ volume).toReal with hMdef
    have hM0 : 0 ≤ M := ENNReal.toReal_nonneg
    have hMae : ∀ᵐ y : Euclidean 2, ‖u y‖ ≤ M := by
      have h := ae_le_eLpNormEssSup (f := u) (μ := volume)
      filter_upwards [h] with y hy
      have hy' : ‖u y‖ₑ ≤ eLpNorm u ⊤ volume := by
        simpa [eLpNorm_exponent_top] using hy
      have := ENNReal.toReal_le_toReal (by simp) htop |>.mpr hy'
      simpa [hMdef] using this
    have hpt : ∀ x : Euclidean 2, ‖dvT phi j R S u x‖ₑ ≤
        ENNReal.ofReal C * eLpNorm u ⊤ volume := by
      intro x
      have hbound : ‖dvT phi j R S u x‖ ≤ C * M := by
        rcases dvT_eq_of_disjoint phi j R hdisj u x with h | ⟨r, _, h⟩
        · rw [h]
          simpa using mul_nonneg hC0.le hM0
        · rw [h]
          refine le_trans (dvOp_sup_bound phi j r hMae x) ?_
          calc surfaceMass 2 * (dvPsiL1 phi * M)
              = (surfaceMass 2 * dvPsiL1 phi) * M := by ring
            _ ≤ C * M := mul_le_mul_of_nonneg_right hC hM0
      have hMeq : ENNReal.ofReal M = eLpNorm u ⊤ volume := by
        rw [hMdef, ENNReal.ofReal_toReal htop]
      calc ‖dvT phi j R S u x‖ₑ = ENNReal.ofReal ‖dvT phi j R S u x‖ := by
            rw [← ofReal_norm]
        _ ≤ ENNReal.ofReal (C * M) := ENNReal.ofReal_le_ofReal hbound
        _ = ENNReal.ofReal C * ENNReal.ofReal M := ENNReal.ofReal_mul hC0.le
        _ = ENNReal.ofReal C * eLpNorm u ⊤ volume := by rw [hMeq]
    rw [eLpNorm_exponent_top, eLpNormEssSup]
    exact essSup_le_of_ae_le _ (Filter.Eventually.of_forall hpt)

/-- A uniform `L²` bound for the finitely many band kernels. -/
theorem exists_dvKerS_l2_bound (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ r ∈ R,
      eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume ≤ ENNReal.ofReal K := by
  classical
  have hfin : ∀ r : ℝ, eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume ≠ ⊤ :=
    fun r => ((dvKerS phi j r).memLp 2 volume).eLpNorm_ne_top
  rcases R.eq_empty_or_nonempty with hR | hRne
  · exact ⟨0, le_rfl, fun r hr => absurd hr (by simp [hR])⟩
  · refine ⟨R.sup' hRne
      (fun r => (eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume).toReal), ?_, ?_⟩
    · obtain ⟨r₀, hr₀⟩ := hRne
      exact le_trans ENNReal.toReal_nonneg
        (Finset.le_sup' (f := fun r =>
          (eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume).toReal) hr₀)
    · intro r hr
      have hle : (eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume).toReal ≤
          R.sup' hRne
            (fun q => (eLpNorm (dvKerS phi j q : Euclidean 2 → ℂ) 2 volume).toReal) :=
        Finset.le_sup' (f := fun q =>
          (eLpNorm (dvKerS phi j q : Euclidean 2 → ℂ) 2 volume).toReal) hr
      calc eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume
          = ENNReal.ofReal (eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume).toReal := by
            rw [ENNReal.ofReal_toReal (hfin r)]
        _ ≤ _ := ENNReal.ofReal_le_ofReal hle

/-- Stability of the linearized operator under `L²` perturbations of the input. -/
theorem dvT_sub_bound (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    {S : ℝ → Set (Euclidean 2)}
    (hdisj : ∀ r ∈ R, ∀ r' ∈ R, r ≠ r' → Disjoint (S r) (S r'))
    {u v : Euclidean 2 → ℂ} (hu : Integrable u volume) (hv : Integrable v volume)
    (hmu : Measurable u) (hmv : Measurable v)
    {K : ℝ} (hK0 : 0 ≤ K)
    (hK : ∀ r ∈ R, eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume ≤ ENNReal.ofReal K)
    {δ : ℝ} (hδ0 : 0 ≤ δ) (hδ : eLpNorm (u - v) 2 volume ≤ ENNReal.ofReal δ)
    (x : Euclidean 2) :
    ‖dvT phi j R S u x - dvT phi j R S v x‖ ≤ surfaceMass 2 * (K * δ) := by
  have hsub : dvT phi j R S u x - dvT phi j R S v x = dvT phi j R S (u - v) x := by
    have h1 : u - v = u + (-1 : ℂ) • v := by
      funext y; simp [sub_eq_add_neg]
    rw [h1, dvT_add phi j R S hu (by simpa using hv.smul (-1 : ℂ)),
      dvT_smul phi j R S (-1 : ℂ) v]
    simp [sub_eq_add_neg]
  rw [hsub]
  have hsm : 0 ≤ surfaceMass 2 := le_of_lt (surfaceMass_pos (by norm_num))
  rcases dvT_eq_of_disjoint phi j R hdisj (u - v) x with h | ⟨r, hr, h⟩
  · rw [h]
    simpa using mul_nonneg hsm (mul_nonneg hK0 hδ0)
  · rw [h, dvOp]
    refine norm_sphericalAverage_le _ _ _ (fun y => ?_)
    have hcs := enorm_convolution_le_l2 (dvKerS phi j r : Euclidean 2 → ℂ) (u - v)
      (continuous_dvKerS phi j r).measurable (hmu.sub hmv) y
    have hbound : ‖((dvKerS phi j r : Euclidean 2 → ℂ)
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (u - v)) y‖ₑ ≤
        ENNReal.ofReal (K * δ) := by
      refine le_trans hcs ?_
      rw [ENNReal.ofReal_mul hK0]
      exact mul_le_mul' (hK r hr) hδ
    have hfin : ENNReal.ofReal ‖((dvKerS phi j r : Euclidean 2 → ℂ)
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (u - v)) y‖ ≤
        ENNReal.ofReal (K * δ) := by
      rwa [ofReal_norm]
    exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp hfin

/-- The critical weighted measure on the fixed output ball. -/
def dvNu : Measure (Euclidean 2) :=
  (powerWeightedVolume 2 (-1)).restrict (Metric.closedBall (0 : Euclidean 2) (1 / 32))

instance dvNu_isFinite : IsFiniteMeasure dvNu := by
  constructor
  have hsub : Metric.closedBall (0 : Euclidean 2) (1 / 32) ⊆
      Metric.ball (0 : Euclidean 2) (1 / 16) := by
    intro x hx
    rw [Metric.mem_closedBall, dist_zero_right] at hx
    rw [Metric.mem_ball, dist_zero_right]
    linarith
  have h1 : dvNu Set.univ =
      powerWeightedVolume 2 (-1) (Metric.closedBall (0 : Euclidean 2) (1 / 32)) := by
    rw [dvNu, Measure.restrict_apply MeasurableSet.univ, Set.univ_inter]
  have h2 : powerWeightedVolume 2 (-1) (Metric.closedBall (0 : Euclidean 2) (1 / 32)) =
      ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32), radialPowerWeight 2 (-1) x := by
    rw [powerWeightedVolume, withDensity_apply _ measurableSet_closedBall]
  have h3 : (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
      radialPowerWeight 2 (-1) x) ≤
      ∫⁻ x in Metric.ball (0 : Euclidean 2) (1 / 16), radialPowerWeight 2 (-1) x :=
    lintegral_mono_set hsub
  have h4 := dvBallWeight_le (ρ := (1 / 16 : ℝ)) (by norm_num)
  rw [h1, h2]
  exact lt_of_le_of_lt (le_trans h3 h4) (by simp)

theorem dvNu_lintegral (g : Euclidean 2 → ℝ≥0∞) (hg : Measurable g) :
    (∫⁻ x, g x ∂dvNu) =
      ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
        radialPowerWeight 2 (-1) x * g x := by
  rw [dvNu, powerWeightedVolume, restrict_withDensity measurableSet_closedBall,
    lintegral_withDensity_eq_lintegral_mul _ (measurable_radialPowerWeight 2 (-1)) hg]
  rfl

theorem dvL2sq (g : Euclidean 2 → ℂ) :
    (∫⁻ x : Euclidean 2, ‖g x‖ₑ ^ 2) = (eLpNorm g 2 volume) ^ 2 := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
  have h1 : (2 : ℝ≥0∞).toReal = 2 := by norm_num
  rw [h1]
  have h2 : (∫⁻ x : Euclidean 2, ‖g x‖ₑ ^ (2 : ℝ)) = ∫⁻ x : Euclidean 2, ‖g x‖ₑ ^ 2 := by
    refine lintegral_congr fun x => ?_
    rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast]
  rw [h2]
  set A : ℝ≥0∞ := ∫⁻ x : Euclidean 2, ‖g x‖ₑ ^ 2 with hA
  rw [← ENNReal.rpow_natCast (A ^ (1 / (2 : ℝ))) 2, ← ENNReal.rpow_mul]
  norm_num

/-- The `L²` endpoint bound for Schwartz inputs, from the weighted core estimate. -/
theorem dvT_l2_schwartz (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (hR : ∀ r ∈ R, r ∈ Icc (1 : ℝ) 2)
    {S : ℝ → Set (Euclidean 2)} (hS : ∀ r ∈ R, MeasurableSet (S r))
    (hdisj : ∀ r ∈ R, ∀ r' ∈ R, r ≠ r' → Disjoint (S r) (S r'))
    (L : ℝ≥0∞) (f : SchwartzMap (Euclidean 2) ℂ)
    (hcore : (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
        radialPowerWeight 2 (-1) x *
          (restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f x) ^ 2) ≤
      L * ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(f : Euclidean 2 → ℂ) x‖) ^ 2) :
    (∫⁻ x, ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ^ 2 ∂dvNu) ≤
      L * ∫⁻ x : Euclidean 2, ‖(f : Euclidean 2 → ℂ) x‖ₑ ^ 2 := by
  have hpt : ∀ x : Euclidean 2, ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ≤
      restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f x := by
    intro x
    rcases dvT_eq_of_disjoint phi j R hdisj (f : Euclidean 2 → ℂ) x with h | ⟨r, hr, h⟩
    · rw [h]; simp
    · rw [h, ← ofReal_norm]
      exact enorm_dvOp_le_maximal phi f j (by simpa using hr) (hR r hr).1 x
  have hmeas : Measurable
      fun x : Euclidean 2 => ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ^ 2 :=
    ((measurable_dvT phi j R hS f.integrable).enorm).pow_const 2
  calc (∫⁻ x, ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ^ 2 ∂dvNu)
      = ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
          radialPowerWeight 2 (-1) x *
            ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ^ 2 := dvNu_lintegral _ hmeas
    _ ≤ ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
          radialPowerWeight 2 (-1) x *
            (restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f x) ^ 2 := by
        refine lintegral_mono fun x => ?_
        exact mul_le_mul' le_rfl (pow_le_pow_left' (hpt x) 2)
    _ ≤ L * ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(f : Euclidean 2 → ℂ) x‖) ^ 2 := hcore
    _ = L * ∫⁻ x : Euclidean 2, ‖(f : Euclidean 2 → ℂ) x‖ₑ ^ 2 := by
        congr 1
        refine lintegral_congr fun x => ?_
        rw [ofReal_norm]

/-- The `L²` endpoint bound extends from Schwartz data to every `L²`-integrable
input, by density and Fatou. -/
theorem dvT_l2_general (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    {S : ℝ → Set (Euclidean 2)} (hS : ∀ r ∈ R, MeasurableSet (S r))
    (hdisj : ∀ r ∈ R, ∀ r' ∈ R, r ≠ r' → Disjoint (S r) (S r'))
    (L : ℝ≥0∞) (hLtop : L ≠ ⊤)
    (hschwartz : ∀ f : SchwartzMap (Euclidean 2) ℂ,
      (∫⁻ x, ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ^ 2 ∂dvNu) ≤
        L * ∫⁻ x : Euclidean 2, ‖(f : Euclidean 2 → ℂ) x‖ₑ ^ 2)
    {u : Euclidean 2 → ℂ} (hu : Integrable u volume) (hmu : Measurable u)
    (hu2 : MemLp u 2 volume) :
    (∫⁻ x, ‖dvT phi j R S u x‖ₑ ^ 2 ∂dvNu) ≤
      L * ∫⁻ x : Euclidean 2, ‖u x‖ₑ ^ 2 := by
  classical
  obtain ⟨K, hK0, hK⟩ := exists_dvKerS_l2_bound phi j R
  set A : ℝ≥0∞ := eLpNorm u 2 volume with hA
  have hex : ∀ n : ℕ, ∃ f : SchwartzMap (Euclidean 2) ℂ,
      eLpNorm (u - (f : Euclidean 2 → ℂ)) 2 volume ≤
        ENNReal.ofReal (1 / ((n : ℝ) + 1)) := by
    intro n
    obtain ⟨g, hg1, hg2, hg3⟩ := hu2.exist_eLpNorm_sub_le (p := 2) (by simp) (by norm_num)
      (ε := 1 / ((n : ℝ) + 1)) (by positivity)
    refine ⟨hg1.toSchwartzMap hg2, ?_⟩
    have hco : ((hg1.toSchwartzMap hg2 : SchwartzMap (Euclidean 2) ℂ) :
        Euclidean 2 → ℂ) = g := rfl
    rw [hco]
    simpa using hg3
  choose F hF using hex
  have hsm : (0 : ℝ) < surfaceMass 2 := surfaceMass_pos (by norm_num)
  -- pointwise convergence of the linearized operators
  have hconv : ∀ x : Euclidean 2, Filter.Tendsto
      (fun n : ℕ => dvT phi j R S (F n : Euclidean 2 → ℂ) x) Filter.atTop
      (nhds (dvT phi j R S u x)) := by
    intro x
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (g := fun n : ℕ => surfaceMass 2 * (K * (1 / ((n : ℝ) + 1))))
      (fun n => norm_nonneg _) (fun n => ?_) ?_
    · have h := dvT_sub_bound phi j R hdisj hu (F n).integrable hmu
        (F n).continuous.measurable hK0 hK
        (δ := 1 / ((n : ℝ) + 1)) (by positivity) (hF n) x
      rw [norm_sub_rev]
      exact h
    · have h1 : Filter.Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) Filter.atTop (nhds 0) :=
        tendsto_one_div_add_atTop_nhds_zero_nat
      have := h1.const_mul (surfaceMass 2 * K)
      simpa using this.congr (fun n => by ring)
  -- Fatou
  have hmeasF : ∀ n : ℕ, Measurable
      fun x : Euclidean 2 => ‖dvT phi j R S (F n : Euclidean 2 → ℂ) x‖ₑ ^ 2 :=
    fun n => ((measurable_dvT phi j R hS (F n).integrable).enorm).pow_const 2
  have hlim : ∀ x : Euclidean 2,
      Filter.liminf (fun n : ℕ => ‖dvT phi j R S (F n : Euclidean 2 → ℂ) x‖ₑ ^ 2)
        Filter.atTop = ‖dvT phi j R S u x‖ₑ ^ 2 := by
    intro x
    refine Filter.Tendsto.liminf_eq ?_
    exact ENNReal.Tendsto.pow (((continuous_enorm).continuousAt).tendsto.comp (hconv x))
  have hfatou : (∫⁻ x, ‖dvT phi j R S u x‖ₑ ^ 2 ∂dvNu) ≤
      Filter.liminf (fun n : ℕ =>
        ∫⁻ x, ‖dvT phi j R S (F n : Euclidean 2 → ℂ) x‖ₑ ^ 2 ∂dvNu) Filter.atTop := by
    have hrw : (∫⁻ x, ‖dvT phi j R S u x‖ₑ ^ 2 ∂dvNu) =
        ∫⁻ x, Filter.liminf
          (fun n : ℕ => ‖dvT phi j R S (F n : Euclidean 2 → ℂ) x‖ₑ ^ 2)
          Filter.atTop ∂dvNu := by
      refine lintegral_congr fun x => ?_
      rw [hlim x]
    rw [hrw]
    exact lintegral_liminf_le hmeasF
  refine le_trans hfatou ?_
  -- the right-hand sides converge
  have hFbound : ∀ n : ℕ,
      (∫⁻ x, ‖dvT phi j R S (F n : Euclidean 2 → ℂ) x‖ₑ ^ 2 ∂dvNu) ≤
        L * (A + ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ 2 := by
    intro n
    refine le_trans (hschwartz (F n)) ?_
    rw [dvL2sq]
    refine mul_le_mul' le_rfl (pow_le_pow_left' ?_ 2)
    have htri : eLpNorm (F n : Euclidean 2 → ℂ) 2 volume ≤
        eLpNorm u 2 volume + eLpNorm ((F n : Euclidean 2 → ℂ) - u) 2 volume := by
      have h0 : eLpNorm (u + ((F n : Euclidean 2 → ℂ) - u)) 2 volume ≤
          eLpNorm u 2 volume + eLpNorm ((F n : Euclidean 2 → ℂ) - u) 2 volume :=
        eLpNorm_add_le (p := 2) (μ := volume) hmu.aestronglyMeasurable
          (((F n).continuous.measurable.sub hmu).aestronglyMeasurable) (by norm_num)
      have h1 : (u + ((F n : Euclidean 2 → ℂ) - u)) = (F n : Euclidean 2 → ℂ) := by
        funext y; simp
      rwa [h1] at h0
    have hneg : eLpNorm ((F n : Euclidean 2 → ℂ) - u) 2 volume =
        eLpNorm (u - (F n : Euclidean 2 → ℂ)) 2 volume := by
      rw [← eLpNorm_neg]
      congr 1
      funext y
      simp
    rw [hneg] at htri
    exact le_trans htri (add_le_add le_rfl (hF n))
  have hAtop : A ≠ ⊤ := hu2.eLpNorm_ne_top
  have hd : Filter.Tendsto (fun n : ℕ => ENNReal.ofReal (1 / ((n : ℝ) + 1)))
      Filter.atTop (nhds 0) := by
    have h1 : Filter.Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) Filter.atTop (nhds 0) :=
      tendsto_one_div_add_atTop_nhds_zero_nat
    simpa using ENNReal.tendsto_ofReal h1
  have hrhs : Filter.Tendsto
      (fun n : ℕ => L * (A + ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ 2)
      Filter.atTop (nhds (L * A ^ 2)) := by
    have h2 : Filter.Tendsto (fun n : ℕ => A + ENNReal.ofReal (1 / ((n : ℝ) + 1)))
        Filter.atTop (nhds A) := by
      simpa using tendsto_const_nhds.add hd
    exact ENNReal.Tendsto.const_mul (ENNReal.Tendsto.pow h2) (Or.inr hLtop)
  have hliminf : Filter.liminf (fun n : ℕ =>
      ∫⁻ x, ‖dvT phi j R S (F n : Euclidean 2 → ℂ) x‖ₑ ^ 2 ∂dvNu) Filter.atTop ≤
      L * A ^ 2 := by
    rw [← hrhs.liminf_eq]
    exact Filter.liminf_le_liminf (Filter.Eventually.of_forall hFbound)
  rw [dvL2sq u]
  exact hliminf

/-- Riesz--Thorin interpolation for the linearized band operator. -/
theorem dvT_lp_simple (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    {S : ℝ → Set (Euclidean 2)} (hS : ∀ r ∈ R, MeasurableSet (S r))
    {p : ℝ} (hp : 2 < p) {M₀ M₁ : ℝ} (hM₀ : 0 < M₀) (hM₁ : 0 < M₁)
    (h0 : ∀ u : SimpleFunc (Euclidean 2) ℂ, Integrable (u : Euclidean 2 → ℂ) volume →
      eLpNorm (dvT phi j R S (u : Euclidean 2 → ℂ)) 2 dvNu ≤
        ENNReal.ofReal M₀ * eLpNorm (u : Euclidean 2 → ℂ) 2 volume)
    (h1 : ∀ u : SimpleFunc (Euclidean 2) ℂ, Integrable (u : Euclidean 2 → ℂ) volume →
      eLpNorm (dvT phi j R S (u : Euclidean 2 → ℂ)) ⊤ dvNu ≤
        ENNReal.ofReal M₁ * eLpNorm (u : Euclidean 2 → ℂ) ⊤ volume) :
    ∀ u : SimpleFunc (Euclidean 2) ℂ, Integrable (u : Euclidean 2 → ℂ) volume →
      eLpNorm (dvT phi j R S (u : Euclidean 2 → ℂ)) (ENNReal.ofReal p) dvNu ≤
        ENNReal.ofReal (Real.rpow M₀ (1 - (1 - 2 / p)) * Real.rpow M₁ (1 - 2 / p)) *
          eLpNorm (u : Euclidean 2 → ℂ) (ENNReal.ofReal p) volume := by
  have hp0 : (0 : ℝ) < p := by linarith
  set θ : ℝ := 1 - 2 / p with hθdef
  have hθ0 : 0 < θ := by
    rw [hθdef]
    have : 2 / p < 1 := by
      rw [div_lt_one hp0]; linarith
    linarith
  have hθ1 : θ < 1 := by
    rw [hθdef]
    have : 0 < 2 / p := by positivity
    linarith
  have hkey : (ENNReal.ofReal p)⁻¹ =
      ENNReal.ofReal (1 - θ) * (2 : ℝ≥0∞)⁻¹ + ENNReal.ofReal θ * (⊤ : ℝ≥0∞)⁻¹ := by
    rw [ENNReal.inv_top, mul_zero, add_zero]
    have h1θ : (1 : ℝ) - θ = 2 / p := by rw [hθdef]; ring
    rw [h1θ]
    have h2 : (2 : ℝ≥0∞)⁻¹ = ENNReal.ofReal (1 / 2) := by
      rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp,
        ← ENNReal.ofReal_inv_of_pos (by norm_num)]
      norm_num
    rw [h2, ← ENNReal.ofReal_mul (by positivity)]
    rw [← ENNReal.ofReal_inv_of_pos hp0]
    congr 1
    field_simp
  have hres := Codex.riesz_thorin
    (T := fun (u : SimpleFunc (Euclidean 2) ℂ) => dvT phi j R S (u : Euclidean 2 → ℂ))
    (μ := (volume : Measure (Euclidean 2))) (ν := dvNu)
    (p₀ := 2) (p₁ := ⊤) (p := ENNReal.ofReal p)
    (q₀ := 2) (q₁ := ⊤) (q := ENNReal.ofReal p) (θ := θ) (M₀ := M₀) (M₁ := M₁)
    (by norm_num) le_top (by norm_num) le_top ⟨hθ0, hθ1⟩ hkey hkey
    (fun f g hf hg => by
      have hco : ((f + g : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) =
          (f : Euclidean 2 → ℂ) + (g : Euclidean 2 → ℂ) := by
        funext y; simp
      rw [hco, dvT_add phi j R S hf hg])
    (fun c f hf => by
      have hco : ((c • f : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) =
          c • (f : Euclidean 2 → ℂ) := by
        funext y; simp
      rw [hco, dvT_smul phi j R S c (f : Euclidean 2 → ℂ)])
    (fun f hf => measurable_dvT phi j R hS hf)
    hM₀ hM₁ h0 h1
  intro u hu
  exact (hres u hu).2
/-! ### Phase E: the finite-radius weighted `L^p` estimate -/

theorem dvLpPow (g : Euclidean 2 → ℂ) (ν : Measure (Euclidean 2)) {p : ℝ} (hp : 0 < p) :
    (∫⁻ x, ‖g x‖ₑ ^ p ∂ν) = (eLpNorm g (ENNReal.ofReal p) ν) ^ p := by
  have hne : ENNReal.ofReal p ≠ 0 := by
    simp [ENNReal.ofReal_eq_zero]
    linarith
  have htop : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have htoReal : (ENNReal.ofReal p).toReal = p := ENNReal.toReal_ofReal hp.le
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hne htop, htoReal,
    ← ENNReal.rpow_mul]
  rw [one_div, inv_mul_cancel₀ hp.ne', ENNReal.rpow_one]

/-- Turn an `eLpNorm` bound into a bound between the corresponding integrals. -/
theorem dvLp_lintegral_of_eLpNorm {g h : Euclidean 2 → ℂ}
    {μ ν : Measure (Euclidean 2)} {p : ℝ} (hp : 0 < p) {M : ℝ≥0∞}
    (hbd : eLpNorm g (ENNReal.ofReal p) ν ≤ M * eLpNorm h (ENNReal.ofReal p) μ) :
    (∫⁻ x, ‖g x‖ₑ ^ p ∂ν) ≤ M ^ p * ∫⁻ x, ‖h x‖ₑ ^ p ∂μ := by
  rw [dvLpPow g ν hp, dvLpPow h μ hp]
  calc (eLpNorm g (ENNReal.ofReal p) ν) ^ p
      ≤ (M * eLpNorm h (ENNReal.ofReal p) μ) ^ p :=
        ENNReal.rpow_le_rpow hbd hp.le
    _ = M ^ p * (eLpNorm h (ENNReal.ofReal p) μ) ^ p :=
        ENNReal.mul_rpow_of_nonneg _ _ hp.le

/-- The `L^p` bound passes from integrable simple functions to Schwartz data. -/
theorem dvT_lp_schwartz (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    {S : ℝ → Set (Euclidean 2)} (hS : ∀ r ∈ R, MeasurableSet (S r))
    (hdisj : ∀ r ∈ R, ∀ r' ∈ R, r ≠ r' → Disjoint (S r) (S r'))
    {p : ℝ} (hp : 2 < p) {M : ℝ≥0∞} (hMtop : M ≠ ⊤)
    (hsimple : ∀ u : SimpleFunc (Euclidean 2) ℂ, Integrable (u : Euclidean 2 → ℂ) volume →
      (∫⁻ x, ‖dvT phi j R S (u : Euclidean 2 → ℂ) x‖ₑ ^ p ∂dvNu) ≤
        M * ∫⁻ x : Euclidean 2, ‖(u : Euclidean 2 → ℂ) x‖ₑ ^ p)
    (f : SchwartzMap (Euclidean 2) ℂ) :
    (∫⁻ x, ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ^ p ∂dvNu) ≤
      M * ∫⁻ x : Euclidean 2, ‖(f : Euclidean 2 → ℂ) x‖ₑ ^ p := by
  classical
  have hp0 : (0 : ℝ) < p := by linarith
  have hpone : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [show (1 : ℝ≥0∞) = ENNReal.ofReal 1 by simp]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  obtain ⟨K, hK0, hK⟩ := exists_dvKerS_l2_bound phi j R
  have hfmeas : Measurable (f : Euclidean 2 → ℂ) := f.continuous.measurable
  -- the approximating simple functions
  set u : ℕ → SimpleFunc (Euclidean 2) ℂ := fun n =>
    SimpleFunc.approxOn (f : Euclidean 2 → ℂ) hfmeas Set.univ 0 (Set.mem_univ 0) n with hu
  have hint : ∀ n, Integrable ((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) volume := by
    intro n
    rw [← memLp_one_iff_integrable]
    exact SimpleFunc.memLp_approxOn hfmeas (by
      rw [memLp_one_iff_integrable]; exact f.integrable)
      (Set.mem_univ 0) (by
        rw [memLp_one_iff_integrable]
        simpa using (integrable_zero (Euclidean 2) ℂ volume)) n
  have hmu : ∀ n, Measurable ((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) :=
    fun n => (u n).measurable
  -- L² convergence
  have hL2 : Filter.Tendsto
      (fun n => eLpNorm (((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) -
        (f : Euclidean 2 → ℂ)) 2 volume) Filter.atTop (nhds 0) := by
    refine SimpleFunc.tendsto_approxOn_Lp_eLpNorm hfmeas (Set.mem_univ 0) (by simp)
      (Filter.Eventually.of_forall fun x => by simp) ?_
    have := (f.memLp 2 volume).eLpNorm_lt_top
    simpa using this
  -- L^p convergence
  have hLp : Filter.Tendsto
      (fun n => eLpNorm (((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) -
        (f : Euclidean 2 → ℂ)) (ENNReal.ofReal p) volume) Filter.atTop (nhds 0) := by
    refine SimpleFunc.tendsto_approxOn_Lp_eLpNorm hfmeas (Set.mem_univ 0)
      ENNReal.ofReal_ne_top (Filter.Eventually.of_forall fun x => by simp) ?_
    have := (f.memLp (ENNReal.ofReal p) volume).eLpNorm_lt_top
    simpa using this
  -- pointwise convergence of the linearized operators
  set δ : ℕ → ℝ := fun n => (eLpNorm (((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) -
    (f : Euclidean 2 → ℂ)) 2 volume).toReal with hδ
  have hδ0 : ∀ n, 0 ≤ δ n := fun n => ENNReal.toReal_nonneg
  have hmem2 : ∀ n, MemLp ((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) 2 volume :=
    fun n => SimpleFunc.memLp_approxOn hfmeas (f.memLp 2 volume) (Set.mem_univ 0)
      (by
        simpa using memLp_const (0 : ℂ) (p := (2 : ℝ≥0∞))
          (μ := (volume : Measure (Euclidean 2)))) n
  have hδle : ∀ n, eLpNorm (((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) -
      (f : Euclidean 2 → ℂ)) 2 volume ≤ ENNReal.ofReal (δ n) := by
    intro n
    have hfin : eLpNorm (((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) -
        (f : Euclidean 2 → ℂ)) 2 volume ≠ ⊤ :=
      ((hmem2 n).sub (f.memLp 2 volume)).eLpNorm_ne_top
    exact le_of_eq (ENNReal.ofReal_toReal hfin).symm
  have hδlim : Filter.Tendsto δ Filter.atTop (nhds 0) := by
    have := (ENNReal.tendsto_toReal (by simp : (0 : ℝ≥0∞) ≠ ⊤)).comp hL2
    simpa [hδ, Function.comp_def] using this
  have hconv : ∀ x : Euclidean 2, Filter.Tendsto
      (fun n : ℕ => dvT phi j R S ((u n : SimpleFunc (Euclidean 2) ℂ) :
        Euclidean 2 → ℂ) x) Filter.atTop
      (nhds (dvT phi j R S (f : Euclidean 2 → ℂ) x)) := by
    intro x
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (g := fun n : ℕ => surfaceMass 2 * (K * δ n))
      (fun n => norm_nonneg _) (fun n => ?_) ?_
    · exact dvT_sub_bound phi j R hdisj (hint n) f.integrable (hmu n) hfmeas
        hK0 hK (hδ0 n) (hδle n) x
    · have h1 := hδlim.const_mul (surfaceMass 2 * K)
      simpa using h1.congr (fun n => by ring)
  -- Fatou
  have hmeasF : ∀ n : ℕ, Measurable fun x : Euclidean 2 =>
      ‖dvT phi j R S ((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) x‖ₑ ^ p :=
    fun n => (ENNReal.continuous_rpow_const.measurable).comp
      ((measurable_dvT phi j R hS (hint n)).enorm)
  have hfatou : (∫⁻ x, ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ^ p ∂dvNu) ≤
      Filter.liminf (fun n : ℕ => ∫⁻ x, ‖dvT phi j R S
        ((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) x‖ₑ ^ p ∂dvNu)
        Filter.atTop := by
    have hrw : (∫⁻ x, ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ^ p ∂dvNu) =
        ∫⁻ x, Filter.liminf (fun n : ℕ => ‖dvT phi j R S
          ((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) x‖ₑ ^ p)
          Filter.atTop ∂dvNu := by
      refine lintegral_congr fun x => ?_
      refine (Filter.Tendsto.liminf_eq ?_).symm
      exact ((ENNReal.continuous_rpow_const (y := p)).continuousAt.tendsto).comp
        (((continuous_enorm).continuousAt.tendsto).comp (hconv x))
    rw [hrw]
    exact lintegral_liminf_le hmeasF
  refine le_trans hfatou ?_
  -- the right-hand side converges
  set A : ℝ≥0∞ := eLpNorm (f : Euclidean 2 → ℂ) (ENNReal.ofReal p) volume with hA
  set d : ℕ → ℝ≥0∞ := fun n => eLpNorm
    (((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) -
      (f : Euclidean 2 → ℂ)) (ENNReal.ofReal p) volume with hd
  have hbd : ∀ n : ℕ, (∫⁻ x, ‖dvT phi j R S
      ((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) x‖ₑ ^ p ∂dvNu) ≤
      M * (A + d n) ^ p := by
    intro n
    refine le_trans (hsimple (u n) (hint n)) ?_
    refine mul_le_mul' le_rfl ?_
    rw [dvLpPow _ _ hp0]
    refine ENNReal.rpow_le_rpow ?_ hp0.le
    have h0 : eLpNorm ((f : Euclidean 2 → ℂ) +
        (((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) -
          (f : Euclidean 2 → ℂ))) (ENNReal.ofReal p) volume ≤ A + d n :=
      eLpNorm_add_le (p := ENNReal.ofReal p) (μ := volume)
        hfmeas.aestronglyMeasurable
        (((hmu n).sub hfmeas).aestronglyMeasurable) hpone
    have h1 : ((f : Euclidean 2 → ℂ) +
        (((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) -
          (f : Euclidean 2 → ℂ))) =
        ((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) := by
      funext y; simp
    rwa [h1] at h0
  have hAtop : A ≠ ⊤ := (f.memLp (ENNReal.ofReal p) volume).eLpNorm_ne_top
  have hrhs : Filter.Tendsto (fun n : ℕ => M * (A + d n) ^ p) Filter.atTop
      (nhds (M * A ^ p)) := by
    have h2 : Filter.Tendsto (fun n : ℕ => A + d n) Filter.atTop (nhds A) := by
      simpa using tendsto_const_nhds.add hLp
    exact ENNReal.Tendsto.const_mul
      (((ENNReal.continuous_rpow_const (y := p)).continuousAt.tendsto).comp h2) (Or.inr hMtop)
  have hlim : Filter.liminf (fun n : ℕ => ∫⁻ x, ‖dvT phi j R S
      ((u n : SimpleFunc (Euclidean 2) ℂ) : Euclidean 2 → ℂ) x‖ₑ ^ p ∂dvNu)
      Filter.atTop ≤ M * A ^ p := by
    rw [← hrhs.liminf_eq]
    exact Filter.liminf_le_liminf (Filter.Eventually.of_forall hbd)
  rw [dvLpPow _ _ hp0]
  exact hlim

theorem dvL2sqM (g : Euclidean 2 → ℂ) (ν : Measure (Euclidean 2)) :
    (∫⁻ x, ‖g x‖ₑ ^ 2 ∂ν) = (eLpNorm g 2 ν) ^ 2 := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]
  have h1 : (2 : ℝ≥0∞).toReal = 2 := by norm_num
  rw [h1]
  have h2 : (∫⁻ x, ‖g x‖ₑ ^ (2 : ℝ) ∂ν) = ∫⁻ x, ‖g x‖ₑ ^ 2 ∂ν := by
    refine lintegral_congr fun x => ?_
    rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast]
  rw [h2]
  set A : ℝ≥0∞ := ∫⁻ x, ‖g x‖ₑ ^ 2 ∂ν with hA
  rw [← ENNReal.rpow_natCast (A ^ (1 / (2 : ℝ))) 2, ← ENNReal.rpow_mul]
  norm_num

/-- Convert an `L²` lintegral bound into an `eLpNorm` bound. -/
theorem dvEL2_of_lintegral {g h : Euclidean 2 → ℂ} {μ ν : Measure (Euclidean 2)}
    {L : ℝ≥0∞} (hbd : (∫⁻ x, ‖g x‖ₑ ^ 2 ∂ν) ≤ L * ∫⁻ x, ‖h x‖ₑ ^ 2 ∂μ) :
    eLpNorm g 2 ν ≤ L ^ ((2 : ℝ)⁻¹) * eLpNorm h 2 μ := by
  rw [dvL2sqM, dvL2sqM] at hbd
  set a : ℝ≥0∞ := eLpNorm g 2 ν with ha
  set b : ℝ≥0∞ := eLpNorm h 2 μ with hb
  have hstep : a = (a ^ 2) ^ ((2 : ℝ)⁻¹) := by
    rw [← ENNReal.rpow_natCast a 2, ← ENNReal.rpow_mul]
    norm_num
  calc a = (a ^ 2) ^ ((2 : ℝ)⁻¹) := hstep
    _ ≤ (L * b ^ 2) ^ ((2 : ℝ)⁻¹) := ENNReal.rpow_le_rpow hbd (by norm_num)
    _ = L ^ ((2 : ℝ)⁻¹) * (b ^ 2) ^ ((2 : ℝ)⁻¹) :=
        ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)
    _ = L ^ ((2 : ℝ)⁻¹) * b := by
        congr 1
        rw [← ENNReal.rpow_natCast b 2, ← ENNReal.rpow_mul]
        norm_num

set_option maxHeartbeats 1000000 in
/-- **The weighted `L^p` band estimate for a finite radius set.** -/
theorem dvMaximal_finset_lp (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (hR : ∀ r ∈ R, r ∈ Icc (1 : ℝ) 2) (hRne : R.Nonempty)
    {p : ℝ} (hp : 2 < p) {A₀ A₁ : ℝ} (hA₀ : 0 < A₀) (hA₁ : 0 < A₁)
    (hA₁' : surfaceMass 2 * dvPsiL1 phi ≤ A₁)
    (hcore : ∀ g : SchwartzMap (Euclidean 2) ℂ,
      (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
          radialPowerWeight 2 (-1) x *
            (restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j g x) ^ 2) ≤
        ENNReal.ofReal (A₀ ^ 2) * ∫⁻ x : Euclidean 2,
          (ENNReal.ofReal ‖(g : Euclidean 2 → ℂ) x‖) ^ 2)
    (f : SchwartzMap (Euclidean 2) ℂ) :
    (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
        radialPowerWeight 2 (-1) x *
          (restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f x) ^ p) ≤
      ENNReal.ofReal (A₀ ^ 2 * A₁ ^ (p - 2)) *
        ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(f : Euclidean 2 → ℂ) x‖) ^ p := by
  classical
  have hp0 : (0 : ℝ) < p := by linarith
  set S : ℝ → Set (Euclidean 2) := dvSel phi j R f with hSdef
  have hSmeas : ∀ r ∈ R, MeasurableSet (S r) :=
    fun r _ => measurableSet_dvSel phi j R f r
  have hdisj : ∀ r ∈ R, ∀ r' ∈ R, r ≠ r' → Disjoint (S r) (S r') :=
    dvSel_disjoint phi j R f
  -- the two endpoints on integrable simple functions
  have h0 : ∀ u : SimpleFunc (Euclidean 2) ℂ, Integrable (u : Euclidean 2 → ℂ) volume →
      eLpNorm (dvT phi j R S (u : Euclidean 2 → ℂ)) 2 dvNu ≤
        ENNReal.ofReal A₀ * eLpNorm (u : Euclidean 2 → ℂ) 2 volume := by
    intro u hu
    have hlin : (∫⁻ x, ‖dvT phi j R S (u : Euclidean 2 → ℂ) x‖ₑ ^ 2 ∂dvNu) ≤
        ENNReal.ofReal (A₀ ^ 2) * ∫⁻ x : Euclidean 2, ‖(u : Euclidean 2 → ℂ) x‖ₑ ^ 2 := by
      refine dvT_l2_general phi j R hSmeas hdisj _ ENNReal.ofReal_ne_top ?_ hu
        u.measurable ((SimpleFunc.memLp_iff_integrable (by simp) (by simp)).mpr hu)
      intro g
      exact dvT_l2_schwartz phi j R hR hSmeas hdisj _ g (hcore g)
    have hres := dvEL2_of_lintegral hlin
    have hcast : (ENNReal.ofReal (A₀ ^ 2)) ^ ((2 : ℝ)⁻¹) = ENNReal.ofReal A₀ := by
      rw [ENNReal.ofReal_rpow_of_pos (by positivity)]
      congr 1
      rw [show (A₀ ^ 2 : ℝ) = A₀ ^ (2 : ℝ) by rw [← Real.rpow_natCast A₀ 2]; norm_num,
        ← Real.rpow_mul hA₀.le]
      norm_num
    rwa [hcast] at hres
  have h1 : ∀ u : SimpleFunc (Euclidean 2) ℂ, Integrable (u : Euclidean 2 → ℂ) volume →
      eLpNorm (dvT phi j R S (u : Euclidean 2 → ℂ)) ⊤ dvNu ≤
        ENNReal.ofReal A₁ * eLpNorm (u : Euclidean 2 → ℂ) ⊤ volume := by
    intro u _
    exact dvT_eLpNorm_top phi j R hdisj dvNu hA₁ hA₁' _
  -- Riesz--Thorin, in lintegral form
  have hM : ENNReal.ofReal (A₀ ^ 2 * A₁ ^ (p - 2)) =
      (ENNReal.ofReal (Real.rpow A₀ (1 - (1 - 2 / p)) *
        Real.rpow A₁ (1 - 2 / p))) ^ p := by
    have e1 : Real.rpow A₀ (1 - (1 - 2 / p)) = A₀ ^ (1 - (1 - 2 / p)) := rfl
    have e2 : Real.rpow A₁ (1 - 2 / p) = A₁ ^ (1 - 2 / p) := rfl
    rw [e1, e2]
    have hp1 : (0 : ℝ) < A₀ ^ (1 - (1 - 2 / p)) := Real.rpow_pos_of_pos hA₀ _
    have hp2 : (0 : ℝ) < A₁ ^ (1 - 2 / p) := Real.rpow_pos_of_pos hA₁ _
    rw [ENNReal.ofReal_rpow_of_pos (mul_pos hp1 hp2)]
    congr 1
    rw [Real.mul_rpow hp1.le hp2.le, ← Real.rpow_mul hA₀.le, ← Real.rpow_mul hA₁.le]
    have h1 : (1 - (1 - 2 / p)) * p = 2 := by
      have e : (1 : ℝ) - (1 - 2 / p) = 2 / p := by ring
      rw [e, div_mul_cancel₀ _ hp0.ne']
    have h2 : (1 - 2 / p) * p = p - 2 := by
      have e : (1 : ℝ) - 2 / p = (p - 2) / p := by
        field_simp
      rw [e, div_mul_cancel₀ _ hp0.ne']
    rw [h1, h2, show (A₀ ^ 2 : ℝ) = A₀ ^ (2 : ℝ) by
      rw [← Real.rpow_natCast A₀ 2]; norm_num]
  have hsimple : ∀ u : SimpleFunc (Euclidean 2) ℂ,
      Integrable (u : Euclidean 2 → ℂ) volume →
      (∫⁻ x, ‖dvT phi j R S (u : Euclidean 2 → ℂ) x‖ₑ ^ p ∂dvNu) ≤
        ENNReal.ofReal (A₀ ^ 2 * A₁ ^ (p - 2)) *
          ∫⁻ x : Euclidean 2, ‖(u : Euclidean 2 → ℂ) x‖ₑ ^ p := by
    intro u hu
    have hrt := dvT_lp_simple phi j R hSmeas hp hA₀ hA₁ h0 h1 u hu
    have := dvLp_lintegral_of_eLpNorm hp0 hrt
    rwa [← hM] at this
  -- pass to Schwartz data
  have hschw := dvT_lp_schwartz phi j R hSmeas hdisj hp
    (M := ENNReal.ofReal (A₀ ^ 2 * A₁ ^ (p - 2))) ENNReal.ofReal_ne_top hsimple f
  -- the maximal function is realized by the linearized operator
  have hmax : ∀ x : Euclidean 2,
      restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f x ≤
        ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ := by
    intro x
    unfold restrictedRelativeBandpassSphericalMaximal
    refine iSup_le fun s => ?_
    have hs1 : s.1 ∈ R := by simpa using s.2.1
    have hs2 : (1 : ℝ) ≤ s.1 := (hR s.1 hs1).1
    rw [← dvOp_schwartz phi f j hs2 x, ← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (dvT_dvSel_eq phi j R hRne f x s.1 hs1)
  have hmeasT : Measurable fun x : Euclidean 2 =>
      ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ^ p :=
    (ENNReal.continuous_rpow_const (y := p)).measurable.comp
      ((measurable_dvT phi j R hSmeas f.integrable).enorm)
  calc (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
        radialPowerWeight 2 (-1) x *
          (restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f x) ^ p)
      ≤ ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
          radialPowerWeight 2 (-1) x *
            ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ^ p := by
        refine lintegral_mono fun x => ?_
        exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (hmax x) hp0.le)
    _ = ∫⁻ x, ‖dvT phi j R S (f : Euclidean 2 → ℂ) x‖ₑ ^ p ∂dvNu :=
        (dvNu_lintegral _ hmeasT).symm
    _ ≤ ENNReal.ofReal (A₀ ^ 2 * A₁ ^ (p - 2)) *
          ∫⁻ x : Euclidean 2, ‖(f : Euclidean 2 → ℂ) x‖ₑ ^ p := hschw
    _ = ENNReal.ofReal (A₀ ^ 2 * A₁ ^ (p - 2)) *
          ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(f : Euclidean 2 → ℂ) x‖) ^ p := by
        congr 1
        refine lintegral_congr fun x => ?_
        rw [ofReal_norm]
/-! ### Phase E: reduction to finite radius sets -/

/-- The restricted maximal function over a finite radius set is realized by the
linearized operator with the tie-broken selection sets. -/
theorem dvMaximal_le_enorm_dvT (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (hR : ∀ r ∈ R, r ∈ Icc (1 : ℝ) 2) (hRne : R.Nonempty)
    (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2) :
    restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f x ≤
      ‖dvT phi j R (dvSel phi j R f) (f : Euclidean 2 → ℂ) x‖ₑ := by
  unfold restrictedRelativeBandpassSphericalMaximal
  refine iSup_le fun s => ?_
  have hs1 : s.1 ∈ R := by simpa using s.2.1
  have hs2 : (1 : ℝ) ≤ s.1 := (hR s.1 hs1).1
  rw [← dvOp_schwartz phi f j hs2 x, ← ofReal_norm]
  exact ENNReal.ofReal_le_ofReal (dvT_dvSel_eq phi j R hRne f x s.1 hs1)

theorem dvMaximal_finset_ne_top (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (R : Finset ℝ)
    (hR : ∀ r ∈ R, r ∈ Icc (1 : ℝ) 2) (hRne : R.Nonempty)
    (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2) :
    restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f x ≠ ⊤ := by
  refine ne_top_of_le_ne_top ?_ (dvMaximal_le_enorm_dvT phi j R hR hRne f x)
  simp [enorm_eq_nnnorm]

open Codex.Spherical.PowerWeights.RelativeMovingOperator in
theorem measurable_dvMaximal_finset (phi : SchwartzMap (Euclidean 2) ℂ)
    (hphi_one : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1) (j : ℕ) (R : Finset ℝ)
    (hR : ∀ r ∈ R, r ∈ Icc (1 : ℝ) 2) (hRne : R.Nonempty)
    (f : SchwartzMap (Euclidean 2) ℂ) :
    Measurable (restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f) := by
  have hE : (R : Set ℝ) ⊆ Icc (1 : ℝ) 2 := by
    intro r hr
    exact hR r (by simpa using hr)
  have hEne : (R : Set ℝ).Nonempty := by
    obtain ⟨r, hr⟩ := hRne
    exact ⟨r, by simpa using hr⟩
  have htoReal : Measurable fun x : Euclidean 2 =>
      (restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f x).toReal :=
    measurable_toReal_restrictedRelativeBandpassSphericalMaximal
      (d := 1) phi f hphi_one hphi_zero hphi_norm j (R : Set ℝ) hE hEne
  have heq : restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f =
      fun x => ENNReal.ofReal
        (restrictedRelativeBandpassSphericalMaximal 2 (R : Set ℝ) phi j f x).toReal := by
    funext x
    exact (ENNReal.ofReal_toReal (dvMaximal_finset_ne_top phi j R hR hRne f x)).symm
  rw [heq]
  exact htoReal.ennreal_ofReal

/-- The `n`-th dyadic radius set in `[1,2]`. -/
def dvR (n : ℕ) : Finset ℝ :=
  (Finset.range (2 ^ n + 1)).image (fun i : ℕ => 1 + (i : ℝ) / 2 ^ n)

theorem dvR_subset (n : ℕ) : ∀ r ∈ dvR n, r ∈ Icc (1 : ℝ) 2 := by
  intro r hr
  rw [dvR, Finset.mem_image] at hr
  obtain ⟨i, hi, rfl⟩ := hr
  rw [Finset.mem_range] at hi
  have hile : (i : ℝ) ≤ 2 ^ n := by
    have : i ≤ 2 ^ n := by omega
    exact_mod_cast this
  have hpow : (0 : ℝ) < 2 ^ n := by positivity
  constructor
  · have : (0 : ℝ) ≤ (i : ℝ) / 2 ^ n := by positivity
    linarith
  · have : (i : ℝ) / 2 ^ n ≤ 1 := by
      rw [div_le_one hpow]
      exact hile
    linarith

theorem dvR_nonempty (n : ℕ) : (dvR n).Nonempty := by
  refine ⟨1 + (0 : ℝ) / 2 ^ n, ?_⟩
  rw [dvR, Finset.mem_image]
  exact ⟨0, by simp, by norm_num⟩

theorem dvR_mono (n : ℕ) : dvR n ⊆ dvR (n + 1) := by
  intro r hr
  rw [dvR, Finset.mem_image] at hr
  obtain ⟨i, hi, rfl⟩ := hr
  rw [Finset.mem_range] at hi
  rw [dvR, Finset.mem_image]
  refine ⟨2 * i, ?_, ?_⟩
  · rw [Finset.mem_range]
    have : i ≤ 2 ^ n := by omega
    have h2 : 2 * i ≤ 2 * 2 ^ n := by omega
    calc 2 * i ≤ 2 * 2 ^ n := h2
      _ < 2 ^ (n + 1) + 1 := by
          rw [pow_succ]
          omega
  · have hpow : (0 : ℝ) < 2 ^ n := by positivity
    push_cast
    rw [pow_succ]
    field_simp

/-- The dyadic approximation of a radius in `[1,2]`. -/
def dvApprox (r : ℝ) (n : ℕ) : ℝ := 1 + (⌊(r - 1) * 2 ^ n⌋₊ : ℝ) / 2 ^ n

theorem dvApprox_mem {r : ℝ} (hr : r ∈ Icc (1 : ℝ) 2) (n : ℕ) : dvApprox r n ∈ dvR n := by
  rw [dvR, Finset.mem_image]
  refine ⟨⌊(r - 1) * 2 ^ n⌋₊, ?_, rfl⟩
  rw [Finset.mem_range]
  have hle : (r - 1) * 2 ^ n ≤ 2 ^ n := by
    have h1 : r - 1 ≤ 1 := by
      have := hr.2; linarith
    have hpow : (0 : ℝ) < 2 ^ n := by positivity
    nlinarith
  have hfl : ⌊(r - 1) * 2 ^ n⌋₊ ≤ 2 ^ n := by
    have h : ⌊(r - 1) * 2 ^ n⌋₊ ≤ ⌊((2:ℝ) ^ n)⌋₊ := Nat.floor_le_floor hle
    have h2 : ⌊((2:ℝ) ^ n)⌋₊ = 2 ^ n := by
      rw [show ((2:ℝ) ^ n) = ((2 ^ n : ℕ) : ℝ) by push_cast; ring, Nat.floor_natCast]
    omega
  omega

theorem dvApprox_le {r : ℝ} (hr : r ∈ Icc (1 : ℝ) 2) (n : ℕ) :
    |r - dvApprox r n| ≤ 1 / 2 ^ n := by
  have hpow : (0 : ℝ) < 2 ^ n := by positivity
  have hnn : 0 ≤ (r - 1) * 2 ^ n := by
    have := hr.1
    nlinarith
  have h1 : (⌊(r - 1) * 2 ^ n⌋₊ : ℝ) ≤ (r - 1) * 2 ^ n := Nat.floor_le hnn
  have h2 : (r - 1) * 2 ^ n < (⌊(r - 1) * 2 ^ n⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one _
  rw [dvApprox, abs_le]
  constructor
  · rw [le_sub_iff_add_le]
    have : (⌊(r - 1) * 2 ^ n⌋₊ : ℝ) / 2 ^ n ≤ r - 1 := by
      rw [div_le_iff₀ hpow]
      exact h1
    have hinv : (0 : ℝ) < 1 / 2 ^ n := by positivity
    linarith
  · have : r - 1 < (⌊(r - 1) * 2 ^ n⌋₊ : ℝ) / 2 ^ n + 1 / 2 ^ n := by
      rw [← add_div, lt_div_iff₀ hpow]
      exact h2
    linarith

theorem tendsto_dvApprox {r : ℝ} (hr : r ∈ Icc (1 : ℝ) 2) :
    Filter.Tendsto (fun n : ℕ => dvApprox r n) Filter.atTop (nhds r) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero (g := fun n : ℕ => 1 / (2 : ℝ) ^ n) (fun n => norm_nonneg _)
    (fun n => ?_) ?_
  · rw [Real.norm_eq_abs, abs_sub_comm]
    simpa using dvApprox_le hr n
  · simpa using tendsto_pow_atTop_nhds_zero_of_lt_one
      (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num : (1:ℝ)/2 < 1)

/-- Continuity in the radius of the (uncut) relative band slice, given the
jointly continuous cut-off version. -/
theorem continuousAt_dvSlice_aux {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ)
    (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2) {r : ℝ} (hr : 1 / 4 < r)
    (FF : ℝ → Euclidean 2 → ℂ)
    (hFF : ∀ (t : ℝ) (y : Euclidean 2), FF t y =
      𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-t • ξ) *
        (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) -
          phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) *
        dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) y)
    (hFc : Continuous (Function.uncurry FF)) :
    ContinuousAt (fun s : ℝ => 𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-s • ξ) *
      (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (s • ξ)) -
        phi ((((2 : ℝ) ^ j)⁻¹) • (s • ξ))) *
      𝓕 (f : Euclidean 2 → ℂ) ξ) x) r := by
  have hFcx : Continuous fun s : ℝ => FF s x :=
    hFc.comp (Continuous.prodMk continuous_id continuous_const)
  have heq : ∀ s : ℝ, 1 / 4 ≤ s →
      𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-s • ξ) *
        (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (s • ξ)) -
          phi ((((2 : ℝ) ^ j)⁻¹) • (s • ξ))) *
        𝓕 (f : Euclidean 2 → ℂ) ξ) x = FF s x := by
    intro s hs
    have hspos : (0 : ℝ) < s := lt_of_lt_of_le (by norm_num) hs
    have hint : (fun ξ : Euclidean 2 => surfaceFourier 2 (-s • ξ) *
        (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (s • ξ)) -
          phi ((((2 : ℝ) ^ j)⁻¹) • (s • ξ))) * 𝓕 (f : Euclidean 2 → ℂ) ξ) =
        fun ξ : Euclidean 2 => surfaceFourier 2 (-s • ξ) *
          (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (s • ξ)) -
            phi ((((2 : ℝ) ^ j)⁻¹) • (s • ξ))) * dvFreqCut phi j ξ *
          𝓕 (f : Euclidean 2 → ℂ) ξ := by
      funext ξ
      rw [dvSig_eq_multiplier hrad j hspos ξ, dvSig_mul_dvFreqCut hone hzero j hs ξ]
    rw [hint, hFF s x]
  have hev : (fun s : ℝ => 𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-s • ξ) *
      (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (s • ξ)) -
        phi ((((2 : ℝ) ^ j)⁻¹) • (s • ξ))) *
      𝓕 (f : Euclidean 2 → ℂ) ξ) x) =ᶠ[nhds r] fun s : ℝ => FF s x := by
    filter_upwards [Ioi_mem_nhds hr] with s hs
    exact heq s (le_of_lt hs)
  exact (hFcx.continuousAt).congr hev.symm

/-- Continuity in the radius of the relative band slice. -/
theorem continuousAt_dvSlice {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ)
    (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2) {r : ℝ} (hr : 1 / 4 < r) :
    ContinuousAt (fun s : ℝ => 𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-s • ξ) *
      (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (s • ξ)) -
        phi ((((2 : ℝ) ^ j)⁻¹) • (s • ξ))) *
      𝓕 (f : Euclidean 2 → ℂ) ξ) x) r := by
  set FF : ℝ → Euclidean 2 → ℂ := fun t y =>
    𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-t • ξ) *
      (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) - phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) *
      dvFreqCut phi j ξ * 𝓕 (f : Euclidean 2 → ℂ) ξ) y with hFFdef
  have hrepo :=
    Codex.Spherical.SphericalMaximalL2.continuous_and_hasDerivAt_fourierInv_relative_dyadic_bandpass
      phi (dvFreqCut phi j) f (hasCompactSupport_dvFreqCut hzero j) j
  exact continuousAt_dvSlice_aux hone hzero hrad j f x hr FF (fun t y => rfl) hrepo.1

/-- The maximal function over `[1,2]` is the increasing limit of its dyadic
finite-radius truncations. -/
theorem dvMaximal_Icc_le_iSup {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ)
    (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2) :
    restrictedRelativeBandpassSphericalMaximal 2 (Icc (1 : ℝ) 2) phi j f x ≤
      ⨆ n : ℕ, restrictedRelativeBandpassSphericalMaximal 2
        ((dvR n : Finset ℝ) : Set ℝ) phi j f x := by
  unfold restrictedRelativeBandpassSphericalMaximal
  refine iSup_le fun s => ?_
  set r : ℝ := s.1 with hrdef
  have hrmem : r ∈ Icc (1 : ℝ) 2 := s.2.1
  have hr4 : 1 / 4 < r := lt_of_lt_of_le (by norm_num) hrmem.1
  set G : ℝ → ℂ := fun t => 𝓕⁻ (fun ξ : Euclidean 2 => surfaceFourier 2 (-t • ξ) *
    (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) -
      phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) *
    𝓕 (f : Euclidean 2 → ℂ) ξ) x with hGdef
  have hcont : ContinuousAt G r := continuousAt_dvSlice hone hzero hrad j f x hr4
  have hlim : Filter.Tendsto (fun n : ℕ => ENNReal.ofReal ‖G (dvApprox r n)‖)
      Filter.atTop (nhds (ENNReal.ofReal ‖G r‖)) := by
    refine ENNReal.tendsto_ofReal ?_
    exact (continuous_norm.continuousAt.tendsto).comp
      (hcont.tendsto.comp (tendsto_dvApprox hrmem))
  have hbd : ∀ n : ℕ, ENNReal.ofReal ‖G (dvApprox r n)‖ ≤
      ⨆ m : ℕ, restrictedRelativeBandpassSphericalMaximal 2
        ((dvR m : Finset ℝ) : Set ℝ) phi j f x := by
    intro n
    refine le_trans ?_ (le_iSup (fun m : ℕ =>
      restrictedRelativeBandpassSphericalMaximal 2
        ((dvR m : Finset ℝ) : Set ℝ) phi j f x) n)
    have hmem : dvApprox r n ∈ ((dvR n : Finset ℝ) : Set ℝ) := by
      simpa using dvApprox_mem hrmem n
    have hpos : (0 : ℝ) < dvApprox r n :=
      lt_of_lt_of_le zero_lt_one (dvR_subset n _ (by simpa using hmem)).1
    unfold restrictedRelativeBandpassSphericalMaximal
    exact le_iSup_of_le
      (⟨dvApprox r n, hmem, hpos⟩ : ↥(((dvR n : Finset ℝ) : Set ℝ) ∩ Ioi (0 : ℝ))) le_rfl
  exact le_of_tendsto hlim (Filter.Eventually.of_forall hbd)

theorem dvMaximal_mono {E F : Set ℝ} (hEF : E ⊆ F) (phi : SchwartzMap (Euclidean 2) ℂ)
    (j : ℕ) (f : SchwartzMap (Euclidean 2) ℂ) (x : Euclidean 2) :
    restrictedRelativeBandpassSphericalMaximal 2 E phi j f x ≤
      restrictedRelativeBandpassSphericalMaximal 2 F phi j f x := by
  unfold restrictedRelativeBandpassSphericalMaximal
  refine iSup_le fun s => ?_
  exact le_iSup_of_le
    (⟨s.1, hEF s.2.1, s.2.2⟩ : ↥(F ∩ Ioi (0 : ℝ))) le_rfl

theorem dvRpow_iSup_of_monotone {a : ℕ → ℝ≥0∞} (hmono : Monotone a) {p : ℝ} (hp : 0 < p) :
    (⨆ n, a n) ^ p = ⨆ n, (a n) ^ p := by
  refine le_antisymm ?_ ?_
  · have htend : Filter.Tendsto a Filter.atTop (nhds (⨆ n, a n)) :=
      tendsto_atTop_iSup hmono
    have h2 : Filter.Tendsto (fun n => (a n) ^ p) Filter.atTop (nhds ((⨆ n, a n) ^ p)) :=
      ((ENNReal.continuous_rpow_const (y := p)).continuousAt.tendsto).comp htend
    exact le_of_tendsto h2
      (Filter.Eventually.of_forall fun n => le_iSup (fun m => (a m) ^ p) n)
  · exact iSup_le fun n => ENNReal.rpow_le_rpow (le_iSup a n) hp.le

set_option maxHeartbeats 1000000 in
/-- **Reduction to finite radius sets.** -/
theorem dvMaximal_set_lp {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1)
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} (hp0 : 0 < p)
    (f : SchwartzMap (Euclidean 2) ℂ) (Y : ℝ≥0∞)
    (hfin : ∀ n : ℕ, (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
        radialPowerWeight 2 (-1) x *
          (restrictedRelativeBandpassSphericalMaximal 2
            ((dvR n : Finset ℝ) : Set ℝ) phi j f x) ^ p) ≤ Y) :
    (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
        radialPowerWeight 2 (-1) x *
          (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ p) ≤ Y := by
  classical
  set a : ℕ → Euclidean 2 → ℝ≥0∞ := fun n x =>
    restrictedRelativeBandpassSphericalMaximal 2 ((dvR n : Finset ℝ) : Set ℝ) phi j f x
    with hadef
  have hamono : ∀ x, Monotone fun n => a n x := by
    intro x
    refine monotone_nat_of_le_succ fun n => ?_
    refine dvMaximal_mono ?_ phi j f x
    intro r hr
    exact (by simpa using dvR_mono n (by simpa using hr) : r ∈ ((dvR (n+1) : Finset ℝ) : Set ℝ))
  have hpt : ∀ x : Euclidean 2,
      radialPowerWeight 2 (-1) x *
        (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ p ≤
        ⨆ n : ℕ, radialPowerWeight 2 (-1) x * (a n x) ^ p := by
    intro x
    have h1 : restrictedRelativeBandpassSphericalMaximal 2 E phi j f x ≤ ⨆ n, a n x :=
      le_trans (dvMaximal_mono hE phi j f x)
        (dvMaximal_Icc_le_iSup hone hzero hrad j f x)
    calc radialPowerWeight 2 (-1) x *
          (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ p
        ≤ radialPowerWeight 2 (-1) x * (⨆ n, a n x) ^ p :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow h1 hp0.le)
      _ = radialPowerWeight 2 (-1) x * ⨆ n, (a n x) ^ p := by
          rw [dvRpow_iSup_of_monotone (hamono x) hp0]
      _ = ⨆ n : ℕ, radialPowerWeight 2 (-1) x * (a n x) ^ p := by
          rw [ENNReal.mul_iSup]
  have hmeas : ∀ n : ℕ, Measurable fun x : Euclidean 2 =>
      radialPowerWeight 2 (-1) x * (a n x) ^ p := by
    intro n
    refine (measurable_radialPowerWeight 2 (-1)).mul ?_
    exact (ENNReal.continuous_rpow_const (y := p)).measurable.comp
      (measurable_dvMaximal_finset phi hone hzero hnorm j (dvR n) (dvR_subset n)
        (dvR_nonempty n) f)
  have hmono2 : Monotone fun n : ℕ => fun x : Euclidean 2 =>
      radialPowerWeight 2 (-1) x * (a n x) ^ p := by
    intro m n hmn x
    exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (hamono x hmn) hp0.le)
  calc (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
        radialPowerWeight 2 (-1) x *
          (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ p)
      ≤ ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
          ⨆ n : ℕ, radialPowerWeight 2 (-1) x * (a n x) ^ p :=
        lintegral_mono hpt
    _ = ⨆ n : ℕ, ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
          radialPowerWeight 2 (-1) x * (a n x) ^ p :=
        lintegral_iSup (fun n => (hmeas n).comp measurable_id) hmono2
    _ ≤ Y := iSup_le hfin
/-! ### Phase E: the small-index case and the final band bound -/

/-- The `L²` size of the physical band profile. -/
def dvPsiL2 (phi : SchwartzMap (Euclidean 2) ℂ) : ℝ :=
  Real.sqrt (∫ y : Euclidean 2,
    ‖(𝓕⁻ (dvPsiS phi) : SchwartzMap (Euclidean 2) ℂ) y‖ ^ 2)

theorem dvPsiL2_nonneg (phi : SchwartzMap (Euclidean 2) ℂ) : 0 ≤ dvPsiL2 phi :=
  Real.sqrt_nonneg _

theorem integral_norm_sq_dvKerS (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (r : ℝ) :
    (∫ y : Euclidean 2, ‖dvKerS phi j r y‖ ^ 2) =
      ((dvA j r)⁻¹) ^ 2 * ∫ y : Euclidean 2,
        ‖(𝓕⁻ (dvPsiS phi) : SchwartzMap (Euclidean 2) ℂ) y‖ ^ 2 := by
  set a : ℝ := dvA j r with ha
  have hapos : 0 < a := dvA_pos j r
  set k : Euclidean 2 → ℝ :=
    fun z => ‖(𝓕⁻ (dvPsiS phi) : SchwartzMap (Euclidean 2) ℂ) z‖ ^ 2 with hk
  have h1 : (fun y : Euclidean 2 => ‖dvKerS phi j r y‖ ^ 2) =
      fun y : Euclidean 2 => ((a⁻¹) ^ 2) ^ 2 * k (a⁻¹ • y) := by
    funext y
    rw [dvKerS_apply, relativeSchwartzMultiplierKernel, norm_smul, hk]
    have hnn : ‖((a⁻¹) ^ 2 : ℝ)‖ = (a⁻¹) ^ 2 := by
      rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    rw [hnn]
    ring
  rw [h1, integral_const_mul, Measure.integral_comp_inv_smul volume k a,
    finrank_euclideanSpace_fin, abs_of_nonneg (by positivity : (0:ℝ) ≤ a ^ 2),
    smul_eq_mul]
  have hfield : ((a⁻¹) ^ 2) ^ 2 * (a ^ 2 * ∫ z : Euclidean 2, k z) =
      (a⁻¹) ^ 2 * ∫ z : Euclidean 2, k z := by
    field_simp
  rw [hfield]

theorem eLpNorm_dvKerS_le (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) {r : ℝ}
    (hr : 1 ≤ r) :
    eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume ≤
      ENNReal.ofReal ((2 : ℝ) ^ j * dvPsiL2 phi) := by
  set a : ℝ := dvA j r with ha
  have hapos : 0 < a := dvA_pos j r
  set L2 : ℝ := ∫ y : Euclidean 2,
    ‖(𝓕⁻ (dvPsiS phi) : SchwartzMap (Euclidean 2) ℂ) y‖ ^ 2 with hL2
  have hL20 : 0 ≤ L2 := integral_nonneg fun _ => by positivity
  have hsq : (eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume) ^ 2 =
      ENNReal.ofReal ((a⁻¹) ^ 2 * L2) := by
    rw [← dvL2sqM]
    have hc : (∫⁻ x : Euclidean 2, ‖(dvKerS phi j r : Euclidean 2 → ℂ) x‖ₑ ^ 2) =
        ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(dvKerS phi j r) x‖) ^ 2 := by
      refine lintegral_congr fun x => ?_
      rw [ofReal_norm]
    rw [hc, dvLintegralSq_eq (dvKerS phi j r), integral_norm_sq_dvKerS]
  have hainv : a⁻¹ ≤ (2 : ℝ) ^ j := by
    rw [ha, dvA, max_eq_left hr]
    rw [mul_inv, inv_inv]
    have hrpos : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
    have hrinv : r⁻¹ ≤ 1 := by
      rw [inv_le_one_iff₀]
      right; exact hr
    have hpow : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
    calc (2 : ℝ) ^ j * r⁻¹ ≤ (2 : ℝ) ^ j * 1 := by
          exact mul_le_mul_of_nonneg_left hrinv hpow.le
      _ = (2 : ℝ) ^ j := by ring
  have hbound : ENNReal.ofReal ((a⁻¹) ^ 2 * L2) ≤
      (ENNReal.ofReal ((2 : ℝ) ^ j * dvPsiL2 phi)) ^ 2 := by
    have hrhs : ((2 : ℝ) ^ j * dvPsiL2 phi) ^ 2 = ((2 : ℝ) ^ j) ^ 2 * L2 := by
      rw [dvPsiL2, ← hL2, mul_pow, Real.sq_sqrt hL20]
    have hle : (a⁻¹) ^ 2 * L2 ≤ ((2 : ℝ) ^ j) ^ 2 * L2 := by
      refine mul_le_mul_of_nonneg_right ?_ hL20
      exact pow_le_pow_left₀ (le_of_lt (inv_pos.mpr hapos)) hainv 2

    calc ENNReal.ofReal ((a⁻¹) ^ 2 * L2) ≤ ENNReal.ofReal (((2 : ℝ) ^ j) ^ 2 * L2) :=
          ENNReal.ofReal_le_ofReal hle
      _ = ENNReal.ofReal (((2 : ℝ) ^ j * dvPsiL2 phi) ^ 2) := by rw [hrhs]
      _ = (ENNReal.ofReal ((2 : ℝ) ^ j * dvPsiL2 phi)) ^ 2 := by
          rw [← ENNReal.ofReal_pow (mul_nonneg (by positivity) (dvPsiL2_nonneg phi))]
  have hfin : (eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume) ^ 2 ≤
      (ENNReal.ofReal ((2 : ℝ) ^ j * dvPsiL2 phi)) ^ 2 := by
    rw [hsq]; exact hbound
  set X : ℝ≥0∞ := eLpNorm (dvKerS phi j r : Euclidean 2 → ℂ) 2 volume with hX
  set Y : ℝ≥0∞ := ENNReal.ofReal ((2 : ℝ) ^ j * dvPsiL2 phi) with hY
  have hstep : ∀ Z : ℝ≥0∞, Z = (Z ^ 2) ^ ((2 : ℝ)⁻¹) := by
    intro Z
    rw [← ENNReal.rpow_natCast Z 2, ← ENNReal.rpow_mul]
    norm_num
  calc X = (X ^ 2) ^ ((2 : ℝ)⁻¹) := hstep X
    _ ≤ (Y ^ 2) ^ ((2 : ℝ)⁻¹) := ENNReal.rpow_le_rpow hfin (by norm_num)
    _ = Y := (hstep Y).symm

