theorem dvMulA_supp {phi : SchwartzMap (Euclidean 2) ℂ}
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) (j : ℕ) (t : ℝ) {ξ : Euclidean 2}
    (hξ : ξ ∉ Metric.closedBall (0 : Euclidean 2) ((2 : ℝ) ^ (j + 7))) :
