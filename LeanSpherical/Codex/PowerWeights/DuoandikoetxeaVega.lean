/-- The pointwise weight splitting behind the Phase F interpolation:
`|x|^{-θ} = (|x|^{-1})^θ`, so the weighted integrand factors as a product of a
critical-weight factor and an unweighted one. -/
theorem radialPowerWeight_mul_eq_holder_split {d : ℕ} {θ : ℝ} (hθ0 : 0 ≤ θ)
    (hθ1 : θ ≤ 1) (x : Euclidean d) (H : ℝ≥0∞) :
    radialPowerWeight d (-θ) x * H =
      (radialPowerWeight d (-1) x * H) ^ θ * H ^ (1 - θ) := by
  have hsplit : radialPowerWeight d (-θ) x = (radialPowerWeight d (-1) x) ^ θ := by
    unfold radialPowerWeight
    rw [← ENNReal.rpow_mul]
    congr 1
    ring
  have hH : H ^ θ * H ^ (1 - θ) = H := by
    rw [← ENNReal.rpow_add_of_nonneg θ (1 - θ) hθ0 (by linarith)]
    simp
  refine Eq.symm ?_
  calc (radialPowerWeight d (-1) x * H) ^ θ * H ^ (1 - θ)
      = ((radialPowerWeight d (-1) x) ^ θ * H ^ θ) * H ^ (1 - θ) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hθ0]
    _ = (radialPowerWeight d (-1) x) ^ θ * (H ^ θ * H ^ (1 - θ)) := by ring
    _ = (radialPowerWeight d (-1) x) ^ θ * H := by rw [hH]
    _ = radialPowerWeight d (-θ) x * H := by rw [hsplit]

