      unfold radialPowerWeight
      rw [ENNReal.ofReal_rpow_of_pos hxpos]
      exact ENNReal.ofReal_le_ofReal
        (Real.rpow_le_rpow_of_nonpos hxpos hxle hα.le)
    calc (ENNReal.ofReal ‖f x‖) ^ p
        = (ENNReal.ofReal ((8 : ℝ) ^ (-α)) * ENNReal.ofReal ((8 : ℝ) ^ α)) *
            (ENNReal.ofReal ‖f x‖) ^ p := by
          rw [← ENNReal.ofReal_mul (by positivity), ← Real.rpow_add (by norm_num)]
          norm_num
      _ ≤ (ENNReal.ofReal ((8 : ℝ) ^ (-α)) * radialPowerWeight 2 α x) *
            (ENNReal.ofReal ‖f x‖) ^ p := by
          gcongr
      _ = ENNReal.ofReal ((8 : ℝ) ^ (-α)) *
            (radialPowerWeight 2 α x * (ENNReal.ofReal ‖f x‖) ^ p) := by ring

/-! ## Phases B--F: the localized weighted band rate

The analytic content of the Duoandikoetxea--Vega proof is packaged as one
predicate: a localized weighted `L^p` estimate for the literal relative
Littlewood--Paley bands of the circular means, carrying a genuine power gain
in the frequency index.

This is exactly the composite of the blueprint's Phase D (the critical-weight
dyadic estimate with `2^{εj}` loss), Phase E (the fixed-measure `2 → p`
interpolation) and Phase F (Stein--Weiss interpolation in the weight).  Phases
G, H and I -- the frequency summation, the extension from the Schwartz core to
all of `L^p`, and the globalization over all radii -- are supplied by the
repository's negative-weight reassembly machinery, which consumes precisely
this predicate. -/
def HasPlanarNegativeRawBandRate (E : Set ℝ) (p α : ℝ)
    (phi : SchwartzMap (Euclidean 2) ℂ) : Prop :=
  ∃ ε : ℝ, ∃ K : ENNReal, 0 < ε ∧ K ≠ ∞ ∧
    ∀ R : ℝ, 0 < R → ∀ (j : ℕ) (f : SchwartzMap (Euclidean 2) ℂ),
      (∀ x : Euclidean 2, x ∉ euclideanAnnulus 2 (1 / 4 : ℝ) 8 → f x = 0) →
      (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ),
          (restrictedRelativeBandpassSphericalMaximal 2
            (normalizedRadiusBlock E R) phi j f x) ^ p ∂
            powerWeightedVolume 2 α) ≤
        (K * (ENNReal.ofReal ((j : ℝ) + 1)) ^ (2 * p - 1) *
            (dyadicMultiplicativeScale j : ENNReal) ^ ε) *
          ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ p ∂
            powerWeightedVolume 2 α

/-- **Blueprint `prop:critical-loss` after Phase E.**  The localized
critical-weight `L^p` estimate for the literal relative bands, with an
arbitrary polynomial loss in the frequency index.  The output is measured on
the fixed ball `B(0, 1/32)` against the critical weight `|x|^{-1}`, and the
input is supported in the fixed annulus `1/4 ≤ |x| ≤ 8`.

A polynomial loss is exactly what the final Hoelder step can absorb, so no
`2^{εj}` bookkeeping is needed inside this predicate. -/
def HasCriticalWeightBandBound (phi : SchwartzMap (Euclidean 2) ℂ) (p : ℝ) : Prop :=
  ∃ (C : ℝ) (N : ℕ), 0 < C ∧
    ∀ (j : ℕ) (E : Set ℝ), E ⊆ Icc (1 : ℝ) 2 →
      ∀ f : SchwartzMap (Euclidean 2) ℂ,
        (∀ x : Euclidean 2, x ∉ euclideanAnnulus 2 (1 / 4 : ℝ) 8 → f x = 0) →
        (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ),
            radialPowerWeight 2 (-1) x *
              (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ p
              ∂ volume) ≤
          ENNReal.ofReal (C * ((j : ℝ) + 1) ^ N) *
            ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ p ∂ volume

/-- **Phases D--F.**  The critical-weight estimate and the unconditional
unweighted Bourgain gain combine, by one Hoelder inequality in the weight, to
the localized weighted band rate consumed by the repository's negative-weight
reassembly. -/
theorem hasPlanarNegativeRawBandRate_of_criticalWeight (E : Set ℝ) {p α : ℝ}
    (hp : 2 < p) (hlo : -1 < α) (hhi : α < 0)
    (phi : SchwartzMap (Euclidean 2) ℂ)
    (hphi_one : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hcrit : HasCriticalWeightBandBound phi p)
    (hband : Codex.Spherical.Bourgain.HasRelativeCircularBandGeometricDecay p phi) :
    HasPlanarNegativeRawBandRate E p α phi := by
  obtain ⟨C, N, hC, hcritb⟩ := hcrit
  obtain ⟨bandConst, rho, hbandtop, hrho, hbandbound⟩ := hband
  have hp0 : 0 < p := by linarith
  have hθ0 : 0 < -α := by linarith
  have hθ1 : -α < 1 := by linarith
  set θ : ℝ := -α with hθdef
  set q : ℝ := p * (1 - θ) with hqdef
  have hq0 : 0 < q := by
    have : 0 < 1 - θ := by simp only [hθdef]; linarith
    exact mul_pos hp0 this
  -- the geometric ratio, moved to a real number in `[1/2, 1)`
  have hrhotop : rho ≠ ∞ := hrho.ne_top
  have hrhoreal : rho.toReal < 1 := by
    have h := ENNReal.toReal_lt_toReal hrhotop (by norm_num : (1 : ENNReal) ≠ ∞) |>.mpr hrho
    simpa using h
  set c : ℝ := max rho.toReal (1 / 2) with hcdef
  have hc0 : 0 < c := lt_of_lt_of_le (by norm_num) (le_max_right _ _)
  have hc1 : c < 1 := max_lt hrhoreal (by norm_num)
  have hrhoc : rho ≤ ENNReal.ofReal c := by
    rw [← ENNReal.ofReal_toReal hrhotop]
    exact ENNReal.ofReal_le_ofReal (le_max_left _ _)
  -- the loss parameter
  set y : ℝ := c ^ q with hydef
  have hy0 : 0 < y := Real.rpow_pos_of_pos hc0 q
  have hy1 : y < 1 := Real.rpow_lt_one hc0.le hc1 hq0
  set t : ℝ := (1 + y⁻¹) / 2 with htdef
  have ht1 : 1 < t := by
    have : 1 < y⁻¹ := one_lt_inv_iff₀.mpr ⟨hy0, hy1⟩
    simp only [htdef]
    linarith
  have ht0 : 0 < t := by linarith
  set ε : ℝ := Real.logb 2 t with hεdef
  have hε : 0 < ε := Real.logb_pos (by norm_num) ht1
  have h2ε : (2 : ℝ) ^ ε = t := Real.rpow_logb (by norm_num) (by norm_num) ht0
  have hyt : y * t < 1 := by
    have hyinv : y * y⁻¹ = 1 := mul_inv_cancel₀ hy0.ne'
    simp only [htdef]
    nlinarith
  have hyt0 : 0 ≤ y * t := by positivity
  obtain ⟨K0, hK0pos, hK0⟩ := exists_bound_pow_mul_geometric N hyt0 hyt
  set Br : ℝ := bandConst.toReal with hBrdef
  have hBr0 : 0 ≤ Br := ENNReal.toReal_nonneg
  have hbandeq : bandConst = ENNReal.ofReal Br := (ENNReal.ofReal_toReal hbandtop).symm
  set A : ℝ := C ^ θ * Br ^ q * (8 : ℝ) ^ (-α) with hAdef
  have hA0 : 0 ≤ A := by
    have h1 : (0 : ℝ) ≤ C ^ θ := Real.rpow_nonneg hC.le θ
    have h2 : (0 : ℝ) ≤ Br ^ q := Real.rpow_nonneg hBr0 q
    have h3 : (0 : ℝ) ≤ (8 : ℝ) ^ (-α) := Real.rpow_nonneg (by norm_num) _
    positivity
  have hnegθ : -θ = α := by rw [hθdef]; ring
  have hscale : ∀ j : ℕ,
      ((dyadicMultiplicativeScale j : ℝ≥0) : ℝ≥0∞) =
        ENNReal.ofReal (((1 : ℝ) / 2) ^ j) := by
    intro j
    have h1 : ((dyadicMultiplicativeScale j : ℝ≥0) : ℝ) = ((1 : ℝ) / 2) ^ j := by
      simp only [dyadicMultiplicativeScale, NNReal.coe_pow, NNReal.coe_inv]
      norm_num
    rw [← ENNReal.ofReal_coe_nnreal, h1]
  refine ⟨ε, ENNReal.ofReal (A * K0), hε, ENNReal.ofReal_ne_top, ?_⟩
  intro R hR j f hfsupp
  have hERIcc : normalizedRadiusBlock E R ⊆ Icc (1 : ℝ) 2 :=
    normalizedRadiusBlock_subset_Icc_one_two hR
  have hERpos : normalizedRadiusBlock E R ⊆ Ioi (0 : ℝ) := fun r hr =>
    lt_of_lt_of_le (by norm_num) (hERIcc hr).1
  have hGmeas : Measurable
      (restrictedRelativeBandpassSphericalMaximal 2 (normalizedRadiusBlock E R) phi j f) :=
    measurable_restrictedRelativeBandpassSphericalMaximal_global
      (normalizedRadiusBlock E R) phi f hphi_one hphi_zero j
  have hHmeas : Measurable (fun x : Euclidean 2 =>
      (restrictedRelativeBandpassSphericalMaximal 2 (normalizedRadiusBlock E R) phi j f x) ^ p) :=
    hGmeas.pow_const p
  -- the weighted integral in physical form
  have hLHS : (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ),
        (restrictedRelativeBandpassSphericalMaximal 2 (normalizedRadiusBlock E R) phi j f x) ^ p
          ∂ powerWeightedVolume 2 α) =
      ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ),
        radialPowerWeight 2 (-θ) x *
          (restrictedRelativeBandpassSphericalMaximal 2 (normalizedRadiusBlock E R) phi j f x) ^ p
            ∂ volume := by
    rw [powerWeightedVolume, restrict_withDensity measurableSet_closedBall,
      lintegral_withDensity_eq_lintegral_mul _ (measurable_radialPowerWeight 2 α) hHmeas,
      hnegθ]
    rfl
  -- the two Hoelder factors
  have hfactor1 := hcritb j (normalizedRadiusBlock E R) hERIcc f hfsupp
  have hfactor2 : (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ),
        (restrictedRelativeBandpassSphericalMaximal 2 (normalizedRadiusBlock E R) phi j f x) ^ p
          ∂ volume) ≤
      (bandConst * rho ^ j) ^ p *
        ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ p ∂ volume := by
    refine le_trans (setLIntegral_le_lintegral _ _) ?_
    refine le_trans (lintegral_mono fun x => ?_)
      (lintegral_rpow_band_le_of_geometricDecay hp0 phi hbandbound j f)
    exact ENNReal.rpow_le_rpow
      (restrictedRelativeBandpassSphericalMaximal_mono hERpos phi j f x) hp0.le
  -- Hoelder
  have hholder := lintegral_radialPowerWeight_le_holder (d := 2)
    (s := Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ)) hθ0 hθ1 hHmeas
  have hcombine :
      (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ),
        radialPowerWeight 2 (-1) x *
          (restrictedRelativeBandpassSphericalMaximal 2 (normalizedRadiusBlock E R) phi j f x) ^ p
            ∂ volume) ^ θ *
      (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ),
        (restrictedRelativeBandpassSphericalMaximal 2 (normalizedRadiusBlock E R) phi j f x) ^ p
            ∂ volume) ^ (1 - θ) ≤
      (ENNReal.ofReal (C * ((j : ℝ) + 1) ^ N) *
          ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ p ∂ volume) ^ θ *
        ((bandConst * rho ^ j) ^ p *
          ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ p ∂ volume) ^ (1 - θ) := by
    gcongr
  -- algebraic normal form of the Hoelder product
  have hJcombine : ∀ a b J : ℝ≥0∞,
      (a * J) ^ θ * (b * J) ^ (1 - θ) = a ^ θ * b ^ (1 - θ) * J := by
    intro a b J
    have hJ : J ^ θ * J ^ (1 - θ) = J := by
      rw [← ENNReal.rpow_add_of_nonneg θ (1 - θ) hθ0.le (by linarith)]
      simp
    rw [ENNReal.mul_rpow_of_nonneg _ _ hθ0.le,
      ENNReal.mul_rpow_of_nonneg _ _ (by linarith : (0 : ℝ) ≤ 1 - θ)]
    calc a ^ θ * J ^ θ * (b ^ (1 - θ) * J ^ (1 - θ))
        = a ^ θ * b ^ (1 - θ) * (J ^ θ * J ^ (1 - θ)) := by ring
      _ = a ^ θ * b ^ (1 - θ) * J := by rw [hJ]
  have hqpow : ∀ z : ℝ≥0∞, (z ^ p) ^ (1 - θ) = z ^ q := by
    intro z
    rw [← ENNReal.rpow_mul, hqdef]
  -- the real constant comparison
  have hu1 : (1 : ℝ) ≤ (j : ℝ) + 1 := by
    have : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
    linarith
  have hpowθ : (((j : ℝ) + 1) ^ N) ^ θ ≤ ((j : ℝ) + 1) ^ N := by
    rw [← Real.rpow_natCast ((j : ℝ) + 1) N, ← Real.rpow_mul (by linarith)]
    exact Real.rpow_le_rpow_of_exponent_le hu1 (by
      have hN : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
      nlinarith)
  have hcpow : ((c ^ j : ℝ)) ^ q = y ^ j := by
    rw [← Real.rpow_natCast c j, ← Real.rpow_mul hc0.le, mul_comm ((j : ℝ)) q,
      Real.rpow_mul hc0.le, ← hydef, Real.rpow_natCast]
  have hhalf : (((1 : ℝ) / 2) ^ j) ^ ε = (t ^ j)⁻¹ := by
    have h2 : ((1 : ℝ) / 2) ^ ε = t⁻¹ := by
      rw [show ((1 : ℝ) / 2) = (2 : ℝ)⁻¹ by norm_num, Real.inv_rpow (by norm_num), h2ε]
    rw [← Real.rpow_natCast ((1 : ℝ) / 2) j, ← Real.rpow_mul (by norm_num),
      mul_comm ((j : ℝ)) ε, Real.rpow_mul (by norm_num), h2,
      Real.rpow_natCast, ← inv_pow]
  have hreal : A * (((j : ℝ) + 1) ^ N * y ^ j) ≤ A * K0 * (((1 : ℝ) / 2) ^ j) ^ ε := by
    have htj : (0 : ℝ) < t ^ j := pow_pos ht0 j
    have hkey : (((j : ℝ) + 1) ^ N * y ^ j) * t ^ j ≤ K0 := by
      rw [mul_assoc, ← mul_pow]
      exact hK0 j
    have hfinal : A * (((j : ℝ) + 1) ^ N * y ^ j) * t ^ j ≤ A * K0 := by
      calc A * (((j : ℝ) + 1) ^ N * y ^ j) * t ^ j
          = A * ((((j : ℝ) + 1) ^ N * y ^ j) * t ^ j) := by ring
        _ ≤ A * K0 := mul_le_mul_of_nonneg_left hkey hA0
    rw [← le_div_iff₀ htj] at hfinal
    rw [hhalf]
    calc A * (((j : ℝ) + 1) ^ N * y ^ j) ≤ A * K0 / t ^ j := hfinal
      _ = A * K0 * (t ^ j)⁻¹ := by ring
  -- assemble
  calc (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ),
        (restrictedRelativeBandpassSphericalMaximal 2 (normalizedRadiusBlock E R) phi j f x) ^ p
          ∂ powerWeightedVolume 2 α)
      = ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32 : ℝ),
          radialPowerWeight 2 (-θ) x *
            (restrictedRelativeBandpassSphericalMaximal 2 (normalizedRadiusBlock E R) phi j f x) ^ p
              ∂ volume := hLHS
    _ ≤ (ENNReal.ofReal (C * ((j : ℝ) + 1) ^ N) *
            ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ p ∂ volume) ^ θ *
          ((bandConst * rho ^ j) ^ p *
            ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ p ∂ volume) ^ (1 - θ) :=
        hholder.trans hcombine
    _ = ENNReal.ofReal (C * ((j : ℝ) + 1) ^ N) ^ θ * (bandConst * rho ^ j) ^ q *
          ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ p ∂ volume := by
        rw [hJcombine, hqpow]
    _ ≤ ENNReal.ofReal (C * ((j : ℝ) + 1) ^ N) ^ θ * (bandConst * rho ^ j) ^ q *
          (ENNReal.ofReal ((8 : ℝ) ^ (-α)) *
            ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ p ∂ powerWeightedVolume 2 α) := by
        gcongr
        exact lintegral_rpow_norm_le_powerWeighted_of_annulus_support hp0 hhi f hfsupp
    _ = (ENNReal.ofReal (C * ((j : ℝ) + 1) ^ N) ^ θ * (bandConst * rho ^ j) ^ q *
          ENNReal.ofReal ((8 : ℝ) ^ (-α))) *
            ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ p ∂ powerWeightedVolume 2 α := by
        ring
    _ ≤ (ENNReal.ofReal (A * K0) *
          (ENNReal.ofReal ((j : ℝ) + 1)) ^ (2 * p - 1) *
            ((dyadicMultiplicativeScale j : ℝ≥0) : ℝ≥0∞) ^ ε) *
              ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ p
                ∂ powerWeightedVolume 2 α := by
        refine mul_le_mul' ?_ le_rfl
        have hstep1 : ENNReal.ofReal (C * ((j : ℝ) + 1) ^ N) ^ θ ≤
            ENNReal.ofReal (C ^ θ * ((j : ℝ) + 1) ^ N) := by
          rw [ENNReal.ofReal_rpow_of_pos (by positivity)]
          refine ENNReal.ofReal_le_ofReal ?_
          rw [Real.mul_rpow hC.le (by positivity)]
          exact mul_le_mul_of_nonneg_left hpowθ (Real.rpow_nonneg hC.le θ)
        have hstep2 : (bandConst * rho ^ j) ^ q ≤ ENNReal.ofReal (Br ^ q * y ^ j) := by
          have hrj : rho ^ j ≤ ENNReal.ofReal (c ^ j) := by
            rw [ENNReal.ofReal_pow hc0.le]
            exact pow_le_pow_left' hrhoc j
          calc (bandConst * rho ^ j) ^ q ≤
              (ENNReal.ofReal Br * ENNReal.ofReal (c ^ j)) ^ q := by
                gcongr
                exact le_of_eq hbandeq
            _ = ENNReal.ofReal ((Br * c ^ j) ^ q) := by
                rw [← ENNReal.ofReal_mul hBr0,
                  ENNReal.ofReal_rpow_of_nonneg (by positivity) hq0.le]
            _ = ENNReal.ofReal (Br ^ q * y ^ j) := by
                rw [Real.mul_rpow hBr0 (by positivity), hcpow]
        have hstep3 : ENNReal.ofReal (C ^ θ * ((j : ℝ) + 1) ^ N) *
            ENNReal.ofReal (Br ^ q * y ^ j) * ENNReal.ofReal ((8 : ℝ) ^ (-α)) =
            ENNReal.ofReal (A * (((j : ℝ) + 1) ^ N * y ^ j)) := by
          rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
          congr 1
          rw [hAdef]
          ring
        have hstep4 : ENNReal.ofReal (A * K0) *
            ((dyadicMultiplicativeScale j : ℝ≥0) : ℝ≥0∞) ^ ε =
            ENNReal.ofReal (A * K0 * (((1 : ℝ) / 2) ^ j) ^ ε) := by
          rw [hscale j, ENNReal.ofReal_rpow_of_nonneg (by positivity) hε.le,
            ← ENNReal.ofReal_mul (by positivity)]
        have hone : (1 : ℝ≥0∞) ≤ (ENNReal.ofReal ((j : ℝ) + 1)) ^ (2 * p - 1) := by
          refine ENNReal.one_le_rpow ?_ (by linarith)
          rw [← ENNReal.ofReal_one]
          exact ENNReal.ofReal_le_ofReal hu1
        calc ENNReal.ofReal (C * ((j : ℝ) + 1) ^ N) ^ θ * (bandConst * rho ^ j) ^ q *
              ENNReal.ofReal ((8 : ℝ) ^ (-α))
            ≤ ENNReal.ofReal (C ^ θ * ((j : ℝ) + 1) ^ N) *
                ENNReal.ofReal (Br ^ q * y ^ j) * ENNReal.ofReal ((8 : ℝ) ^ (-α)) := by
              gcongr
          _ = ENNReal.ofReal (A * (((j : ℝ) + 1) ^ N * y ^ j)) := hstep3
          _ ≤ ENNReal.ofReal (A * K0 * (((1 : ℝ) / 2) ^ j) ^ ε) :=
              ENNReal.ofReal_le_ofReal hreal
          _ = ENNReal.ofReal (A * K0) *
                ((dyadicMultiplicativeScale j : ℝ≥0) : ℝ≥0∞) ^ ε := hstep4.symm
          _ = ENNReal.ofReal (A * K0) * 1 *
                ((dyadicMultiplicativeScale j : ℝ≥0) : ℝ≥0∞) ^ ε := by rw [mul_one]
          _ ≤ ENNReal.ofReal (A * K0) *
                (ENNReal.ofReal ((j : ℝ) + 1)) ^ (2 * p - 1) *
                  ((dyadicMultiplicativeScale j : ℝ≥0) : ℝ≥0∞) ^ ε := by
              gcongr

/-! ## Phase D: the oscillatory radial kernel

The `r`-integrals of the blueprint's Phase D are handled with a polynomial
weight which vanishes at the endpoints of `[1/4, 5]`.  This makes integration
by parts boundary-term free without constructing a smooth cutoff, and the
weight dominates `1` on `[1/2, 3]`, which contains every interval
`[r - 2 ^ (-(j+1)), r + 2 ^ (-(j+1))]` with `r ∈ [1,2]`. -/

/-- The polynomial radial weight of the Phase D `r`-integrals. -/
def dvWeight (r : ℝ) : ℝ := ((r - 1 / 4) * (5 - r)) ^ 2

/-- The derivative of `dvWeight`. -/
def dvWeightDeriv (r : ℝ) : ℝ :=
  2 * ((r - 1 / 4) * (5 - r)) * ((5 - r) - (r - 1 / 4))

theorem hasDerivAt_dvWeight (r : ℝ) : HasDerivAt dvWeight (dvWeightDeriv r) r := by
  have h1 : HasDerivAt (fun x : ℝ => x - 1 / 4) 1 r := (hasDerivAt_id r).sub_const _
  have h2 : HasDerivAt (fun x : ℝ => (5 : ℝ) - x) (-1) r := by
    simpa using (hasDerivAt_id r).const_sub (5 : ℝ)
  have hg : HasDerivAt (fun x : ℝ => (x - 1 / 4) * (5 - x))
      ((5 - r) - (r - 1 / 4)) r := by
    have h := h1.mul h2
    refine h.congr_deriv ?_
    ring
  have hp := hg.pow 2
  refine hp.congr_deriv ?_
  simp only [dvWeightDeriv]
  norm_num

theorem continuous_dvWeight : Continuous dvWeight := by
  unfold dvWeight
  fun_prop

theorem continuous_dvWeightDeriv : Continuous dvWeightDeriv := by
  unfold dvWeightDeriv
  fun_prop

theorem dvWeight_nonneg (r : ℝ) : 0 ≤ dvWeight r := by
  unfold dvWeight
  positivity

theorem dvWeight_left : dvWeight (1 / 4) = 0 := by norm_num [dvWeight]

theorem dvWeight_right : dvWeight 5 = 0 := by norm_num [dvWeight]

theorem one_le_dvWeight {r : ℝ} (h1 : 1 / 2 ≤ r) (h2 : r ≤ 3) : 1 ≤ dvWeight r := by
  have hg : (1 : ℝ) ≤ (r - 1 / 4) * (5 - r) := by nlinarith
  unfold dvWeight
  nlinarith

theorem dvWeight_le {r : ℝ} (h1 : 1 / 4 ≤ r) (h2 : r ≤ 5) : dvWeight r ≤ 36 := by
  have hg0 : (0 : ℝ) ≤ (r - 1 / 4) * (5 - r) := by nlinarith
  have hg : (r - 1 / 4) * (5 - r) ≤ 6 := by nlinarith [sq_nonneg (r - 21 / 8)]
  unfold dvWeight
  nlinarith

theorem abs_dvWeightDeriv_le {r : ℝ} (h1 : 1 / 4 ≤ r) (h2 : r ≤ 5) :
    |dvWeightDeriv r| ≤ 60 := by
  have hg0 : (0 : ℝ) ≤ (r - 1 / 4) * (5 - r) := by nlinarith
  have hg : (r - 1 / 4) * (5 - r) ≤ 6 := by nlinarith [sq_nonneg (r - 21 / 8)]
  have hd : |(5 - r) - (r - 1 / 4)| ≤ 5 := by
    rw [abs_le]
    constructor <;> nlinarith
  unfold dvWeightDeriv
  rw [abs_mul, abs_mul]
  have h2r : |(2 : ℝ)| = 2 := by norm_num
  have hgabs : |(r - 1 / 4) * (5 - r)| ≤ 6 := by
    rw [abs_of_nonneg hg0]
    exact hg
  calc |(2 : ℝ)| * |(r - 1 / 4) * (5 - r)| * |(5 - r) - (r - 1 / 4)|
      ≤ 2 * 6 * 5 := by
        rw [h2r]
        have : (0 : ℝ) ≤ |(r - 1 / 4) * (5 - r)| := abs_nonneg _
        have h5 : (0 : ℝ) ≤ |(5 - r) - (r - 1 / 4)| := abs_nonneg _
        nlinarith
    _ ≤ 60 := by norm_num

/-- The integrand of one term of the expanded radial kernel. -/
def dvKernelIntegrand (A B : ℝ → ℂ) (freq : ℝ) (r : ℝ) : ℂ :=
  (dvWeight r : ℂ) * A r * (starRingEnd ℂ) (B r) * oscillatoryExp freq r

/-- Pointwise size of that integrand. -/
theorem norm_dvKernelIntegrand_le {A B : ℝ → ℂ} {MA MB : ℝ} (freq : ℝ)
    {r : ℝ} (hr1 : 1 / 4 ≤ r) (hr2 : r ≤ 5)
    (hMA : ‖A r‖ ≤ MA) (hMB : ‖B r‖ ≤ MB) (hMA0 : 0 ≤ MA) (hMB0 : 0 ≤ MB) :
    ‖dvKernelIntegrand A B freq r‖ ≤ 36 * MA * MB := by
  unfold dvKernelIntegrand
  rw [norm_mul, norm_mul, norm_mul, norm_oscillatoryExp, mul_one,
    RCLike.norm_conj, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (dvWeight_nonneg r)]
  have hw : dvWeight r ≤ 36 := dvWeight_le hr1 hr2
  have h1 : (0 : ℝ) ≤ dvWeight r := dvWeight_nonneg r
  have h2 : (0 : ℝ) ≤ ‖A r‖ := norm_nonneg _
  have h3 : (0 : ℝ) ≤ ‖B r‖ := norm_nonneg _
  have hstep : dvWeight r * ‖A r‖ ≤ 36 * MA :=
    mul_le_mul hw hMA h2 (by norm_num)
  exact mul_le_mul hstep hMB h3 (by positivity)

/-- Direct bound for one oscillatory radial integral; no cancellation is used. -/
theorem norm_integral_dvKernelIntegrand_le {A B : ℝ → ℂ} {MA MB : ℝ} (freq : ℝ)
    (hMA : ∀ r ∈ Icc (1 / 4 : ℝ) 5, ‖A r‖ ≤ MA)
    (hMB : ∀ r ∈ Icc (1 / 4 : ℝ) 5, ‖B r‖ ≤ MB)
    (hMA0 : 0 ≤ MA) (hMB0 : 0 ≤ MB) :
    ‖∫ r in (1 / 4 : ℝ)..5, dvKernelIntegrand A B freq r‖ ≤ 180 * MA * MB := by
  have hbound : ∀ r ∈ Set.uIoc (1 / 4 : ℝ) 5,
      ‖dvKernelIntegrand A B freq r‖ ≤ 36 * MA * MB := by
    intro r hr
    rw [Set.uIoc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)] at hr
    have hmem : r ∈ Icc (1 / 4 : ℝ) 5 := ⟨le_of_lt hr.1, hr.2⟩
    exact norm_dvKernelIntegrand_le freq hmem.1 hmem.2 (hMA r hmem) (hMB r hmem) hMA0 hMB0
  have h := intervalIntegral.norm_integral_le_of_norm_le_const hbound
  have habs : |(5 : ℝ) - 1 / 4| = 19 / 4 := by
    rw [abs_of_nonneg (by norm_num : (0 : ℝ) ≤ (5 : ℝ) - 1 / 4)]
    norm_num
  rw [habs] at h
  refine h.trans ?_
  nlinarith [mul_nonneg hMA0 hMB0]

/-- Integration by parts for one oscillatory radial integral.  The polynomial
weight vanishes at both endpoints, so no boundary term appears. -/
theorem norm_integral_dvKernelIntegrand_ibp_le {A B A' B' : ℝ → ℂ}
    {MA MB MA' MB' freq : ℝ} (hfreq : freq ≠ 0)
    (hA : ∀ r, HasDerivAt A (A' r) r) (hB : ∀ r, HasDerivAt B (B' r) r)
    (hAc : Continuous A) (hBc : Continuous B)
    (hA'c : Continuous A') (hB'c : Continuous B')
    (hMA : ∀ r ∈ Icc (1 / 4 : ℝ) 5, ‖A r‖ ≤ MA)
    (hMB : ∀ r ∈ Icc (1 / 4 : ℝ) 5, ‖B r‖ ≤ MB)
    (hMA' : ∀ r ∈ Icc (1 / 4 : ℝ) 5, ‖A' r‖ ≤ MA')
    (hMB' : ∀ r ∈ Icc (1 / 4 : ℝ) 5, ‖B' r‖ ≤ MB')
    (hMA0 : 0 ≤ MA) (hMB0 : 0 ≤ MB) (hMA'0 : 0 ≤ MA') (hMB'0 : 0 ≤ MB') :
    ‖∫ r in (1 / 4 : ℝ)..5, dvKernelIntegrand A B freq r‖ ≤
      |freq|⁻¹ * (300 * (MA * MB) + 180 * (MA' * MB) + 180 * (MA * MB')) := by
  set F : ℝ → ℂ := fun r => (dvWeight r : ℂ) * A r * (starRingEnd ℂ) (B r) with hFdef
  set G : ℝ → ℂ := fun r =>
    (dvWeightDeriv r : ℂ) * A r * (starRingEnd ℂ) (B r) +
      ((dvWeight r : ℂ) * A' r * (starRingEnd ℂ) (B r) +
        (dvWeight r : ℂ) * A r * (starRingEnd ℂ) (B' r)) with hGdef
  have hBstar : ∀ r, HasDerivAt (fun x : ℝ => (starRingEnd ℂ) (B x))
      ((starRingEnd ℂ) (B' r)) r := fun r =>
    Complex.conjCLE.hasFDerivAt.comp_hasDerivAt r (hB r)
  have hwC : ∀ r, HasDerivAt (fun x : ℝ => ((dvWeight x : ℝ) : ℂ))
      ((dvWeightDeriv r : ℝ) : ℂ) r := by
    intro r
    exact (hasDerivAt_dvWeight r).ofReal_comp
  have hFderiv : ∀ r, HasDerivAt F (G r) r := by
    intro r
    have h1 := ((hwC r).mul (hA r)).mul (hBstar r)
    refine h1.congr_deriv ?_
    simp only [hGdef, Pi.mul_apply]
    ring
  have hGc : Continuous G := by
    simp only [hGdef]
    have h1 : Continuous fun r : ℝ => ((dvWeight r : ℝ) : ℂ) :=
      Complex.continuous_ofReal.comp continuous_dvWeight
    have h2 : Continuous fun r : ℝ => ((dvWeightDeriv r : ℝ) : ℂ) :=
      Complex.continuous_ofReal.comp continuous_dvWeightDeriv
    have h3 : Continuous fun r : ℝ => (starRingEnd ℂ) (B r) :=
      Complex.continuous_conj.comp hBc
    have h4 : Continuous fun r : ℝ => (starRingEnd ℂ) (B' r) :=
      Complex.continuous_conj.comp hB'c
    exact ((h2.mul hAc).mul h3).add (((h1.mul hA'c).mul h3).add ((h1.mul hAc).mul h4))
  have hFa : F (1 / 4) = 0 := by
    simp only [hFdef, dvWeight_left]
    simp
  have hFb : F 5 = 0 := by
    simp only [hFdef, dvWeight_right]
    simp
  have hkey := intervalIntegral_mul_oscillatoryExp_eq_neg_inv_mul (a := (1 / 4 : ℝ))
    (b := (5 : ℝ)) hfreq (fun t _ => hFderiv t) hGc hFa hFb
  have hrewrite : (∫ r in (1 / 4 : ℝ)..5, dvKernelIntegrand A B freq r) =
      ∫ r in (1 / 4 : ℝ)..5, F r * oscillatoryExp freq r := by
    apply intervalIntegral.integral_congr
    intro r _
    simp only [dvKernelIntegrand, hFdef]
  rw [hrewrite, hkey, norm_mul]
  have hcoef : ‖-(((freq : ℂ) * Complex.I)⁻¹)‖ = |freq|⁻¹ := by
    rw [norm_neg, norm_inv, norm_mul, Complex.norm_I, mul_one, Complex.norm_real,
      Real.norm_eq_abs]
  rw [hcoef]
  have hGbound : ∀ r ∈ Set.uIoc (1 / 4 : ℝ) 5,
      ‖G r * oscillatoryExp freq r‖ ≤
        60 * (MA * MB) + 36 * (MA' * MB) + 36 * (MA * MB') := by
    intro r hr
    rw [Set.uIoc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)] at hr
    have hmem : r ∈ Icc (1 / 4 : ℝ) 5 := ⟨le_of_lt hr.1, hr.2⟩
    rw [norm_mul, norm_oscillatoryExp, mul_one]
    have hA1 := hMA r hmem
    have hB1 := hMB r hmem
    have hA2 := hMA' r hmem
    have hB2 := hMB' r hmem
    have hw := dvWeight_le hmem.1 hmem.2
    have hw0 := dvWeight_nonneg r
    have hwd := abs_dvWeightDeriv_le hmem.1 hmem.2
    have ht1 : ‖(dvWeightDeriv r : ℂ) * A r * (starRingEnd ℂ) (B r)‖ ≤ 60 * (MA * MB) := by
      rw [norm_mul, norm_mul, RCLike.norm_conj, Complex.norm_real, Real.norm_eq_abs]
      have h2 : (0 : ℝ) ≤ ‖A r‖ := norm_nonneg _
      have h3 : (0 : ℝ) ≤ ‖B r‖ := norm_nonneg _
      have h4 : (0 : ℝ) ≤ |dvWeightDeriv r| := abs_nonneg _
      have hstep : |dvWeightDeriv r| * ‖A r‖ ≤ 60 * MA :=
        mul_le_mul hwd hA1 h2 (by norm_num)
      calc |dvWeightDeriv r| * ‖A r‖ * ‖B r‖ ≤ 60 * MA * MB :=
            mul_le_mul hstep hB1 h3 (by positivity)
        _ = 60 * (MA * MB) := by ring
    have ht2 : ‖(dvWeight r : ℂ) * A' r * (starRingEnd ℂ) (B r)‖ ≤ 36 * (MA' * MB) := by
      rw [norm_mul, norm_mul, RCLike.norm_conj, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg hw0]
      have h2 : (0 : ℝ) ≤ ‖A' r‖ := norm_nonneg _
      have h3 : (0 : ℝ) ≤ ‖B r‖ := norm_nonneg _
      have hstep : dvWeight r * ‖A' r‖ ≤ 36 * MA' :=
        mul_le_mul hw hA2 h2 (by norm_num)
      calc dvWeight r * ‖A' r‖ * ‖B r‖ ≤ 36 * MA' * MB :=
            mul_le_mul hstep hB1 h3 (by positivity)
        _ = 36 * (MA' * MB) := by ring
    have ht3 : ‖(dvWeight r : ℂ) * A r * (starRingEnd ℂ) (B' r)‖ ≤ 36 * (MA * MB') := by
      rw [norm_mul, norm_mul, RCLike.norm_conj, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg hw0]
      have h2 : (0 : ℝ) ≤ ‖A r‖ := norm_nonneg _
      have h3 : (0 : ℝ) ≤ ‖B' r‖ := norm_nonneg _
      have hstep : dvWeight r * ‖A r‖ ≤ 36 * MA :=
        mul_le_mul hw hA1 h2 (by norm_num)
      calc dvWeight r * ‖A r‖ * ‖B' r‖ ≤ 36 * MA * MB' :=
            mul_le_mul hstep hB2 h3 (by positivity)
        _ = 36 * (MA * MB') := by ring
    have hsum := norm_add_le ((dvWeightDeriv r : ℂ) * A r * (starRingEnd ℂ) (B r))
      ((dvWeight r : ℂ) * A' r * (starRingEnd ℂ) (B r) +
        (dvWeight r : ℂ) * A r * (starRingEnd ℂ) (B' r))
    have hsum2 := norm_add_le ((dvWeight r : ℂ) * A' r * (starRingEnd ℂ) (B r))
      ((dvWeight r : ℂ) * A r * (starRingEnd ℂ) (B' r))
    simp only [hGdef]
    linarith
  have hint := intervalIntegral.norm_integral_le_of_norm_le_const hGbound
  have habs : |(5 : ℝ) - 1 / 4| = 19 / 4 := by
    rw [abs_of_nonneg (by norm_num : (0 : ℝ) ≤ (5 : ℝ) - 1 / 4)]
    norm_num
  rw [habs] at hint
  have hfa : (0 : ℝ) ≤ |freq|⁻¹ := by positivity
  refine mul_le_mul_of_nonneg_left (hint.trans ?_) hfa
  nlinarith [mul_nonneg hMA0 hMB0, mul_nonneg hMA'0 hMB0, mul_nonneg hMA0 hMB'0]

/-! ### Amplitude bounds for the three planar wave parts

The exact planar normal form
`PlanarTripleWaveNormalForm.planarCoordinateSurfaceWaveSum_eq_three_radialTerms`
writes the circle surface factor as an outgoing wave, an incoming wave and a
middle remainder.  On the radial interval `[1/4, 5]` and for scalar frequency
`s ≥ 1`, the two endpoint amplitudes and their `r`-derivatives are of size
`s ^ (-1/2)`, while the middle amplitude is of size `s ^ (-2)` and its
derivative of size `s ^ (-1)`.  Two orders of decay for the middle piece is
exactly what the kernel bound needs. -/

/-- The `r`-derivative of a planar coordinate-wave amplitude. -/
def dvAmpDeriv (part : CoordinateWavePart) (s r : ℝ) : ℂ :=
  (surfaceMass 1 : ℂ) *
    match part with
    | .outgoing => ((2 * Real.pi * s : ℝ) : ℂ) *
        deriv planarEndpointQuadraticIntegral ((2 * Real.pi * s) * r)
    | .incoming => ((-(2 * Real.pi * s) : ℝ) : ℂ) *
        deriv planarEndpointQuadraticIntegral ((-(2 * Real.pi * s)) * r)
    | .middle => ((2 * Real.pi * s : ℝ) : ℂ) *
        deriv (coordinateMiddleMeridianLocalizedIntegral 0) ((2 * Real.pi * s) * r)

private theorem aux_hasDerivAt_comp_linear {P : ℝ → ℂ}
    (hP : ContDiff ℝ (⊤ : ℕ∞) P) (c r : ℝ) :
    HasDerivAt (fun rho : ℝ => P (c * rho)) (((c : ℝ) : ℂ) * deriv P (c * r)) r := by
  have hPd : HasDerivAt P (deriv P (c * r)) (c * r) :=
    ((hP.differentiable (by simp)) _).hasDerivAt
  have hlin : HasDerivAt (fun rho : ℝ => c * rho) c r := by
    simpa using (hasDerivAt_id r).const_mul c
  have hcomp := hPd.scomp r hlin
  refine hcomp.congr_deriv ?_
  rw [Complex.real_smul]

/-- Chain rule for the planar coordinate-wave amplitudes. -/
theorem hasDerivAt_planarCoordinateWaveRadialAmplitude
    (part : CoordinateWavePart) (s r : ℝ) :
    HasDerivAt (fun rho : ℝ => planarCoordinateWaveRadialAmplitude part s rho)
      (dvAmpDeriv part s r) r := by
  cases part with
  | outgoing =>
      unfold planarCoordinateWaveRadialAmplitude dvAmpDeriv
      dsimp only
      exact (aux_hasDerivAt_comp_linear contDiff_planarEndpointQuadraticIntegral
        (2 * Real.pi * s) r).const_mul (surfaceMass 1 : ℂ)
  | incoming =>
      unfold planarCoordinateWaveRadialAmplitude dvAmpDeriv
      dsimp only
      exact (aux_hasDerivAt_comp_linear contDiff_planarEndpointQuadraticIntegral
        (-(2 * Real.pi * s)) r).const_mul (surfaceMass 1 : ℂ)
  | middle =>
      unfold planarCoordinateWaveRadialAmplitude dvAmpDeriv
      dsimp only
      exact (aux_hasDerivAt_comp_linear
        (contDiff_coordinateMiddleMeridianLocalizedIntegral 0)
        (2 * Real.pi * s) r).const_mul (surfaceMass 1 : ℂ)

theorem continuous_planarCoordinateWaveRadialAmplitude
    (part : CoordinateWavePart) (s : ℝ) :
    Continuous fun rho : ℝ => planarCoordinateWaveRadialAmplitude part s rho :=
  (contDiff_planarCoordinateWaveRadialAmplitude part s).continuous

theorem continuous_dvAmpDeriv (part : CoordinateWavePart) (s : ℝ) :
    Continuous fun r : ℝ => dvAmpDeriv part s r := by
  have hP : Continuous (deriv planarEndpointQuadraticIntegral) :=
    contDiff_planarEndpointQuadraticIntegral.continuous_deriv (by simp)
  have hM : Continuous (deriv (coordinateMiddleMeridianLocalizedIntegral 0)) :=
    (contDiff_coordinateMiddleMeridianLocalizedIntegral 0).continuous_deriv (by simp)
  have hlin : Continuous fun r : ℝ => (2 * Real.pi * s) * r :=
    continuous_const.mul continuous_id
  have hlin' : Continuous fun r : ℝ => (-(2 * Real.pi * s)) * r :=
    continuous_const.mul continuous_id
  cases part with
  | outgoing =>
      unfold dvAmpDeriv
      dsimp only
      exact continuous_const.mul (continuous_const.mul (hP.comp hlin))
  | incoming =>
      unfold dvAmpDeriv
      dsimp only
      exact continuous_const.mul (continuous_const.mul (hP.comp hlin'))
  | middle =>
      unfold dvAmpDeriv
      dsimp only
      exact continuous_const.mul (continuous_const.mul (hM.comp hlin))

private theorem aux_radial_lower {s r : ℝ} (hs : 1 ≤ s) (hr1 : 1 / 4 ≤ r) :
    s ≤ 2 * Real.pi * s * r ∧ 1 ≤ |2 * Real.pi * s * r| ∧
      |2 * Real.pi * s * r| = 2 * Real.pi * s * r := by
  have hpi : (3 : ℝ) ≤ Real.pi := by
    have := Real.pi_gt_three
    linarith
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have hr0 : (0 : ℝ) < r := by linarith
  have hpr : (3 : ℝ) * r ≤ Real.pi * r := by
    exact mul_le_mul_of_nonneg_right hpi hr0.le
  have h32 : (3 : ℝ) / 2 ≤ 2 * Real.pi * r := by linarith
  have hpos : (0 : ℝ) ≤ 2 * Real.pi * s * r := by positivity
  have hkey : s ≤ 2 * Real.pi * s * r := by
    have hmul : s * ((3 : ℝ) / 2) ≤ s * (2 * Real.pi * r) :=
      mul_le_mul_of_nonneg_left h32 hs0.le
    have hrw : s * (2 * Real.pi * r) = 2 * Real.pi * s * r := by ring
    rw [hrw] at hmul
    linarith
  refine ⟨hkey, ?_, abs_of_nonneg hpos⟩
  rw [abs_of_nonneg hpos]
  linarith

private theorem aux_const_le {m1 C0 C1 : ℝ} (hm10 : 0 ≤ m1) (hC0 : 0 < C0)
    (hC1 : 0 < C1) :
    m1 * C0 ≤ (m1 + 1) * (C0 + C1) * (2 * Real.pi + 1) ∧
      m1 * (C1 * (2 * Real.pi + 1)) ≤ (m1 + 1) * (C0 + C1) * (2 * Real.pi + 1) ∧
      m1 * C1 ≤ (m1 + 1) * (C0 + C1) * (2 * Real.pi + 1) ∧
      m1 * (2 * Real.pi * C1) ≤ (m1 + 1) * (C0 + C1) * (2 * Real.pi + 1) := by
  have hpi : (0 : ℝ) < Real.pi := Real.pi_pos
  have hbase : (0 : ℝ) ≤ (m1 + 1) * (C0 + C1) := by positivity
  have hfac : (1 : ℝ) ≤ 2 * Real.pi + 1 := by linarith
  have hp0 : m1 * C0 ≤ (m1 + 1) * (C0 + C1) := by
    nlinarith [mul_nonneg hm10 hC1.le, hC0.le, hC1.le]
  have hp1 : m1 * C1 ≤ (m1 + 1) * (C0 + C1) := by
    nlinarith [mul_nonneg hm10 hC0.le, hC0.le, hC1.le]
  refine ⟨?_, ?_, ?_, ?_⟩
  · calc m1 * C0 ≤ (m1 + 1) * (C0 + C1) := hp0
      _ = (m1 + 1) * (C0 + C1) * 1 := by ring
      _ ≤ (m1 + 1) * (C0 + C1) * (2 * Real.pi + 1) := by gcongr
  · calc m1 * (C1 * (2 * Real.pi + 1)) = m1 * C1 * (2 * Real.pi + 1) := by ring
      _ ≤ (m1 + 1) * (C0 + C1) * (2 * Real.pi + 1) := by gcongr
  · calc m1 * C1 ≤ (m1 + 1) * (C0 + C1) := hp1
      _ = (m1 + 1) * (C0 + C1) * 1 := by ring
      _ ≤ (m1 + 1) * (C0 + C1) * (2 * Real.pi + 1) := by gcongr
  · calc m1 * (2 * Real.pi * C1) = m1 * C1 * (2 * Real.pi) := by ring
      _ ≤ (m1 + 1) * (C0 + C1) * (2 * Real.pi) := by gcongr
      _ ≤ (m1 + 1) * (C0 + C1) * (2 * Real.pi + 1) := by nlinarith [hbase]

/-- Amplitude and derivative bounds for the two endpoint planar waves. -/
theorem exists_planarAmplitude_endpoint_bound :
    ∃ C : ℝ, 0 < C ∧ ∀ part : CoordinateWavePart,
      (part = CoordinateWavePart.outgoing ∨ part = CoordinateWavePart.incoming) →
      ∀ s : ℝ, 1 ≤ s → ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
        ‖planarCoordinateWaveRadialAmplitude part s r‖ ≤ C / Real.sqrt s ∧
        ‖dvAmpDeriv part s r‖ ≤ C / Real.sqrt s := by
  obtain ⟨C0, hC0, h0⟩ := exists_iteratedDeriv_planarEndpointQuadraticIntegral_abs_decay 0
  obtain ⟨C1, hC1, h1⟩ := exists_iteratedDeriv_planarEndpointQuadraticIntegral_abs_decay 1
  set m1 : ℝ := ‖(surfaceMass 1 : ℂ)‖ with hm1
  have hm10 : 0 ≤ m1 := norm_nonneg _
  have hpi0 : (0 : ℝ) < Real.pi := Real.pi_pos
  obtain ⟨hK1, _, _, hK4⟩ := aux_const_le hm10 hC0 hC1
  refine ⟨(m1 + 1) * (C0 + C1) * (2 * Real.pi + 1), by positivity, ?_⟩
  intro part hpart s hs r hr1 hr2
  obtain ⟨hlow, hone, habs⟩ := aux_radial_lower hs hr1
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have hsq0 : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hs0
  have hsqrtmono : Real.sqrt s ≤ Real.sqrt (2 * Real.pi * s * r) := Real.sqrt_le_sqrt hlow
  have hsqrt0' : (0 : ℝ) ≤ Real.sqrt s := hsq0.le
  have hcube : Real.sqrt s ^ 3 = s * Real.sqrt s := by
    have h := Real.sq_sqrt hs0.le
    nlinarith
  have hcubemono : Real.sqrt s ^ 3 ≤ Real.sqrt (2 * Real.pi * s * r) ^ 3 := by
    gcongr
  have hsize : ∀ c : ℝ, |c * r| = 2 * Real.pi * s * r →
      ‖planarEndpointQuadraticIntegral (c * r)‖ ≤ C0 / Real.sqrt s := by
    intro c hc
    have hcone : 1 ≤ |c * r| := by
      rw [hc, ← habs]
      exact hone
    have h := h0 (c * r) hcone
    rw [iteratedDeriv_zero] at h
    refine h.trans ?_
    have hqm : quadraticMomentScale (2 * 0) |c * r| = Real.sqrt |c * r| := by
      simp [quadraticMomentScale]
    rw [hqm, hc]
    gcongr
  have hderivsize : ∀ c : ℝ, |c * r| = 2 * Real.pi * s * r → |c| = 2 * Real.pi * s →
      ‖((c : ℝ) : ℂ) * deriv planarEndpointQuadraticIntegral (c * r)‖ ≤
        (2 * Real.pi * C1) / Real.sqrt s := by
    intro c hc hcabs
    have hcone : 1 ≤ |c * r| := by
      rw [hc, ← habs]
      exact hone
    have h := h1 (c * r) hcone
    rw [iteratedDeriv_one] at h
    have hqm : quadraticMomentScale (2 * 1) |c * r| = Real.sqrt |c * r| ^ 3 := by
      simp [quadraticMomentScale]
    rw [hqm, hc] at h
    have hfinal : ‖deriv planarEndpointQuadraticIntegral (c * r)‖ ≤
        C1 / (s * Real.sqrt s) := by
      refine h.trans ?_
      rw [← hcube]
      gcongr
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, hcabs]
    calc (2 * Real.pi * s) * ‖deriv planarEndpointQuadraticIntegral (c * r)‖
        ≤ (2 * Real.pi * s) * (C1 / (s * Real.sqrt s)) := by
          gcongr
      _ = (2 * Real.pi * C1) / Real.sqrt s := by
          field_simp
  rcases hpart with hp | hp
  · subst hp
    unfold planarCoordinateWaveRadialAmplitude dvAmpDeriv
    dsimp only
    have hb1 := hsize (2 * Real.pi * s) habs
    have hb2 := hderivsize (2 * Real.pi * s) habs (abs_of_nonneg (by positivity))
    refine ⟨?_, ?_⟩
    · rw [norm_mul]
      calc m1 * ‖planarEndpointQuadraticIntegral (2 * Real.pi * s * r)‖
          ≤ m1 * (C0 / Real.sqrt s) := by gcongr
        _ = (m1 * C0) / Real.sqrt s := by ring
        _ ≤ ((m1 + 1) * (C0 + C1) * (2 * Real.pi + 1)) / Real.sqrt s := by gcongr
    · rw [norm_mul]
      calc m1 * ‖((2 * Real.pi * s : ℝ) : ℂ) *
              deriv planarEndpointQuadraticIntegral (2 * Real.pi * s * r)‖
          ≤ m1 * ((2 * Real.pi * C1) / Real.sqrt s) := by gcongr
        _ = (m1 * (2 * Real.pi * C1)) / Real.sqrt s := by ring
        _ ≤ ((m1 + 1) * (C0 + C1) * (2 * Real.pi + 1)) / Real.sqrt s := by gcongr
  · subst hp
    unfold planarCoordinateWaveRadialAmplitude dvAmpDeriv
    dsimp only
    have hflip : |(-(2 * Real.pi * s)) * r| = 2 * Real.pi * s * r := by
      rw [neg_mul, abs_neg]
      exact habs
    have hb1 := hsize (-(2 * Real.pi * s)) hflip
    have hb2 := hderivsize (-(2 * Real.pi * s)) hflip
      (by rw [abs_neg]; exact abs_of_nonneg (by positivity))
    refine ⟨?_, ?_⟩
    · rw [norm_mul]
      calc m1 * ‖planarEndpointQuadraticIntegral (-(2 * Real.pi * s) * r)‖
          ≤ m1 * (C0 / Real.sqrt s) := by gcongr
        _ = (m1 * C0) / Real.sqrt s := by ring
        _ ≤ ((m1 + 1) * (C0 + C1) * (2 * Real.pi + 1)) / Real.sqrt s := by gcongr
    · rw [norm_mul]
      calc m1 * ‖((-(2 * Real.pi * s) : ℝ) : ℂ) *
              deriv planarEndpointQuadraticIntegral (-(2 * Real.pi * s) * r)‖
          ≤ m1 * ((2 * Real.pi * C1) / Real.sqrt s) := by gcongr
        _ = (m1 * (2 * Real.pi * C1)) / Real.sqrt s := by ring
        _ ≤ ((m1 + 1) * (C0 + C1) * (2 * Real.pi + 1)) / Real.sqrt s := by gcongr

/-- Amplitude and derivative bounds for the planar middle remainder, at two
orders of decay. -/
theorem exists_planarAmplitude_middle_bound :
    ∃ C : ℝ, 0 < C ∧ ∀ s : ℝ, 1 ≤ s → ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
      ‖planarCoordinateWaveRadialAmplitude CoordinateWavePart.middle s r‖ ≤
          C / s ^ 2 ∧
      ‖dvAmpDeriv CoordinateWavePart.middle s r‖ ≤ C / s := by
  obtain ⟨C0, hC0, h0⟩ :=
    exists_iteratedDeriv_coordinateMiddleMeridianLocalizedIntegral_abs_decay 0 0 2
  obtain ⟨C1, hC1, h1⟩ :=
    exists_iteratedDeriv_coordinateMiddleMeridianLocalizedIntegral_abs_decay 0 1 2
  set m1 : ℝ := ‖(surfaceMass 1 : ℂ)‖ with hm1
  have hm10 : 0 ≤ m1 := norm_nonneg _
  have hpi0 : (0 : ℝ) < Real.pi := Real.pi_pos
  obtain ⟨hK1, _, _, hK4⟩ := aux_const_le hm10 hC0 hC1
  refine ⟨(m1 + 1) * (C0 + C1) * (2 * Real.pi + 1), by positivity, ?_⟩
  intro s hs r hr1 hr2
  obtain ⟨hlow, hone, habs⟩ := aux_radial_lower hs hr1
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have hsq : s ^ 2 ≤ |2 * Real.pi * s * r| ^ 2 := by
    rw [habs]
    gcongr
  unfold planarCoordinateWaveRadialAmplitude dvAmpDeriv
  dsimp only
  refine ⟨?_, ?_⟩
  · have h := h0 (2 * Real.pi * s * r) hone
    rw [iteratedDeriv_zero] at h
    rw [norm_mul]
    have hb : ‖coordinateMiddleMeridianLocalizedIntegral 0 (2 * Real.pi * s * r)‖ ≤
        C0 / s ^ 2 := by
      refine h.trans ?_
      gcongr
    calc m1 * ‖coordinateMiddleMeridianLocalizedIntegral 0 (2 * Real.pi * s * r)‖
        ≤ m1 * (C0 / s ^ 2) := by gcongr
      _ = (m1 * C0) / s ^ 2 := by ring
      _ ≤ ((m1 + 1) * (C0 + C1) * (2 * Real.pi + 1)) / s ^ 2 := by gcongr
  · have h := h1 (2 * Real.pi * s * r) hone
    rw [iteratedDeriv_one] at h
    have hcoef : ‖((2 * Real.pi * s : ℝ) : ℂ)‖ = 2 * Real.pi * s := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    rw [norm_mul, norm_mul, hcoef]
    have hb : ‖deriv (coordinateMiddleMeridianLocalizedIntegral 0)
        (2 * Real.pi * s * r)‖ ≤ C1 / s ^ 2 := by
      refine h.trans ?_
      gcongr
    calc m1 * ((2 * Real.pi * s) *
          ‖deriv (coordinateMiddleMeridianLocalizedIntegral 0) (2 * Real.pi * s * r)‖)
        ≤ m1 * ((2 * Real.pi * s) * (C1 / s ^ 2)) := by gcongr
      _ = (m1 * (2 * Real.pi * C1)) / s := by
          field_simp
      _ ≤ ((m1 + 1) * (C0 + C1) * (2 * Real.pi + 1)) / s := by gcongr

/-! ### The oscillatory radial kernel and its decay

The radial kernel of the Phase D quadratic form is

  `K(s,t) = ∫ w(r) σ(s r) conj (σ (t r)) dr`,

where `σ` is the circle surface factor written in its exact planar
outgoing/incoming/middle normal form.  Expanding both factors gives nine
oscillatory integrals.  Seven of them are estimated by one integration by
parts against a nonresonant phase, or directly by the rapid decay of the
middle amplitude; the two resonant terms carry the phase `∓2π(s-t)` and
produce the factor `(1 + |s - t|)⁻¹`. -/

/-- The three coordinate wave parts as a `Finset`. -/
def dvParts : Finset CoordinateWavePart :=
  {CoordinateWavePart.outgoing, CoordinateWavePart.incoming,
    CoordinateWavePart.middle}

theorem dvParts_sum {M : Type*} [AddCommMonoid M] (f : CoordinateWavePart → M) :
    ∑ p ∈ dvParts, f p =
      f CoordinateWavePart.outgoing + f CoordinateWavePart.incoming +
        f CoordinateWavePart.middle := by
  simp only [dvParts]
  rw [Finset.sum_insert (by decide), Finset.sum_insert (by decide),
    Finset.sum_singleton, ← add_assoc]

theorem continuous_dvKernelIntegrand {A B : ℝ → ℂ} (hA : Continuous A)
    (hB : Continuous B) (freq : ℝ) :
    Continuous fun r : ℝ => dvKernelIntegrand A B freq r := by
  unfold dvKernelIntegrand oscillatoryExp
  have hw : Continuous fun r : ℝ => ((dvWeight r : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp continuous_dvWeight
  have hconj : Continuous fun r : ℝ => (starRingEnd ℂ) (B r) :=
    Complex.continuous_conj.comp hB
  have hosc : Continuous fun r : ℝ =>
      Complex.exp (((freq * r : ℝ) : ℂ) * Complex.I) := by
    exact Complex.continuous_exp.comp
      ((Complex.continuous_ofReal.comp (continuous_const.mul continuous_id)).mul
        continuous_const)
  exact ((hw.mul hA).mul hconj).mul hosc

/-- One term of the expanded radial kernel, for an abstract amplitude
family. -/
def dvKernelTermOf (Amp : CoordinateWavePart -> ℝ -> ℝ -> ℂ)
    (p q : CoordinateWavePart) (s t : ℝ) : ℂ :=
  ∫ r in (1 / 4 : ℝ)..5,
    dvKernelIntegrand (fun u => Amp p s u)
      (fun u => Amp q t u)
      (coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t) r

private theorem aux_term_product (w A B : ℂ) (f g r : ℝ) :
    w * (A * oscillatoryExp f r) * (starRingEnd ℂ) (B * oscillatoryExp g r) =
      w * A * (starRingEnd ℂ) B * oscillatoryExp (f - g) r := by
  rw [map_mul, star_oscillatoryExp,
    show f - g = f + (-g) from by ring, ← oscillatoryExp_mul]
  ring

private theorem aux_integrand_eq_sum
    {Amp : CoordinateWavePart → ℝ → ℝ → ℂ} {Sig : ℝ → ℝ → ℂ}
    (hexp : ∀ u r : ℝ, Sig u r =
      ∑ p ∈ dvParts, Amp p u r * oscillatoryExp (coordinateWaveRadialPhase p u) r)
    (s t r : ℝ) :
    (dvWeight r : ℂ) * Sig s r *
        (starRingEnd ℂ) (Sig t r) =
      ∑ p ∈ dvParts, ∑ q ∈ dvParts,
        dvKernelIntegrand (fun u => Amp p s u)
          (fun u => Amp q t u)
          (coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t) r := by
  rw [hexp s r, hexp t r, map_sum]
  have step1 : (dvWeight r : ℂ) *
      (∑ p ∈ dvParts, Amp p s r * oscillatoryExp (coordinateWaveRadialPhase p s) r) =
      ∑ p ∈ dvParts, (dvWeight r : ℂ) *
        (Amp p s r * oscillatoryExp (coordinateWaveRadialPhase p s) r) :=
    Finset.mul_sum _ _ _
  rw [step1, Finset.sum_mul]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun q _ => ?_
  unfold dvKernelIntegrand
  exact aux_term_product _ _ _ _ _ _

/-- The radial kernel expands into the nine oscillatory pieces. -/
theorem dvKernel_eq_sum {Amp : CoordinateWavePart → ℝ → ℝ → ℂ}
    {Sig : ℝ → ℝ → ℂ}
    (hcA : ∀ (p : CoordinateWavePart) (u : ℝ), Continuous fun v : ℝ => Amp p u v)
    (hexp : ∀ u r : ℝ, Sig u r =
      ∑ p ∈ dvParts, Amp p u r * oscillatoryExp (coordinateWaveRadialPhase p u) r)
    (s t : ℝ) :
    (∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) *
        Sig s r *
          (starRingEnd ℂ) (Sig t r)) =
      ∑ p ∈ dvParts, ∑ q ∈ dvParts, dvKernelTermOf Amp p q s t := by
  have hcont : ∀ p q : CoordinateWavePart, Continuous fun r : ℝ =>
      dvKernelIntegrand (fun u => Amp p s u)
        (fun u => Amp q t u)
        (coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t) r := by
    intro p q
    exact continuous_dvKernelIntegrand
      (hcA p s)
      (hcA q t) _
  calc (∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) *
        Sig s r *
          (starRingEnd ℂ) (Sig t r))
      = ∫ r in (1 / 4 : ℝ)..5, ∑ p ∈ dvParts, ∑ q ∈ dvParts,
          dvKernelIntegrand (fun u => Amp p s u)
            (fun u => Amp q t u)
            (coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t) r := by
        apply intervalIntegral.integral_congr
        intro r _
        exact aux_integrand_eq_sum hexp s t r
    _ = ∑ p ∈ dvParts, ∫ r in (1 / 4 : ℝ)..5, ∑ q ∈ dvParts,
          dvKernelIntegrand (fun u => Amp p s u)
            (fun u => Amp q t u)
            (coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t) r := by
        refine intervalIntegral.integral_finsetSum fun p _ => ?_
        exact (continuous_finsetSum _ fun q hq => hcont p q).intervalIntegrable _ _
    _ = ∑ p ∈ dvParts, ∑ q ∈ dvParts, dvKernelTermOf Amp p q s t := by
        refine Finset.sum_congr rfl fun p _ => ?_
        refine intervalIntegral.integral_finsetSum fun q _ => ?_
        exact (hcont p q).intervalIntegrable _ _


/-! ### Uniform amplitude bounds and the nine term estimates -/

/-- On `[1/4, 5]` every planar amplitude and every amplitude derivative is
bounded by `C / sqrt u`.  For the middle piece this discards decay, which is
harmless for the eight terms carrying a nonzero phase. -/
theorem exists_dvUniform_bound :
    ∃ C : ℝ, 0 < C ∧ ∀ (p : CoordinateWavePart) (u : ℝ), 1 ≤ u →
      ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
        ‖planarCoordinateWaveRadialAmplitude p u r‖ ≤ C / Real.sqrt u ∧
        ‖dvAmpDeriv p u r‖ ≤ C / Real.sqrt u := by
  obtain ⟨Ce, hCe, he⟩ := exists_planarAmplitude_endpoint_bound
  obtain ⟨Cm, hCm, hm⟩ := exists_planarAmplitude_middle_bound
  refine ⟨Ce + Cm, by positivity, ?_⟩
  intro p u hu r hr1 hr2
  have hu0 : (0 : ℝ) < u := lt_of_lt_of_le zero_lt_one hu
  have hsqu : (1 : ℝ) ≤ Real.sqrt u := by
    rw [show (1 : ℝ) = Real.sqrt 1 from Real.sqrt_one.symm]
    exact Real.sqrt_le_sqrt hu
  have hsq0 : (0 : ℝ) < Real.sqrt u := lt_of_lt_of_le zero_lt_one hsqu
  have hsqle : Real.sqrt u ≤ u := by
    nlinarith [Real.sq_sqrt hu0.le, hsqu]
  have hsqle2 : Real.sqrt u ≤ u ^ 2 := by nlinarith [hsqle, hu]
  cases p with
  | outgoing =>
      obtain ⟨h1, h2⟩ := he CoordinateWavePart.outgoing (Or.inl rfl) u hu r hr1 hr2
      exact ⟨h1.trans (by gcongr; linarith), h2.trans (by gcongr; linarith)⟩
  | incoming =>
      obtain ⟨h1, h2⟩ := he CoordinateWavePart.incoming (Or.inr rfl) u hu r hr1 hr2
      exact ⟨h1.trans (by gcongr; linarith), h2.trans (by gcongr; linarith)⟩
  | middle =>
      obtain ⟨h1, h2⟩ := hm u hu r hr1 hr2
      refine ⟨h1.trans ?_, h2.trans ?_⟩
      · rw [div_le_div_iff₀ (by positivity) hsq0]
        nlinarith [hCe.le, hCm.le, hsqle2, hsq0.le]
      · rw [div_le_div_iff₀ hu0 hsq0]
        nlinarith [hCe.le, hCm.le, hsqle, hsq0.le]

/-- One integration by parts for a term with nonzero phase. -/
theorem dvKernelTerm_ibp_bound {Amp AmpD : CoordinateWavePart → ℝ → ℝ → ℂ}
    (hderiv : ∀ (p : CoordinateWavePart) (u r : ℝ),
      HasDerivAt (fun v : ℝ => Amp p u v) (AmpD p u r) r)
    (hcA : ∀ (p : CoordinateWavePart) (u : ℝ), Continuous fun v : ℝ => Amp p u v)
    (hcAd : ∀ (p : CoordinateWavePart) (u : ℝ), Continuous fun v : ℝ => AmpD p u v)
    (p q : CoordinateWavePart) {s t C : ℝ}
    (hs : 1 ≤ s) (ht : 1 ≤ t) (hC : 0 ≤ C)
    (hunif : ∀ (p' : CoordinateWavePart) (u : ℝ), 1 ≤ u →
      ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
        ‖Amp p' u r‖ ≤ C / Real.sqrt u ∧
        ‖AmpD p' u r‖ ≤ C / Real.sqrt u)
    (hfreq : coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t ≠ 0) :
    ‖dvKernelTermOf Amp p q s t‖ ≤
      |coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t|⁻¹ *
        (660 * ((C / Real.sqrt s) * (C / Real.sqrt t))) := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have ht0 : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
  have hsq : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hs0
  have htq : (0 : ℝ) < Real.sqrt t := Real.sqrt_pos.mpr ht0
  have hb := norm_integral_dvKernelIntegrand_ibp_le
    (A := fun u => Amp p s u)
    (B := fun u => Amp q t u)
    (A' := fun u => AmpD p s u) (B' := fun u => AmpD q t u)
    hfreq
    (fun r => hderiv p s r)
    (fun r => hderiv q t r)
    (hcA p s)
    (hcA q t)
    (hcAd p s) (hcAd q t)
    (fun r hr => (hunif p s hs r hr.1 hr.2).1)
    (fun r hr => (hunif q t ht r hr.1 hr.2).1)
    (fun r hr => (hunif p s hs r hr.1 hr.2).2)
    (fun r hr => (hunif q t ht r hr.1 hr.2).2)
    (by positivity) (by positivity) (by positivity) (by positivity)
  refine hb.trans (le_of_eq ?_)
  ring

/-- The direct bound for a term with zero phase, using the sharp middle
decay. -/
theorem dvKernelTerm_middle_bound {Amp AmpD : CoordinateWavePart → ℝ → ℝ → ℂ}
    {s t Cm : ℝ} (hs : 1 ≤ s) (ht : 1 ≤ t) (hCm : 0 < Cm)
    (hm : ∀ u : ℝ, 1 ≤ u → ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
      ‖Amp CoordinateWavePart.middle u r‖ ≤
          Cm / u ^ 2 ∧
        ‖AmpD CoordinateWavePart.middle u r‖ ≤ Cm / u) :
    ‖dvKernelTermOf Amp CoordinateWavePart.middle CoordinateWavePart.middle s t‖ ≤
      180 * (Cm / s ^ 2) * (Cm / t ^ 2) := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have ht0 : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
  unfold dvKernelTermOf
  exact norm_integral_dvKernelIntegrand_le _
    (fun r hr => (hm s hs r hr.1 hr.2).1) (fun r hr => (hm t ht r hr.1 hr.2).1)
    (by positivity) (by positivity)


/-- The direct bound for any term, with the uniform amplitude bounds. -/
theorem dvKernelTerm_direct_bound {Amp AmpD : CoordinateWavePart → ℝ → ℝ → ℂ}
    (p q : CoordinateWavePart) {s t C : ℝ}
    (hs : 1 ≤ s) (ht : 1 ≤ t) (hC : 0 ≤ C)
    (hunif : ∀ (p' : CoordinateWavePart) (u : ℝ), 1 ≤ u →
      ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
        ‖Amp p' u r‖ ≤ C / Real.sqrt u ∧
        ‖AmpD p' u r‖ ≤ C / Real.sqrt u) :
    ‖dvKernelTermOf Amp p q s t‖ ≤ 180 * (C / Real.sqrt s) * (C / Real.sqrt t) := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have ht0 : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
  have hsq : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hs0
  have htq : (0 : ℝ) < Real.sqrt t := Real.sqrt_pos.mpr ht0
  unfold dvKernelTermOf
  exact norm_integral_dvKernelIntegrand_le _
    (fun r hr => (hunif p s hs r hr.1 hr.2).1)
    (fun r hr => (hunif q t ht r hr.1 hr.2).1)
    (by positivity) (by positivity)

private theorem aux_sqrt_facts {s t : ℝ} (hs : 1 ≤ s) (ht : 1 ≤ t) :
    Real.sqrt s * Real.sqrt s = s ∧ Real.sqrt t * Real.sqrt t = t ∧
      1 ≤ Real.sqrt s ∧ 1 ≤ Real.sqrt t := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have ht0 : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
  refine ⟨Real.mul_self_sqrt hs0.le, Real.mul_self_sqrt ht0.le, ?_, ?_⟩
  · rw [show (1 : ℝ) = Real.sqrt 1 from Real.sqrt_one.symm]
    exact Real.sqrt_le_sqrt hs
  · rw [show (1 : ℝ) = Real.sqrt 1 from Real.sqrt_one.symm]
    exact Real.sqrt_le_sqrt ht

private theorem aux_sqrt_ratio {s t : ℝ} (hs : 1 ≤ s) (ht : 1 ≤ t)
    (hts : t ≤ 100 * s) : Real.sqrt t ≤ 10 * Real.sqrt s := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have h : Real.sqrt t ≤ Real.sqrt (100 * s) := Real.sqrt_le_sqrt hts
  have h100 : Real.sqrt (100 * s) = 10 * Real.sqrt s := by
    rw [Real.sqrt_mul (by norm_num) s]
    congr 1
    rw [show (100 : ℝ) = 10 ^ 2 from by norm_num, Real.sqrt_sq (by norm_num)]
  rwa [h100] at h

/-- Converting an integration-by-parts bound with a lower bound `lb` on the
phase frequency into the shape `K / (s t)`. -/
private theorem aux_ibp_to_inv_st {s t C freq lb K : ℝ}
    (hs : 1 ≤ s) (ht : 1 ≤ t) (hC : 0 ≤ C) (hlb : 0 < lb) (hfreq : lb ≤ |freq|)
    (hkey : 660 * (C * C) * (s * t) ≤ K * (lb * (Real.sqrt s * Real.sqrt t))) :
    |freq|⁻¹ * (660 * ((C / Real.sqrt s) * (C / Real.sqrt t))) ≤ K * (s * t)⁻¹ := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have ht0 : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
  have hsq : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hs0
  have htq : (0 : ℝ) < Real.sqrt t := Real.sqrt_pos.mpr ht0
  have hfabs : (0 : ℝ) < |freq| := lt_of_lt_of_le hlb hfreq
  have hstep : |freq|⁻¹ * (660 * ((C / Real.sqrt s) * (C / Real.sqrt t))) ≤
      lb⁻¹ * (660 * ((C / Real.sqrt s) * (C / Real.sqrt t))) := by
    gcongr
  refine hstep.trans ?_
  rw [show lb⁻¹ * (660 * ((C / Real.sqrt s) * (C / Real.sqrt t))) =
      (660 * (C * C)) / (lb * (Real.sqrt s * Real.sqrt t)) from by field_simp]
  rw [show K * (s * t)⁻¹ = K / (s * t) from by ring,
    div_le_div_iff₀ (by positivity) (by positivity)]
  nlinarith [hkey]

private theorem aux_inv_st_le_bnd {s t : ℝ} (hs : 1 ≤ s) (ht : 1 ≤ t)
    (hts : t ≤ 100 * s) (hst : s ≤ 100 * t) :
    (s * t)⁻¹ ≤ 102 * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have ht0 : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
  have habs : |s - t| ≤ s + t := by
    rw [abs_le]
    constructor <;> linarith
  have hd : 1 + |s - t| ≤ 102 * t := by
    have h1 : |s - t| ≤ 101 * t := by
      have : s + t ≤ 101 * t := by linarith
      linarith [habs]
    linarith
  have hd0 : (0 : ℝ) < 1 + |s - t| := by positivity
  rw [show (102 : ℝ) * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) =
      (102 * (s⁻¹ + t⁻¹)) / (1 + |s - t|) from by ring, le_div_iff₀ hd0]
  have hinv : s⁻¹ ≤ s⁻¹ + t⁻¹ := by
    have : (0 : ℝ) < t⁻¹ := by positivity
    linarith
  calc (s * t)⁻¹ * (1 + |s - t|) ≤ (s * t)⁻¹ * (102 * t) := by
        gcongr
    _ = 102 * s⁻¹ := by field_simp
    _ ≤ 102 * (s⁻¹ + t⁻¹) := by gcongr

private theorem aux_res_le_bnd {s t : ℝ} (hs : 1 ≤ s) (ht : 1 ≤ t)
    (hst : s ≤ 100 * t) :
    (Real.sqrt s * Real.sqrt t)⁻¹ / (1 + |s - t|) ≤
      10 * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have ht0 : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
  have hsq : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hs0
  have htq : (0 : ℝ) < Real.sqrt t := Real.sqrt_pos.mpr ht0
  have hd0 : (0 : ℝ) < 1 + |s - t| := by positivity
  obtain ⟨hss, htt, hs1, ht1⟩ := aux_sqrt_facts hs ht
  have hratio : Real.sqrt s ≤ 10 * Real.sqrt t := aux_sqrt_ratio ht hs hst
  have hkey : (Real.sqrt s * Real.sqrt t)⁻¹ ≤ 10 * (s⁻¹ + t⁻¹) := by
    have h1 : s ≤ 10 * (Real.sqrt s * Real.sqrt t) := by
      calc s = Real.sqrt s * Real.sqrt s := hss.symm
        _ ≤ (10 * Real.sqrt t) * Real.sqrt s := by gcongr
        _ = 10 * (Real.sqrt s * Real.sqrt t) := by ring
    have hinv : s⁻¹ ≤ s⁻¹ + t⁻¹ := by
      have : (0 : ℝ) < t⁻¹ := by positivity
      linarith
    have h2 : (Real.sqrt s * Real.sqrt t)⁻¹ ≤ 10 * s⁻¹ := by
      rw [inv_eq_one_div, show (10 : ℝ) * s⁻¹ = 10 / s from by ring,
        div_le_div_iff₀ (by positivity) hs0]
      linarith
    calc (Real.sqrt s * Real.sqrt t)⁻¹ ≤ 10 * s⁻¹ := h2
      _ ≤ 10 * (s⁻¹ + t⁻¹) := by gcongr
  rw [show (10 : ℝ) * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) =
      (10 * (s⁻¹ + t⁻¹)) / (1 + |s - t|) from by ring]
  gcongr


private theorem aux_phase_out (a : ℝ) :
    coordinateWaveRadialPhase CoordinateWavePart.outgoing a = -(2 * Real.pi * a) := rfl

private theorem aux_phase_in (a : ℝ) :
    coordinateWaveRadialPhase CoordinateWavePart.incoming a = 2 * Real.pi * a := rfl

private theorem aux_phase_mid (a : ℝ) :
    coordinateWaveRadialPhase CoordinateWavePart.middle a = 0 := rfl

private theorem aux_two_pi : (1 : ℝ) ≤ 2 * Real.pi := by
  have := Real.pi_gt_three
  linarith

/-- The two resonant terms, whose phase is `∓2π(s - t)`. -/
private theorem aux_resonant_term {Amp AmpD : CoordinateWavePart → ℝ → ℝ → ℂ}
    (hderiv : ∀ (p : CoordinateWavePart) (u r : ℝ),
      HasDerivAt (fun v : ℝ => Amp p u v) (AmpD p u r) r)
    (hcA : ∀ (p : CoordinateWavePart) (u : ℝ), Continuous fun v : ℝ => Amp p u v)
    (hcAd : ∀ (p : CoordinateWavePart) (u : ℝ), Continuous fun v : ℝ => AmpD p u v)
    (p q : CoordinateWavePart) {s t C : ℝ}
    (hs : 1 ≤ s) (ht : 1 ≤ t) (hst : s ≤ 100 * t) (hC : 0 ≤ C)
    (hunif : ∀ (p' : CoordinateWavePart) (u : ℝ), 1 ≤ u →
      ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
        ‖Amp p' u r‖ ≤ C / Real.sqrt u ∧
        ‖AmpD p' u r‖ ≤ C / Real.sqrt u)
    (hfabs : |coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t| =
      2 * Real.pi * |s - t|) :
    ‖dvKernelTermOf Amp p q s t‖ ≤
      13200 * (C * C) * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have ht0 : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
  have hsq : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hs0
  have htq : (0 : ℝ) < Real.sqrt t := Real.sqrt_pos.mpr ht0
  have hd0 : (0 : ℝ) < 1 + |s - t| := by positivity
  have hres := aux_res_le_bnd hs ht hst
  have hCC : (0 : ℝ) ≤ C * C := by positivity
  by_cases hgap : 1 ≤ |s - t|
  · -- integration by parts against the resonant phase
    have hfne : coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t ≠ 0 := by
      intro h
      rw [h] at hfabs
      simp only [abs_zero] at hfabs
      have hpos : (0 : ℝ) < 2 * Real.pi * |s - t| := by
        have := Real.pi_pos
        nlinarith
      linarith
    have hb := dvKernelTerm_ibp_bound hderiv hcA hcAd p q hs ht hC hunif hfne
    have hlb : (1 + |s - t|) / 2 ≤
        |coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t| := by
      rw [hfabs]
      nlinarith [aux_two_pi, hgap]
    have hinv : |coordinateWaveRadialPhase p s -
        coordinateWaveRadialPhase q t|⁻¹ ≤ 2 / (1 + |s - t|) := by
      rw [show (2 : ℝ) / (1 + |s - t|) = ((1 + |s - t|) / 2)⁻¹ from by
        rw [inv_div]]
      gcongr
    refine hb.trans ?_
    have hstep : |coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t|⁻¹ *
        (660 * ((C / Real.sqrt s) * (C / Real.sqrt t))) ≤
        (2 / (1 + |s - t|)) * (660 * ((C / Real.sqrt s) * (C / Real.sqrt t))) := by
      gcongr
    refine hstep.trans ?_
    have heq : (2 / (1 + |s - t|)) * (660 * ((C / Real.sqrt s) * (C / Real.sqrt t))) =
        1320 * (C * C) * ((Real.sqrt s * Real.sqrt t)⁻¹ / (1 + |s - t|)) := by
      field_simp
      ring
    rw [heq]
    calc 1320 * (C * C) * ((Real.sqrt s * Real.sqrt t)⁻¹ / (1 + |s - t|))
        ≤ 1320 * (C * C) * (10 * ((s⁻¹ + t⁻¹) / (1 + |s - t|))) := by gcongr
      _ = 13200 * (C * C) * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by ring
  · -- no cancellation needed: the interval is short
    have hb := dvKernelTerm_direct_bound p q hs ht hC hunif
    refine hb.trans ?_
    have hd2 : 1 + |s - t| ≤ 2 := by
      push_neg at hgap
      linarith
    have heq : (180 : ℝ) * (C / Real.sqrt s) * (C / Real.sqrt t) =
        180 * (C * C) * (Real.sqrt s * Real.sqrt t)⁻¹ := by
      field_simp
    rw [heq]
    have hstep : (Real.sqrt s * Real.sqrt t)⁻¹ ≤
        2 * ((Real.sqrt s * Real.sqrt t)⁻¹ / (1 + |s - t|)) := by
      rw [show (2 : ℝ) * ((Real.sqrt s * Real.sqrt t)⁻¹ / (1 + |s - t|)) =
          (2 * (Real.sqrt s * Real.sqrt t)⁻¹) / (1 + |s - t|) from by ring,
        le_div_iff₀ hd0]
      have hinvpos : (0 : ℝ) < (Real.sqrt s * Real.sqrt t)⁻¹ := by positivity
      nlinarith [hd2, hinvpos]
    calc (180 : ℝ) * (C * C) * (Real.sqrt s * Real.sqrt t)⁻¹
        ≤ 180 * (C * C) * (2 * ((Real.sqrt s * Real.sqrt t)⁻¹ / (1 + |s - t|))) := by
          gcongr
      _ = 360 * (C * C) * ((Real.sqrt s * Real.sqrt t)⁻¹ / (1 + |s - t|)) := by ring
      _ ≤ 360 * (C * C) * (10 * ((s⁻¹ + t⁻¹) / (1 + |s - t|))) := by gcongr
      _ = 3600 * (C * C) * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by ring
      _ ≤ 13200 * (C * C) * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by
          have hb0 : (0 : ℝ) ≤ (s⁻¹ + t⁻¹) / (1 + |s - t|) := by positivity
          nlinarith [hCC, hb0]

/-- A nonresonant term whose phase frequency is at least `lb` in absolute
value, where `lb ∈ {s, t, s + t}`. -/
private theorem aux_nonresonant_term {Amp AmpD : CoordinateWavePart → ℝ → ℝ → ℂ}
    (hderiv : ∀ (p : CoordinateWavePart) (u r : ℝ),
      HasDerivAt (fun v : ℝ => Amp p u v) (AmpD p u r) r)
    (hcA : ∀ (p : CoordinateWavePart) (u : ℝ), Continuous fun v : ℝ => Amp p u v)
    (hcAd : ∀ (p : CoordinateWavePart) (u : ℝ), Continuous fun v : ℝ => AmpD p u v)
    (p q : CoordinateWavePart) {s t C lb : ℝ}
    (hs : 1 ≤ s) (ht : 1 ≤ t) (hts : t ≤ 100 * s) (hst : s ≤ 100 * t) (hC : 0 ≤ C)
    (hunif : ∀ (p' : CoordinateWavePart) (u : ℝ), 1 ≤ u →
      ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
        ‖Amp p' u r‖ ≤ C / Real.sqrt u ∧
        ‖AmpD p' u r‖ ≤ C / Real.sqrt u)
    (hlb0 : 0 < lb)
    (hfne : coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t ≠ 0)
    (hfreq : lb ≤ |coordinateWaveRadialPhase p s - coordinateWaveRadialPhase q t|)
    (hkey : 660 * (C * C) * (s * t) ≤
      6600 * (C * C) * (lb * (Real.sqrt s * Real.sqrt t))) :
    ‖dvKernelTermOf Amp p q s t‖ ≤
      673200 * (C * C) * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by
  have hCC : (0 : ℝ) ≤ C * C := by positivity
  have hb := dvKernelTerm_ibp_bound hderiv hcA hcAd p q hs ht hC hunif hfne
  have hconv := aux_ibp_to_inv_st hs ht hC hlb0 hfreq hkey
  refine (hb.trans hconv).trans ?_
  calc 6600 * (C * C) * (s * t)⁻¹
      ≤ 6600 * (C * C) * (102 * ((s⁻¹ + t⁻¹) / (1 + |s - t|))) := by
        gcongr
        exact aux_inv_st_le_bnd hs ht hts hst
    _ = 673200 * (C * C) * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by ring


set_option maxHeartbeats 1600000 in
/-- **The Phase D radial kernel bound.**  For comparable scalar frequencies
`s, t ≥ 1` the radial kernel of the quadratic form obeys
`|K(s,t)| ≲ (s⁻¹ + t⁻¹) / (1 + |s - t|)`.  The two resonant terms produce the
`|s - t|` decay; the other seven are nonresonant or rapidly decaying. -/
theorem dvKernel_bound_of_abstract {Amp AmpD : CoordinateWavePart → ℝ → ℝ → ℂ}
    {Sig : ℝ → ℝ → ℂ} {C Cm : ℝ}
    (hderiv : ∀ (p : CoordinateWavePart) (u r : ℝ),
      HasDerivAt (fun v : ℝ => Amp p u v) (AmpD p u r) r)
    (hcA : ∀ (p : CoordinateWavePart) (u : ℝ), Continuous fun v : ℝ => Amp p u v)
    (hcAd : ∀ (p : CoordinateWavePart) (u : ℝ), Continuous fun v : ℝ => AmpD p u v)
    (hexp : ∀ u r : ℝ, Sig u r =
      ∑ p ∈ dvParts, Amp p u r * oscillatoryExp (coordinateWaveRadialPhase p u) r)
    (hC : 0 < C) (hCm : 0 < Cm)
    (hunif : ∀ (p' : CoordinateWavePart) (u : ℝ), 1 ≤ u →
      ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
        ‖Amp p' u r‖ ≤ C / Real.sqrt u ∧ ‖AmpD p' u r‖ ≤ C / Real.sqrt u)
    (hm : ∀ u : ℝ, 1 ≤ u → ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
      ‖Amp CoordinateWavePart.middle u r‖ ≤ Cm / u ^ 2 ∧
        ‖AmpD CoordinateWavePart.middle u r‖ ≤ Cm / u) :
    ∀ s t : ℝ, 1 ≤ s → 1 ≤ t → t ≤ 100 * s → s ≤ 100 * t →
      ‖∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) *
          Sig s r *
            (starRingEnd ℂ) (Sig t r)‖ ≤
        9 * (673200 * (C * C) + 13200 * (C * C) + 18360 * (Cm * Cm) + 1) *
          ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by
  have hCC : (0 : ℝ) ≤ C * C := by positivity
  have hCmm : (0 : ℝ) ≤ Cm * Cm := by positivity
  have hpi0 : (0 : ℝ) < Real.pi := Real.pi_pos
  intro s t hs ht hts hst
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have ht0 : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
  have hd0 : (0 : ℝ) < 1 + |s - t| := by positivity
  have hBnd : (0 : ℝ) ≤ (s⁻¹ + t⁻¹) / (1 + |s - t|) := by positivity
  obtain ⟨hss, htt, hs1, ht1⟩ := aux_sqrt_facts hs ht
  have hsq : (0 : ℝ) < Real.sqrt s := lt_of_lt_of_le zero_lt_one hs1
  have htq : (0 : ℝ) < Real.sqrt t := lt_of_lt_of_le zero_lt_one ht1
  have hrt : Real.sqrt t ≤ 10 * Real.sqrt s := aux_sqrt_ratio hs ht hts
  have hrs : Real.sqrt s ≤ 10 * Real.sqrt t := aux_sqrt_ratio ht hs hst
  have hkeyS : s * t ≤ 10 * (s * (Real.sqrt s * Real.sqrt t)) := by
    have h : t ≤ 10 * (Real.sqrt s * Real.sqrt t) := by
      calc t = Real.sqrt t * Real.sqrt t := htt.symm
        _ ≤ (10 * Real.sqrt s) * Real.sqrt t := by gcongr
        _ = 10 * (Real.sqrt s * Real.sqrt t) := by ring
    calc s * t ≤ s * (10 * (Real.sqrt s * Real.sqrt t)) := by gcongr
      _ = 10 * (s * (Real.sqrt s * Real.sqrt t)) := by ring
  have hkeyT : s * t ≤ 10 * (t * (Real.sqrt s * Real.sqrt t)) := by
    have h : s ≤ 10 * (Real.sqrt s * Real.sqrt t) := by
      calc s = Real.sqrt s * Real.sqrt s := hss.symm
        _ ≤ (10 * Real.sqrt t) * Real.sqrt s := by gcongr
        _ = 10 * (Real.sqrt s * Real.sqrt t) := by ring
    calc s * t = t * s := by ring
      _ ≤ t * (10 * (Real.sqrt s * Real.sqrt t)) := by gcongr
      _ = 10 * (t * (Real.sqrt s * Real.sqrt t)) := by ring
  have hkeyST : s * t ≤ 10 * ((s + t) * (Real.sqrt s * Real.sqrt t)) := by
    have hmono : s * (Real.sqrt s * Real.sqrt t) ≤ (s + t) * (Real.sqrt s * Real.sqrt t) := by
      nlinarith [mul_nonneg hsq.le htq.le, ht0.le]
    linarith [hkeyS]
  obtain ⟨KT, hKTdef⟩ : ∃ K : ℝ,
      K = 673200 * (C * C) + 13200 * (C * C) + 18360 * (Cm * Cm) + 1 := ⟨_, rfl⟩
  have hKT0 : (0 : ℝ) ≤ KT := by
    rw [hKTdef]
    positivity
  have hle1 : 673200 * (C * C) ≤ KT := by
    rw [hKTdef]
    linarith [hCC, hCmm]
  have hle2 : 13200 * (C * C) ≤ KT := by
    rw [hKTdef]
    linarith [hCC, hCmm]
  have hle3 : 18360 * (Cm * Cm) ≤ KT := by
    rw [hKTdef]
    linarith [hCC, hCmm]
  -- the nine term estimates
  have hterm : ∀ p q : CoordinateWavePart,
      ‖dvKernelTermOf Amp p q s t‖ ≤ KT * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by
    intro p q
    have habs2pi : |2 * Real.pi| = 2 * Real.pi := abs_of_nonneg (by positivity)
    cases p with
    | outgoing =>
        cases q with
        | outgoing =>
            have hfabs : |coordinateWaveRadialPhase CoordinateWavePart.outgoing s -
                coordinateWaveRadialPhase CoordinateWavePart.outgoing t| =
                2 * Real.pi * |s - t| := by
              rw [aux_phase_out, aux_phase_out,
                show -(2 * Real.pi * s) - -(2 * Real.pi * t) =
                  -(2 * Real.pi * (s - t)) from by ring, abs_neg, abs_mul, habs2pi]
            refine (aux_resonant_term hderiv hcA hcAd _ _ hs ht hst hC.le hunif
              hfabs).trans ?_
            gcongr
        | incoming =>
            have hval : coordinateWaveRadialPhase CoordinateWavePart.outgoing s -
                coordinateWaveRadialPhase CoordinateWavePart.incoming t =
                -(2 * Real.pi * (s + t)) := by
              rw [aux_phase_out, aux_phase_in]
              ring
            have hfabs : |coordinateWaveRadialPhase CoordinateWavePart.outgoing s -
                coordinateWaveRadialPhase CoordinateWavePart.incoming t| =
                2 * Real.pi * (s + t) := by
              rw [hval, abs_neg, abs_mul, habs2pi,
                abs_of_nonneg (by linarith : (0 : ℝ) ≤ s + t)]
            refine (aux_nonresonant_term hderiv hcA hcAd _ _ hs ht hts hst hC.le hunif
              (by linarith : (0 : ℝ) < s + t) ?_ ?_ ?_).trans ?_
            · rw [hval]
              intro hcon
              have : (0 : ℝ) < 2 * Real.pi * (s + t) := by positivity
              simp only [neg_eq_zero] at hcon
              linarith
            · rw [hfabs]
              nlinarith [aux_two_pi]
            · nlinarith [hkeyST, hCC]
            · gcongr
        | middle =>
            have hval : coordinateWaveRadialPhase CoordinateWavePart.outgoing s -
                coordinateWaveRadialPhase CoordinateWavePart.middle t =
                -(2 * Real.pi * s) := by
              rw [aux_phase_out, aux_phase_mid]
              ring
            have hfabs : |coordinateWaveRadialPhase CoordinateWavePart.outgoing s -
                coordinateWaveRadialPhase CoordinateWavePart.middle t| =
                2 * Real.pi * s := by
              rw [hval, abs_neg, abs_mul, habs2pi, abs_of_nonneg hs0.le]
            refine (aux_nonresonant_term hderiv hcA hcAd _ _ hs ht hts hst hC.le
              hunif hs0 ?_ ?_ ?_).trans ?_
            · rw [hval]
              intro hcon
              have : (0 : ℝ) < 2 * Real.pi * s := by positivity
              simp only [neg_eq_zero] at hcon
              linarith
            · rw [hfabs]
              nlinarith [aux_two_pi]
            · nlinarith [hkeyS, hCC]
            · gcongr
    | incoming =>
        cases q with
        | outgoing =>
            have hval : coordinateWaveRadialPhase CoordinateWavePart.incoming s -
                coordinateWaveRadialPhase CoordinateWavePart.outgoing t =
                2 * Real.pi * (s + t) := by
              rw [aux_phase_in, aux_phase_out]
              ring
            have hfabs : |coordinateWaveRadialPhase CoordinateWavePart.incoming s -
                coordinateWaveRadialPhase CoordinateWavePart.outgoing t| =
                2 * Real.pi * (s + t) := by
              rw [hval, abs_mul, habs2pi, abs_of_nonneg (by linarith : (0 : ℝ) ≤ s + t)]
            refine (aux_nonresonant_term hderiv hcA hcAd _ _ hs ht hts hst hC.le hunif
              (by linarith : (0 : ℝ) < s + t) ?_ ?_ ?_).trans ?_
            · rw [hval]
              positivity
            · rw [hfabs]
              nlinarith [aux_two_pi]
            · nlinarith [hkeyST, hCC]
            · gcongr
        | incoming =>
            have hfabs : |coordinateWaveRadialPhase CoordinateWavePart.incoming s -
                coordinateWaveRadialPhase CoordinateWavePart.incoming t| =
                2 * Real.pi * |s - t| := by
              rw [aux_phase_in, aux_phase_in,
                show 2 * Real.pi * s - 2 * Real.pi * t =
                  2 * Real.pi * (s - t) from by ring, abs_mul, habs2pi]
            refine (aux_resonant_term hderiv hcA hcAd _ _ hs ht hst hC.le hunif
              hfabs).trans ?_
            gcongr
        | middle =>
            have hval : coordinateWaveRadialPhase CoordinateWavePart.incoming s -
                coordinateWaveRadialPhase CoordinateWavePart.middle t =
                2 * Real.pi * s := by
              rw [aux_phase_in, aux_phase_mid]
              ring
            have hfabs : |coordinateWaveRadialPhase CoordinateWavePart.incoming s -
                coordinateWaveRadialPhase CoordinateWavePart.middle t| =
                2 * Real.pi * s := by
              rw [hval, abs_mul, habs2pi, abs_of_nonneg hs0.le]
            refine (aux_nonresonant_term hderiv hcA hcAd _ _ hs ht hts hst hC.le
              hunif hs0 ?_ ?_ ?_).trans ?_
            · rw [hval]
              positivity
            · rw [hfabs]
              nlinarith [aux_two_pi]
            · nlinarith [hkeyS, hCC]
            · gcongr
    | middle =>
        cases q with
        | outgoing =>
            have hval : coordinateWaveRadialPhase CoordinateWavePart.middle s -
                coordinateWaveRadialPhase CoordinateWavePart.outgoing t =
                2 * Real.pi * t := by
              rw [aux_phase_mid, aux_phase_out]
              ring
            have hfabs : |coordinateWaveRadialPhase CoordinateWavePart.middle s -
                coordinateWaveRadialPhase CoordinateWavePart.outgoing t| =
                2 * Real.pi * t := by
              rw [hval, abs_mul, habs2pi, abs_of_nonneg ht0.le]
            refine (aux_nonresonant_term hderiv hcA hcAd _ _ hs ht hts hst hC.le
              hunif ht0 ?_ ?_ ?_).trans ?_
            · rw [hval]
              positivity
            · rw [hfabs]
              nlinarith [aux_two_pi]
            · nlinarith [hkeyT, hCC]
            · gcongr
        | incoming =>
            have hval : coordinateWaveRadialPhase CoordinateWavePart.middle s -
                coordinateWaveRadialPhase CoordinateWavePart.incoming t =
                -(2 * Real.pi * t) := by
              rw [aux_phase_mid, aux_phase_in]
              ring
            have hfabs : |coordinateWaveRadialPhase CoordinateWavePart.middle s -
                coordinateWaveRadialPhase CoordinateWavePart.incoming t| =
                2 * Real.pi * t := by
              rw [hval, abs_neg, abs_mul, habs2pi, abs_of_nonneg ht0.le]
            refine (aux_nonresonant_term hderiv hcA hcAd _ _ hs ht hts hst hC.le
              hunif ht0 ?_ ?_ ?_).trans ?_
            · rw [hval]
              intro hcon
              have : (0 : ℝ) < 2 * Real.pi * t := by positivity
              simp only [neg_eq_zero] at hcon
              linarith
            · rw [hfabs]
              nlinarith [aux_two_pi]
            · nlinarith [hkeyT, hCC]
            · gcongr
        | middle =>
            refine (dvKernelTerm_middle_bound hs ht hCm hm).trans ?_
            have hs2 : s ≤ s ^ 2 := by nlinarith
            have ht2 : t ≤ t ^ 2 := by nlinarith
            have hstle : s * t ≤ s ^ 2 * t ^ 2 := by
              calc s * t ≤ s ^ 2 * t := by gcongr
                _ ≤ s ^ 2 * t ^ 2 := by gcongr
            have heq : (180 : ℝ) * (Cm / s ^ 2) * (Cm / t ^ 2) =
                180 * (Cm * Cm) * (s ^ 2 * t ^ 2)⁻¹ := by
              field_simp
            rw [heq]
            calc (180 : ℝ) * (Cm * Cm) * (s ^ 2 * t ^ 2)⁻¹
                ≤ 180 * (Cm * Cm) * (s * t)⁻¹ := by
                  gcongr
              _ ≤ 180 * (Cm * Cm) * (102 * ((s⁻¹ + t⁻¹) / (1 + |s - t|))) := by
                  gcongr
                  exact aux_inv_st_le_bnd hs ht hts hst
              _ = 18360 * (Cm * Cm) * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by ring
              _ ≤ KT * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by gcongr
  rw [dvKernel_eq_sum hcA hexp]
  calc ‖∑ p ∈ dvParts, ∑ q ∈ dvParts, dvKernelTermOf Amp p q s t‖
      ≤ ∑ p ∈ dvParts, ‖∑ q ∈ dvParts, dvKernelTermOf Amp p q s t‖ := norm_sum_le _ _
    _ ≤ ∑ p ∈ dvParts, ∑ q ∈ dvParts, ‖dvKernelTermOf Amp p q s t‖ :=
        Finset.sum_le_sum fun p _ => norm_sum_le _ _
    _ ≤ ∑ p ∈ dvParts, ∑ q ∈ dvParts, KT * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) :=
        Finset.sum_le_sum fun p _ => Finset.sum_le_sum fun q _ => hterm p q
    _ = 9 * KT * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by
        simp only [dvParts_sum]
        ring
    _ = 9 * (673200 * (C * C) + 13200 * (C * C) + 18360 * (Cm * Cm) + 1) *
          ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by rw [hKTdef]




/-- **The Phase D radial kernel bound for the bare circle surface factor.** -/
theorem exists_dvKernel_bound :
    ∃ C : ℝ, 0 < C ∧ ∀ s t : ℝ, 1 ≤ s → 1 ≤ t → t ≤ 100 * s → s ≤ 100 * t →
      ‖∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) *
          planarCoordinateSurfaceWaveSum (s * r) *
            (starRingEnd ℂ) (planarCoordinateSurfaceWaveSum (t * r))‖ ≤
        C * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by
  obtain ⟨C, hC, hunif⟩ := exists_dvUniform_bound
  obtain ⟨Cm, hCm, hm⟩ := exists_planarAmplitude_middle_bound
  refine ⟨9 * (673200 * (C * C) + 13200 * (C * C) + 18360 * (Cm * Cm) + 1),
    by positivity, ?_⟩
  exact dvKernel_bound_of_abstract
    (Amp := planarCoordinateWaveRadialAmplitude) (AmpD := dvAmpDeriv)
    (Sig := fun u r => planarCoordinateSurfaceWaveSum (u * r))
    (fun p u r => hasDerivAt_planarCoordinateWaveRadialAmplitude p u r)
    (fun p u => continuous_planarCoordinateWaveRadialAmplitude p u)
    (fun p u => continuous_dvAmpDeriv p u)
    (fun u r => by
      rw [dvParts_sum]
      exact planarCoordinateSurfaceWaveSum_eq_three_radialTerms u r)
    hC hCm hunif hm

/-! ### Schur's test

The Phase D quadratic form is estimated by the symmetric form of Schur's
test, which in `ℝ≥0∞` needs no integrability side conditions. -/

private theorem aux_cancel_two {b c : ℝ≥0∞} (h : 2 * b ≤ 2 * c) : b ≤ c := by
  by_contra hcon
  rw [not_le] at hcon
  have h2 : c * (2 : ℝ≥0∞) < b * 2 :=
    ENNReal.mul_lt_mul_left (a := (2 : ℝ≥0∞)) (by norm_num) (by norm_num) hcon
  rw [mul_comm c 2, mul_comm b 2] at h2
  exact absurd h (not_le.mpr h2)

theorem two_mul_mul_le_sq_add_sq (a b : ℝ≥0∞) : 2 * (a * b) ≤ a ^ 2 + b ^ 2 := by
  by_cases ha : a = ∞
  · by_cases hb : b = 0
    · subst hb
      simp
    · have : a * b = ∞ := by
        rw [ha]
        exact ENNReal.top_mul hb
      rw [this, ha]
      simp
  · by_cases hb : b = ∞
    · by_cases ha0 : a = 0
      · subst ha0
        simp
      · have : a * b = ∞ := by
          rw [hb]
          exact ENNReal.mul_top ha0
        rw [this, hb]
        simp
    · lift a to ℝ≥0 using ha with a'
      lift b to ℝ≥0 using hb with b'
      have hreal : 2 * (a' * b') ≤ a' ^ 2 + b' ^ 2 := by
        have h := sq_nonneg ((a' : ℝ) - (b' : ℝ))
        have : ((2 * (a' * b') : ℝ≥0) : ℝ) ≤ ((a' ^ 2 + b' ^ 2 : ℝ≥0) : ℝ) := by
          push_cast
          nlinarith
        exact_mod_cast this
      calc (2 : ℝ≥0∞) * ((a' : ℝ≥0∞) * (b' : ℝ≥0∞))
          = ((2 * (a' * b') : ℝ≥0) : ℝ≥0∞) := by
            push_cast
            ring
        _ ≤ ((a' ^ 2 + b' ^ 2 : ℝ≥0) : ℝ≥0∞) := by
            exact_mod_cast hreal
        _ = (a' : ℝ≥0∞) ^ 2 + (b' : ℝ≥0∞) ^ 2 := by push_cast; ring

/-- **Schur's test**, symmetric form.  A symmetric nonnegative kernel with
uniformly bounded rows defines a bounded quadratic form on `L²`. -/
theorem schur_lintegral {X : Type*} [MeasurableSpace X] {μ : Measure X}
    [SFinite μ] {N : X → X → ℝ≥0∞} {u : X → ℝ≥0∞} {A : ℝ≥0∞}
    (hsymm : ∀ x y, N x y = N y x)
    (hN : Measurable fun p : X × X => N p.1 p.2)
    (hu : Measurable u)
    (hrow : ∀ x, (∫⁻ y, N x y ∂μ) ≤ A) :
    (∫⁻ x, ∫⁻ y, N x y * (u x * u y) ∂μ ∂μ) ≤ A * ∫⁻ x, u x ^ 2 ∂μ := by
  have hmeasRow : ∀ x, Measurable fun y => N x y := fun x => hN.comp measurable_prodMk_left
  have hmeasCol : ∀ y, Measurable fun x => N x y := fun y => hN.comp measurable_prodMk_right
  -- the two one-sided pieces
  have hleft : (∫⁻ x, ∫⁻ y, N x y * u x ^ 2 ∂μ ∂μ) ≤ A * ∫⁻ x, u x ^ 2 ∂μ := by
    have hstep : ∀ x, (∫⁻ y, N x y * u x ^ 2 ∂μ) ≤ A * u x ^ 2 := by
      intro x
      rw [lintegral_mul_const _ (hmeasRow x)]
      exact mul_le_mul' (hrow x) le_rfl
    calc (∫⁻ x, ∫⁻ y, N x y * u x ^ 2 ∂μ ∂μ) ≤ ∫⁻ x, A * u x ^ 2 ∂μ :=
          lintegral_mono hstep
      _ = A * ∫⁻ x, u x ^ 2 ∂μ := lintegral_const_mul A (hu.pow_const 2)
  have hright : (∫⁻ x, ∫⁻ y, N x y * u y ^ 2 ∂μ ∂μ) ≤ A * ∫⁻ x, u x ^ 2 ∂μ := by
    have hswap : (∫⁻ x, ∫⁻ y, N x y * u y ^ 2 ∂μ ∂μ) =
        ∫⁻ y, ∫⁻ x, N x y * u y ^ 2 ∂μ ∂μ := by
      refine lintegral_lintegral_swap ?_
      exact (hN.mul ((hu.comp measurable_snd).pow_const 2)).aemeasurable
    rw [hswap]
    have hstep : ∀ y, (∫⁻ x, N x y * u y ^ 2 ∂μ) ≤ A * u y ^ 2 := by
      intro y
      rw [lintegral_mul_const _ (hmeasCol y)]
      refine mul_le_mul' ?_ le_rfl
      calc (∫⁻ x, N x y ∂μ) = ∫⁻ x, N y x ∂μ := by
            refine lintegral_congr fun x => ?_
            exact hsymm x y
        _ ≤ A := hrow y
    calc (∫⁻ y, ∫⁻ x, N x y * u y ^ 2 ∂μ ∂μ) ≤ ∫⁻ y, A * u y ^ 2 ∂μ :=
          lintegral_mono hstep
      _ = A * ∫⁻ y, u y ^ 2 ∂μ := lintegral_const_mul A (hu.pow_const 2)
  -- pointwise Schur bound and assembly
  have hpoint : ∀ x y, 2 * (N x y * (u x * u y)) ≤
      N x y * u x ^ 2 + N x y * u y ^ 2 := by
    intro x y
    calc 2 * (N x y * (u x * u y)) = N x y * (2 * (u x * u y)) := by ring
      _ ≤ N x y * (u x ^ 2 + u y ^ 2) := by
          exact mul_le_mul' le_rfl (two_mul_mul_le_sq_add_sq _ _)
      _ = N x y * u x ^ 2 + N x y * u y ^ 2 := by ring
  have hdouble : 2 * (∫⁻ x, ∫⁻ y, N x y * (u x * u y) ∂μ ∂μ) ≤
      2 * (A * ∫⁻ x, u x ^ 2 ∂μ) := by
    calc 2 * (∫⁻ x, ∫⁻ y, N x y * (u x * u y) ∂μ ∂μ)
        = ∫⁻ x, ∫⁻ y, 2 * (N x y * (u x * u y)) ∂μ ∂μ := by
          rw [← lintegral_const_mul' (2 : ℝ≥0∞) _ (by norm_num)]
          refine lintegral_congr fun x => ?_
          rw [← lintegral_const_mul' (2 : ℝ≥0∞) _ (by norm_num)]
      _ ≤ ∫⁻ x, ∫⁻ y, (N x y * u x ^ 2 + N x y * u y ^ 2) ∂μ ∂μ := by
          refine lintegral_mono fun x => lintegral_mono fun y => hpoint x y
      _ = (∫⁻ x, ∫⁻ y, N x y * u x ^ 2 ∂μ ∂μ) +
            ∫⁻ x, ∫⁻ y, N x y * u y ^ 2 ∂μ ∂μ := by
          rw [← lintegral_add_left]
          · refine lintegral_congr fun x => ?_
            refine lintegral_add_left ?_ _
            exact (hmeasRow x).mul_const _
          · exact (hN.mul ((hu.comp measurable_fst).pow_const 2)).lintegral_prod_right'
      _ ≤ (A * ∫⁻ x, u x ^ 2 ∂μ) + (A * ∫⁻ x, u x ^ 2 ∂μ) := by
          exact add_le_add hleft hright
      _ = 2 * (A * ∫⁻ x, u x ^ 2 ∂μ) := by ring
  exact aux_cancel_two hdouble


/-! ### The geometric row estimate

For Schur's test we need the `η`-row sum of the localized kernel.  In polar
coordinates the angular factor is a spherical cap, whose measure is
`O(R / t)`; the Jacobian `t` of the polar decomposition cancels that `1 / t`
exactly, leaving a one-dimensional radial integral of `(1 + |a - t|)⁻¹`, which
is logarithmic in the length of the band. -/

/-- The set of directions `ω` for which `t • ω` lies within `R` of `ξ` is the
cap of radius `R / t` about `t⁻¹ • ξ`. -/
theorem cap_set_eq (ξ : Euclidean 2) {t R : ℝ} (ht : 0 < t) :
    {ω : Metric.sphere (0 : Euclidean 2) 1 | ‖ξ - t • (ω : Euclidean 2)‖ < R} =
      (fun ω : Metric.sphere (0 : Euclidean 2) 1 => (ω : Euclidean 2)) ⁻¹'
        Metric.ball (t⁻¹ • ξ) (R / t) := by
  ext ω
  simp only [Set.mem_setOf_eq, Set.mem_preimage, Metric.mem_ball, dist_eq_norm]
  constructor
  · intro h
    have hrw : (ω : Euclidean 2) - t⁻¹ • ξ = -(t⁻¹ • (ξ - t • (ω : Euclidean 2))) := by
      rw [smul_sub, smul_smul, inv_mul_cancel₀ ht.ne', one_smul]
      abel
    rw [hrw, norm_neg, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ht),
      inv_mul_eq_div, div_lt_div_iff_of_pos_right ht]
    exact h
  · intro h
    have hrw : ξ - t • (ω : Euclidean 2) = -(t • ((ω : Euclidean 2) - t⁻¹ • ξ)) := by
      rw [smul_sub, smul_smul, mul_inv_cancel₀ ht.ne', one_smul]
      abel
    rw [hrw, norm_neg, norm_smul, Real.norm_eq_abs, abs_of_pos ht]
    calc t * ‖(ω : Euclidean 2) - t⁻¹ • ξ‖ < t * (R / t) :=
          mul_lt_mul_of_pos_left h ht
      _ = R := by field_simp

/-- Uniform cap bound in the form needed by the polar row estimate. -/
theorem exists_dvCap_bound :
    ∃ C : ℝ≥0∞, C ≠ ⊤ ∧ ∀ (ξ : Euclidean 2) (t R : ℝ), 0 < t → 0 ≤ R →
      (unitSurfaceMeasure 2)
          {ω : Metric.sphere (0 : Euclidean 2) 1 | ‖ξ - t • (ω : Euclidean 2)‖ < R} ≤
        C * ENNReal.ofReal (R / t) := by
  obtain ⟨C, hCtop, hC⟩ := exists_unitSurfaceMeasure_cap_le_power (d := 2) (by norm_num)
  refine ⟨C, hCtop, ?_⟩
  intro ξ t R ht hR
  rw [cap_set_eq ξ ht]
  have h := hC (t⁻¹ • ξ) (R / t) (by positivity)
  simpa using h

/-! #### The one-dimensional logarithmic radial integral -/

private theorem aux_log_ratio {a c d : ℝ} (hcd : c ≤ d) (hac : a ≤ c) :
    Real.log ((1 + (d - a)) / (1 + (c - a))) ≤ Real.log (1 + (d - c)) := by
  have h1 : (0 : ℝ) < 1 + (c - a) := by linarith
  have h2 : (1 + (d - a)) / (1 + (c - a)) ≤ 1 + (d - c) := by
    rw [div_le_iff₀ h1]
    nlinarith
  have h3 : (0 : ℝ) < (1 + (d - a)) / (1 + (c - a)) := div_pos (by linarith) h1
  exact Real.log_le_log h3 h2

private theorem aux_int_right {a c d : ℝ} (hcd : c ≤ d) (hac : a ≤ c) :
    (∫ t in c..d, (1 + |a - t|)⁻¹) ≤ Real.log (1 + (d - c)) := by
  have hcongr : (∫ t in c..d, (1 + |a - t|)⁻¹) = ∫ t in c..d, (t - (a - 1))⁻¹ := by
    refine intervalIntegral.integral_congr fun t ht => ?_
    rw [Set.uIcc_of_le hcd] at ht
    rw [abs_of_nonpos (by linarith [ht.1] : a - t ≤ 0)]
    congr 1
    ring
  rw [hcongr]
  have hshift : (∫ t in c..d, (t - (a - 1))⁻¹) =
      ∫ x in (c - (a - 1))..(d - (a - 1)), x⁻¹ :=
    intervalIntegral.integral_comp_sub_right (fun x : ℝ => x⁻¹) (a - 1)
  rw [hshift, integral_inv_of_pos (by linarith) (by linarith)]
  have hrw : (d - (a - 1)) / (c - (a - 1)) = (1 + (d - a)) / (1 + (c - a)) := by
    congr 1 <;> ring
  rw [hrw]
  exact aux_log_ratio hcd hac

private theorem aux_int_left {a c d : ℝ} (hcd : c ≤ d) (hda : d ≤ a) :
    (∫ t in c..d, (1 + |a - t|)⁻¹) ≤ Real.log (1 + (d - c)) := by
  have hcongr : (∫ t in c..d, (1 + |a - t|)⁻¹) = ∫ t in c..d, ((a + 1) - t)⁻¹ := by
    refine intervalIntegral.integral_congr fun t ht => ?_
    rw [Set.uIcc_of_le hcd] at ht
    rw [abs_of_nonneg (by linarith [ht.2] : (0 : ℝ) ≤ a - t)]
    congr 1
    ring
  rw [hcongr]
  have hshift : (∫ t in c..d, ((a + 1) - t)⁻¹) =
      ∫ x in ((a + 1) - d)..((a + 1) - c), x⁻¹ :=
    intervalIntegral.integral_comp_sub_left (fun x : ℝ => x⁻¹) (a + 1)
  rw [hshift, integral_inv_of_pos (by linarith) (by linarith)]
  have hrw : ((a + 1) - c) / ((a + 1) - d) = (1 + (a - c)) / (1 + (a - d)) := by
    congr 1 <;> ring
  rw [hrw]
  have h1 : (0 : ℝ) < 1 + (a - d) := by linarith
  have h2 : (1 + (a - c)) / (1 + (a - d)) ≤ 1 + (d - c) := by
    rw [div_le_iff₀ h1]
    nlinarith
  have h3 : (0 : ℝ) < (1 + (a - c)) / (1 + (a - d)) := div_pos (by linarith) h1
  exact Real.log_le_log h3 h2

/-- The radial integral of `(1 + |a - t|)⁻¹` over an interval is at most twice
the logarithm of one plus the length of the interval. -/
theorem integral_inv_one_add_abs_le {a c d : ℝ} (hcd : c ≤ d) :
    (∫ t in c..d, (1 + |a - t|)⁻¹) ≤ 2 * Real.log (1 + (d - c)) := by
  have hlog0 : (0 : ℝ) ≤ Real.log (1 + (d - c)) :=
    Real.log_nonneg (by linarith)
  rcases le_or_gt a c with hac | hca
  · exact (aux_int_right hcd hac).trans (by linarith)
  rcases le_or_gt d a with hda | had
  · exact (aux_int_left hcd hda).trans (by linarith)
  -- `c < a < d`: split at `a`
  have hca' : c ≤ a := le_of_lt hca
  have had' : a ≤ d := le_of_lt had
  have hcont : ∀ u v : ℝ, IntervalIntegrable (fun t : ℝ => (1 + |a - t|)⁻¹) volume u v := by
    intro u v
    apply ContinuousOn.intervalIntegrable
    apply ContinuousOn.inv₀
    · fun_prop
    · intro t _
      positivity
  have hsplit : (∫ t in c..d, (1 + |a - t|)⁻¹) =
      (∫ t in c..a, (1 + |a - t|)⁻¹) + ∫ t in a..d, (1 + |a - t|)⁻¹ :=
    (intervalIntegral.integral_add_adjacent_intervals (hcont c a) (hcont a d)).symm
  have h1 : (∫ t in c..a, (1 + |a - t|)⁻¹) ≤ Real.log (1 + (a - c)) :=
    aux_int_left hca' le_rfl
  have h2 : (∫ t in a..d, (1 + |a - t|)⁻¹) ≤ Real.log (1 + (d - a)) :=
    aux_int_right had' le_rfl
  have hm1 : Real.log (1 + (a - c)) ≤ Real.log (1 + (d - c)) := by
    apply Real.log_le_log (by linarith)
    linarith
  have hm2 : Real.log (1 + (d - a)) ≤ Real.log (1 + (d - c)) := by
    apply Real.log_le_log (by linarith)
    linarith
  rw [hsplit]
  linarith


/-! ### The spatial weight profile and the Schur row estimate -/

/-- The base bump used to build the spatial weight profile. -/
def dvBump : ContDiffBump (0 : Euclidean 2) := ⟨1 / 128, 1 / 64, by norm_num, by norm_num⟩

/-- The normalized bump: nonnegative, of unit mass, supported in a small ball. -/
def dvChi : Euclidean 2 → ℝ := dvBump.normed volume

/-- The complex-valued version of `dvChi`. -/
def dvChiC : Euclidean 2 → ℂ := fun y => (dvChi y : ℂ)

theorem continuous_dvChi : Continuous dvChi := ContDiffBump.continuous_normed _

theorem dvChi_nonneg (y : Euclidean 2) : 0 ≤ dvChi y := ContDiffBump.nonneg_normed _ _

theorem integral_dvChi : ∫ y : Euclidean 2, dvChi y = 1 :=
  ContDiffBump.integral_normed dvBump

theorem dvChi_neg (y : Euclidean 2) : dvChi (-y) = dvChi y :=
  ContDiffBump.normed_neg _ _

theorem dvChi_eq_zero {y : Euclidean 2} (h : 1 / 64 ≤ ‖y‖) : dvChi y = 0 := by
  have hsupp : Function.support dvChi = Metric.ball (0 : Euclidean 2) dvBump.rOut :=
    ContDiffBump.support_normed_eq dvBump
  by_contra hne
  have hmem : y ∈ Function.support dvChi := hne
  rw [hsupp] at hmem
  rw [Metric.mem_ball, dist_zero_right] at hmem
  have : (dvBump.rOut : ℝ) = 1 / 64 := rfl
  rw [this] at hmem
  linarith

theorem hasCompactSupport_dvChi : HasCompactSupport dvChi :=
  ContDiffBump.hasCompactSupport_normed dvBump

theorem integrable_dvChi : Integrable dvChi volume :=
  ContDiffBump.integrable_normed dvBump

theorem continuous_dvChiC : Continuous dvChiC :=
  Complex.continuous_ofReal.comp continuous_dvChi

theorem integrable_dvChiC : Integrable dvChiC volume := by
  exact integrable_dvChi.ofReal

theorem conj_fourier_dvChiC (x : Euclidean 2) :
    (starRingEnd ℂ) (𝓕 dvChiC x) = 𝓕 dvChiC x := by
  have hstep : (starRingEnd ℂ) (𝓕 dvChiC x) =
      ∫ v : Euclidean 2,
        (starRingEnd ℂ) (Complex.exp ((↑(-2 * Real.pi * (inner ℝ v x : ℝ)) * Complex.I)) *
          dvChiC v) := by
    rw [Real.fourier_eq' dvChiC x, ← integral_conj]
    rfl
  rw [hstep, ← MeasureTheory.integral_neg_eq_self, Real.fourier_eq' dvChiC x]
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  simp only [smul_eq_mul, dvChiC, dvChi_neg, inner_neg_left, map_mul, Complex.conj_ofReal]
  congr 1
  rw [← Complex.exp_conj]
  congr 1
  simp only [map_mul, Complex.conj_I, Complex.conj_ofReal]
  push_cast
  ring

/-- The compactly supported inverse Fourier transform of the spatial profile. -/
def dvTheta : Euclidean 2 → ℂ :=
  dvChiC ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dvChiC

/-- The spatial weight profile. -/
def dvGb : Euclidean 2 → ℝ := fun x => ‖𝓕 dvChiC x‖ ^ 2

theorem dvGb_nonneg (x : Euclidean 2) : 0 ≤ dvGb x := by
  simp only [dvGb]
  positivity

theorem fourier_dvTheta (x : Euclidean 2) : 𝓕 dvTheta x = (dvGb x : ℂ) := by
  have hconv := Real.fourier_mul_convolution_eq (R := ℂ)
    integrable_dvChiC integrable_dvChiC x
  have hz : ((dvGb x : ℝ) : ℂ) = 𝓕 dvChiC x * 𝓕 dvChiC x := by
    have h1 : ((dvGb x : ℝ) : ℂ) = (Complex.normSq (𝓕 dvChiC x) : ℂ) := by
      simp only [dvGb, Complex.sq_norm]
    rw [h1, ← Complex.mul_conj, conj_fourier_dvChiC]
  rw [dvTheta, hconv, hz]

theorem dvTheta_eq_zero {x : Euclidean 2} (hx : 1 / 32 ≤ ‖x‖) : dvTheta x = 0 := by
  have hpt : ∀ y : Euclidean 2,
      (ContinuousLinearMap.mul ℂ ℂ) (dvChiC y) (dvChiC (x - y)) = 0 := by
    intro y
    by_cases hy : 1 / 64 ≤ ‖y‖
    · have : dvChiC y = 0 := by simp only [dvChiC, dvChi_eq_zero hy, Complex.ofReal_zero]
      simp [this]
    · have hy' : ‖y‖ < 1 / 64 := lt_of_not_ge hy
      have hxy : 1 / 64 ≤ ‖x - y‖ := by
        have := norm_sub_norm_le x y
        linarith
      have : dvChiC (x - y) = 0 := by
        simp only [dvChiC, dvChi_eq_zero hxy, Complex.ofReal_zero]
      simp [this]
  simp only [dvTheta, convolution_def]
  simp only [hpt]
  simp

theorem contDiff_dvChi : ContDiff ℝ (⊤ : ℕ∞) dvChi := dvBump.contDiff_normed (μ := volume)

theorem contDiff_dvChiC : ContDiff ℝ (⊤ : ℕ∞) dvChiC :=
  Complex.ofRealCLM.contDiff.comp contDiff_dvChi

theorem hasCompactSupport_dvChiC : HasCompactSupport dvChiC :=
  hasCompactSupport_dvChi.comp_left (by rfl)

/-- The bump as a Schwartz map. -/
def dvChiS : SchwartzMap (Euclidean 2) ℂ :=
  hasCompactSupport_dvChiC.toSchwartzMap contDiff_dvChiC

theorem dvChiS_coe : ((dvChiS : Euclidean 2 → ℂ)) = dvChiC := rfl

theorem memLp_two_fourier_dvChiC : MemLp (𝓕 dvChiC) 2 volume := by
  have h : 𝓕 dvChiC = ((𝓕 dvChiS : SchwartzMap (Euclidean 2) ℂ) : Euclidean 2 → ℂ) := by
    rw [SchwartzMap.fourier_coe, dvChiS_coe]
  rw [h]
  exact (𝓕 dvChiS : SchwartzMap (Euclidean 2) ℂ).memLp 2 volume

theorem integrable_dvGb : Integrable dvGb volume := by
  have hmeas : AEStronglyMeasurable (𝓕 dvChiC) volume :=
    memLp_two_fourier_dvChiC.aestronglyMeasurable
  exact (memLp_two_iff_integrable_sq_norm hmeas).mp memLp_two_fourier_dvChiC

theorem continuous_dvTheta : Continuous dvTheta :=
  hasCompactSupport_dvChiC.continuous_convolution_right _
    integrable_dvChiC.locallyIntegrable continuous_dvChiC

theorem hasCompactSupport_dvTheta : HasCompactSupport dvTheta := by
  apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclidean 2) (1 / 32 : ℝ))
  intro x hx
  refine dvTheta_eq_zero ?_
  rw [Metric.mem_closedBall, dist_zero_right] at hx
  exact le_of_not_ge hx

theorem integrable_dvTheta : Integrable dvTheta volume :=
  continuous_dvTheta.integrable_of_hasCompactSupport hasCompactSupport_dvTheta

theorem fourierInv_dvGb : 𝓕⁻ (fun x : Euclidean 2 => (dvGb x : ℂ)) = dvTheta := by
  have h : 𝓕 dvTheta = fun x : Euclidean 2 => (dvGb x : ℂ) := funext fourier_dvTheta
  rw [← h]
  refine continuous_dvTheta.fourierInv_fourier_eq integrable_dvTheta ?_
  rw [h]
  exact integrable_dvGb.ofReal

theorem norm_fourier_dvChiC_sub_one_le {x : Euclidean 2} (hx : ‖x‖ ≤ 1) :
    ‖𝓕 dvChiC x - 1‖ ≤ 1 / 4 := by
  set E : Euclidean 2 → ℂ := fun v =>
    Complex.exp ((↑(-2 * Real.pi * (inner ℝ v x : ℝ)) : ℂ) * Complex.I) with hEdef
  have hEnorm : ∀ v, ‖E v‖ = 1 := by
    intro v
    simp only [hEdef]
    rw [Complex.norm_exp]
    simp
  have hEcont : Continuous E := by
    simp only [hEdef]
    fun_prop
  have hint1 : Integrable (fun v : Euclidean 2 => E v * dvChiC v) volume := by
    refine Integrable.mono' integrable_dvChiC.norm ?_ ?_
    · exact (hEcont.mul continuous_dvChiC).aestronglyMeasurable
    · refine Filter.Eventually.of_forall fun v => ?_
      rw [norm_mul, hEnorm v, one_mul]
  have hfour : 𝓕 dvChiC x = ∫ v : Euclidean 2, E v * dvChiC v := by
    rw [Real.fourier_eq' dvChiC x]
    refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
    simp only [hEdef, smul_eq_mul]
  have hchiint : ∫ v : Euclidean 2, dvChiC v = 1 := by
    simp only [dvChiC]
    rw [integral_complex_ofReal, integral_dvChi, Complex.ofReal_one]
  have hsub : 𝓕 dvChiC x - 1 =
      ∫ v : Euclidean 2, (E v - 1) * dvChiC v := by
    have hstep : (∫ v : Euclidean 2, (E v - 1) * dvChiC v) =
        (∫ v : Euclidean 2, E v * dvChiC v) - ∫ v : Euclidean 2, dvChiC v := by
      rw [← integral_sub hint1 integrable_dvChiC]
      refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
      ring
    rw [hstep, hchiint, hfour]
  have hpt : ∀ v : Euclidean 2, ‖(E v - 1) * dvChiC v‖ ≤ 1 / 4 * dvChi v := by
    intro v
    have hchi : ‖dvChiC v‖ = dvChi v := by
      simp only [dvChiC, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (dvChi_nonneg v)]
    by_cases hv : 1 / 64 ≤ ‖v‖
    · rw [norm_mul, hchi, dvChi_eq_zero hv]
      simp
    · have hv' : ‖v‖ < 1 / 64 := lt_of_not_ge hv
      have hinner : |(inner ℝ v x : ℝ)| ≤ 1 / 64 := by
        have h1 : |(inner ℝ v x : ℝ)| ≤ ‖v‖ * ‖x‖ := abs_real_inner_le_norm v x
        have h2 : ‖v‖ * ‖x‖ ≤ (1 / 64) * 1 :=
          mul_le_mul hv'.le hx (norm_nonneg _) (by norm_num)
        linarith
      have hz : ‖((↑(-2 * Real.pi * (inner ℝ v x : ℝ)) : ℂ) * Complex.I)‖ =
          2 * Real.pi * |(inner ℝ v x : ℝ)| := by
        rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs,
          abs_mul, abs_mul, abs_neg, abs_two, abs_of_pos Real.pi_pos]
      have hpi := Real.pi_le_four
      have habs := abs_nonneg (inner ℝ v x : ℝ)
      have hzle : ‖((↑(-2 * Real.pi * (inner ℝ v x : ℝ)) : ℂ) * Complex.I)‖ ≤ 1 := by
        rw [hz]
        nlinarith
      have hexp := Complex.norm_exp_sub_one_le hzle
      have hexp' : ‖E v - 1‖ ≤ 2 * (2 * Real.pi * |(inner ℝ v x : ℝ)|) := by
        rw [← hz]
        simpa only [hEdef] using hexp
      have hbound : ‖E v - 1‖ ≤ 1 / 4 := by nlinarith
      rw [norm_mul, hchi]
      exact mul_le_mul_of_nonneg_right hbound (dvChi_nonneg v)
  have hfinal : ‖𝓕 dvChiC x - 1‖ ≤ ∫ v : Euclidean 2, 1 / 4 * dvChi v := by
    rw [hsub]
    exact norm_integral_le_of_norm_le (integrable_dvChi.const_mul (1 / 4))
      (Filter.Eventually.of_forall hpt)
  rw [integral_const_mul, integral_dvChi, mul_one] at hfinal
  exact hfinal

theorem dvGb_ge_of_norm_le_one {x : Euclidean 2} (hx : ‖x‖ ≤ 1) : (1 : ℝ) / 2 ≤ dvGb x := by
  have hkey := norm_fourier_dvChiC_sub_one_le hx
  have h1 : (3 : ℝ) / 4 ≤ ‖𝓕 dvChiC x‖ := by
    have h2 := norm_sub_norm_le (1 : ℂ) (𝓕 dvChiC x)
    rw [norm_one] at h2
    have h3 : ‖(1 : ℂ) - 𝓕 dvChiC x‖ = ‖𝓕 dvChiC x - 1‖ := by
      rw [norm_sub_rev]
    rw [h3] at h2
    linarith
  calc (1:ℝ)/2 ≤ (3/4) ^ 2 := by norm_num
    _ ≤ ‖𝓕 dvChiC x‖ ^ 2 := by gcongr
    _ = dvGb x := rfl

theorem continuous_dvGb : Continuous dvGb := by
  have h : 𝓕 dvChiC = ((𝓕 dvChiS : SchwartzMap (Euclidean 2) ℂ) : Euclidean 2 → ℂ) := by
    rw [SchwartzMap.fourier_coe, dvChiS_coe]
  have h2 : dvGb = fun x =>
      ‖((𝓕 dvChiS : SchwartzMap (Euclidean 2) ℂ) : Euclidean 2 → ℂ) x‖ ^ 2 := by
    funext x
    simp only [dvGb, h]
  rw [h2]
  exact ((𝓕 dvChiS : SchwartzMap (Euclidean 2) ℂ).continuous.norm.pow 2)

/-- **The spatial weight profile.**  A nonnegative continuous integrable
function, bounded below on the unit ball, whose inverse Fourier transform is
bounded and supported in a small ball. -/
theorem exists_dvProfile :
    ∃ (Gb : Euclidean 2 → ℝ) (Th : Euclidean 2 → ℂ) (A : ℝ),
      0 < A ∧ (∀ x, 0 ≤ Gb x) ∧ Continuous Gb ∧ Integrable Gb volume ∧
      (∀ x : Euclidean 2, ‖x‖ ≤ 1 → (1 : ℝ) / 2 ≤ Gb x) ∧
      𝓕⁻ (fun x : Euclidean 2 => (Gb x : ℂ)) = Th ∧
      (∀ ζ, ‖Th ζ‖ ≤ A) ∧ (∀ ζ : Euclidean 2, 1 / 32 ≤ ‖ζ‖ → Th ζ = 0) := by
  obtain ⟨A, hA⟩ :=
    continuous_dvTheta.bounded_above_of_compact_support hasCompactSupport_dvTheta
  refine ⟨dvGb, dvTheta, A + 1, ?_, dvGb_nonneg, continuous_dvGb, integrable_dvGb,
    fun x hx => dvGb_ge_of_norm_le_one hx, fourierInv_dvGb, fun ζ => ?_,
    fun ζ hζ => dvTheta_eq_zero hζ⟩
  · have h0 : (0 : ℝ) ≤ A := le_trans (norm_nonneg _) (hA 0)
    linarith
  · exact le_trans (hA ζ) (by linarith)

theorem continuousOn_inv_one_add_abs (s : ℝ) (I : Set ℝ) :
    ContinuousOn (fun r : ℝ => (1 + |s - r|)⁻¹) I := by
  apply ContinuousOn.inv₀
  · fun_prop
  · intro t _
    positivity

theorem lintegral_inv_one_add_abs_le {s T : ℝ} (hT : 0 ≤ T) :
    (∫⁻ r in Ioc (0 : ℝ) T, ENNReal.ofReal ((1 + |s - r|)⁻¹)) ≤
      ENNReal.ofReal (2 * Real.log (1 + T)) := by
  have hcont : ContinuousOn (fun r : ℝ => (1 + |s - r|)⁻¹) (Icc (0 : ℝ) T) :=
    continuousOn_inv_one_add_abs s _
  have hintable : IntegrableOn (fun r : ℝ => (1 + |s - r|)⁻¹) (Ioc (0 : ℝ) T) volume := by
    have := hcont.integrableOn_compact (μ := (volume : Measure ℝ)) isCompact_Icc
    exact this.mono_set Ioc_subset_Icc_self
  have hnn : (0 : ℝ → ℝ) ≤ᵐ[volume.restrict (Ioc (0 : ℝ) T)]
      fun r : ℝ => (1 + |s - r|)⁻¹ := by
    refine Filter.Eventually.of_forall fun r => ?_
    positivity
  rw [← MeasureTheory.ofReal_integral_eq_lintegral_ofReal hintable hnn]
  refine ENNReal.ofReal_le_ofReal ?_
  have hswitch : (∫ r in Ioc (0 : ℝ) T, (1 + |s - r|)⁻¹) =
      ∫ r in (0 : ℝ)..T, (1 + |s - r|)⁻¹ := by
    rw [intervalIntegral.integral_of_le hT]
  rw [hswitch]
  have := integral_inv_one_add_abs_le (a := s) (c := 0) (d := T) hT
  simpa using this

theorem dvRow_polar (H : Euclidean 2 → ℝ≥0∞) (hH : Measurable H) :
    (∫⁻ η : Euclidean 2, H η) =
      ∫⁻ r in Ioi (0 : ℝ), ENNReal.ofReal r *
        ∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
          H (r • (ω : Euclidean 2)) ∂(unitSurfaceMeasure 2) := by
  rw [lintegral_polar_unitSurfaceMeasure (d := 2) (by norm_num) H]
  rw [MeasureTheory.lintegral_prod_symm]
  · rw [lintegral_volumeIoiPow 1 (fun r : ℝ => ∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
        H (r • (ω : Euclidean 2)) ∂(unitSurfaceMeasure 2)) ?_]
    · simp only [pow_one]
    · have hprod : Measurable (fun p : ℝ × Metric.sphere (0 : Euclidean 2) 1 =>
          H (p.1 • (p.2 : Euclidean 2))) :=
        hH.comp (measurable_fst.smul (measurable_subtype_coe.comp measurable_snd))
      exact hprod.lintegral_prod_right'
  · have hprod : Measurable (fun p : Metric.sphere (0 : Euclidean 2) 1 × Ioi (0 : ℝ) =>
        H (p.2.1 • (p.1 : Euclidean 2))) :=
      hH.comp ((measurable_subtype_coe.comp measurable_snd).smul
        (measurable_subtype_coe.comp measurable_fst))
    exact hprod.aemeasurable

theorem measurableSet_dvCap (ξ : Euclidean 2) (r R : ℝ) :
    MeasurableSet {ω : Metric.sphere (0 : Euclidean 2) 1 | ‖ξ - r • (ω : Euclidean 2)‖ < R} := by
  have hcont : Continuous fun ω : Metric.sphere (0 : Euclidean 2) 1 =>
      ‖ξ - r • (ω : Euclidean 2)‖ := by
    fun_prop
  exact hcont.measurable (measurableSet_Iio (a := R))

theorem dvRow_le_aux (Th : Euclidean 2 → ℂ) (Q : Euclidean 2 → ℝ≥0∞) {P R T : ℝ}
    {ξ : Euclidean 2} {Bnd : ℝ≥0∞}
    (hP : 0 ≤ P) (hT : 0 ≤ T)
    (hThmeas : Measurable Th) (hQmeas : Measurable Q)
    (hbd : ∀ ζ, ‖Th ζ‖ ≤ P) (hsupp : ∀ ζ : Euclidean 2, R ≤ ‖ζ‖ → Th ζ = 0)
    (hQ : ∀ η : Euclidean 2, Q η ≤ ENNReal.ofReal ((1 + |‖ξ‖ - ‖η‖|)⁻¹))
    (hQ0 : ∀ η : Euclidean 2, T < ‖η‖ → Q η = 0)
    (hcap : ∀ r : ℝ, 0 < r → r ≤ T →
      ENNReal.ofReal r *
        (unitSurfaceMeasure 2)
          {ω : Metric.sphere (0 : Euclidean 2) 1 | ‖ξ - r • (ω : Euclidean 2)‖ < R} ≤ Bnd) :
    (∫⁻ η : Euclidean 2, ENNReal.ofReal ‖Th (ξ - η)‖ * Q η) ≤
      ENNReal.ofReal P * Bnd * ENNReal.ofReal (2 * Real.log (1 + T)) := by
  have hmeas : Measurable fun η : Euclidean 2 => ENNReal.ofReal ‖Th (ξ - η)‖ * Q η := by
    refine Measurable.mul ?_ hQmeas
    exact ((hThmeas.comp (measurable_const.sub measurable_id)).norm).ennreal_ofReal
  rw [dvRow_polar _ hmeas]
  -- the inner spherical integral for a fixed radius
  have hinner : ∀ r : ℝ, 0 < r →
      (∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
        ENNReal.ofReal ‖Th (ξ - r • (ω : Euclidean 2))‖ * Q (r • (ω : Euclidean 2))
          ∂(unitSurfaceMeasure 2)) ≤
        ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) *
          (ENNReal.ofReal P *
            (unitSurfaceMeasure 2)
              {ω : Metric.sphere (0 : Euclidean 2) 1 |
                ‖ξ - r • (ω : Euclidean 2)‖ < R}) := by
    intro r hr
    have hstep : ∀ ω : Metric.sphere (0 : Euclidean 2) 1,
        ENNReal.ofReal ‖Th (ξ - r • (ω : Euclidean 2))‖ * Q (r • (ω : Euclidean 2)) ≤
          ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) *
            Set.indicator {ω : Metric.sphere (0 : Euclidean 2) 1 |
              ‖ξ - r • (ω : Euclidean 2)‖ < R}
              (fun _ => ENNReal.ofReal P) ω := by
      intro ω
      have hnorm : ‖r • (ω : Euclidean 2)‖ = r := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr]
        have : ‖(ω : Euclidean 2)‖ = 1 := by
          have := ω.2
          rw [mem_sphere_iff_norm, sub_zero] at this
          exact this
        rw [this, mul_one]
      have hQle : Q (r • (ω : Euclidean 2)) ≤ ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) := by
        have := hQ (r • (ω : Euclidean 2))
        rwa [hnorm] at this
      by_cases hcapmem : ‖ξ - r • (ω : Euclidean 2)‖ < R
      · rw [Set.indicator_of_mem (show ω ∈ {ω : Metric.sphere (0 : Euclidean 2) 1 |
          ‖ξ - r • (ω : Euclidean 2)‖ < R} from hcapmem)]
        rw [mul_comm]
        exact mul_le_mul' hQle (ENNReal.ofReal_le_ofReal (hbd (ξ - r • (ω : Euclidean 2))))
      · have hz : Th (ξ - r • (ω : Euclidean 2)) = 0 :=
          hsupp _ (le_of_not_gt hcapmem)
        rw [hz]
        simp
    calc (∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
          ENNReal.ofReal ‖Th (ξ - r • (ω : Euclidean 2))‖ * Q (r • (ω : Euclidean 2))
            ∂(unitSurfaceMeasure 2)) ≤
        ∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
          ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) *
            Set.indicator {ω : Metric.sphere (0 : Euclidean 2) 1 |
              ‖ξ - r • (ω : Euclidean 2)‖ < R}
              (fun _ => ENNReal.ofReal P) ω ∂(unitSurfaceMeasure 2) :=
          lintegral_mono hstep
      _ = ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) *
            ∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
              Set.indicator {ω : Metric.sphere (0 : Euclidean 2) 1 |
                ‖ξ - r • (ω : Euclidean 2)‖ < R}
                (fun _ => ENNReal.ofReal P) ω ∂(unitSurfaceMeasure 2) := by
          rw [lintegral_const_mul]
          exact measurable_const.indicator (measurableSet_dvCap ξ r R)
      _ = ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) *
            (ENNReal.ofReal P *
              (unitSurfaceMeasure 2)
                {ω : Metric.sphere (0 : Euclidean 2) 1 |
                  ‖ξ - r • (ω : Euclidean 2)‖ < R}) := by
          rw [lintegral_indicator_const (measurableSet_dvCap ξ r R)]
  -- the slices beyond the cutoff radius vanish
  have hzero : ∀ r : ℝ, T < r →
      (∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
        ENNReal.ofReal ‖Th (ξ - r • (ω : Euclidean 2))‖ * Q (r • (ω : Euclidean 2))
          ∂(unitSurfaceMeasure 2)) = 0 := by
    intro r hrT
    have hr : 0 < r := lt_of_le_of_lt hT hrT
    have hpt : ∀ ω : Metric.sphere (0 : Euclidean 2) 1,
        ENNReal.ofReal ‖Th (ξ - r • (ω : Euclidean 2))‖ * Q (r • (ω : Euclidean 2)) = 0 := by
      intro ω
      have hnorm : ‖r • (ω : Euclidean 2)‖ = r := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr]
        have hw : ‖(ω : Euclidean 2)‖ = 1 := by
          have := ω.2
          rw [mem_sphere_iff_norm, sub_zero] at this
          exact this
        rw [hw, mul_one]
      rw [hQ0 _ (by rw [hnorm]; exact hrT), mul_zero]
    simp only [hpt]
    simp
  have hpt : ∀ r ∈ Ioi (0 : ℝ),
      ENNReal.ofReal r *
        (∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
          ENNReal.ofReal ‖Th (ξ - r • (ω : Euclidean 2))‖ * Q (r • (ω : Euclidean 2))
            ∂(unitSurfaceMeasure 2)) ≤
      Set.indicator (Ioc (0 : ℝ) T)
        (fun r => ENNReal.ofReal P * Bnd * ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹)) r := by
    intro r hr
    have hr0 : 0 < r := hr
    by_cases hrT : r ≤ T
    · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) T from ⟨hr0, hrT⟩)]
      calc ENNReal.ofReal r *
            (∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
              ENNReal.ofReal ‖Th (ξ - r • (ω : Euclidean 2))‖ * Q (r • (ω : Euclidean 2))
                ∂(unitSurfaceMeasure 2)) ≤
          ENNReal.ofReal r *
            (ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) *
              (ENNReal.ofReal P *
                (unitSurfaceMeasure 2)
                  {ω : Metric.sphere (0 : Euclidean 2) 1 |
                    ‖ξ - r • (ω : Euclidean 2)‖ < R})) :=
            mul_le_mul' le_rfl (hinner r hr0)
        _ = ENNReal.ofReal P * ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) *
              (ENNReal.ofReal r *
                (unitSurfaceMeasure 2)
                  {ω : Metric.sphere (0 : Euclidean 2) 1 |
                    ‖ξ - r • (ω : Euclidean 2)‖ < R}) := by ring
        _ ≤ ENNReal.ofReal P * ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) * Bnd :=
            mul_le_mul' le_rfl (hcap r hr0 hrT)
        _ = ENNReal.ofReal P * Bnd * ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) := by ring
    · rw [hzero r (lt_of_not_ge hrT), mul_zero]
      exact bot_le
  calc (∫⁻ r in Ioi (0 : ℝ), ENNReal.ofReal r *
        ∫⁻ ω : Metric.sphere (0 : Euclidean 2) 1,
          ENNReal.ofReal ‖Th (ξ - r • (ω : Euclidean 2))‖ * Q (r • (ω : Euclidean 2))
            ∂(unitSurfaceMeasure 2)) ≤
      ∫⁻ r in Ioi (0 : ℝ), Set.indicator (Ioc (0 : ℝ) T)
        (fun r => ENNReal.ofReal P * Bnd * ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹)) r :=
        setLIntegral_mono' measurableSet_Ioi hpt
    _ = ∫⁻ r in Ioc (0 : ℝ) T,
        ENNReal.ofReal P * Bnd * ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) := by
        rw [lintegral_indicator measurableSet_Ioc,
          Measure.restrict_restrict measurableSet_Ioc]
        congr 1
        rw [Set.inter_eq_self_of_subset_left Ioc_subset_Ioi_self]
    _ = ENNReal.ofReal P * Bnd *
        ∫⁻ r in Ioc (0 : ℝ) T, ENNReal.ofReal ((1 + |‖ξ‖ - r|)⁻¹) := by
        rw [lintegral_const_mul]
        have hm : Measurable fun r : ℝ => ((1 + |‖ξ‖ - r|)⁻¹) := by fun_prop
        exact hm.ennreal_ofReal
    _ ≤ ENNReal.ofReal P * Bnd * ENNReal.ofReal (2 * Real.log (1 + T)) := by
        exact mul_le_mul' le_rfl (lintegral_inv_one_add_abs_le hT)

/-- **The Schur row estimate.**  The angular cap gain cancels the polar
Jacobian, leaving a logarithmic radial integral. -/
theorem exists_dvRow_bound :
    ∃ Cc : ℝ≥0∞, Cc ≠ ⊤ ∧ ∀ (Th : Euclidean 2 → ℂ) (Q : Euclidean 2 → ℝ≥0∞) (P R T : ℝ)
      (ξ : Euclidean 2), 0 ≤ P → 0 ≤ R → 0 ≤ T → Measurable Th → Measurable Q →
      (∀ ζ, ‖Th ζ‖ ≤ P) → (∀ ζ : Euclidean 2, R ≤ ‖ζ‖ → Th ζ = 0) →
      (∀ η : Euclidean 2, Q η ≤ ENNReal.ofReal ((1 + |‖ξ‖ - ‖η‖|)⁻¹)) →
      (∀ η : Euclidean 2, T < ‖η‖ → Q η = 0) →
      (∫⁻ η : Euclidean 2, ENNReal.ofReal ‖Th (ξ - η)‖ * Q η) ≤
        Cc * ENNReal.ofReal (P * min R T * (2 * Real.log (1 + T))) := by
  obtain ⟨Ccap, hCcap, hcapbd⟩ := exists_dvCap_bound
  refine ⟨Ccap + (unitSurfaceMeasure 2) univ + 1, ?_, ?_⟩
  · have h1 : (unitSurfaceMeasure 2) univ ≠ ⊤ := measure_ne_top _ _
    simp [hCcap, h1]
  intro Th Q P R T ξ hP hR hT hThmeas hQmeas hbd hsupp hQ hQ0
  have hL : (0 : ℝ) ≤ 2 * Real.log (1 + T) := by
    have := Real.log_nonneg (by linarith : (1 : ℝ) ≤ 1 + T)
    linarith
  by_cases hRT : R ≤ T
  · -- use the cap bound
    have hcap : ∀ r : ℝ, 0 < r → r ≤ T →
        ENNReal.ofReal r *
          (unitSurfaceMeasure 2)
            {ω : Metric.sphere (0 : Euclidean 2) 1 | ‖ξ - r • (ω : Euclidean 2)‖ < R} ≤
          Ccap * ENNReal.ofReal R := by
      intro r hr _
      calc ENNReal.ofReal r *
            (unitSurfaceMeasure 2)
              {ω : Metric.sphere (0 : Euclidean 2) 1 | ‖ξ - r • (ω : Euclidean 2)‖ < R} ≤
          ENNReal.ofReal r * (Ccap * ENNReal.ofReal (R / r)) :=
            mul_le_mul' le_rfl (hcapbd ξ r R hr hR)
        _ = Ccap * (ENNReal.ofReal r * ENNReal.ofReal (R / r)) := by ring
        _ = Ccap * ENNReal.ofReal R := by
            rw [← ENNReal.ofReal_mul hr.le]
            congr 2
            field_simp
    have hmain := dvRow_le_aux Th Q hP hT hThmeas hQmeas hbd hsupp hQ hQ0 hcap
    refine hmain.trans ?_
    rw [min_eq_left hRT]
    calc ENNReal.ofReal P * (Ccap * ENNReal.ofReal R) *
          ENNReal.ofReal (2 * Real.log (1 + T))
        = Ccap * (ENNReal.ofReal P * ENNReal.ofReal R *
            ENNReal.ofReal (2 * Real.log (1 + T))) := by ring
      _ = Ccap * ENNReal.ofReal (P * R * (2 * Real.log (1 + T))) := by
          rw [← ENNReal.ofReal_mul hP, ← ENNReal.ofReal_mul (by positivity)]
      _ ≤ (Ccap + (unitSurfaceMeasure 2) univ + 1) *
            ENNReal.ofReal (P * R * (2 * Real.log (1 + T))) := by
          gcongr
          exact le_add_right (le_add_right le_rfl)
  · -- use the total surface mass
    have hTR : T ≤ R := le_of_lt (lt_of_not_ge hRT)
    have hcap : ∀ r : ℝ, 0 < r → r ≤ T →
        ENNReal.ofReal r *
          (unitSurfaceMeasure 2)
            {ω : Metric.sphere (0 : Euclidean 2) 1 | ‖ξ - r • (ω : Euclidean 2)‖ < R} ≤
          ENNReal.ofReal T * (unitSurfaceMeasure 2) univ := by
      intro r hr hrT
      exact mul_le_mul' (ENNReal.ofReal_le_ofReal hrT) (measure_mono (subset_univ _))
    have hmain := dvRow_le_aux Th Q hP hT hThmeas hQmeas hbd hsupp hQ hQ0 hcap
    refine hmain.trans ?_
    rw [min_eq_right hTR]
    calc ENNReal.ofReal P * (ENNReal.ofReal T * (unitSurfaceMeasure 2) univ) *
          ENNReal.ofReal (2 * Real.log (1 + T))
        = (unitSurfaceMeasure 2) univ * (ENNReal.ofReal P * ENNReal.ofReal T *
            ENNReal.ofReal (2 * Real.log (1 + T))) := by ring
      _ = (unitSurfaceMeasure 2) univ * ENNReal.ofReal (P * T * (2 * Real.log (1 + T))) := by
          rw [← ENNReal.ofReal_mul hP, ← ENNReal.ofReal_mul (by positivity)]
      _ ≤ (Ccap + (unitSurfaceMeasure 2) univ + 1) *
            ENNReal.ofReal (P * T * (2 * Real.log (1 + T))) := by
          gcongr
          exact le_add_right (le_add_left le_rfl)

/-! ### The `TT*` identity and the weighted `L²` bound -/

/-- The inner-product pairing behind the planar inverse Fourier transform is
jointly continuous. -/
theorem dvInnerNegCont :
    Continuous fun p : Euclidean 2 × Euclidean 2 => -(inner ℝ p.1 p.2 : ℝ) :=
  continuous_inner.neg

theorem dvContinuous_fourierInv {A : Euclidean 2 → ℂ} (hA : Integrable A volume) :
    Continuous (𝓕⁻ A) := by
  have h : 𝓕⁻ A = VectorFourier.fourierIntegral 𝐞 volume (-innerₗ (Euclidean 2)) A := rfl
  rw [h]
  exact VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar dvInnerNegCont hA

theorem dvNorm_fourierInv_le {A : Euclidean 2 → ℂ} (x : Euclidean 2) :
    ‖𝓕⁻ A x‖ ≤ ∫ ξ : Euclidean 2, ‖A ξ‖ := by
  have h : 𝓕⁻ A x = VectorFourier.fourierIntegral 𝐞 volume (-innerₗ (Euclidean 2)) A x := rfl
  rw [h]
  exact VectorFourier.norm_fourierIntegral_le_integral_norm _ _ _ _ _

theorem dvIntegrable_mul_char {Gb : Euclidean 2 → ℂ} (hGc : Continuous Gb)
    (hG : Integrable Gb volume) (x : Euclidean 2) :
    Integrable (fun ξ : Euclidean 2 =>
      Gb ξ * ((Real.fourierChar (-(inner ℝ ξ x : ℝ)) : Circle) : ℂ)) volume := by
  refine Integrable.mono' hG.norm ?_ ?_
  · have hcont : Continuous fun ξ : Euclidean 2 =>
        Gb ξ * ((Real.fourierChar (-(inner ℝ ξ x : ℝ)) : Circle) : ℂ) := by
      refine hGc.mul ?_
      fun_prop
    exact hcont.aestronglyMeasurable
  · refine Filter.Eventually.of_forall fun ξ => ?_
    rw [norm_mul]
    have h1 : ‖((Real.fourierChar (-(inner ℝ ξ x : ℝ)) : Circle) : ℂ)‖ = 1 := by
      exact Circle.norm_coe _
    rw [h1, mul_one]

theorem dvIntegrable_mul_fourierInv {Gb A : Euclidean 2 → ℂ} (hGc : Continuous Gb)
    (hG : Integrable Gb volume) (hA : Integrable A volume) :
    Integrable (fun ξ : Euclidean 2 => Gb ξ * 𝓕⁻ A ξ) volume := by
  refine Integrable.mono' (hG.norm.const_mul (∫ ξ : Euclidean 2, ‖A ξ‖)) ?_ ?_
  · exact (hGc.mul (dvContinuous_fourierInv hA)).aestronglyMeasurable
  · refine Filter.Eventually.of_forall fun ξ => ?_
    rw [norm_mul]
    rw [mul_comm]
    exact mul_le_mul_of_nonneg_right (dvNorm_fourierInv_le ξ) (norm_nonneg _)

theorem dvFlipInner : (-(innerₗ (Euclidean 2))).flip = -(innerₗ (Euclidean 2)) := by
  ext u v
  simp [real_inner_comm]

theorem dvNegFlipInner : -(-(innerₗ (Euclidean 2))).flip = innerₗ (Euclidean 2) := by
  ext u v
  simp [real_inner_comm]

/-- Step C of the `TT*` expansion: the Fourier transform of the weighted
inverse transform is the frequency convolution with the transform of the
weight. -/
theorem dvTTStar_stepC {Gb A : Euclidean 2 → ℂ} (hGc : Continuous Gb)
    (hG : Integrable Gb volume) (hA : Integrable A volume) (x : Euclidean 2) :
    𝓕 (fun ξ : Euclidean 2 => Gb ξ * 𝓕⁻ A ξ) x =
      ∫ ζ : Euclidean 2, A ζ * 𝓕⁻ Gb (ζ - x) := by
  have hg := dvIntegrable_mul_char hGc hG x
  have key := VectorFourier.integral_bilin_fourierIntegral_eq_flip
    (μ := (volume : Measure (Euclidean 2))) (ν := (volume : Measure (Euclidean 2)))
    (L := -(innerₗ (Euclidean 2))) (e := Real.fourierChar)
    (f := A) (g := fun ξ : Euclidean 2 =>
      Gb ξ * ((Real.fourierChar (-(inner ℝ ξ x : ℝ)) : Circle) : ℂ))
    (ContinuousLinearMap.mul ℂ ℂ) Real.continuous_fourierChar dvInnerNegCont hA hg
  rw [dvFlipInner] at key
  have hL : (∫ (ξ : Euclidean 2),
      ((ContinuousLinearMap.mul ℂ ℂ)
        (VectorFourier.fourierIntegral 𝐞 volume (-innerₗ (Euclidean 2)) A ξ))
          (Gb ξ * ((Real.fourierChar (-(inner ℝ ξ x : ℝ)) : Circle) : ℂ))) =
      𝓕 (fun ξ : Euclidean 2 => Gb ξ * 𝓕⁻ A ξ) x := by
    rw [Real.fourier_eq]
    refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
    have h1 : VectorFourier.fourierIntegral 𝐞 volume (-innerₗ (Euclidean 2)) A ξ = 𝓕⁻ A ξ := rfl
    simp only [h1, ContinuousLinearMap.mul_apply', Circle.smul_def, smul_eq_mul]
    ring
  have hR : ∀ ζ : Euclidean 2,
      VectorFourier.fourierIntegral 𝐞 volume (-innerₗ (Euclidean 2))
        (fun ξ : Euclidean 2 =>
          Gb ξ * ((Real.fourierChar (-(inner ℝ ξ x : ℝ)) : Circle) : ℂ)) ζ =
        𝓕⁻ Gb (ζ - x) := by
    intro ζ
    have h2 : VectorFourier.fourierIntegral 𝐞 volume (-innerₗ (Euclidean 2))
        (fun ξ : Euclidean 2 =>
          Gb ξ * ((Real.fourierChar (-(inner ℝ ξ x : ℝ)) : Circle) : ℂ)) ζ =
        𝓕⁻ (fun ξ : Euclidean 2 =>
          Gb ξ * ((Real.fourierChar (-(inner ℝ ξ x : ℝ)) : Circle) : ℂ)) ζ := rfl
    rw [h2, Real.fourierInv_eq, Real.fourierInv_eq]
    refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
    simp only []
    rw [inner_sub_right]
    have hmul : ((Real.fourierChar ((inner ℝ ξ ζ : ℝ) - (inner ℝ ξ x : ℝ)) : Circle) : ℂ)
        = ((Real.fourierChar (inner ℝ ξ ζ : ℝ) : Circle) : ℂ) *
          ((Real.fourierChar (-(inner ℝ ξ x : ℝ)) : Circle) : ℂ) := by
      rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]
      congr 2
      try ring
    rw [Circle.smul_def, Circle.smul_def, smul_eq_mul, smul_eq_mul, hmul]
    ring
  simp only [ContinuousLinearMap.mul_apply', hR] at key hL
  rw [← hL]
  exact key

/-- Step A of the `TT*` expansion: Parseval for the weighted square. -/
theorem dvTTStar_stepA {Gb A : Euclidean 2 → ℂ} (hGc : Continuous Gb)
    (hG : Integrable Gb volume) (hA : Integrable A volume) :
    (∫ ξ : Euclidean 2, Gb ξ * 𝓕⁻ A ξ * (starRingEnd ℂ) (𝓕⁻ A ξ)) =
      ∫ η : Euclidean 2, 𝓕 (fun ξ : Euclidean 2 => Gb ξ * 𝓕⁻ A ξ) η *
        (starRingEnd ℂ) (A η) := by
  have hg := dvIntegrable_mul_fourierInv hGc hG hA
  have key := VectorFourier.integral_sesq_fourierIntegral_eq_neg_flip
    (μ := (volume : Measure (Euclidean 2))) (ν := (volume : Measure (Euclidean 2)))
    (L := -(innerₗ (Euclidean 2))) (e := Real.fourierChar)
    (f := A) (g := fun ξ : Euclidean 2 => Gb ξ * 𝓕⁻ A ξ)
    (innerSL ℂ) Real.continuous_fourierChar dvInnerNegCont hA hg
  rw [dvNegFlipInner] at key
  have h1 : ∀ ξ : Euclidean 2,
      VectorFourier.fourierIntegral 𝐞 volume (-innerₗ (Euclidean 2)) A ξ = 𝓕⁻ A ξ :=
    fun ξ => rfl
  have h2 : ∀ x : Euclidean 2,
      VectorFourier.fourierIntegral 𝐞 volume (innerₗ (Euclidean 2))
        (fun ξ : Euclidean 2 => Gb ξ * 𝓕⁻ A ξ) x =
        𝓕 (fun ξ : Euclidean 2 => Gb ξ * 𝓕⁻ A ξ) x :=
    fun x => rfl
  simp only [h1, h2] at key
  simpa [inner, mul_comm] using key

/-- **The `TT*` identity.** -/
theorem dvTTStar_pointwise {Gb A : Euclidean 2 → ℂ} (hGc : Continuous Gb)
    (hG : Integrable Gb volume) (hA : Integrable A volume) :
    (∫ ξ : Euclidean 2, Gb ξ * 𝓕⁻ A ξ * (starRingEnd ℂ) (𝓕⁻ A ξ)) =
      ∫ η : Euclidean 2, (∫ ζ : Euclidean 2, A ζ * 𝓕⁻ Gb (ζ - η)) *
        (starRingEnd ℂ) (A η) := by
  rw [dvTTStar_stepA hGc hG hA]
  refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
  simp only []
  rw [dvTTStar_stepC hGc hG hA η]

theorem dvOfReal_integral_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (g : α → ℝ) (hg : 0 ≤ᵐ[μ] g) :
    ENNReal.ofReal (∫ x, g x ∂μ) ≤ ∫⁻ x, ENNReal.ofReal (g x) ∂μ := by
  by_cases hi : Integrable g μ
  · rw [ofReal_integral_eq_lintegral_ofReal hi hg]
  · rw [integral_undef hi]
    simp

/-- The transform of a real weight has an even modulus. -/
theorem dvNorm_fourierInv_neg {Gb : Euclidean 2 → ℝ} (z : Euclidean 2) :
    ‖𝓕⁻ (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ)) (-z)‖ =
      ‖𝓕⁻ (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ)) z‖ := by
  have hconj : (starRingEnd ℂ) (𝓕⁻ (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ)) z) =
      𝓕⁻ (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ)) (-z) := by
    rw [Real.fourierInv_eq, Real.fourierInv_eq, ← integral_conj]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    simp only [Circle.smul_def, smul_eq_mul, map_mul, Complex.conj_ofReal, inner_neg_right]
    congr 1
    rw [← Circle.coe_inv_eq_conj, ← AddChar.map_neg_eq_inv]
  rw [← hconj, RCLike.norm_conj]

theorem dvIntegrable_indicator_prod {S : Set (Euclidean 2)} (hSmeas : MeasurableSet S)
    (hSfin : volume S ≠ ⊤) (C : ℝ) :
    Integrable (fun q : Euclidean 2 × Euclidean 2 =>
      C * (S.indicator (fun _ => (1 : ℝ)) q.1 * S.indicator (fun _ => (1 : ℝ)) q.2))
      (volume.prod volume) := by
  have h1 : Integrable (S.indicator (fun _ => (1 : ℝ))) volume := by
    rw [integrable_indicator_iff hSmeas]
    have hfin : volume S < ⊤ := lt_of_le_of_ne le_top hSfin
    exact integrableOn_const (by simpa using hfin.ne)
  exact (Integrable.mul_prod h1 h1).const_mul C

theorem dvSwap {a b : ℝ} (hab : a ≤ b) (W : ℝ → Euclidean 2 → Euclidean 2 → ℂ)
    (hWc : Continuous fun p : ℝ × Euclidean 2 × Euclidean 2 => W p.1 p.2.1 p.2.2)
    {S : Set (Euclidean 2)} (hSmeas : MeasurableSet S) (hSfin : volume S ≠ ⊤)
    {C : ℝ}
    (hWbd : ∀ t η ζ, ‖W t η ζ‖ ≤
      C * (S.indicator (fun _ => (1 : ℝ)) η * S.indicator (fun _ => (1 : ℝ)) ζ)) :
    (∫ t in a..b, ∫ η : Euclidean 2, ∫ ζ : Euclidean 2, W t η ζ) =
      ∫ η : Euclidean 2, ∫ ζ : Euclidean 2, ∫ t in a..b, W t η ζ := by
  have hμfin : IsFiniteMeasure (volume.restrict (Ioc a b)) := by
    constructor
    rw [Measure.restrict_apply_univ]
    exact measure_Ioc_lt_top
  have hmaj := dvIntegrable_indicator_prod hSmeas hSfin C
  have hprod : ∀ t : ℝ, Integrable (fun q : Euclidean 2 × Euclidean 2 => W t q.1 q.2)
      (volume.prod volume) := by
    intro t
    refine Integrable.mono' hmaj ?_ (Filter.Eventually.of_forall fun q => hWbd t q.1 q.2)
    have : Continuous fun q : Euclidean 2 × Euclidean 2 => W t q.1 q.2 :=
      hWc.comp (Continuous.prodMk continuous_const continuous_id)
    exact this.aestronglyMeasurable
  have hbig : Integrable
      (Function.uncurry fun (t : ℝ) (q : Euclidean 2 × Euclidean 2) => W t q.1 q.2)
      ((volume.restrict (Ioc a b)).prod (volume.prod volume)) := by
    refine Integrable.mono' ?_ ?_ (Filter.Eventually.of_forall fun p => hWbd p.1 p.2.1 p.2.2)
    · have hmb := Integrable.mul_prod
        (μ := volume.restrict (Ioc a b)) (integrable_const (1 : ℝ)) hmaj
      simpa using hmb
    · have hcc : Continuous fun p : ℝ × (Euclidean 2 × Euclidean 2) => W p.1 p.2.1 p.2.2 := hWc
      exact hcc.aestronglyMeasurable
  rw [intervalIntegral.integral_of_le hab]
  have hstep1 : (∫ t in Ioc a b, ∫ η : Euclidean 2, ∫ ζ : Euclidean 2, W t η ζ) =
      ∫ t, (∫ q : Euclidean 2 × Euclidean 2, W t q.1 q.2 ∂(volume.prod volume))
        ∂(volume.restrict (Ioc a b)) := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
    exact (integral_prod _ (hprod t)).symm
  rw [hstep1, integral_integral_swap hbig]
  have hfinal : Integrable (fun q : Euclidean 2 × Euclidean 2 =>
      ∫ t, W t q.1 q.2 ∂(volume.restrict (Ioc a b))) (volume.prod volume) :=
    MeasureTheory.Integrable.integral_prod_right hbig
  rw [integral_prod _ hfinal]
  refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
  refine integral_congr_ae (Filter.Eventually.of_forall fun ζ => ?_)
  simp only []
  rw [intervalIntegral.integral_of_le hab]

set_option maxHeartbeats 1000000 in
/-- **The weighted `L²` bound from a Schur row estimate.**  The `TT*` identity
turns the weighted space-time square into a frequency quadratic form whose
kernel is the product of the transform of the weight and the radial pair
kernel; Schur's test then gives the bound. -/
theorem dvWeightedSquare_le
    {Gb : Euclidean 2 → ℝ} (hGc : Continuous Gb)
    (hG : Integrable Gb volume)
    {a b : ℝ} (hab : a ≤ b)
    {m : ℝ → Euclidean 2 → ℂ} (hmc : Continuous fun p : ℝ × Euclidean 2 => m p.1 p.2)
    {S : Set (Euclidean 2)} (hSmeas : MeasurableSet S) (hSfin : volume S ≠ ⊤)
    {Cm : ℝ} (hmbd : ∀ (t : ℝ) (ξ : Euclidean 2), ‖m t ξ‖ ≤ Cm)
    (hmsupp : ∀ (t : ℝ) (ξ : Euclidean 2), ξ ∉ S → m t ξ = 0)
    {F : Euclidean 2 → ℂ} (hFc : Continuous F) {CF : ℝ} (hFbd : ∀ ξ, ‖F ξ‖ ≤ CF)
    {Arow : ℝ≥0∞}
    (hrow : ∀ ξ : Euclidean 2, (∫⁻ η : Euclidean 2,
        ENNReal.ofReal ‖𝓕⁻ (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ)) (η - ξ)‖ *
          ENNReal.ofReal ‖∫ t in a..b, m t η * (starRingEnd ℂ) (m t ξ)‖) ≤ Arow) :
    ENNReal.ofReal (∫ t in a..b, ∫ x : Euclidean 2,
        Gb x * ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2) ≤
      Arow * ∫⁻ ξ : Euclidean 2, (ENNReal.ofReal ‖F ξ‖) ^ 2 := by
  -- notation
  set Gc : Euclidean 2 → ℂ := fun x => ((Gb x : ℝ) : ℂ) with hGcdef
  set Th : Euclidean 2 → ℂ := 𝓕⁻ Gc with hThdef
  set A : ℝ → Euclidean 2 → ℂ := fun t ξ => m t ξ * F ξ with hAdef
  set K : Euclidean 2 → Euclidean 2 → ℂ :=
    fun η ζ => ∫ t in a..b, m t ζ * (starRingEnd ℂ) (m t η) with hKdef
  set W : ℝ → Euclidean 2 → Euclidean 2 → ℂ :=
    fun t η ζ => A t ζ * Th (ζ - η) * (starRingEnd ℂ) (A t η) with hWdef
  have hGcc : Continuous Gc := Complex.continuous_ofReal.comp hGc
  have hGci : Integrable Gc volume := hG.ofReal
  have hThc : Continuous Th := dvContinuous_fourierInv hGci
  have hThbd : ∀ z : Euclidean 2, ‖Th z‖ ≤ ∫ x : Euclidean 2, ‖Gc x‖ :=
    fun z => dvNorm_fourierInv_le z
  have hCm0 : 0 ≤ Cm := le_trans (norm_nonneg _) (hmbd a 0)
  have hCF0 : 0 ≤ CF := le_trans (norm_nonneg _) (hFbd 0)
  have hAc : Continuous fun p : ℝ × Euclidean 2 => A p.1 p.2 := hmc.mul (hFc.comp continuous_snd)
  have hAsupp : ∀ (t : ℝ) (ξ : Euclidean 2), ξ ∉ S → A t ξ = 0 := by
    intro t ξ hξ
    simp only [hAdef, hmsupp t ξ hξ, zero_mul]
  have hAbd : ∀ (t : ℝ) (ξ : Euclidean 2), ‖A t ξ‖ ≤ Cm * CF := by
    intro t ξ
    simp only [hAdef, norm_mul]
    exact mul_le_mul (hmbd t ξ) (hFbd ξ) (norm_nonneg _) hCm0
  have hAi : ∀ t : ℝ, Integrable (A t) volume := by
    intro t
    have hmaj : Integrable (fun ξ : Euclidean 2 =>
        (Cm * CF) * S.indicator (fun _ => (1 : ℝ)) ξ) volume := by
      refine Integrable.const_mul ?_ _
      rw [integrable_indicator_iff hSmeas]
      exact integrableOn_const (by simpa using (lt_of_le_of_ne le_top hSfin).ne)
    refine Integrable.mono' hmaj ((hAc.comp (Continuous.prodMk continuous_const
      continuous_id)).aestronglyMeasurable) (Filter.Eventually.of_forall fun ξ => ?_)
    by_cases hξ : ξ ∈ S
    · rw [Set.indicator_of_mem hξ, mul_one]
      exact hAbd t ξ
    · rw [hAsupp t ξ hξ, Set.indicator_of_notMem hξ]
      simp
  -- Step 1: the pointwise `TT*` identity
  have hstep1 : ∀ t : ℝ, ((∫ x : Euclidean 2, Gb x * ‖𝓕⁻ (A t) x‖ ^ 2 : ℝ) : ℂ) =
      ∫ η : Euclidean 2, ∫ ζ : Euclidean 2, W t η ζ := by
    intro t
    have h := dvTTStar_pointwise hGcc hGci (hAi t)
    have hlhs : (∫ ξ : Euclidean 2, Gc ξ * 𝓕⁻ (A t) ξ * (starRingEnd ℂ) (𝓕⁻ (A t) ξ)) =
        ((∫ x : Euclidean 2, Gb x * ‖𝓕⁻ (A t) x‖ ^ 2 : ℝ) : ℂ) := by
      rw [← integral_complex_ofReal]
      refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
      have hsq : 𝓕⁻ (A t) ξ * (starRingEnd ℂ) (𝓕⁻ (A t) ξ) =
          ((‖𝓕⁻ (A t) ξ‖ ^ 2 : ℝ) : ℂ) := by
        rw [Complex.mul_conj, ← Complex.sq_norm]
      simp only []
      rw [mul_assoc, hsq]
      simp only [hGcdef]
      push_cast
      ring
    have hrhs : (∫ η : Euclidean 2, (∫ ζ : Euclidean 2, A t ζ * Th (ζ - η)) *
        (starRingEnd ℂ) (A t η)) = ∫ η : Euclidean 2, ∫ ζ : Euclidean 2, W t η ζ := by
      refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
      simp only [hWdef]
      rw [integral_mul_const]
    rw [← hlhs, h, hrhs]
  -- Step 2: the Fubini swap in the radius variable
  have hWc : Continuous fun p : ℝ × Euclidean 2 × Euclidean 2 => W p.1 p.2.1 p.2.2 := by
    simp only [hWdef]
    refine Continuous.mul (Continuous.mul ?_ ?_) ?_
    · exact hAc.comp (Continuous.prodMk continuous_fst (continuous_snd.comp continuous_snd))
    · exact hThc.comp ((continuous_snd.comp continuous_snd).sub
        (continuous_fst.comp continuous_snd))
    · exact Complex.continuous_conj.comp
        (hAc.comp (Continuous.prodMk continuous_fst (continuous_fst.comp continuous_snd)))
  have hCTh0 : (0 : ℝ) ≤ ∫ x : Euclidean 2, ‖Gc x‖ :=
    integral_nonneg fun x => norm_nonneg _
  have hWbd : ∀ (t : ℝ) (η ζ : Euclidean 2), ‖W t η ζ‖ ≤
      ((Cm * CF) * (Cm * CF) * (∫ x : Euclidean 2, ‖Gc x‖)) *
        (S.indicator (fun _ => (1 : ℝ)) η * S.indicator (fun _ => (1 : ℝ)) ζ) := by
    intro t η ζ
    have hWval : ‖W t η ζ‖ = ‖A t ζ‖ * ‖Th (ζ - η)‖ * ‖A t η‖ := by
      simp only [hWdef, norm_mul, RCLike.norm_conj]
    have hCC : (0 : ℝ) ≤ Cm * CF := mul_nonneg hCm0 hCF0
    by_cases hη : η ∈ S
    · by_cases hζ : ζ ∈ S
      · rw [Set.indicator_of_mem hη, Set.indicator_of_mem hζ, mul_one, mul_one, hWval]
        have h1 : ‖A t ζ‖ * ‖Th (ζ - η)‖ ≤ (Cm * CF) * (∫ x : Euclidean 2, ‖Gc x‖) :=
          mul_le_mul (hAbd t ζ) (hThbd _) (norm_nonneg _) hCC
        have h2 : ‖A t ζ‖ * ‖Th (ζ - η)‖ * ‖A t η‖ ≤
            (Cm * CF) * (∫ x : Euclidean 2, ‖Gc x‖) * (Cm * CF) :=
          mul_le_mul h1 (hAbd t η) (norm_nonneg _) (mul_nonneg hCC hCTh0)
        calc ‖A t ζ‖ * ‖Th (ζ - η)‖ * ‖A t η‖ ≤
              (Cm * CF) * (∫ x : Euclidean 2, ‖Gc x‖) * (Cm * CF) := h2
          _ = (Cm * CF) * (Cm * CF) * (∫ x : Euclidean 2, ‖Gc x‖) := by ring
      · rw [hWval, hAsupp t ζ hζ, Set.indicator_of_notMem hζ]
        simp
    · rw [hWval, hAsupp t η hη, Set.indicator_of_notMem hη]
      simp
  have hswap := dvSwap hab W hWc hSmeas hSfin hWbd
  -- Step 3: Schur's test
  set N : Euclidean 2 → Euclidean 2 → ℝ≥0∞ :=
    fun η ζ => ENNReal.ofReal ‖Th (ζ - η)‖ * ENNReal.ofReal ‖K η ζ‖ with hNdef
  set u : Euclidean 2 → ℝ≥0∞ := fun ξ => ENNReal.ofReal ‖F ξ‖ with hudef
  have hKc : Continuous fun p : Euclidean 2 × Euclidean 2 => K p.1 p.2 := by
    have hunc : Continuous
        (Function.uncurry fun (p : Euclidean 2 × Euclidean 2) (t : ℝ) =>
          m t p.2 * (starRingEnd ℂ) (m t p.1)) := by
      have h1 : Continuous fun q : (Euclidean 2 × Euclidean 2) × ℝ => m q.2 q.1.2 :=
        hmc.comp (Continuous.prodMk continuous_snd (continuous_snd.comp continuous_fst))
      have h2 : Continuous fun q : (Euclidean 2 × Euclidean 2) × ℝ => m q.2 q.1.1 :=
        hmc.comp (Continuous.prodMk continuous_snd (continuous_fst.comp continuous_fst))
      exact h1.mul (Complex.continuous_conj.comp h2)
    exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hunc a b
  have hNmeas : Measurable fun p : Euclidean 2 × Euclidean 2 => N p.1 p.2 := by
    have h1 : Measurable fun p : Euclidean 2 × Euclidean 2 =>
        ENNReal.ofReal ‖Th (p.2 - p.1)‖ :=
      ((hThc.comp (continuous_snd.sub continuous_fst)).norm).measurable.ennreal_ofReal
    have h2 : Measurable fun p : Euclidean 2 × Euclidean 2 =>
        ENNReal.ofReal ‖K p.1 p.2‖ :=
      (hKc.norm).measurable.ennreal_ofReal
    exact h1.mul h2
  have humeas : Measurable u := by
    simp only [hudef]
    exact hFc.norm.measurable.ennreal_ofReal
  have hKconj : ∀ η ζ : Euclidean 2, K ζ η = (starRingEnd ℂ) (K η ζ) := by
    intro η ζ
    simp only [hKdef]
    rw [intervalIntegral.integral_of_le hab, intervalIntegral.integral_of_le hab,
      ← integral_conj]
    refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
    simp only [map_mul, RingHomCompTriple.comp_apply, RingHom.id_apply]
    ring
  have hNsymm : ∀ η ζ : Euclidean 2, N η ζ = N ζ η := by
    intro η ζ
    simp only [hNdef]
    have h1 : ‖Th (η - ζ)‖ = ‖Th (ζ - η)‖ := by
      have hneg : η - ζ = -(ζ - η) := by abel
      rw [hneg]
      simp only [hThdef, hGcdef]
      exact dvNorm_fourierInv_neg (Gb := Gb) (ζ - η)
    have h2 : ‖K ζ η‖ = ‖K η ζ‖ := by
      rw [hKconj η ζ, RCLike.norm_conj]
    rw [h1, h2]
  have hpoint : ∀ η ζ : Euclidean 2,
      ENNReal.ofReal ‖∫ t in a..b, W t η ζ‖ = N η ζ * (u η * u ζ) := by
    intro η ζ
    have hint : (∫ t in a..b, W t η ζ) =
        K η ζ * (F ζ * Th (ζ - η) * (starRingEnd ℂ) (F η)) := by
      simp only [hKdef]
      rw [← intervalIntegral.integral_mul_const]
      refine intervalIntegral.integral_congr fun t _ => ?_
      simp only [hWdef, hAdef, map_mul]
      ring
    rw [hint]
    simp only [hNdef, hudef, norm_mul, RCLike.norm_conj]
    rw [ENNReal.ofReal_mul (norm_nonneg _), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_mul (norm_nonneg _)]
    ring
  have hgoaleq : (∫ t in a..b, ∫ x : Euclidean 2,
      Gb x * ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2) =
      ∫ t in a..b, ∫ x : Euclidean 2, Gb x * ‖𝓕⁻ (A t) x‖ ^ 2 := rfl
  rw [hgoaleq]
  have hRc : ((∫ t in a..b, ∫ x : Euclidean 2, Gb x * ‖𝓕⁻ (A t) x‖ ^ 2 : ℝ) : ℂ) =
      ∫ η : Euclidean 2, ∫ ζ : Euclidean 2, ∫ t in a..b, W t η ζ := by
    rw [← hswap, intervalIntegral.integral_of_le hab, intervalIntegral.integral_of_le hab,
      ← integral_complex_ofReal]
    exact integral_congr_ae (Filter.Eventually.of_forall fun t => hstep1 t)
  calc ENNReal.ofReal (∫ t in a..b, ∫ x : Euclidean 2, Gb x * ‖𝓕⁻ (A t) x‖ ^ 2)
      ≤ ENNReal.ofReal
        ‖((∫ t in a..b, ∫ x : Euclidean 2, Gb x * ‖𝓕⁻ (A t) x‖ ^ 2 : ℝ) : ℂ)‖ := by
        refine ENNReal.ofReal_le_ofReal ?_
        rw [Complex.norm_real, Real.norm_eq_abs]
        exact le_abs_self _
    _ = ENNReal.ofReal ‖∫ η : Euclidean 2, ∫ ζ : Euclidean 2, ∫ t in a..b, W t η ζ‖ := by
        rw [hRc]
    _ ≤ ∫⁻ η : Euclidean 2, ENNReal.ofReal ‖∫ ζ : Euclidean 2, ∫ t in a..b, W t η ζ‖ := by
        refine le_trans (ENNReal.ofReal_le_ofReal (norm_integral_le_integral_norm _)) ?_
        exact dvOfReal_integral_le _ (Filter.Eventually.of_forall fun η => norm_nonneg _)
    _ ≤ ∫⁻ η : Euclidean 2, ∫⁻ ζ : Euclidean 2,
          ENNReal.ofReal ‖∫ t in a..b, W t η ζ‖ := by
        refine lintegral_mono fun η => ?_
        refine le_trans (ENNReal.ofReal_le_ofReal (norm_integral_le_integral_norm _)) ?_
        exact dvOfReal_integral_le _ (Filter.Eventually.of_forall fun ζ => norm_nonneg _)
    _ = ∫⁻ η : Euclidean 2, ∫⁻ ζ : Euclidean 2, N η ζ * (u η * u ζ) := by
        refine lintegral_congr fun η => ?_
        exact lintegral_congr fun ζ => hpoint η ζ
    _ ≤ Arow * ∫⁻ ξ : Euclidean 2, u ξ ^ 2 :=
        schur_lintegral hNsymm hNmeas humeas hrow

/-! ### The radial band profile and the band-multiplied kernel bound -/

/-- A fixed unit vector of the plane. -/
def dvUnit : Euclidean 2 := EuclideanSpace.single 0 (1 : ℝ)

theorem dvUnit_norm : ‖dvUnit‖ = 1 := by
  simp [dvUnit]

/-- The radial profile of a norm-radial cutoff. -/
def dvProfile (phi : SchwartzMap (Euclidean 2) ℂ) (v : ℝ) : ℂ := phi (v • dvUnit)

/-- The derivative of the radial profile. -/
def dvProfileDeriv (phi : SchwartzMap (Euclidean 2) ℂ) (v : ℝ) : ℂ :=
  fderiv ℝ (phi : Euclidean 2 → ℂ) (v • dvUnit) dvUnit

theorem norm_smul_dvUnit (v : ℝ) : ‖v • dvUnit‖ = |v| := by
  rw [norm_smul, Real.norm_eq_abs, dvUnit_norm, mul_one]

theorem dvProfile_apply {phi : SchwartzMap (Euclidean 2) ℂ}
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (ξ : Euclidean 2) :
    phi ξ = dvProfile phi ‖ξ‖ := by
  refine hrad ?_
  rw [norm_smul_dvUnit, abs_of_nonneg (norm_nonneg ξ)]

theorem hasDerivAt_dvProfile (phi : SchwartzMap (Euclidean 2) ℂ) (v : ℝ) :
    HasDerivAt (dvProfile phi) (dvProfileDeriv phi v) v := by
  have hlin : HasDerivAt (fun t : ℝ => t • dvUnit) dvUnit v := by
    simpa using (hasDerivAt_id v).smul_const dvUnit
  have hphi : HasFDerivAt (phi : Euclidean 2 → ℂ)
      (fderiv ℝ (phi : Euclidean 2 → ℂ) (v • dvUnit)) (v • dvUnit) :=
    (phi.smooth 1).differentiable (by norm_num) (v • dvUnit) |>.hasFDerivAt
  exact hphi.comp_hasDerivAt v hlin

theorem dvProfile_eq_one {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1) {v : ℝ} (hv : |v| ≤ 1) :
    dvProfile phi v = 1 := by
  unfold dvProfile
  exact hone _ (by rw [norm_smul_dvUnit]; exact hv)

theorem dvProfile_eq_zero {phi : SchwartzMap (Euclidean 2) ℂ}
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) {v : ℝ} (hv : 2 ≤ |v|) :
    dvProfile phi v = 0 := by
  unfold dvProfile
  exact hzero _ (by rw [norm_smul_dvUnit]; exact hv)

theorem dvProfileDeriv_eq_zero_of_abs_lt_one {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1) {v : ℝ} (hv : |v| < 1) :
    dvProfileDeriv phi v = 0 := by
  have heq : (phi : Euclidean 2 → ℂ) =ᶠ[nhds (v • dvUnit)] fun _ => (1 : ℂ) := by
    have hball : Metric.ball (0 : Euclidean 2) 1 ∈ nhds (v • dvUnit) := by
      refine Metric.isOpen_ball.mem_nhds ?_
      rw [Metric.mem_ball, dist_zero_right, norm_smul_dvUnit]
      exact hv
    filter_upwards [hball] with y hy
    refine hone y ?_
    rw [Metric.mem_ball, dist_zero_right] at hy
    exact hy.le
  unfold dvProfileDeriv
  rw [heq.fderiv_eq]
  simp

theorem dvProfileDeriv_eq_zero_of_two_lt_abs {phi : SchwartzMap (Euclidean 2) ℂ}
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) {v : ℝ} (hv : 2 < |v|) :
    dvProfileDeriv phi v = 0 := by
  have heq : (phi : Euclidean 2 → ℂ) =ᶠ[nhds (v • dvUnit)] fun _ => (0 : ℂ) := by
    have hopen : IsOpen {y : Euclidean 2 | 2 < ‖y‖} := by
      have : Continuous fun y : Euclidean 2 => ‖y‖ := continuous_norm
      exact isOpen_lt continuous_const this
    have hmem : {y : Euclidean 2 | 2 < ‖y‖} ∈ nhds (v • dvUnit) := by
      refine hopen.mem_nhds ?_
      rw [Set.mem_setOf_eq, norm_smul_dvUnit]
      exact hv
    filter_upwards [hmem] with y hy
    exact hzero y (le_of_lt hy)
  unfold dvProfileDeriv
  rw [heq.fderiv_eq]
  simp

theorem exists_dvProfileDeriv_bound (phi : SchwartzMap (Euclidean 2) ℂ) :
    ∃ M : ℝ, 0 < M ∧ ∀ v : ℝ, ‖dvProfileDeriv phi v‖ ≤ M := by
  refine ⟨‖((SchwartzMap.fderivCLM ℂ (Euclidean 2) ℂ) phi).toBoundedContinuousFunction‖ + 1,
    by positivity, fun v => ?_⟩
  have hbd : ‖fderiv ℝ (phi : Euclidean 2 → ℂ) (v • dvUnit)‖ ≤
      ‖((SchwartzMap.fderivCLM ℂ (Euclidean 2) ℂ) phi).toBoundedContinuousFunction‖ := by
    have h := ((SchwartzMap.fderivCLM ℂ (Euclidean 2) ℂ)
      phi).toBoundedContinuousFunction.norm_coe_le_norm
      (v • dvUnit)
    simpa using h
  unfold dvProfileDeriv
  calc ‖fderiv ℝ (phi : Euclidean 2 → ℂ) (v • dvUnit) dvUnit‖ ≤
      ‖fderiv ℝ (phi : Euclidean 2 → ℂ) (v • dvUnit)‖ * ‖dvUnit‖ :=
        ContinuousLinearMap.le_opNorm _ _
    _ = ‖fderiv ℝ (phi : Euclidean 2 → ℂ) (v • dvUnit)‖ := by rw [dvUnit_norm, mul_one]
    _ ≤ _ := by linarith

theorem continuous_dvProfile (phi : SchwartzMap (Euclidean 2) ℂ) :
    Continuous (dvProfile phi) := by
  unfold dvProfile
  exact phi.continuous.comp (continuous_id.smul continuous_const)

theorem continuous_dvProfileDeriv (phi : SchwartzMap (Euclidean 2) ℂ) :
    Continuous (dvProfileDeriv phi) := by
  unfold dvProfileDeriv
  have hf : Continuous (fderiv ℝ (phi : Euclidean 2 → ℂ)) :=
    (phi.smooth 2).continuous_fderiv (by norm_num)
  exact (hf.comp (continuous_id.smul continuous_const)).clm_apply continuous_const

/-- The relative dyadic band profile. -/
def dvBand (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (v : ℝ) : ℂ :=
  dvProfile phi ((((2 : ℝ) ^ (j + 1))⁻¹) * v) - dvProfile phi ((((2 : ℝ) ^ j)⁻¹) * v)

/-- The derivative of the band profile. -/
def dvBandDeriv (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (v : ℝ) : ℂ :=
  ((((2 : ℝ) ^ (j + 1))⁻¹ : ℝ) : ℂ) * dvProfileDeriv phi ((((2 : ℝ) ^ (j + 1))⁻¹) * v) -
    ((((2 : ℝ) ^ j)⁻¹ : ℝ) : ℂ) * dvProfileDeriv phi ((((2 : ℝ) ^ j)⁻¹) * v)

theorem hasDerivAt_dvBand (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (v : ℝ) :
    HasDerivAt (dvBand phi j) (dvBandDeriv phi j v) v := by
  have h1 : HasDerivAt (fun w : ℝ => dvProfile phi ((((2 : ℝ) ^ (j + 1))⁻¹) * w))
      (((((2 : ℝ) ^ (j + 1))⁻¹ : ℝ) : ℂ) *
        dvProfileDeriv phi ((((2 : ℝ) ^ (j + 1))⁻¹) * v)) v := by
    have hlin : HasDerivAt (fun w : ℝ => (((2 : ℝ) ^ (j + 1))⁻¹) * w)
        (((2 : ℝ) ^ (j + 1))⁻¹) v := by
      simpa using (hasDerivAt_id v).const_mul (((2 : ℝ) ^ (j + 1))⁻¹)
    have := (hasDerivAt_dvProfile phi ((((2 : ℝ) ^ (j + 1))⁻¹) * v)).scomp v hlin
    simpa [Function.comp_def, smul_eq_mul, mul_comm] using this
  have h2 : HasDerivAt (fun w : ℝ => dvProfile phi ((((2 : ℝ) ^ j)⁻¹) * w))
      (((((2 : ℝ) ^ j)⁻¹ : ℝ) : ℂ) * dvProfileDeriv phi ((((2 : ℝ) ^ j)⁻¹) * v)) v := by
    have hlin : HasDerivAt (fun w : ℝ => (((2 : ℝ) ^ j)⁻¹) * w)
        (((2 : ℝ) ^ j)⁻¹) v := by
      simpa using (hasDerivAt_id v).const_mul (((2 : ℝ) ^ j)⁻¹)
    have := (hasDerivAt_dvProfile phi ((((2 : ℝ) ^ j)⁻¹) * v)).scomp v hlin
    simpa [Function.comp_def, smul_eq_mul, mul_comm] using this
  exact h1.sub h2

theorem continuous_dvBand (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) :
    Continuous (dvBand phi j) := by
  unfold dvBand
  exact ((continuous_dvProfile phi).comp (continuous_const.mul continuous_id)).sub
    ((continuous_dvProfile phi).comp (continuous_const.mul continuous_id))

theorem continuous_dvBandDeriv (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) :
    Continuous (dvBandDeriv phi j) := by
  unfold dvBandDeriv
  exact (continuous_const.mul
      ((continuous_dvProfileDeriv phi).comp (continuous_const.mul continuous_id))).sub
    (continuous_const.mul
      ((continuous_dvProfileDeriv phi).comp (continuous_const.mul continuous_id)))

theorem norm_dvBand_le {phi : SchwartzMap (Euclidean 2) ℂ}
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1) (j : ℕ) (v : ℝ) :
    ‖dvBand phi j v‖ ≤ 2 := by
  unfold dvBand dvProfile
  calc ‖phi ((((2 : ℝ) ^ (j + 1))⁻¹ * v) • dvUnit) - phi ((((2 : ℝ) ^ j)⁻¹ * v) • dvUnit)‖ ≤
      ‖phi ((((2 : ℝ) ^ (j + 1))⁻¹ * v) • dvUnit)‖ +
        ‖phi ((((2 : ℝ) ^ j)⁻¹ * v) • dvUnit)‖ := norm_sub_le _ _
    _ ≤ 1 + 1 := add_le_add (hnorm _) (hnorm _)
    _ = 2 := by norm_num

/-- The `w * g'(w)` profile is bounded because `g'` is supported in a fixed
annulus. -/
theorem norm_mul_dvProfileDeriv_le {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    {M : ℝ} (hM : ∀ v : ℝ, ‖dvProfileDeriv phi v‖ ≤ M) (w : ℝ) :
    ‖(w : ℂ) * dvProfileDeriv phi w‖ ≤ 2 * M := by
  have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hM 0)
  by_cases h1 : |w| < 1
  · rw [dvProfileDeriv_eq_zero_of_abs_lt_one hone h1]
    simp
    positivity
  · by_cases h2 : 2 < |w|
    · rw [dvProfileDeriv_eq_zero_of_two_lt_abs hzero h2]
      simp
      positivity
    · have hle : |w| ≤ 2 := le_of_not_gt h2
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
      exact mul_le_mul hle (hM w) (norm_nonneg _) (by norm_num)

theorem norm_mul_dvBandDeriv_le {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    {M : ℝ} (hM : ∀ v : ℝ, ‖dvProfileDeriv phi v‖ ≤ M) (j : ℕ) (v : ℝ) :
    ‖(v : ℂ) * dvBandDeriv phi j v‖ ≤ 4 * M := by
  have hexp : (v : ℂ) * dvBandDeriv phi j v =
      (((((2 : ℝ) ^ (j + 1))⁻¹ * v : ℝ)) : ℂ) *
          dvProfileDeriv phi ((((2 : ℝ) ^ (j + 1))⁻¹) * v) -
        (((((2 : ℝ) ^ j)⁻¹ * v : ℝ)) : ℂ) * dvProfileDeriv phi ((((2 : ℝ) ^ j)⁻¹) * v) := by
    unfold dvBandDeriv
    push_cast
    ring
  rw [hexp]
  calc ‖(((((2 : ℝ) ^ (j + 1))⁻¹ * v : ℝ)) : ℂ) *
        dvProfileDeriv phi ((((2 : ℝ) ^ (j + 1))⁻¹) * v) -
      (((((2 : ℝ) ^ j)⁻¹ * v : ℝ)) : ℂ) * dvProfileDeriv phi ((((2 : ℝ) ^ j)⁻¹) * v)‖ ≤
      ‖(((((2 : ℝ) ^ (j + 1))⁻¹ * v : ℝ)) : ℂ) *
        dvProfileDeriv phi ((((2 : ℝ) ^ (j + 1))⁻¹) * v)‖ +
        ‖(((((2 : ℝ) ^ j)⁻¹ * v : ℝ)) : ℂ) *
          dvProfileDeriv phi ((((2 : ℝ) ^ j)⁻¹) * v)‖ := norm_sub_le _ _
    _ ≤ 2 * M + 2 * M :=
        add_le_add (norm_mul_dvProfileDeriv_le hone hzero hM _)
          (norm_mul_dvProfileDeriv_le hone hzero hM _)
    _ = 4 * M := by ring

/-- The band-multiplied planar radial amplitude. -/
def dvBandAmp (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u r : ℝ) : ℂ :=
  planarCoordinateWaveRadialAmplitude p u r * dvBand phi j (u * r)

/-- Its radial derivative. -/
def dvBandAmpDeriv (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u r : ℝ) : ℂ :=
  dvAmpDeriv p u r * dvBand phi j (u * r) +
    planarCoordinateWaveRadialAmplitude p u r * ((u : ℂ) * dvBandDeriv phi j (u * r))

theorem hasDerivAt_dvBand_comp (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (u r : ℝ) :
    HasDerivAt (fun v : ℝ => dvBand phi j (u * v))
      ((u : ℂ) * dvBandDeriv phi j (u * r)) r := by
  have hlin : HasDerivAt (fun v : ℝ => u * v) u r := by
    simpa using (hasDerivAt_id r).const_mul u
  have := (hasDerivAt_dvBand phi j (u * r)).scomp r hlin
  simpa [Function.comp_def, smul_eq_mul, mul_comm] using this

theorem hasDerivAt_dvBandAmp (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u r : ℝ) :
    HasDerivAt (fun v : ℝ => dvBandAmp phi j p u v) (dvBandAmpDeriv phi j p u r) r := by
  unfold dvBandAmp dvBandAmpDeriv
  exact (hasDerivAt_planarCoordinateWaveRadialAmplitude p u r).mul
    (hasDerivAt_dvBand_comp phi j u r)

theorem continuous_dvBandAmp (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u : ℝ) :
    Continuous fun v : ℝ => dvBandAmp phi j p u v := by
  unfold dvBandAmp
  exact (continuous_planarCoordinateWaveRadialAmplitude p u).mul
    ((continuous_dvBand phi j).comp (continuous_const.mul continuous_id))

theorem continuous_dvBandAmpDeriv (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u : ℝ) :
    Continuous fun v : ℝ => dvBandAmpDeriv phi j p u v := by
  unfold dvBandAmpDeriv
  refine Continuous.add ?_ ?_
  · exact (continuous_dvAmpDeriv p u).mul
      ((continuous_dvBand phi j).comp (continuous_const.mul continuous_id))
  · exact (continuous_planarCoordinateWaveRadialAmplitude p u).mul
      (continuous_const.mul
        ((continuous_dvBandDeriv phi j).comp (continuous_const.mul continuous_id)))

theorem norm_mul_dvBandDeriv_scaled {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    {M : ℝ} (hM : ∀ v : ℝ, ‖dvProfileDeriv phi v‖ ≤ M) (j : ℕ) {u r : ℝ}
    (hr : 1 / 4 ≤ r) :
    ‖(u : ℂ) * dvBandDeriv phi j (u * r)‖ ≤ 16 * M := by
  have h4 := norm_mul_dvBandDeriv_le hone hzero hM j (u * r)
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_mul] at h4
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  have hrabs : (1 : ℝ) / 4 ≤ |r| := le_trans hr (le_abs_self r)
  have hnn : 0 ≤ |u| * ‖dvBandDeriv phi j (u * r)‖ :=
    mul_nonneg (abs_nonneg u) (norm_nonneg _)
  nlinarith [norm_nonneg (dvBandDeriv phi j (u * r)), abs_nonneg u]

set_option maxHeartbeats 1600000 in
/-- **The radial pair-kernel bound with the relative band factor.**  The
constant is uniform in the frequency index. -/
theorem exists_dvBandKernel_bound {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (s t : ℝ), 1 ≤ s → 1 ≤ t → t ≤ 100 * s → s ≤ 100 * t →
      ‖∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) *
          (planarCoordinateSurfaceWaveSum (s * r) * dvBand phi j (s * r)) *
            (starRingEnd ℂ) (planarCoordinateSurfaceWaveSum (t * r) * dvBand phi j (t * r))‖ ≤
        C * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by
  obtain ⟨C, hC, hunif⟩ := exists_dvUniform_bound
  obtain ⟨Cm, hCm, hmid⟩ := exists_planarAmplitude_middle_bound
  obtain ⟨M, hM0, hM⟩ := exists_dvProfileDeriv_bound phi
  set C' : ℝ := C * (2 + 16 * M) with hC'def
  set Cm' : ℝ := Cm * (2 + 16 * M) with hCm'def
  have hC' : 0 < C' := by
    simp only [hC'def]
    positivity
  have hCm' : 0 < Cm' := by
    simp only [hCm'def]
    positivity
  refine ⟨9 * (673200 * (C' * C') + 13200 * (C' * C') + 18360 * (Cm' * Cm') + 1),
    by positivity, ?_⟩
  intro j
  refine dvKernel_bound_of_abstract
    (Amp := dvBandAmp phi j) (AmpD := dvBandAmpDeriv phi j)
    (Sig := fun u r => planarCoordinateSurfaceWaveSum (u * r) * dvBand phi j (u * r))
    (fun p u r => hasDerivAt_dvBandAmp phi j p u r)
    (fun p u => continuous_dvBandAmp phi j p u)
    (fun p u => continuous_dvBandAmpDeriv phi j p u)
    (fun u r => ?_) hC' hCm' (fun p u hu r hr1 hr2 => ?_) (fun u hu r hr1 hr2 => ?_)
  · rw [dvParts_sum]
    have h := planarCoordinateSurfaceWaveSum_eq_three_radialTerms u r
    unfold planarCoordinateWaveRadialTerm at h
    unfold dvBandAmp
    rw [h]
    ring
  · -- uniform bounds
    obtain ⟨h1, h2⟩ := hunif p u hu r hr1 hr2
    have hband := norm_dvBand_le hnorm j (u * r)
    have hscaled := norm_mul_dvBandDeriv_scaled hone hzero hM j (u := u) (r := r) hr1
    have hu0 : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr (lt_of_lt_of_le zero_lt_one hu)
    constructor
    · unfold dvBandAmp
      rw [norm_mul]
      calc ‖planarCoordinateWaveRadialAmplitude p u r‖ * ‖dvBand phi j (u * r)‖ ≤
          (C / Real.sqrt u) * 2 := mul_le_mul h1 hband (norm_nonneg _) (by positivity)
        _ ≤ C' / Real.sqrt u := by
            rw [hC'def, div_mul_eq_mul_div, div_le_div_iff_of_pos_right hu0]
            nlinarith
    · unfold dvBandAmpDeriv
      calc ‖dvAmpDeriv p u r * dvBand phi j (u * r) +
            planarCoordinateWaveRadialAmplitude p u r *
              ((u : ℂ) * dvBandDeriv phi j (u * r))‖ ≤
          ‖dvAmpDeriv p u r * dvBand phi j (u * r)‖ +
            ‖planarCoordinateWaveRadialAmplitude p u r *
              ((u : ℂ) * dvBandDeriv phi j (u * r))‖ := norm_add_le _ _
        _ ≤ (C / Real.sqrt u) * 2 + (C / Real.sqrt u) * (16 * M) := by
            rw [norm_mul, norm_mul]
            exact add_le_add (mul_le_mul h2 hband (norm_nonneg _) (by positivity))
              (mul_le_mul h1 hscaled (norm_nonneg _) (by positivity))
        _ = C' / Real.sqrt u := by
            rw [hC'def]
            field_simp
  · -- middle bounds
    obtain ⟨h1, h2⟩ := hmid u hu r hr1 hr2
    have hband := norm_dvBand_le hnorm j (u * r)
    have hscaled := norm_mul_dvBandDeriv_scaled hone hzero hM j (u := u) (r := r) hr1
    have hu1 : (0 : ℝ) < u := lt_of_lt_of_le zero_lt_one hu
    constructor
    · unfold dvBandAmp
      rw [norm_mul]
      calc ‖planarCoordinateWaveRadialAmplitude CoordinateWavePart.middle u r‖ *
            ‖dvBand phi j (u * r)‖ ≤ (Cm / u ^ 2) * 2 :=
            mul_le_mul h1 hband (norm_nonneg _) (by positivity)
        _ ≤ Cm' / u ^ 2 := by
            rw [hCm'def, div_mul_eq_mul_div, div_le_div_iff_of_pos_right (by positivity)]
            nlinarith
    · unfold dvBandAmpDeriv
      have hsq : Cm / u ^ 2 ≤ Cm / u := by
        apply div_le_div_of_nonneg_left hCm.le hu1
        nlinarith
      calc ‖dvAmpDeriv CoordinateWavePart.middle u r * dvBand phi j (u * r) +
            planarCoordinateWaveRadialAmplitude CoordinateWavePart.middle u r *
              ((u : ℂ) * dvBandDeriv phi j (u * r))‖ ≤
          ‖dvAmpDeriv CoordinateWavePart.middle u r * dvBand phi j (u * r)‖ +
            ‖planarCoordinateWaveRadialAmplitude CoordinateWavePart.middle u r *
              ((u : ℂ) * dvBandDeriv phi j (u * r))‖ := norm_add_le _ _
        _ ≤ (Cm / u) * 2 + (Cm / u ^ 2) * (16 * M) := by
            rw [norm_mul, norm_mul]
            exact add_le_add (mul_le_mul h2 hband (norm_nonneg _) (by positivity))
              (mul_le_mul h1 hscaled (norm_nonneg _) (by positivity))
        _ ≤ (Cm / u) * 2 + (Cm / u) * (16 * M) := by
            have : (Cm / u ^ 2) * (16 * M) ≤ (Cm / u) * (16 * M) := by
              apply mul_le_mul_of_nonneg_right hsq (by positivity)
            linarith
        _ = Cm' / u := by
            rw [hCm'def]
            field_simp
/-! ### Second radial derivatives and the derivative pair kernel -/

/-- The second radial derivative of the planar coordinate-wave amplitude. -/
def dvAmpDeriv2 (part : CoordinateWavePart) (s r : ℝ) : ℂ :=
  (surfaceMass 1 : ℂ) *
    match part with
    | .outgoing => (((2 * Real.pi * s) : ℝ) : ℂ) * (((2 * Real.pi * s) : ℝ) : ℂ) *
        iteratedDeriv 2 planarEndpointQuadraticIntegral ((2 * Real.pi * s) * r)
    | .incoming => (((-(2 * Real.pi * s)) : ℝ) : ℂ) * (((-(2 * Real.pi * s)) : ℝ) : ℂ) *
        iteratedDeriv 2 planarEndpointQuadraticIntegral ((-(2 * Real.pi * s)) * r)
    | .middle => (((2 * Real.pi * s) : ℝ) : ℂ) * (((2 * Real.pi * s) : ℝ) : ℂ) *
        iteratedDeriv 2 (coordinateMiddleMeridianLocalizedIntegral 0) ((2 * Real.pi * s) * r)

private theorem aux_deriv2 {P : ℝ → ℂ} (hP : ContDiff ℝ (⊤ : ℕ∞) P) (c r : ℝ) :
    HasDerivAt (fun rho : ℝ => ((c : ℝ) : ℂ) * deriv P (c * rho))
      (((c : ℝ) : ℂ) * ((c : ℝ) : ℂ) * iteratedDeriv 2 P (c * r)) r := by
  have hdP : ContDiff ℝ (⊤ : ℕ∞) (deriv P) := (contDiff_infty_iff_deriv.mp hP).2
  have h := aux_hasDerivAt_comp_linear (P := deriv P) hdP c r
  have hiter : iteratedDeriv 2 P = deriv (deriv P) := by
    rw [iteratedDeriv_succ, iteratedDeriv_one]
  have hres := h.const_mul (((c : ℝ) : ℂ))
  rw [hiter]
  refine hres.congr_deriv ?_
  ring

theorem hasDerivAt_dvAmpDeriv (part : CoordinateWavePart) (s r : ℝ) :
    HasDerivAt (fun rho : ℝ => dvAmpDeriv part s rho) (dvAmpDeriv2 part s r) r := by
  cases part with
  | outgoing =>
      have h := aux_deriv2 contDiff_planarEndpointQuadraticIntegral (2 * Real.pi * s) r
      have := h.const_mul (surfaceMass 1 : ℂ)
      refine this.congr_deriv ?_
      simp only [dvAmpDeriv2]
      try ring
  | incoming =>
      have h := aux_deriv2 contDiff_planarEndpointQuadraticIntegral (-(2 * Real.pi * s)) r
      have := h.const_mul (surfaceMass 1 : ℂ)
      refine this.congr_deriv ?_
      simp only [dvAmpDeriv2]
      try ring
  | middle =>
      have h := aux_deriv2 (contDiff_coordinateMiddleMeridianLocalizedIntegral 0)
        (2 * Real.pi * s) r
      have := h.const_mul (surfaceMass 1 : ℂ)
      refine this.congr_deriv ?_
      simp only [dvAmpDeriv2]
      try ring

theorem continuous_dvAmpDeriv2 (part : CoordinateWavePart) (s : ℝ) :
    Continuous fun rho : ℝ => dvAmpDeriv2 part s rho := by
  have hcont : ∀ P : ℝ → ℂ, ContDiff ℝ (⊤ : ℕ∞) P → ∀ c : ℝ,
      Continuous fun rho : ℝ => iteratedDeriv 2 P (c * rho) := by
    intro P hP c
    have h2 : Continuous (iteratedDeriv 2 P) := by
      have hi : ContDiff ℝ (⊤ : ℕ∞) (iteratedDeriv 2 P) := by
        rw [iteratedDeriv_eq_iterate]
        exact hP.iterate_deriv 2
      exact hi.continuous
    exact h2.comp (continuous_const.mul continuous_id)
  cases part with
  | outgoing =>
      exact continuous_const.mul (continuous_const.mul
        (hcont _ contDiff_planarEndpointQuadraticIntegral _))
  | incoming =>
      exact continuous_const.mul (continuous_const.mul
        (hcont _ contDiff_planarEndpointQuadraticIntegral _))
  | middle =>
      exact continuous_const.mul (continuous_const.mul
        (hcont _ (contDiff_coordinateMiddleMeridianLocalizedIntegral 0) _))

private theorem aux_end2 {C2 : ℝ} (hC2 : 0 < C2)
    (h2 : ∀ lambda : ℝ, 1 ≤ |lambda| →
      ‖iteratedDeriv 2 planarEndpointQuadraticIntegral lambda‖ ≤
        C2 / quadraticMomentScale (2 * 2) |lambda|)
    {s r : ℝ} (hs : 1 ≤ s) (hr1 : 1 / 4 ≤ r) (c : ℝ) (hc : |c| = 2 * Real.pi * s) :
    ‖((c : ℝ) : ℂ) * ((c : ℝ) : ℂ) *
        iteratedDeriv 2 planarEndpointQuadraticIntegral (c * r)‖ ≤
      (4 * Real.pi ^ 2 * C2) / Real.sqrt s := by
  obtain ⟨hlow, hone, habs⟩ := aux_radial_lower hs hr1
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have hr0 : (0 : ℝ) < r := by linarith
  have hsq0 : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hs0
  have hsqs : Real.sqrt s ^ 2 = s := Real.sq_sqrt hs0.le
  have hcr : |c * r| = 2 * Real.pi * s * r := by
    rw [abs_mul, hc, abs_of_pos hr0]
  have hcone : 1 ≤ |c * r| := by rw [hcr, ← habs]; exact hone
  have h := h2 (c * r) hcone
  have hqm : quadraticMomentScale (2 * 2) |c * r| = Real.sqrt |c * r| ^ 5 := by
    simp [quadraticMomentScale]
  rw [hqm, hcr] at h
  have hsqrtmono : Real.sqrt s ≤ Real.sqrt (2 * Real.pi * s * r) := Real.sqrt_le_sqrt hlow
  have hfive : Real.sqrt s ^ 5 ≤ Real.sqrt (2 * Real.pi * s * r) ^ 5 := by gcongr
  have hfiveval : Real.sqrt s ^ 5 = s ^ 2 * Real.sqrt s := by
    have hrw : Real.sqrt s ^ 5 = (Real.sqrt s ^ 2) ^ 2 * Real.sqrt s := by ring
    rw [hrw, hsqs]
  have hfinal : ‖iteratedDeriv 2 planarEndpointQuadraticIntegral (c * r)‖ ≤
      C2 / (s ^ 2 * Real.sqrt s) := by
    refine h.trans ?_
    rw [← hfiveval]
    gcongr
  have hnc : ‖((c : ℝ) : ℂ)‖ = 2 * Real.pi * s := by
    rw [Complex.norm_real, Real.norm_eq_abs, hc]
  rw [norm_mul, norm_mul, hnc]
  calc (2 * Real.pi * s) * (2 * Real.pi * s) *
        ‖iteratedDeriv 2 planarEndpointQuadraticIntegral (c * r)‖ ≤
      (2 * Real.pi * s) * (2 * Real.pi * s) * (C2 / (s ^ 2 * Real.sqrt s)) := by
        gcongr
    _ = (4 * Real.pi ^ 2 * C2) / Real.sqrt s := by
        field_simp
        ring

private theorem aux_mid2 {C3 : ℝ} (hC3 : 0 < C3)
    (h3 : ∀ l : ℝ, 1 ≤ |l| →
      ‖iteratedDeriv 2 (coordinateMiddleMeridianLocalizedIntegral 0) l‖ ≤ C3 / |l| ^ 3)
    {s r : ℝ} (hs : 1 ≤ s) (hr1 : 1 / 4 ≤ r) :
    ‖((2 * Real.pi * s : ℝ) : ℂ) * ((2 * Real.pi * s : ℝ) : ℂ) *
        iteratedDeriv 2 (coordinateMiddleMeridianLocalizedIntegral 0)
          ((2 * Real.pi * s) * r)‖ ≤ (4 * Real.pi ^ 2 * C3) / Real.sqrt s := by
  obtain ⟨hlow, hone, habs⟩ := aux_radial_lower hs hr1
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have hsq0 : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hs0
  have hsq1 : Real.sqrt s ≤ s := by
    nlinarith [Real.sq_sqrt hs0.le, Real.sqrt_nonneg s, Real.one_le_sqrt.mpr hs]
  have h := h3 _ hone
  rw [habs] at h
  have hcube : s ^ 2 * Real.sqrt s ≤ (2 * Real.pi * s * r) ^ 3 := by
    have h1 : s ≤ 2 * Real.pi * s * r := hlow
    have h2 : (0 : ℝ) < 2 * Real.pi * s * r := by
      have := Real.pi_pos
      have hr0 : (0 : ℝ) < r := by linarith
      positivity
    have hp3 : s ^ 3 ≤ (2 * Real.pi * s * r) ^ 3 := by gcongr
    nlinarith [hp3, hsq1, hs0.le]
  have hfinal : ‖iteratedDeriv 2 (coordinateMiddleMeridianLocalizedIntegral 0)
      ((2 * Real.pi * s) * r)‖ ≤ C3 / (s ^ 2 * Real.sqrt s) := by
    refine h.trans ?_
    gcongr
  have hnn : (0 : ℝ) ≤ 2 * Real.pi * s := by
    have := Real.pi_pos
    positivity
  have hnc : ‖((2 * Real.pi * s : ℝ) : ℂ)‖ = 2 * Real.pi * s := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hnn]
  rw [norm_mul, norm_mul, hnc]
  calc (2 * Real.pi * s) * (2 * Real.pi * s) *
        ‖iteratedDeriv 2 (coordinateMiddleMeridianLocalizedIntegral 0)
          ((2 * Real.pi * s) * r)‖ ≤
      (2 * Real.pi * s) * (2 * Real.pi * s) * (C3 / (s ^ 2 * Real.sqrt s)) := by
        gcongr
    _ = (4 * Real.pi ^ 2 * C3) / Real.sqrt s := by
        field_simp
        ring

/-- The uniform bound for the second radial derivative of the planar
amplitudes. -/
theorem exists_dvAmpDeriv2_bound :
    ∃ C : ℝ, 0 < C ∧ ∀ (p : CoordinateWavePart) (s : ℝ), 1 ≤ s →
      ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 → ‖dvAmpDeriv2 p s r‖ ≤ C / Real.sqrt s := by
  obtain ⟨C2, hC2, h2⟩ := exists_iteratedDeriv_planarEndpointQuadraticIntegral_abs_decay 2
  obtain ⟨C3, hC3, h3⟩ :=
    exists_iteratedDeriv_coordinateMiddleMeridianLocalizedIntegral_abs_decay 0 2 3
  set m1 : ℝ := ‖(surfaceMass 1 : ℂ)‖ with hm1def
  have hm10 : 0 ≤ m1 := norm_nonneg _
  have hpi0 : (0 : ℝ) < Real.pi := Real.pi_pos
  refine ⟨(m1 + 1) * (C2 + C3) * (4 * Real.pi ^ 2 + 1), by positivity, ?_⟩
  intro p s hs r hr1 hr2
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have hsq0 : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hs0
  have habsorb : ∀ Ck : ℝ, 0 < Ck → Ck ≤ C2 + C3 →
      m1 * ((4 * Real.pi ^ 2 * Ck) / Real.sqrt s) ≤
        ((m1 + 1) * (C2 + C3) * (4 * Real.pi ^ 2 + 1)) / Real.sqrt s := by
    intro Ck hCk hCkle
    rw [mul_div_assoc']
    have hstep : m1 * (4 * Real.pi ^ 2 * Ck) ≤
        (m1 + 1) * (C2 + C3) * (4 * Real.pi ^ 2 + 1) := ?_
    · exact div_le_div_of_nonneg_right hstep hsq0.le
    have h1 : m1 * (4 * Real.pi ^ 2 * Ck) ≤ (m1 + 1) * (4 * Real.pi ^ 2 * (C2 + C3)) := by
      apply mul_le_mul (by linarith) (by nlinarith [sq_nonneg Real.pi]) (by positivity)
        (by linarith)
    nlinarith [sq_nonneg Real.pi, mul_nonneg (by positivity : (0:ℝ) ≤ (m1+1)) hC2.le,
      mul_nonneg (by positivity : (0:ℝ) ≤ (m1+1)) hC3.le]
  cases p with
  | outgoing =>
      have hc : |2 * Real.pi * s| = 2 * Real.pi * s := abs_of_nonneg (by positivity)
      have h := aux_end2 hC2 h2 hs hr1 (2 * Real.pi * s) hc
      have hval : ‖dvAmpDeriv2 CoordinateWavePart.outgoing s r‖ =
          m1 * ‖((2 * Real.pi * s : ℝ) : ℂ) * ((2 * Real.pi * s : ℝ) : ℂ) *
            iteratedDeriv 2 planarEndpointQuadraticIntegral ((2 * Real.pi * s) * r)‖ := by
        simp only [dvAmpDeriv2, hm1def]
        rw [norm_mul]
      rw [hval]
      exact le_trans (mul_le_mul_of_nonneg_left h hm10) (habsorb C2 hC2 (by linarith))
  | incoming =>
      have hc : |(-(2 * Real.pi * s))| = 2 * Real.pi * s := by
        rw [abs_neg]
        exact abs_of_nonneg (by positivity)
      have h := aux_end2 hC2 h2 hs hr1 (-(2 * Real.pi * s)) hc
      have hval : ‖dvAmpDeriv2 CoordinateWavePart.incoming s r‖ =
          m1 * ‖((-(2 * Real.pi * s) : ℝ) : ℂ) * ((-(2 * Real.pi * s) : ℝ) : ℂ) *
            iteratedDeriv 2 planarEndpointQuadraticIntegral ((-(2 * Real.pi * s)) * r)‖ := by
        simp only [dvAmpDeriv2, hm1def]
        rw [norm_mul]
      rw [hval]
      exact le_trans (mul_le_mul_of_nonneg_left h hm10) (habsorb C2 hC2 (by linarith))
  | middle =>
      have h := aux_mid2 hC3 h3 hs hr1
      have hval : ‖dvAmpDeriv2 CoordinateWavePart.middle s r‖ =
          m1 * ‖((2 * Real.pi * s : ℝ) : ℂ) * ((2 * Real.pi * s : ℝ) : ℂ) *
            iteratedDeriv 2 (coordinateMiddleMeridianLocalizedIntegral 0)
              ((2 * Real.pi * s) * r)‖ := by
        simp only [dvAmpDeriv2, hm1def]
        rw [norm_mul]
      rw [hval]
      exact le_trans (mul_le_mul_of_nonneg_left h hm10) (habsorb C3 hC3 (by linarith))

/-- The second derivative of the radial profile along the fixed ray. -/
def dvProfileDeriv2 (phi : SchwartzMap (Euclidean 2) ℂ) (v : ℝ) : ℂ :=
  (fderiv ℝ (fderiv ℝ (phi : Euclidean 2 → ℂ)) (v • dvUnit) dvUnit) dvUnit

theorem hasDerivAt_dvProfileDeriv (phi : SchwartzMap (Euclidean 2) ℂ) (v : ℝ) :
    HasDerivAt (dvProfileDeriv phi) (dvProfileDeriv2 phi v) v := by
  have hlin : HasDerivAt (fun t : ℝ => t • dvUnit) dvUnit v := by
    simpa using (hasDerivAt_id v).smul_const dvUnit
  have hdiff2 : HasFDerivAt (fderiv ℝ (phi : Euclidean 2 → ℂ))
      (fderiv ℝ (fderiv ℝ (phi : Euclidean 2 → ℂ)) (v • dvUnit)) (v • dvUnit) := by
    have hcd : ContDiff ℝ (⊤ : ℕ∞) (phi : Euclidean 2 → ℂ) := phi.smooth (⊤ : ℕ∞)
    have hfd : ContDiff ℝ (⊤ : ℕ∞) (fderiv ℝ (phi : Euclidean 2 → ℂ)) := by
      have := hcd.fderiv_right (m := (⊤ : ℕ∞)) (by simp)
      exact this
    exact ((hfd.differentiable (by simp)) (v • dvUnit)).hasFDerivAt
  have hstep : HasDerivAt (fun t : ℝ => fderiv ℝ (phi : Euclidean 2 → ℂ) (t • dvUnit))
      (fderiv ℝ (fderiv ℝ (phi : Euclidean 2 → ℂ)) (v • dvUnit) dvUnit) v :=
    hdiff2.comp_hasDerivAt v hlin
  have hL := (ContinuousLinearMap.apply ℝ ℂ dvUnit).hasFDerivAt.comp_hasDerivAt v hstep
  exact hL

theorem continuous_dvProfileDeriv2 (phi : SchwartzMap (Euclidean 2) ℂ) :
    Continuous (dvProfileDeriv2 phi) := by
  have hcd : ContDiff ℝ (⊤ : ℕ∞) (phi : Euclidean 2 → ℂ) := phi.smooth (⊤ : ℕ∞)
  have hfd : ContDiff ℝ (⊤ : ℕ∞) (fderiv ℝ (phi : Euclidean 2 → ℂ)) :=
    hcd.fderiv_right (m := (⊤ : ℕ∞)) (by simp)
  have hf : Continuous (fderiv ℝ (fderiv ℝ (phi : Euclidean 2 → ℂ))) :=
    hfd.continuous_fderiv (by simp)
  unfold dvProfileDeriv2
  exact ((hf.comp (continuous_id.smul continuous_const)).clm_apply
    continuous_const).clm_apply continuous_const

theorem dvProfileDeriv2_eq_zero_of_abs_lt_one {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1) {v : ℝ} (hv : |v| < 1) :
    dvProfileDeriv2 phi v = 0 := by
  have hball : Metric.ball (0 : Euclidean 2) 1 ∈ nhds (v • dvUnit) := by
    refine Metric.isOpen_ball.mem_nhds ?_
    rw [Metric.mem_ball, dist_zero_right, norm_smul_dvUnit]
    exact hv
  have heq : fderiv ℝ (phi : Euclidean 2 → ℂ) =ᶠ[nhds (v • dvUnit)] fun _ => 0 := by
    filter_upwards [hball] with y hy
    have hnb : Metric.ball (0 : Euclidean 2) 1 ∈ nhds y := Metric.isOpen_ball.mem_nhds hy
    have hloc : (phi : Euclidean 2 → ℂ) =ᶠ[nhds y] fun _ => (1 : ℂ) := by
      filter_upwards [hnb] with z hz
      refine hone z ?_
      rw [Metric.mem_ball, dist_zero_right] at hz
      exact hz.le
    rw [hloc.fderiv_eq]
    simp
  unfold dvProfileDeriv2
  rw [heq.fderiv_eq]
  simp

theorem dvProfileDeriv2_eq_zero_of_two_lt_abs {phi : SchwartzMap (Euclidean 2) ℂ}
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) {v : ℝ} (hv : 2 < |v|) :
    dvProfileDeriv2 phi v = 0 := by
  have hopen : IsOpen {y : Euclidean 2 | 2 < ‖y‖} := isOpen_lt continuous_const continuous_norm
  have hmem : {y : Euclidean 2 | 2 < ‖y‖} ∈ nhds (v • dvUnit) := by
    refine hopen.mem_nhds ?_
    rw [Set.mem_setOf_eq, norm_smul_dvUnit]
    exact hv
  have heq : fderiv ℝ (phi : Euclidean 2 → ℂ) =ᶠ[nhds (v • dvUnit)] fun _ => 0 := by
    filter_upwards [hmem] with y hy
    have hnb : {z : Euclidean 2 | 2 < ‖z‖} ∈ nhds y := hopen.mem_nhds hy
    have hloc : (phi : Euclidean 2 → ℂ) =ᶠ[nhds y] fun _ => (0 : ℂ) := by
      filter_upwards [hnb] with z hz
      exact hzero z (le_of_lt hz)
    rw [hloc.fderiv_eq]
    simp
  unfold dvProfileDeriv2
  rw [heq.fderiv_eq]
  simp

theorem exists_dvProfileDeriv2_bound {phi : SchwartzMap (Euclidean 2) ℂ}
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) :
    ∃ M : ℝ, 0 < M ∧ ∀ v : ℝ, ‖dvProfileDeriv2 phi v‖ ≤ M := by
  have hcs : HasCompactSupport (dvProfileDeriv2 phi) := by
    apply HasCompactSupport.intro (isCompact_Icc (a := (-2 : ℝ)) (b := 2))
    intro v hv
    refine dvProfileDeriv2_eq_zero_of_two_lt_abs hzero ?_
    rw [Set.mem_Icc] at hv
    rcases lt_or_ge v (-2) with h | h
    · rw [abs_of_neg (by linarith)]
      linarith
    · have hv2 : 2 < v := by
        by_contra hc
        exact hv ⟨h, le_of_not_gt hc⟩
      rw [abs_of_pos (by linarith)]
      exact hv2
  obtain ⟨M, hM⟩ := (continuous_dvProfileDeriv2 phi).bounded_above_of_compact_support hcs
  refine ⟨M + 1, ?_, fun v => le_trans (hM v) (by linarith)⟩
  have h0 : (0 : ℝ) ≤ M := le_trans (norm_nonneg _) (hM 0)
  linarith

theorem norm_sq_mul_dvProfileDeriv2_le {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    {M2 : ℝ} (hM2 : ∀ v : ℝ, ‖dvProfileDeriv2 phi v‖ ≤ M2) (w : ℝ) :
    ‖((w : ℂ) * (w : ℂ)) * dvProfileDeriv2 phi w‖ ≤ 4 * M2 := by
  have hM20 : 0 ≤ M2 := le_trans (norm_nonneg _) (hM2 0)
  by_cases h1 : |w| < 1
  · rw [dvProfileDeriv2_eq_zero_of_abs_lt_one hone h1]
    simp
    positivity
  · by_cases h2 : 2 < |w|
    · rw [dvProfileDeriv2_eq_zero_of_two_lt_abs hzero h2]
      simp
      positivity
    · have hle : |w| ≤ 2 := le_of_not_gt h2
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
      calc |w| * |w| * ‖dvProfileDeriv2 phi w‖ ≤ 2 * 2 * M2 := by
            apply mul_le_mul _ (hM2 w) (norm_nonneg _) (by norm_num)
            exact mul_le_mul hle hle (abs_nonneg _) (by norm_num)
        _ = 4 * M2 := by ring

/-- The second derivative of the band profile. -/
def dvBandDeriv2 (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (v : ℝ) : ℂ :=
  ((((2 : ℝ) ^ (j + 1))⁻¹ : ℝ) : ℂ) * ((((2 : ℝ) ^ (j + 1))⁻¹ : ℝ) : ℂ) *
      dvProfileDeriv2 phi ((((2 : ℝ) ^ (j + 1))⁻¹) * v) -
    ((((2 : ℝ) ^ j)⁻¹ : ℝ) : ℂ) * ((((2 : ℝ) ^ j)⁻¹ : ℝ) : ℂ) *
      dvProfileDeriv2 phi ((((2 : ℝ) ^ j)⁻¹) * v)

theorem hasDerivAt_dvBandDeriv (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (v : ℝ) :
    HasDerivAt (dvBandDeriv phi j) (dvBandDeriv2 phi j v) v := by
  have hgen : ∀ c : ℝ, HasDerivAt (fun w : ℝ => ((c : ℝ) : ℂ) * dvProfileDeriv phi (c * w))
      (((c : ℝ) : ℂ) * ((c : ℝ) : ℂ) * dvProfileDeriv2 phi (c * v)) v := by
    intro c
    have hlin : HasDerivAt (fun w : ℝ => c * w) c v := by
      simpa using (hasDerivAt_id v).const_mul c
    have h := (hasDerivAt_dvProfileDeriv phi (c * v)).scomp v hlin
    have h2 : HasDerivAt (fun w : ℝ => dvProfileDeriv phi (c * w))
        (((c : ℝ) : ℂ) * dvProfileDeriv2 phi (c * v)) v := by
      simpa [Function.comp_def, smul_eq_mul, mul_comm] using h
    have h3 := h2.const_mul (((c : ℝ) : ℂ))
    refine h3.congr_deriv ?_
    ring
  exact (hgen (((2 : ℝ) ^ (j + 1))⁻¹)).sub (hgen (((2 : ℝ) ^ j)⁻¹))

theorem continuous_dvBandDeriv2 (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) :
    Continuous (dvBandDeriv2 phi j) := by
  unfold dvBandDeriv2
  exact (continuous_const.mul
      ((continuous_dvProfileDeriv2 phi).comp (continuous_const.mul continuous_id))).sub
    (continuous_const.mul
      ((continuous_dvProfileDeriv2 phi).comp (continuous_const.mul continuous_id)))

theorem norm_sq_mul_dvBandDeriv2_le {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    {M2 : ℝ} (hM2 : ∀ v : ℝ, ‖dvProfileDeriv2 phi v‖ ≤ M2) (j : ℕ) (v : ℝ) :
    ‖((v : ℂ) * (v : ℂ)) * dvBandDeriv2 phi j v‖ ≤ 8 * M2 := by
  have hrw : ((v : ℂ) * (v : ℂ)) * dvBandDeriv2 phi j v =
      ((((((2 : ℝ) ^ (j + 1))⁻¹ * v : ℝ)) : ℂ) * ((((((2 : ℝ) ^ (j + 1))⁻¹ * v : ℝ)) : ℂ))) *
          dvProfileDeriv2 phi ((((2 : ℝ) ^ (j + 1))⁻¹) * v) -
        ((((((2 : ℝ) ^ j)⁻¹ * v : ℝ)) : ℂ) * ((((((2 : ℝ) ^ j)⁻¹ * v : ℝ)) : ℂ))) *
          dvProfileDeriv2 phi ((((2 : ℝ) ^ j)⁻¹) * v) := by
    unfold dvBandDeriv2
    push_cast
    ring
  rw [hrw]
  calc ‖((((((2 : ℝ) ^ (j + 1))⁻¹ * v : ℝ)) : ℂ) *
          ((((((2 : ℝ) ^ (j + 1))⁻¹ * v : ℝ)) : ℂ))) *
        dvProfileDeriv2 phi ((((2 : ℝ) ^ (j + 1))⁻¹) * v) -
      ((((((2 : ℝ) ^ j)⁻¹ * v : ℝ)) : ℂ) * ((((((2 : ℝ) ^ j)⁻¹ * v : ℝ)) : ℂ))) *
        dvProfileDeriv2 phi ((((2 : ℝ) ^ j)⁻¹) * v)‖ ≤
      ‖((((((2 : ℝ) ^ (j + 1))⁻¹ * v : ℝ)) : ℂ) *
          ((((((2 : ℝ) ^ (j + 1))⁻¹ * v : ℝ)) : ℂ))) *
        dvProfileDeriv2 phi ((((2 : ℝ) ^ (j + 1))⁻¹) * v)‖ +
        ‖((((((2 : ℝ) ^ j)⁻¹ * v : ℝ)) : ℂ) * ((((((2 : ℝ) ^ j)⁻¹ * v : ℝ)) : ℂ))) *
          dvProfileDeriv2 phi ((((2 : ℝ) ^ j)⁻¹) * v)‖ := norm_sub_le _ _
    _ ≤ 4 * M2 + 4 * M2 :=
        add_le_add (norm_sq_mul_dvProfileDeriv2_le hone hzero hM2 _)
          (norm_sq_mul_dvProfileDeriv2_le hone hzero hM2 _)
    _ = 8 * M2 := by ring

theorem norm_sq_mul_dvBandDeriv2_scaled {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    {M2 : ℝ} (hM2 : ∀ v : ℝ, ‖dvProfileDeriv2 phi v‖ ≤ M2) (j : ℕ) {u r : ℝ}
    (hr : 1 / 4 ≤ r) :
    ‖((u : ℂ) * (u : ℂ)) * dvBandDeriv2 phi j (u * r)‖ ≤ 128 * M2 := by
  have h8 := norm_sq_mul_dvBandDeriv2_le hone hzero hM2 j (u * r)
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_mul] at h8 ⊢
  have hrabs : (1 : ℝ) / 4 ≤ |r| := le_trans hr (le_abs_self r)
  have hnn : 0 ≤ |u| * |u| * ‖dvBandDeriv2 phi j (u * r)‖ := by positivity
  have heq : |u| * |r| * (|u| * |r|) * ‖dvBandDeriv2 phi j (u * r)‖ =
      (|u| * |u| * ‖dvBandDeriv2 phi j (u * r)‖) * (|r| * |r|) := by ring
  rw [heq] at h8
  have hr2 : (1 : ℝ) / 16 ≤ |r| * |r| := by nlinarith
  nlinarith [mul_le_mul_of_nonneg_left hr2 hnn]

/-- The second radial derivative of the band-multiplied amplitude. -/
def dvBandAmpDeriv2 (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u r : ℝ) : ℂ :=
  dvAmpDeriv2 p u r * dvBand phi j (u * r) +
    2 * (dvAmpDeriv p u r * ((u : ℂ) * dvBandDeriv phi j (u * r))) +
      planarCoordinateWaveRadialAmplitude p u r *
        (((u : ℂ) * (u : ℂ)) * dvBandDeriv2 phi j (u * r))

theorem hasDerivAt_dvBandAmpDeriv (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u r : ℝ) :
    HasDerivAt (fun v : ℝ => dvBandAmpDeriv phi j p u v) (dvBandAmpDeriv2 phi j p u r) r := by
  have hbandc : HasDerivAt (fun v : ℝ => dvBand phi j (u * v))
      ((u : ℂ) * dvBandDeriv phi j (u * r)) r := hasDerivAt_dvBand_comp phi j u r
  have hbandd : HasDerivAt (fun v : ℝ => (u : ℂ) * dvBandDeriv phi j (u * v))
      ((u : ℂ) * ((u : ℂ) * dvBandDeriv2 phi j (u * r))) r := by
    have hlin : HasDerivAt (fun v : ℝ => u * v) u r := by
      simpa using (hasDerivAt_id r).const_mul u
    have h := (hasDerivAt_dvBandDeriv phi j (u * r)).scomp r hlin
    have h2 : HasDerivAt (fun v : ℝ => dvBandDeriv phi j (u * v))
        ((u : ℂ) * dvBandDeriv2 phi j (u * r)) r := by
      simpa [Function.comp_def, smul_eq_mul, mul_comm] using h
    exact h2.const_mul ((u : ℂ))
  have h1 := (hasDerivAt_dvAmpDeriv p u r).mul hbandc
  have h2 := (hasDerivAt_planarCoordinateWaveRadialAmplitude p u r).mul hbandd
  have hsum := h1.add h2
  unfold dvBandAmpDeriv dvBandAmpDeriv2
  refine hsum.congr_deriv ?_
  ring

theorem continuous_dvBandAmpDeriv2 (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u : ℝ) :
    Continuous fun v : ℝ => dvBandAmpDeriv2 phi j p u v := by
  unfold dvBandAmpDeriv2
  refine Continuous.add (Continuous.add ?_ ?_) ?_
  · exact (continuous_dvAmpDeriv2 p u).mul
      ((continuous_dvBand phi j).comp (continuous_const.mul continuous_id))
  · exact continuous_const.mul ((continuous_dvAmpDeriv p u).mul
      (continuous_const.mul
        ((continuous_dvBandDeriv phi j).comp (continuous_const.mul continuous_id))))
  · exact (continuous_planarCoordinateWaveRadialAmplitude p u).mul
      (continuous_const.mul
        ((continuous_dvBandDeriv2 phi j).comp (continuous_const.mul continuous_id)))

/-- Uniform bounds for the band-multiplied amplitude and its first two radial
derivatives. -/
theorem exists_dvBandAmp_bounds {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (p : CoordinateWavePart) (u : ℝ), 1 ≤ u →
      ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
        ‖dvBandAmp phi j p u r‖ ≤ C / Real.sqrt u ∧
        ‖dvBandAmpDeriv phi j p u r‖ ≤ C / Real.sqrt u ∧
        ‖dvBandAmpDeriv2 phi j p u r‖ ≤ C / Real.sqrt u := by
  obtain ⟨C1, hC1, h1⟩ := exists_dvUniform_bound
  obtain ⟨C2, hC2, h2⟩ := exists_dvAmpDeriv2_bound
  obtain ⟨M, hM0, hM⟩ := exists_dvProfileDeriv_bound phi
  obtain ⟨M2, hM20, hM2⟩ := exists_dvProfileDeriv2_bound hzero
  refine ⟨(C1 + C2) * (2 + 16 * M + 128 * M2) * 2, by positivity, ?_⟩
  intro j p u hu r hr1 hr2
  obtain ⟨ha, had⟩ := h1 p u hu r hr1 hr2
  have ha2 := h2 p u hu r hr1 hr2
  have hband := norm_dvBand_le hnorm j (u * r)
  have hbd := norm_mul_dvBandDeriv_scaled hone hzero hM j (u := u) (r := r) hr1
  have hbd2 := norm_sq_mul_dvBandDeriv2_scaled hone hzero hM2 j (u := u) (r := r) hr1
  have hu0 : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr (lt_of_lt_of_le zero_lt_one hu)
  have hCsum : (0 : ℝ) < C1 + C2 := by linarith
  have habsorb : ∀ k : ℝ, 0 ≤ k → k ≤ 2 + 16 * M + 128 * M2 →
      (C1 + C2) / Real.sqrt u * k ≤ ((C1 + C2) * (2 + 16 * M + 128 * M2) * 2) / Real.sqrt u := by
    intro k hk hkle
    rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hu0]
    nlinarith [hCsum.le, hM0.le, hM20.le]
  have haC : ‖planarCoordinateWaveRadialAmplitude p u r‖ ≤ (C1 + C2) / Real.sqrt u := by
    refine ha.trans ?_
    gcongr
    linarith
  have hadC : ‖dvAmpDeriv p u r‖ ≤ (C1 + C2) / Real.sqrt u := by
    refine had.trans ?_
    gcongr
    linarith
  have ha2C : ‖dvAmpDeriv2 p u r‖ ≤ (C1 + C2) / Real.sqrt u := by
    refine ha2.trans ?_
    gcongr
    linarith
  refine ⟨?_, ?_, ?_⟩
  · unfold dvBandAmp
    rw [norm_mul]
    calc ‖planarCoordinateWaveRadialAmplitude p u r‖ * ‖dvBand phi j (u * r)‖ ≤
        ((C1 + C2) / Real.sqrt u) * 2 :=
          mul_le_mul haC hband (norm_nonneg _) (by positivity)
      _ ≤ _ := habsorb 2 (by norm_num) (by nlinarith [hM0.le, hM20.le])
  · unfold dvBandAmpDeriv
    calc ‖dvAmpDeriv p u r * dvBand phi j (u * r) +
          planarCoordinateWaveRadialAmplitude p u r *
            ((u : ℂ) * dvBandDeriv phi j (u * r))‖ ≤
        ‖dvAmpDeriv p u r * dvBand phi j (u * r)‖ +
          ‖planarCoordinateWaveRadialAmplitude p u r *
            ((u : ℂ) * dvBandDeriv phi j (u * r))‖ := norm_add_le _ _
      _ ≤ ((C1 + C2) / Real.sqrt u) * 2 + ((C1 + C2) / Real.sqrt u) * (16 * M) := by
          have e1 : ‖dvAmpDeriv p u r * dvBand phi j (u * r)‖ =
              ‖dvAmpDeriv p u r‖ * ‖dvBand phi j (u * r)‖ := norm_mul _ _
          have e2 : ‖planarCoordinateWaveRadialAmplitude p u r *
                ((u : ℂ) * dvBandDeriv phi j (u * r))‖ =
              ‖planarCoordinateWaveRadialAmplitude p u r‖ *
                ‖(u : ℂ) * dvBandDeriv phi j (u * r)‖ := norm_mul _ _
          rw [e1, e2]
          exact add_le_add (mul_le_mul hadC hband (norm_nonneg _) (by positivity))
            (mul_le_mul haC hbd (norm_nonneg _) (by positivity))
      _ = ((C1 + C2) / Real.sqrt u) * (2 + 16 * M) := by ring
      _ ≤ _ := habsorb (2 + 16 * M) (by positivity) (by nlinarith [hM20.le])
  · unfold dvBandAmpDeriv2
    calc ‖dvAmpDeriv2 p u r * dvBand phi j (u * r) +
          2 * (dvAmpDeriv p u r * ((u : ℂ) * dvBandDeriv phi j (u * r))) +
            planarCoordinateWaveRadialAmplitude p u r *
              (((u : ℂ) * (u : ℂ)) * dvBandDeriv2 phi j (u * r))‖ ≤
        ‖dvAmpDeriv2 p u r * dvBand phi j (u * r)‖ +
          ‖2 * (dvAmpDeriv p u r * ((u : ℂ) * dvBandDeriv phi j (u * r)))‖ +
            ‖planarCoordinateWaveRadialAmplitude p u r *
              (((u : ℂ) * (u : ℂ)) * dvBandDeriv2 phi j (u * r))‖ :=
          le_trans (norm_add_le _ _) (by gcongr; exact norm_add_le _ _)
      _ ≤ ((C1 + C2) / Real.sqrt u) * 2 + 2 * (((C1 + C2) / Real.sqrt u) * (16 * M)) +
            ((C1 + C2) / Real.sqrt u) * (128 * M2) := by
          have e1 : ‖dvAmpDeriv2 p u r * dvBand phi j (u * r)‖ =
              ‖dvAmpDeriv2 p u r‖ * ‖dvBand phi j (u * r)‖ := norm_mul _ _
          have e2 : ‖(2 : ℂ) * (dvAmpDeriv p u r * ((u : ℂ) * dvBandDeriv phi j (u * r)))‖ =
              2 * (‖dvAmpDeriv p u r‖ * ‖(u : ℂ) * dvBandDeriv phi j (u * r)‖) := by
            rw [norm_mul, norm_mul]
            norm_num
          have e3 : ‖planarCoordinateWaveRadialAmplitude p u r *
                (((u : ℂ) * (u : ℂ)) * dvBandDeriv2 phi j (u * r))‖ =
              ‖planarCoordinateWaveRadialAmplitude p u r‖ *
                ‖((u : ℂ) * (u : ℂ)) * dvBandDeriv2 phi j (u * r)‖ := norm_mul _ _
          rw [e1, e2, e3]
          refine add_le_add (add_le_add ?_ ?_) ?_
          · exact mul_le_mul ha2C hband (norm_nonneg _) (by positivity)
          · exact mul_le_mul_of_nonneg_left
              (mul_le_mul hadC hbd (norm_nonneg _) (by positivity)) (by norm_num)
          · exact mul_le_mul haC hbd2 (norm_nonneg _) (by positivity)
      _ = ((C1 + C2) / Real.sqrt u) * (2 + 32 * M + 128 * M2) := by ring
      _ ≤ _ := by
          rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hu0]
          nlinarith [hCsum.le, hM0.le, hM20.le]

/-- Uniform middle-wave bounds for the band-multiplied amplitude. -/
theorem exists_dvBandAmp_middle_bounds {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (u : ℝ), 1 ≤ u → ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
      ‖dvBandAmp phi j CoordinateWavePart.middle u r‖ ≤ C / u ^ 2 ∧
      ‖dvBandAmpDeriv phi j CoordinateWavePart.middle u r‖ ≤ C / u := by
  obtain ⟨Cm, hCm, hm⟩ := exists_planarAmplitude_middle_bound
  obtain ⟨M, hM0, hM⟩ := exists_dvProfileDeriv_bound phi
  refine ⟨Cm * (2 + 16 * M), by positivity, ?_⟩
  intro j u hu r hr1 hr2
  obtain ⟨h1, h2⟩ := hm u hu r hr1 hr2
  have hband := norm_dvBand_le hnorm j (u * r)
  have hbd := norm_mul_dvBandDeriv_scaled hone hzero hM j (u := u) (r := r) hr1
  have hu1 : (0 : ℝ) < u := lt_of_lt_of_le zero_lt_one hu
  have hsq : Cm / u ^ 2 ≤ Cm / u := by
    apply div_le_div_of_nonneg_left hCm.le hu1
    nlinarith
  constructor
  · unfold dvBandAmp
    rw [norm_mul]
    calc ‖planarCoordinateWaveRadialAmplitude CoordinateWavePart.middle u r‖ *
          ‖dvBand phi j (u * r)‖ ≤ (Cm / u ^ 2) * 2 :=
          mul_le_mul h1 hband (norm_nonneg _) (by positivity)
      _ ≤ (Cm * (2 + 16 * M)) / u ^ 2 := by
          rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right (by positivity)]
          nlinarith
  · unfold dvBandAmpDeriv
    calc ‖dvAmpDeriv CoordinateWavePart.middle u r * dvBand phi j (u * r) +
          planarCoordinateWaveRadialAmplitude CoordinateWavePart.middle u r *
            ((u : ℂ) * dvBandDeriv phi j (u * r))‖ ≤
        ‖dvAmpDeriv CoordinateWavePart.middle u r * dvBand phi j (u * r)‖ +
          ‖planarCoordinateWaveRadialAmplitude CoordinateWavePart.middle u r *
            ((u : ℂ) * dvBandDeriv phi j (u * r))‖ := norm_add_le _ _
      _ ≤ (Cm / u) * 2 + (Cm / u ^ 2) * (16 * M) := by
          have e1 : ‖dvAmpDeriv CoordinateWavePart.middle u r * dvBand phi j (u * r)‖ =
              ‖dvAmpDeriv CoordinateWavePart.middle u r‖ * ‖dvBand phi j (u * r)‖ :=
            norm_mul _ _
          have e2 : ‖planarCoordinateWaveRadialAmplitude CoordinateWavePart.middle u r *
                ((u : ℂ) * dvBandDeriv phi j (u * r))‖ =
              ‖planarCoordinateWaveRadialAmplitude CoordinateWavePart.middle u r‖ *
                ‖(u : ℂ) * dvBandDeriv phi j (u * r)‖ := norm_mul _ _
          rw [e1, e2]
          exact add_le_add (mul_le_mul h2 hband (norm_nonneg _) (by positivity))
            (mul_le_mul h1 hbd (norm_nonneg _) (by positivity))
      _ ≤ (Cm / u) * 2 + (Cm / u) * (16 * M) := by
          have : (Cm / u ^ 2) * (16 * M) ≤ (Cm / u) * (16 * M) :=
            mul_le_mul_of_nonneg_right hsq (by positivity)
          linarith
      _ = (Cm * (2 + 16 * M)) / u := by
          field_simp

theorem abs_coordinateWaveRadialPhase_le (p : CoordinateWavePart) (u : ℝ) :
    |coordinateWaveRadialPhase p u| ≤ 2 * Real.pi * |u| := by
  have hpi : (0 : ℝ) ≤ Real.pi := Real.pi_pos.le
  have hbase : ∀ x : ℝ, |2 * Real.pi * x| = 2 * Real.pi * |x| := by
    intro x
    rw [abs_mul, abs_mul, abs_two, abs_of_nonneg hpi]
  cases p with
  | outgoing =>
      simp only [coordinateWaveRadialPhase, abs_neg]
      rw [hbase]
  | incoming =>
      simp only [coordinateWaveRadialPhase]
      rw [hbase]
  | middle =>
      simp only [coordinateWaveRadialPhase, abs_zero]
      positivity

/-- The normalized amplitude of the radial derivative of the band multiplier. -/
def dvDAmp (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u r : ℝ) : ℂ :=
  (dvBandAmpDeriv phi j p u r +
      Complex.I * ((coordinateWaveRadialPhase p u : ℝ) : ℂ) * dvBandAmp phi j p u r) *
    ((u : ℂ))⁻¹

/-- Its radial derivative. -/
def dvDAmpD (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u r : ℝ) : ℂ :=
  (dvBandAmpDeriv2 phi j p u r +
      Complex.I * ((coordinateWaveRadialPhase p u : ℝ) : ℂ) * dvBandAmpDeriv phi j p u r) *
    ((u : ℂ))⁻¹

theorem hasDerivAt_dvDAmp (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u r : ℝ) :
    HasDerivAt (fun v : ℝ => dvDAmp phi j p u v) (dvDAmpD phi j p u r) r := by
  unfold dvDAmp dvDAmpD
  exact ((hasDerivAt_dvBandAmpDeriv phi j p u r).add
    ((hasDerivAt_dvBandAmp phi j p u r).const_mul
      (Complex.I * ((coordinateWaveRadialPhase p u : ℝ) : ℂ)))).mul_const _

theorem continuous_dvDAmp (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u : ℝ) :
    Continuous fun v : ℝ => dvDAmp phi j p u v := by
  unfold dvDAmp
  exact (((continuous_dvBandAmpDeriv phi j p u).add
    (continuous_const.mul (continuous_dvBandAmp phi j p u))).mul continuous_const)

theorem continuous_dvDAmpD (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) (u : ℝ) :
    Continuous fun v : ℝ => dvDAmpD phi j p u v := by
  unfold dvDAmpD
  exact (((continuous_dvBandAmpDeriv2 phi j p u).add
    (continuous_const.mul (continuous_dvBandAmpDeriv phi j p u))).mul continuous_const)

private theorem aux_dvD_bound {A B C u : ℝ} (hu : 1 ≤ u) (hA : A ≤ C / Real.sqrt u)
    (hB : B ≤ C / Real.sqrt u) (hC : 0 ≤ C) (hA0 : 0 ≤ A) (hB0 : 0 ≤ B) :
    (A + 2 * Real.pi * u * B) * u⁻¹ ≤ (C * (1 + 2 * Real.pi)) / Real.sqrt u := by
  have hu0 : (0 : ℝ) < u := lt_of_lt_of_le zero_lt_one hu
  have hsq0 : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr hu0
  have hpi : (0 : ℝ) < Real.pi := Real.pi_pos
  have hstep : (A + 2 * Real.pi * u * B) * u⁻¹ ≤
      (C / Real.sqrt u) * u⁻¹ + 2 * Real.pi * (C / Real.sqrt u) := by
    have h1 : (A + 2 * Real.pi * u * B) * u⁻¹ = A * u⁻¹ + 2 * Real.pi * B := by
      field_simp
    rw [h1]
    have h2 : A * u⁻¹ ≤ (C / Real.sqrt u) * u⁻¹ := by
      apply mul_le_mul_of_nonneg_right hA (by positivity)
    have h3 : 2 * Real.pi * B ≤ 2 * Real.pi * (C / Real.sqrt u) := by
      apply mul_le_mul_of_nonneg_left hB (by positivity)
    linarith
  refine hstep.trans ?_
  have huinv : u⁻¹ ≤ 1 := by
    rw [inv_le_one_iff₀]
    right
    exact hu
  have hfin : (C / Real.sqrt u) * u⁻¹ + 2 * Real.pi * (C / Real.sqrt u) =
      (C * u⁻¹ + 2 * Real.pi * C) / Real.sqrt u := by
    field_simp
  rw [hfin, div_le_div_iff_of_pos_right hsq0]
  nlinarith [mul_nonneg hC (le_of_lt hpi), huinv, hC]

/-- The normal form of the radial derivative of the band multiplier, divided
by the frequency modulus. -/
def dvSigD (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (u r : ℝ) : ℂ :=
  ∑ p ∈ dvParts, dvDAmp phi j p u r * oscillatoryExp (coordinateWaveRadialPhase p u) r

set_option maxHeartbeats 1600000 in
/-- **The radial pair-kernel bound for the derivative multiplier.** -/
theorem exists_dvBandDerivKernel_bound {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (s t : ℝ), 1 ≤ s → 1 ≤ t → t ≤ 100 * s → s ≤ 100 * t →
      ‖∫ r in (1 / 4 : ℝ)..5, (dvWeight r : ℂ) * dvSigD phi j s r *
          (starRingEnd ℂ) (dvSigD phi j t r)‖ ≤ C * ((s⁻¹ + t⁻¹) / (1 + |s - t|)) := by
  obtain ⟨C, hC, hb⟩ := exists_dvBandAmp_bounds hone hzero hnorm
  obtain ⟨Cm, hCm, hmb⟩ := exists_dvBandAmp_middle_bounds hone hzero hnorm
  have hpi : (0 : ℝ) < Real.pi := Real.pi_pos
  set C' : ℝ := C * (1 + 2 * Real.pi) with hC'def
  set Cm' : ℝ := Cm + C with hCm'def
  have hC' : 0 < C' := by
    simp only [hC'def]
    positivity
  have hCm' : 0 < Cm' := by
    simp only [hCm'def]
    positivity
  refine ⟨9 * (673200 * (C' * C') + 13200 * (C' * C') + 18360 * (Cm' * Cm') + 1),
    by positivity, ?_⟩
  intro j
  have hnorminv : ∀ u : ℝ, 1 ≤ u → ‖((u : ℂ))⁻¹‖ = u⁻¹ := by
    intro u hu
    rw [norm_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (lt_of_lt_of_le zero_lt_one hu)]
  refine dvKernel_bound_of_abstract
    (Amp := dvDAmp phi j) (AmpD := dvDAmpD phi j) (Sig := dvSigD phi j)
    (fun p u r => hasDerivAt_dvDAmp phi j p u r)
    (fun p u => continuous_dvDAmp phi j p u)
    (fun p u => continuous_dvDAmpD phi j p u)
    (fun u r => rfl) hC' hCm' (fun p u hu r hr1 hr2 => ?_) (fun u hu r hr1 hr2 => ?_)
  · obtain ⟨h0, h1, h2⟩ := hb j p u hu r hr1 hr2
    have hu0 : (0 : ℝ) < u := lt_of_lt_of_le zero_lt_one hu
    have hphase : |coordinateWaveRadialPhase p u| ≤ 2 * Real.pi * u := by
      have := abs_coordinateWaveRadialPhase_le p u
      rwa [abs_of_pos hu0] at this
    have hkey : ∀ A B : ℂ, ‖A‖ ≤ C / Real.sqrt u → ‖B‖ ≤ C / Real.sqrt u →
        ‖(A + Complex.I * ((coordinateWaveRadialPhase p u : ℝ) : ℂ) * B) * ((u : ℂ))⁻¹‖ ≤
          C' / Real.sqrt u := by
      intro A B hA hB
      have hstep : ‖(A + Complex.I * ((coordinateWaveRadialPhase p u : ℝ) : ℂ) * B) *
          ((u : ℂ))⁻¹‖ ≤ (‖A‖ + 2 * Real.pi * u * ‖B‖) * u⁻¹ := by
        rw [norm_mul, hnorminv u hu]
        refine mul_le_mul_of_nonneg_right ?_ (by positivity)
        refine le_trans (norm_add_le _ _) ?_
        have hb2 : ‖Complex.I * ((coordinateWaveRadialPhase p u : ℝ) : ℂ) * B‖ ≤
            2 * Real.pi * u * ‖B‖ := by
          rw [norm_mul, norm_mul, Complex.norm_I, one_mul, Complex.norm_real,
            Real.norm_eq_abs]
          exact mul_le_mul_of_nonneg_right hphase (norm_nonneg _)
        linarith
      exact hstep.trans (aux_dvD_bound hu hA hB hC.le (norm_nonneg _) (norm_nonneg _))
    exact ⟨hkey _ _ h1 h0, hkey _ _ h2 h1⟩
  · obtain ⟨hm0, hm1⟩ := hmb j u hu r hr1 hr2
    obtain ⟨_, _, h2⟩ := hb j CoordinateWavePart.middle u hu r hr1 hr2
    have hu0 : (0 : ℝ) < u := lt_of_lt_of_le zero_lt_one hu
    have hphase0 : coordinateWaveRadialPhase CoordinateWavePart.middle u = 0 := rfl
    have hsimp : ∀ A : ℂ,
        (A + Complex.I * ((coordinateWaveRadialPhase CoordinateWavePart.middle u : ℝ) : ℂ) *
          dvBandAmp phi j CoordinateWavePart.middle u r) = A := by
      intro A
      rw [hphase0]
      simp
    constructor
    · unfold dvDAmp
      rw [hsimp, norm_mul, hnorminv u hu]
      calc ‖dvBandAmpDeriv phi j CoordinateWavePart.middle u r‖ * u⁻¹ ≤
          (Cm / u) * u⁻¹ := mul_le_mul_of_nonneg_right hm1 (by positivity)
        _ = Cm / u ^ 2 := by
            field_simp
        _ ≤ Cm' / u ^ 2 := by
            apply div_le_div_of_nonneg_right _ (by positivity)
            simp only [hCm'def]
            linarith
    · unfold dvDAmpD
      have hsimp2 : (dvBandAmpDeriv2 phi j CoordinateWavePart.middle u r +
          Complex.I * ((coordinateWaveRadialPhase CoordinateWavePart.middle u : ℝ) : ℂ) *
            dvBandAmpDeriv phi j CoordinateWavePart.middle u r) =
          dvBandAmpDeriv2 phi j CoordinateWavePart.middle u r := by
        rw [hphase0]
        simp
      rw [hsimp2, norm_mul, hnorminv u hu]
      have hsq1 : (1 : ℝ) ≤ Real.sqrt u := Real.one_le_sqrt.mpr hu
      have hstep : ‖dvBandAmpDeriv2 phi j CoordinateWavePart.middle u r‖ ≤ C := by
        refine h2.trans ?_
        rw [div_le_iff₀ (by positivity)]
        nlinarith [hC.le]
      calc ‖dvBandAmpDeriv2 phi j CoordinateWavePart.middle u r‖ * u⁻¹ ≤ C * u⁻¹ :=
            mul_le_mul_of_nonneg_right hstep (by positivity)
        _ = C / u := by field_simp
        _ ≤ Cm' / u := by
            apply div_le_div_of_nonneg_right _ hu0.le
            simp only [hCm'def]
            linarith
/-! ### The radial normal form, the crude kernel and the radial Sobolev step -/

/-- The band multiplier in radial normal form. -/
def dvSig (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (u r : ℝ) : ℂ :=
  planarCoordinateSurfaceWaveSum (u * r) * dvBand phi j (u * r)

theorem dvSig_eq_sum (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (u r : ℝ) :
    dvSig phi j u r =
      ∑ p ∈ dvParts, dvBandAmp phi j p u r *
        oscillatoryExp (coordinateWaveRadialPhase p u) r := by
  rw [dvParts_sum]
  have h := planarCoordinateSurfaceWaveSum_eq_three_radialTerms u r
  unfold planarCoordinateWaveRadialTerm at h
  unfold dvSig dvBandAmp
  rw [h]
  ring

/-- The literal relative band multiplier is the radial normal form. -/
theorem dvSig_eq_multiplier {phi : SchwartzMap (Euclidean 2) ℂ}
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) (j : ℕ) {t : ℝ} (ht : 0 < t)
    (ξ : Euclidean 2) :
    surfaceFourier 2 (-t • ξ) *
        (phi ((((2 : ℝ) ^ (j + 1))⁻¹) • (t • ξ)) - phi ((((2 : ℝ) ^ j)⁻¹) • (t • ξ))) =
      dvSig phi j ‖ξ‖ t := by
  have hsurf : surfaceFourier 2 (-t • ξ) = planarCoordinateSurfaceWaveSum (‖ξ‖ * t) := by
    rw [surfaceFourier_two_neg_smul_eq_planarCoordinateSurfaceWaveSum ht ξ, mul_comm]
  have hband : ∀ n : ℕ, phi ((((2 : ℝ) ^ n)⁻¹) • (t • ξ)) =
      dvProfile phi ((((2 : ℝ) ^ n)⁻¹) * (‖ξ‖ * t)) := by
    intro n
    rw [dvProfile_apply hrad]
    congr 1
    rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_pos (by positivity : (0 : ℝ) < ((2 : ℝ) ^ n)⁻¹), abs_of_pos ht]
    ring
  rw [hsurf, hband, hband]
  unfold dvSig dvBand
  ring

theorem norm_dvSig_le {phi : SchwartzMap (Euclidean 2) ℂ} {C : ℝ}
    (hb : ∀ (j : ℕ) (p : CoordinateWavePart) (u : ℝ), 1 ≤ u →
      ∀ r : ℝ, 1 / 4 ≤ r → r ≤ 5 →
        ‖dvBandAmp phi j p u r‖ ≤ C / Real.sqrt u ∧
        ‖dvBandAmpDeriv phi j p u r‖ ≤ C / Real.sqrt u ∧
        ‖dvBandAmpDeriv2 phi j p u r‖ ≤ C / Real.sqrt u)
    (j : ℕ) {u : ℝ} (hu : 1 ≤ u) {r : ℝ} (hr1 : 1 / 4 ≤ r) (hr2 : r ≤ 5) :
    ‖dvSig phi j u r‖ ≤ 3 * (C / Real.sqrt u) := by
  rw [dvSig_eq_sum, dvParts_sum]
  have hterm : ∀ p : CoordinateWavePart,
      ‖dvBandAmp phi j p u r * oscillatoryExp (coordinateWaveRadialPhase p u) r‖ ≤
        C / Real.sqrt u := by
    intro p
    rw [norm_mul, norm_oscillatoryExp, mul_one]
    exact (hb j p u hu r hr1 hr2).1
  calc ‖dvBandAmp phi j CoordinateWavePart.outgoing u r *
          oscillatoryExp (coordinateWaveRadialPhase CoordinateWavePart.outgoing u) r +
        dvBandAmp phi j CoordinateWavePart.incoming u r *
          oscillatoryExp (coordinateWaveRadialPhase CoordinateWavePart.incoming u) r +
        dvBandAmp phi j CoordinateWavePart.middle u r *
          oscillatoryExp (coordinateWaveRadialPhase CoordinateWavePart.middle u) r‖ ≤
      C / Real.sqrt u + C / Real.sqrt u + C / Real.sqrt u := by
        refine le_trans (norm_add_le _ _) ?_
        refine add_le_add (le_trans (norm_add_le _ _) (add_le_add (hterm _) (hterm _)))
          (hterm _)
    _ = 3 * (C / Real.sqrt u) := by ring

theorem hasDerivAt_oscillatoryExp (c r : ℝ) :
    HasDerivAt (fun v : ℝ => oscillatoryExp c v)
      (oscillatoryExp c r * ((c : ℂ) * Complex.I)) r := by
  have hlin : HasDerivAt (fun v : ℝ => ((c * v : ℝ) : ℂ)) ((c : ℂ)) r := by
    have h := (hasDerivAt_id r).const_mul c
    have h2 : HasDerivAt (fun v : ℝ => c * v) c r := by simpa using h
    simpa using h2.ofReal_comp
  have hz : HasDerivAt (fun v : ℝ => ((c * v : ℝ) : ℂ) * Complex.I)
      ((c : ℂ) * Complex.I) r := hlin.mul_const Complex.I
  have := hz.cexp
  unfold oscillatoryExp
  exact this

theorem hasDerivAt_dvSig (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) {u : ℝ}
    (hu : u ≠ 0) (r : ℝ) :
    HasDerivAt (fun v : ℝ => dvSig phi j u v) ((u : ℂ) * dvSigD phi j u r) r := by
  have hfun : (fun v : ℝ => dvSig phi j u v) =
      fun v : ℝ => ∑ p ∈ dvParts, dvBandAmp phi j p u v *
        oscillatoryExp (coordinateWaveRadialPhase p u) v := by
    funext v
    exact dvSig_eq_sum phi j u v
  rw [hfun]
  have hterm : ∀ p : CoordinateWavePart,
      HasDerivAt (fun v : ℝ => dvBandAmp phi j p u v *
          oscillatoryExp (coordinateWaveRadialPhase p u) v)
        ((u : ℂ) * (dvDAmp phi j p u r *
          oscillatoryExp (coordinateWaveRadialPhase p u) r)) r := by
    intro p
    have h := (hasDerivAt_dvBandAmp phi j p u r).mul
      (hasDerivAt_oscillatoryExp (coordinateWaveRadialPhase p u) r)
    refine h.congr_deriv ?_
    have huc : ((u : ℂ)) ≠ 0 := by
      simpa using hu
    unfold dvDAmp
    field_simp
  have hsum : HasDerivAt (fun v : ℝ => ∑ p ∈ dvParts, dvBandAmp phi j p u v *
      oscillatoryExp (coordinateWaveRadialPhase p u) v)
      (∑ p ∈ dvParts, (u : ℂ) * (dvDAmp phi j p u r *
        oscillatoryExp (coordinateWaveRadialPhase p u) r)) r :=
    HasDerivAt.fun_sum (fun p _ => hterm p)
  refine hsum.congr_deriv ?_
  unfold dvSigD
  rw [Finset.mul_sum]

/-- A continuous cutoff which is one on `[1/4, 5]` and vanishes outside
`[1/8, 6]`. -/
def dvTcut (t : ℝ) : ℝ := min 1 (max 0 (min (8 * t - 1) (6 - t)))

theorem continuous_dvTcut : Continuous dvTcut := by
  unfold dvTcut
  fun_prop

theorem dvTcut_eq_one {t : ℝ} (h1 : 1 / 4 ≤ t) (h2 : t ≤ 5) : dvTcut t = 1 := by
  unfold dvTcut
  have ha : (1 : ℝ) ≤ 8 * t - 1 := by linarith
  have hb : (1 : ℝ) ≤ 6 - t := by linarith
  have hmin : (1 : ℝ) ≤ min (8 * t - 1) (6 - t) := le_min ha hb
  have hmax : (1 : ℝ) ≤ max 0 (min (8 * t - 1) (6 - t)) :=
    le_trans hmin (le_max_right _ _)
  exact min_eq_left hmax

theorem dvTcut_nonneg (t : ℝ) : 0 ≤ dvTcut t := by
  unfold dvTcut
  rcases le_total (1 : ℝ) (max 0 (min (8 * t - 1) (6 - t))) with h | h
  · rw [min_eq_left h]
    norm_num
  · rw [min_eq_right h]
    exact le_max_left _ _

theorem dvTcut_le_one (t : ℝ) : dvTcut t ≤ 1 := min_le_left _ _

theorem dvTcut_eq_zero_of_lt {t : ℝ} (h : t < 1 / 8) : dvTcut t = 0 := by
  unfold dvTcut
  have h1 : 8 * t - 1 < 0 := by linarith
  have h2 : max 0 (min (8 * t - 1) (6 - t)) = 0 := by
    rw [max_eq_left]
    exact le_of_lt (lt_of_le_of_lt (min_le_left _ _) h1)
  rw [h2]
  norm_num

theorem dvTcut_eq_zero_of_gt {t : ℝ} (h : 6 < t) : dvTcut t = 0 := by
  unfold dvTcut
  have h1 : 6 - t < 0 := by linarith
  have h2 : max 0 (min (8 * t - 1) (6 - t)) = 0 := by
    rw [max_eq_left]
    exact le_of_lt (lt_of_le_of_lt (min_le_right _ _) h1)
  rw [h2]
  norm_num

/-- The square root of the radial weight, cut off outside `[1/8, 6]`. -/
def dvSqrtW (t : ℝ) : ℝ := dvTcut t * Real.sqrt (dvWeight t)

theorem continuous_dvSqrtW : Continuous dvSqrtW := by
  unfold dvSqrtW
  exact continuous_dvTcut.mul (Real.continuous_sqrt.comp continuous_dvWeight)

theorem dvSqrtW_sq {t : ℝ} (h1 : 1 / 4 ≤ t) (h2 : t ≤ 5) :
    dvSqrtW t * dvSqrtW t = dvWeight t := by
  unfold dvSqrtW
  rw [dvTcut_eq_one h1 h2, one_mul]
  exact Real.mul_self_sqrt (dvWeight_nonneg t)

theorem dvSqrtW_eq_zero_of_lt {t : ℝ} (h : t < 1 / 8) : dvSqrtW t = 0 := by
  unfold dvSqrtW
  rw [dvTcut_eq_zero_of_lt h, zero_mul]

theorem dvSqrtW_eq_zero_of_gt {t : ℝ} (h : 6 < t) : dvSqrtW t = 0 := by
  unfold dvSqrtW
  rw [dvTcut_eq_zero_of_gt h, zero_mul]

theorem continuous_planarEndpointQuadraticIntegral :
    Continuous planarEndpointQuadraticIntegral :=
  contDiff_planarEndpointQuadraticIntegral.continuous

theorem continuous_deriv_planarEndpointQuadraticIntegral :
    Continuous (deriv planarEndpointQuadraticIntegral) :=
  (contDiff_infty_iff_deriv.mp contDiff_planarEndpointQuadraticIntegral).2.continuous

theorem continuous_coordinateMiddle : Continuous (coordinateMiddleMeridianLocalizedIntegral 0) :=
  (contDiff_coordinateMiddleMeridianLocalizedIntegral 0).continuous

theorem continuous_deriv_coordinateMiddle :
    Continuous (deriv (coordinateMiddleMeridianLocalizedIntegral 0)) :=
  (contDiff_infty_iff_deriv.mp (contDiff_coordinateMiddleMeridianLocalizedIntegral 0)).2.continuous

theorem continuous_uncurry_planarCoordinateWaveRadialAmplitude (p : CoordinateWavePart) :
    Continuous fun q : ℝ × ℝ => planarCoordinateWaveRadialAmplitude p q.1 q.2 := by
  cases p with
  | outgoing =>
      exact continuous_const.mul
        (continuous_planarEndpointQuadraticIntegral.comp (by fun_prop))
  | incoming =>
      exact continuous_const.mul
        (continuous_planarEndpointQuadraticIntegral.comp (by fun_prop))
  | middle =>
      exact continuous_const.mul (continuous_coordinateMiddle.comp (by fun_prop))

theorem continuous_uncurry_dvAmpDeriv (p : CoordinateWavePart) :
    Continuous fun q : ℝ × ℝ => dvAmpDeriv p q.1 q.2 := by
  cases p with
  | outgoing =>
      exact continuous_const.mul ((by fun_prop : Continuous fun q : ℝ × ℝ =>
        (((2 * Real.pi * q.1 : ℝ)) : ℂ)).mul
        (continuous_deriv_planarEndpointQuadraticIntegral.comp (by fun_prop)))
  | incoming =>
      exact continuous_const.mul ((by fun_prop : Continuous fun q : ℝ × ℝ =>
        (((-(2 * Real.pi * q.1) : ℝ)) : ℂ)).mul
        (continuous_deriv_planarEndpointQuadraticIntegral.comp (by fun_prop)))
  | middle =>
      exact continuous_const.mul ((by fun_prop : Continuous fun q : ℝ × ℝ =>
        (((2 * Real.pi * q.1 : ℝ)) : ℂ)).mul
        (continuous_deriv_coordinateMiddle.comp (by fun_prop)))

theorem continuous_planarCoordinateSurfaceWaveSum :
    Continuous planarCoordinateSurfaceWaveSum := by
  unfold planarCoordinateSurfaceWaveSum
  refine continuous_const.mul (Continuous.add (Continuous.add ?_ ?_) ?_)
  · exact ((Complex.continuous_exp.comp (by fun_prop))).mul
      (continuous_planarEndpointQuadraticIntegral.comp (by fun_prop))
  · exact ((Complex.continuous_exp.comp (by fun_prop))).mul
      (continuous_planarEndpointQuadraticIntegral.comp (by fun_prop))
  · exact continuous_coordinateMiddle.comp (by fun_prop)

theorem continuous_uncurry_dvSig (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) :
    Continuous fun q : ℝ × ℝ => dvSig phi j q.1 q.2 := by
  unfold dvSig
  exact (continuous_planarCoordinateSurfaceWaveSum.comp (by fun_prop)).mul
    ((continuous_dvBand phi j).comp (by fun_prop))

theorem continuous_uncurry_dvBandAmp (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) :
    Continuous fun q : ℝ × ℝ => dvBandAmp phi j p q.1 q.2 := by
  unfold dvBandAmp
  exact (continuous_uncurry_planarCoordinateWaveRadialAmplitude p).mul
    ((continuous_dvBand phi j).comp (by fun_prop))

theorem continuous_uncurry_dvBandAmpDeriv (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ)
    (p : CoordinateWavePart) :
    Continuous fun q : ℝ × ℝ => dvBandAmpDeriv phi j p q.1 q.2 := by
  unfold dvBandAmpDeriv
  refine Continuous.add ?_ ?_
  · exact (continuous_uncurry_dvAmpDeriv p).mul ((continuous_dvBand phi j).comp (by fun_prop))
  · exact (continuous_uncurry_planarCoordinateWaveRadialAmplitude p).mul
      ((by fun_prop : Continuous fun q : ℝ × ℝ => ((q.1 : ℝ) : ℂ)).mul
        ((continuous_dvBandDeriv phi j).comp (by fun_prop)))

/-- The numerator normal form of the radial derivative: continuous, and equal
to `u` times `dvSigD`. -/
def dvSigDnum (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (u r : ℝ) : ℂ :=
  ∑ p ∈ dvParts, (dvBandAmpDeriv phi j p u r +
      Complex.I * ((coordinateWaveRadialPhase p u : ℝ) : ℂ) * dvBandAmp phi j p u r) *
    oscillatoryExp (coordinateWaveRadialPhase p u) r

theorem continuous_uncurry_dvSigDnum (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) :
    Continuous fun q : ℝ × ℝ => dvSigDnum phi j q.1 q.2 := by
  unfold dvSigDnum
  refine continuous_finsetSum _ fun p _ => ?_
  refine Continuous.mul (Continuous.add (continuous_uncurry_dvBandAmpDeriv phi j p) ?_) ?_
  · refine Continuous.mul ?_ (continuous_uncurry_dvBandAmp phi j p)
    refine continuous_const.mul ?_
    have hph : Continuous fun u : ℝ => coordinateWaveRadialPhase p u := by
      cases p with
      | outgoing => exact (continuous_const.mul continuous_id).neg
      | incoming => exact continuous_const.mul continuous_id
      | middle => exact continuous_const
    exact (Complex.continuous_ofReal.comp (hph.comp continuous_fst))
  · unfold oscillatoryExp
    refine Complex.continuous_exp.comp ?_
    have hph : Continuous fun u : ℝ => coordinateWaveRadialPhase p u := by
      cases p with
      | outgoing => exact (continuous_const.mul continuous_id).neg
      | incoming => exact continuous_const.mul continuous_id
      | middle => exact continuous_const
    exact ((Complex.continuous_ofReal.comp
      ((hph.comp continuous_fst).mul continuous_snd)).mul continuous_const)

theorem dvSigDnum_eq (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (u r : ℝ) :
    dvSigDnum phi j u r = (u : ℂ) * dvSigD phi j u r := by
  by_cases hu : u = 0
  · subst hu
    have hband : dvBand phi j (0 * r) = 0 := by
      unfold dvBand
      norm_num
    unfold dvSigDnum dvSigD dvBandAmpDeriv dvBandAmp
    rw [hband]
    simp
  · unfold dvSigDnum dvSigD dvDAmp
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    have huc : ((u : ℂ)) ≠ 0 := by simpa using hu
    field_simp

private theorem aux_inv_sqrt_le {s t : ℝ} (hs : 1 ≤ s) (ht : 1 ≤ t) :
    1 / (Real.sqrt s * Real.sqrt t) ≤ s⁻¹ + t⁻¹ := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  have ht0 : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
  have hsq : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hs0
  have htq : (0 : ℝ) < Real.sqrt t := Real.sqrt_pos.mpr ht0
  have ha : (Real.sqrt s)⁻¹ ^ 2 = s⁻¹ := by
    rw [inv_pow, Real.sq_sqrt hs0.le]
  have hb : (Real.sqrt t)⁻¹ ^ 2 = t⁻¹ := by
    rw [inv_pow, Real.sq_sqrt ht0.le]
  have hkey : 2 * ((Real.sqrt s)⁻¹ * (Real.sqrt t)⁻¹) ≤
      (Real.sqrt s)⁻¹ ^ 2 + (Real.sqrt t)⁻¹ ^ 2 := by
    nlinarith [sq_nonneg ((Real.sqrt s)⁻¹ - (Real.sqrt t)⁻¹)]
  rw [ha, hb] at hkey
  have hrw : 1 / (Real.sqrt s * Real.sqrt t) = (Real.sqrt s)⁻¹ * (Real.sqrt t)⁻¹ := by
    field_simp
  rw [hrw]
  nlinarith [mul_pos (inv_pos.mpr hsq) (inv_pos.mpr htq)]

/-- **The crude radial pair-kernel bound.**  No oscillation is used. -/
theorem exists_dvCrudeKernel_bound {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : ℕ) (s t : ℝ), 1 ≤ s → 1 ≤ t →
      ‖∫ r in (1 / 4 : ℝ)..5, dvSig phi j s r * (starRingEnd ℂ) (dvSig phi j t r)‖ ≤
        C * (s⁻¹ + t⁻¹) := by
  obtain ⟨C, hC, hb⟩ := exists_dvBandAmp_bounds hone hzero hnorm
  refine ⟨43 * (C * C) + 1, by positivity, ?_⟩
  intro j s t hs ht
  have hs0 : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr (lt_of_lt_of_le zero_lt_one hs)
  have ht0 : (0 : ℝ) < Real.sqrt t := Real.sqrt_pos.mpr (lt_of_lt_of_le zero_lt_one ht)
  have hpt : ∀ r ∈ Set.uIoc (1 / 4 : ℝ) 5,
      ‖dvSig phi j s r * (starRingEnd ℂ) (dvSig phi j t r)‖ ≤
        9 * (C * C) * (1 / (Real.sqrt s * Real.sqrt t)) := by
    intro r hr
    rw [Set.uIoc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)] at hr
    have hr1 : 1 / 4 ≤ r := le_of_lt hr.1
    have hr2 : r ≤ 5 := hr.2
    rw [norm_mul, RCLike.norm_conj]
    calc ‖dvSig phi j s r‖ * ‖dvSig phi j t r‖ ≤
        (3 * (C / Real.sqrt s)) * (3 * (C / Real.sqrt t)) :=
          mul_le_mul (norm_dvSig_le hb j hs hr1 hr2) (norm_dvSig_le hb j ht hr1 hr2)
            (norm_nonneg _) (by positivity)
      _ = 9 * (C * C) * (1 / (Real.sqrt s * Real.sqrt t)) := by
          field_simp
          ring
  have hmain := intervalIntegral.norm_integral_le_of_norm_le_const hpt
  refine hmain.trans ?_
  have hlen : |(5 : ℝ) - 1 / 4| = 19 / 4 := by
    rw [abs_of_nonneg (by norm_num)]
    norm_num
  rw [hlen]
  have hinv := aux_inv_sqrt_le hs ht
  have hCC : (0 : ℝ) ≤ C * C := by positivity
  calc 9 * (C * C) * (1 / (Real.sqrt s * Real.sqrt t)) * (19 / 4) ≤
      9 * (C * C) * (s⁻¹ + t⁻¹) * (19 / 4) := by
        apply mul_le_mul_of_nonneg_right _ (by norm_num)
        exact mul_le_mul_of_nonneg_left hinv (by positivity)
    _ ≤ (43 * (C * C) + 1) * (s⁻¹ + t⁻¹) := by
        have hsum : (0 : ℝ) ≤ s⁻¹ + t⁻¹ := by
          have h1 : (0:ℝ) < s := lt_of_lt_of_le zero_lt_one hs
          have h2 : (0:ℝ) < t := lt_of_lt_of_le zero_lt_one ht
          positivity
        nlinarith

/-- **The radial Sobolev estimate with the vanishing smooth weight.**  Since
the weight vanishes at the left endpoint there is no boundary term. -/
theorem dvSobolev {F FD : ℝ → ℂ} (hFcont : Continuous F) (hFDcont : Continuous FD)
    (hderiv : ∀ t : ℝ, HasDerivAt F (FD t) t) (lam : ℝ) (hlam : 0 < lam)
    {r₀ : ℝ} (h1 : 1 ≤ r₀) (h2 : r₀ ≤ 2) :
    ‖F r₀‖ ^ 2 ≤ 60 * (∫ t in (1 / 4 : ℝ)..5, ‖F t‖ ^ 2) +
      lam * (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖F t‖ ^ 2) +
      lam⁻¹ * (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖FD t‖ ^ 2) := by
  set G : ℝ → ℝ := fun t => dvWeight t * ‖F t‖ ^ 2 with hGdef
  set G' : ℝ → ℝ := fun t =>
    dvWeightDeriv t * ‖F t‖ ^ 2 + dvWeight t * (2 * (inner ℝ (F t) (FD t) : ℝ)) with hG'def
  have hnormsq : ∀ t : ℝ, HasDerivAt (fun s : ℝ => ‖F s‖ ^ 2)
      (2 * (inner ℝ (F t) (FD t) : ℝ)) t := by
    intro t
    simpa using (hderiv t).norm_sq
  have hGderiv : ∀ t : ℝ, HasDerivAt G (G' t) t := by
    intro t
    exact (hasDerivAt_dvWeight t).mul (hnormsq t)
  have hG'cont : Continuous G' := by
    simp only [hG'def]
    exact (continuous_dvWeightDeriv.mul (hFcont.norm.pow 2)).add
      (continuous_dvWeight.mul (continuous_const.mul (hFcont.inner hFDcont)))
  have hFTC : G r₀ - G (1 / 4) = ∫ t in (1 / 4 : ℝ)..r₀, G' t := by
    refine (intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hGderiv t) ?_).symm
    exact hG'cont.intervalIntegrable _ _
  have hG0 : G (1 / 4) = 0 := by
    simp only [hGdef, dvWeight_left, zero_mul]
  have hlow : ‖F r₀‖ ^ 2 ≤ G r₀ := by
    simp only [hGdef]
    have hw : 1 ≤ dvWeight r₀ := one_le_dvWeight (by linarith) (by linarith)
    nlinarith [sq_nonneg ‖F r₀‖]
  -- the pointwise bound on the derivative of the weighted square
  have hptwise : ∀ t ∈ Set.uIcc (1 / 4 : ℝ) 5, G' t ≤
      60 * ‖F t‖ ^ 2 + (lam * (dvWeight t * ‖F t‖ ^ 2) +
        lam⁻¹ * (dvWeight t * ‖FD t‖ ^ 2)) := by
    intro t ht
    rw [Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)] at ht
    have hd : |dvWeightDeriv t| ≤ 60 := abs_dvWeightDeriv_le ht.1 ht.2
    have hw0 : 0 ≤ dvWeight t := dvWeight_nonneg t
    have hinner : (inner ℝ (F t) (FD t) : ℝ) ≤ ‖F t‖ * ‖FD t‖ := real_inner_le_norm _ _
    have hyoung : 2 * (‖F t‖ * ‖FD t‖) ≤ lam * ‖F t‖ ^ 2 + lam⁻¹ * ‖FD t‖ ^ 2 := by
      have h0 : 0 ≤ (lam * ‖F t‖ - ‖FD t‖) ^ 2 := sq_nonneg _
      have hinvl : lam⁻¹ * lam = 1 := inv_mul_cancel₀ hlam.ne'
      have hmul : 2 * (‖F t‖ * ‖FD t‖) * lam ≤
          (lam * ‖F t‖ ^ 2 + lam⁻¹ * ‖FD t‖ ^ 2) * lam := by
        nlinarith [h0, hinvl]
      exact le_of_mul_le_mul_right hmul hlam
    have h1' : dvWeightDeriv t * ‖F t‖ ^ 2 ≤ 60 * ‖F t‖ ^ 2 := by
      nlinarith [sq_nonneg ‖F t‖, abs_le.mp hd]
    have h2' : dvWeight t * (2 * (inner ℝ (F t) (FD t) : ℝ)) ≤
        dvWeight t * (lam * ‖F t‖ ^ 2 + lam⁻¹ * ‖FD t‖ ^ 2) := by
      apply mul_le_mul_of_nonneg_left _ hw0
      nlinarith
    simp only [hG'def]
    nlinarith [h1', h2']
  have hmono : (∫ t in (1 / 4 : ℝ)..r₀, G' t) ≤
      ∫ t in (1 / 4 : ℝ)..5, (60 * ‖F t‖ ^ 2 + (lam * (dvWeight t * ‖F t‖ ^ 2) +
        lam⁻¹ * (dvWeight t * ‖FD t‖ ^ 2))) := by
    have hRint : IntervalIntegrable (fun t : ℝ => 60 * ‖F t‖ ^ 2 +
        (lam * (dvWeight t * ‖F t‖ ^ 2) + lam⁻¹ * (dvWeight t * ‖FD t‖ ^ 2)))
        volume (1 / 4 : ℝ) 5 := by
      refine Continuous.intervalIntegrable ?_ _ _
      exact (continuous_const.mul (hFcont.norm.pow 2)).add
        ((continuous_const.mul (continuous_dvWeight.mul (hFcont.norm.pow 2))).add
          (continuous_const.mul (continuous_dvWeight.mul (hFDcont.norm.pow 2))))
    have hstep1 : (∫ t in (1 / 4 : ℝ)..r₀, G' t) ≤
        ∫ t in (1 / 4 : ℝ)..r₀, (60 * ‖F t‖ ^ 2 + (lam * (dvWeight t * ‖F t‖ ^ 2) +
          lam⁻¹ * (dvWeight t * ‖FD t‖ ^ 2))) := by
      refine intervalIntegral.integral_mono_on (by linarith) (hG'cont.intervalIntegrable _ _)
        (hRint.mono_set ?_) ?_
      · rw [Set.uIcc_of_le (by linarith : (1 / 4 : ℝ) ≤ r₀),
          Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)]
        exact Set.Icc_subset_Icc le_rfl (by linarith)
      · intro t ht
        refine hptwise t ?_
        rw [Set.uIcc_of_le (by norm_num : (1 / 4 : ℝ) ≤ 5)]
        exact ⟨ht.1, by linarith [ht.2]⟩
    refine hstep1.trans ?_
    refine intervalIntegral.integral_mono_interval le_rfl (by linarith) (by linarith) ?_ hRint
    refine Filter.Eventually.of_forall fun t => ?_
    have hw0 : 0 ≤ dvWeight t := dvWeight_nonneg t
    have hlam0 : (0:ℝ) < lam⁻¹ := inv_pos.mpr hlam
    positivity
  have hsplit : (∫ t in (1 / 4 : ℝ)..5, (60 * ‖F t‖ ^ 2 +
      (lam * (dvWeight t * ‖F t‖ ^ 2) + lam⁻¹ * (dvWeight t * ‖FD t‖ ^ 2)))) =
      60 * (∫ t in (1 / 4 : ℝ)..5, ‖F t‖ ^ 2) +
        lam * (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖F t‖ ^ 2) +
        lam⁻¹ * (∫ t in (1 / 4 : ℝ)..5, dvWeight t * ‖FD t‖ ^ 2) := by
    have hi1 : IntervalIntegrable (fun t : ℝ => ‖F t‖ ^ 2) volume (1 / 4 : ℝ) 5 :=
      (hFcont.norm.pow 2).intervalIntegrable _ _
    have hi2 : IntervalIntegrable (fun t : ℝ => dvWeight t * ‖F t‖ ^ 2) volume (1 / 4 : ℝ) 5 :=
      (continuous_dvWeight.mul (hFcont.norm.pow 2)).intervalIntegrable _ _
    have hi3 : IntervalIntegrable (fun t : ℝ => dvWeight t * ‖FD t‖ ^ 2) volume (1 / 4 : ℝ) 5 :=
      (continuous_dvWeight.mul (hFDcont.norm.pow 2)).intervalIntegrable _ _
    rw [intervalIntegral.integral_add (hi1.const_mul _) ((hi2.const_mul _).add (hi3.const_mul _)),
      intervalIntegral.integral_add (hi2.const_mul _) (hi3.const_mul _),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul]
    ring
  rw [hG0, sub_zero] at hFTC
  rw [← hsplit]
  exact le_trans hlow (le_trans (le_of_eq hFTC) hmono)
/-! ### Band support, the frequency localizer and the shell arithmetic -/

private theorem aux_pow_mono (j : ℕ) (n : ℕ) : (2 : ℝ) ^ j ≤ (2 : ℝ) ^ (j + n) := by
  apply pow_le_pow_right₀ (by norm_num)
  omega

theorem dvBand_eq_zero_of_abs_le {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1) (j : ℕ) {v : ℝ}
    (hv : |v| ≤ (2 : ℝ) ^ j) : dvBand phi j v = 0 := by
  have hgen : ∀ n : ℕ, |(((2 : ℝ) ^ (j + n))⁻¹) * v| ≤ 1 := by
    intro n
    have hc : (0 : ℝ) < (2 : ℝ) ^ (j + n) := by positivity
    have key : |v| ≤ (2 : ℝ) ^ (j + n) := le_trans hv (aux_pow_mono j n)
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (((2 : ℝ) ^ (j + n))⁻¹))]
    calc ((2 : ℝ) ^ (j + n))⁻¹ * |v| ≤ ((2 : ℝ) ^ (j + n))⁻¹ * (2 : ℝ) ^ (j + n) :=
          mul_le_mul_of_nonneg_left key (by positivity)
      _ = 1 := inv_mul_cancel₀ hc.ne'
  unfold dvBand
  have h1 := hgen 1
  have h2 := hgen 0
  simp only [Nat.add_zero] at h2
  rw [dvProfile_eq_one hone h1, dvProfile_eq_one hone h2, sub_self]

theorem dvBand_eq_zero_of_le_abs {phi : SchwartzMap (Euclidean 2) ℂ}
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) (j : ℕ) {v : ℝ}
    (hv : (2 : ℝ) ^ (j + 2) ≤ |v|) : dvBand phi j v = 0 := by
  have hgen : ∀ n : ℕ, n ≤ 1 → 2 ≤ |(((2 : ℝ) ^ (j + n))⁻¹) * v| := by
    intro n hn
    have hc : (0 : ℝ) < (2 : ℝ) ^ (j + n) := by positivity
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (((2 : ℝ) ^ (j + n))⁻¹))]
    have hstep : (2 : ℝ) = ((2 : ℝ) ^ (j + n))⁻¹ * (2 : ℝ) ^ (j + n + 1) := by
      rw [pow_succ]
      field_simp
    have hnn : (0 : ℝ) ≤ ((2 : ℝ) ^ (j + n))⁻¹ := by positivity
    have hpow : (2 : ℝ) ^ (j + n + 1) ≤ (2 : ℝ) ^ (j + 2) := by
      apply pow_le_pow_right₀ (by norm_num)
      omega
    calc (2 : ℝ) = ((2 : ℝ) ^ (j + n))⁻¹ * (2 : ℝ) ^ (j + n + 1) := hstep
      _ ≤ ((2 : ℝ) ^ (j + n))⁻¹ * |v| :=
          mul_le_mul_of_nonneg_left (le_trans hpow hv) hnn
  unfold dvBand
  have h1 := hgen 1 (by norm_num)
  have h2 := hgen 0 (by norm_num)
  simp only [Nat.add_zero] at h2
  rw [dvProfile_eq_zero hzero h1, dvProfile_eq_zero hzero h2, sub_self]

theorem dvSig_eq_zero_of_small {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1) (j : ℕ) {u r : ℝ}
    (hu : 0 ≤ u) (hr1 : 0 ≤ r) (hr2 : r ≤ 5) (hsmall : u * 5 < (2 : ℝ) ^ j) :
    dvSig phi j u r = 0 := by
  have habs : |u * r| ≤ (2 : ℝ) ^ j := by
    rw [abs_of_nonneg (by positivity)]
    calc u * r ≤ u * 5 := by nlinarith
      _ ≤ (2 : ℝ) ^ j := le_of_lt hsmall
  unfold dvSig
  rw [dvBand_eq_zero_of_abs_le hone j habs, mul_zero]

theorem dvSig_eq_zero_of_large {phi : SchwartzMap (Euclidean 2) ℂ}
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) (j : ℕ) {u r : ℝ}
    (hu : 0 ≤ u) (hr1 : 1 / 4 ≤ r) (hlarge : (2 : ℝ) ^ (j + 4) < u) :
    dvSig phi j u r = 0 := by
  have habs : (2 : ℝ) ^ (j + 2) ≤ |u * r| := by
    rw [abs_of_nonneg (by positivity)]
    have hpow : (2 : ℝ) ^ (j + 4) = (2 : ℝ) ^ (j + 2) * 4 := by ring
    have hp0 : (0 : ℝ) < (2 : ℝ) ^ (j + 2) := by positivity
    nlinarith
  unfold dvSig
  rw [dvBand_eq_zero_of_le_abs hzero j habs, mul_zero]

/-- The Schur row estimate with a multiplicative constant in front of the
kernel gap factor. -/
theorem dvRow_le_const {Cc : ℝ≥0∞}
    (hrow : ∀ (Th : Euclidean 2 → ℂ) (Q : Euclidean 2 → ℝ≥0∞) (P R T : ℝ)
      (ξ : Euclidean 2), 0 ≤ P → 0 ≤ R → 0 ≤ T → Measurable Th → Measurable Q →
      (∀ ζ, ‖Th ζ‖ ≤ P) → (∀ ζ : Euclidean 2, R ≤ ‖ζ‖ → Th ζ = 0) →
      (∀ η : Euclidean 2, Q η ≤ ENNReal.ofReal ((1 + |‖ξ‖ - ‖η‖|)⁻¹)) →
      (∀ η : Euclidean 2, T < ‖η‖ → Q η = 0) →
      (∫⁻ η : Euclidean 2, ENNReal.ofReal ‖Th (ξ - η)‖ * Q η) ≤
        Cc * ENNReal.ofReal (P * min R T * (2 * Real.log (1 + T))))
    (Th : Euclidean 2 → ℂ) (Q : Euclidean 2 → ℝ≥0∞) (P R T : ℝ) (kap : ℝ≥0∞)
    (ξ : Euclidean 2) (hP : 0 ≤ P) (hR : 0 ≤ R) (hT : 0 ≤ T)
    (hThmeas : Measurable Th) (hQmeas : Measurable Q)
    (hbd : ∀ ζ, ‖Th ζ‖ ≤ P) (hsupp : ∀ ζ : Euclidean 2, R ≤ ‖ζ‖ → Th ζ = 0)
    (hQ : ∀ η : Euclidean 2, ‖η‖ ≤ T →
      Q η ≤ kap * ENNReal.ofReal ((1 + |‖ξ‖ - ‖η‖|)⁻¹))
    (hQ0 : ∀ η : Euclidean 2, T < ‖η‖ → Q η = 0) :
    (∫⁻ η : Euclidean 2, ENNReal.ofReal ‖Th (ξ - η)‖ * Q η) ≤
      kap * (Cc * ENNReal.ofReal (P * min R T * (2 * Real.log (1 + T)))) := by
  classical
  set Q' : Euclidean 2 → ℝ≥0∞ := fun η =>
    Set.indicator {η : Euclidean 2 | ‖η‖ ≤ T}
      (fun η => ENNReal.ofReal ((1 + |‖ξ‖ - ‖η‖|)⁻¹)) η with hQ'def
  have hmeasSet : MeasurableSet {η : Euclidean 2 | ‖η‖ ≤ T} :=
    measurableSet_le continuous_norm.measurable measurable_const
  have hQ'meas : Measurable Q' := by
    simp only [hQ'def]
    refine Measurable.indicator ?_ hmeasSet
    have hm : Measurable fun η : Euclidean 2 => ((1 + |‖ξ‖ - ‖η‖|)⁻¹) := by fun_prop
    exact hm.ennreal_ofReal
  have hQle : ∀ η : Euclidean 2, Q η ≤ kap * Q' η := by
    intro η
    by_cases hη : ‖η‖ ≤ T
    · simp only [hQ'def]
      rw [Set.indicator_of_mem (show η ∈ {η : Euclidean 2 | ‖η‖ ≤ T} from hη)]
      exact hQ η hη
    · rw [hQ0 η (lt_of_not_ge hη)]
      exact bot_le
  have hQ'le : ∀ η : Euclidean 2, Q' η ≤ ENNReal.ofReal ((1 + |‖ξ‖ - ‖η‖|)⁻¹) := by
    intro η
    simp only [hQ'def]
    by_cases hη : ‖η‖ ≤ T
    · rw [Set.indicator_of_mem (show η ∈ {η : Euclidean 2 | ‖η‖ ≤ T} from hη)]
    · rw [Set.indicator_of_notMem (by simpa using lt_of_not_ge hη)]
      exact bot_le
  have hQ'0 : ∀ η : Euclidean 2, T < ‖η‖ → Q' η = 0 := by
    intro η hη
    simp only [hQ'def]
    rw [Set.indicator_of_notMem (by simpa using hη)]
  calc (∫⁻ η : Euclidean 2, ENNReal.ofReal ‖Th (ξ - η)‖ * Q η) ≤
      ∫⁻ η : Euclidean 2, ENNReal.ofReal ‖Th (ξ - η)‖ * (kap * Q' η) := by
        exact lintegral_mono fun η => mul_le_mul' le_rfl (hQle η)
    _ = kap * ∫⁻ η : Euclidean 2, ENNReal.ofReal ‖Th (ξ - η)‖ * Q' η := by
        have hm : Measurable fun η : Euclidean 2 =>
            ENNReal.ofReal ‖Th (ξ - η)‖ * Q' η := by
          refine Measurable.mul ?_ hQ'meas
          exact ((hThmeas.comp (measurable_const.sub measurable_id)).norm).ennreal_ofReal
        rw [← lintegral_const_mul kap hm]
        exact lintegral_congr fun η => by ring
    _ ≤ kap * (Cc * ENNReal.ofReal (P * min R T * (2 * Real.log (1 + T)))) :=
        mul_le_mul' le_rfl (hrow Th Q' P R T ξ hP hR hT hThmeas hQ'meas hbd hsupp hQ'le hQ'0)

theorem dvGeomSumLe (K : ℕ) : ∑ k ∈ Finset.range K, (2 : ℝ≥0∞) ^ k ≤ 2 ^ K := by
  induction K with
  | zero => simp
  | succ K ih =>
      rw [Finset.sum_range_succ]
      calc (∑ k ∈ Finset.range K, (2 : ℝ≥0∞) ^ k) + 2 ^ K ≤ 2 ^ K + 2 ^ K :=
            add_le_add ih le_rfl
        _ = 2 ^ (K + 1) := by ring

/-- The frequency localizer used to make the band multiplier compactly
supported. -/
def dvFreqCut (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) : SchwartzMap (Euclidean 2) ℂ :=
  Codex.Spherical.LittlewoodPaley.dyadicLowpassMultiplier phi (j + 6)

theorem dvFreqCut_apply (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (ξ : Euclidean 2) :
    dvFreqCut phi j ξ = phi ((((2 : ℝ) ^ (j + 6))⁻¹) • ξ) :=
  Codex.Spherical.LittlewoodPaley.dyadicLowpassMultiplier_apply phi (j + 6) ξ

theorem dvFreqCut_eq_one {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1) (j : ℕ) {ξ : Euclidean 2}
    (h : ‖ξ‖ ≤ (2 : ℝ) ^ (j + 6)) : dvFreqCut phi j ξ = 1 := by
  rw [dvFreqCut_apply]
  refine hone _ ?_
  rw [norm_smul, Real.norm_eq_abs,
    abs_of_pos (by positivity : (0 : ℝ) < (((2 : ℝ) ^ (j + 6))⁻¹))]
  rw [inv_mul_le_one₀ (by positivity)]
  exact h

theorem dvFreqCut_eq_zero {phi : SchwartzMap (Euclidean 2) ℂ}
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) (j : ℕ) {ξ : Euclidean 2}
    (h : (2 : ℝ) ^ (j + 7) ≤ ‖ξ‖) : dvFreqCut phi j ξ = 0 := by
  rw [dvFreqCut_apply]
  refine hzero _ ?_
  rw [norm_smul, Real.norm_eq_abs,
    abs_of_pos (by positivity : (0 : ℝ) < (((2 : ℝ) ^ (j + 6))⁻¹))]
  rw [le_inv_mul_iff₀ (by positivity)]
  calc (2 : ℝ) ^ (j + 6) * 2 = (2 : ℝ) ^ (j + 7) := by ring
    _ ≤ ‖ξ‖ := h

theorem norm_dvFreqCut_le {phi : SchwartzMap (Euclidean 2) ℂ}
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1) (j : ℕ) (ξ : Euclidean 2) :
    ‖dvFreqCut phi j ξ‖ ≤ 1 := by
  rw [dvFreqCut_apply]
  exact hnorm _

theorem hasCompactSupport_dvFreqCut {phi : SchwartzMap (Euclidean 2) ℂ}
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) (j : ℕ) :
    HasCompactSupport (dvFreqCut phi j : Euclidean 2 → ℂ) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) ((2 : ℝ) ^ (j + 7)))
  intro ξ hξ
  refine dvFreqCut_eq_zero hzero j ?_
  rw [Metric.mem_closedBall, dist_zero_right] at hξ
  exact le_of_not_ge hξ

theorem dvSig_mul_dvFreqCut {phi : SchwartzMap (Euclidean 2) ℂ}
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0) (j : ℕ) {t : ℝ}
    (ht : 1 / 4 ≤ t) (ξ : Euclidean 2) :
    dvSig phi j ‖ξ‖ t * dvFreqCut phi j ξ = dvSig phi j ‖ξ‖ t := by
  by_cases hz : dvSig phi j ‖ξ‖ t = 0
  · rw [hz, zero_mul]
  · have hle : ‖ξ‖ ≤ (2 : ℝ) ^ (j + 4) := by
      by_contra hcon
      exact hz (dvSig_eq_zero_of_large hzero j (norm_nonneg ξ) ht (lt_of_not_ge hcon))
    have hle' : ‖ξ‖ ≤ (2 : ℝ) ^ (j + 6) := by
      refine hle.trans ?_
      apply pow_le_pow_right₀ (by norm_num)
      omega
    rw [dvFreqCut_eq_one hone j hle', mul_one]
/-! ### The iterated form of the weighted bound and the dyadic shell weights -/

set_option maxHeartbeats 1000000 in
/-- The weighted `L²` bound in the iterated `ℝ≥0∞` form actually consumed by
the shell assembly. -/
theorem dvWeightedSquare_lintegral_le
    {Gb : Euclidean 2 → ℝ} (hGnn : ∀ x, 0 ≤ Gb x) (hGc : Continuous Gb)
    (hG : Integrable Gb volume)
    {a b : ℝ} (hab : a ≤ b)
    {m : ℝ → Euclidean 2 → ℂ} (hmc : Continuous fun p : ℝ × Euclidean 2 => m p.1 p.2)
    {S : Set (Euclidean 2)} (hSmeas : MeasurableSet S) (hSfin : volume S ≠ ⊤)
    {Cm : ℝ} (hmbd : ∀ (t : ℝ) (ξ : Euclidean 2), ‖m t ξ‖ ≤ Cm)
    (hmsupp : ∀ (t : ℝ) (ξ : Euclidean 2), ξ ∉ S → m t ξ = 0)
    {F : Euclidean 2 → ℂ} (hFc : Continuous F) {CF : ℝ} (hFbd : ∀ ξ, ‖F ξ‖ ≤ CF)
    (hjoint : Continuous fun p : ℝ × Euclidean 2 =>
      𝓕⁻ (fun ξ => m p.1 ξ * F ξ) p.2)
    {Arow : ℝ≥0∞}
    (hrow : ∀ ξ : Euclidean 2, (∫⁻ η : Euclidean 2,
        ENNReal.ofReal ‖𝓕⁻ (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ)) (η - ξ)‖ *
          ENNReal.ofReal ‖∫ t in a..b, m t η * (starRingEnd ℂ) (m t ξ)‖) ≤ Arow) :
    (∫⁻ x : Euclidean 2, ENNReal.ofReal
        (Gb x * ∫ t in a..b, ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2)) ≤
      Arow * ∫⁻ ξ : Euclidean 2, (ENNReal.ofReal ‖F ξ‖) ^ 2 := by
  have hCm0 : 0 ≤ Cm := le_trans (norm_nonneg _) (hmbd a 0)
  have hCF0 : 0 ≤ CF := le_trans (norm_nonneg _) (hFbd 0)
  -- a uniform bound for the localized inverse transforms
  have hSfin' : volume S < ⊤ := lt_of_le_of_ne le_top hSfin
  set K : ℝ := Cm * CF * (volume S).toReal with hKdef
  have hK0 : 0 ≤ K := by
    simp only [hKdef]
    have : (0 : ℝ) ≤ (volume S).toReal := ENNReal.toReal_nonneg
    positivity
  have hunif : ∀ (t : ℝ) (x : Euclidean 2), ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ≤ K := by
    intro t x
    refine (dvNorm_fourierInv_le x).trans ?_
    have hpt : ∀ ξ : Euclidean 2, ‖m t ξ * F ξ‖ ≤
        (Cm * CF) * S.indicator (fun _ => (1 : ℝ)) ξ := by
      intro ξ
      by_cases hξ : ξ ∈ S
      · rw [Set.indicator_of_mem hξ, mul_one, norm_mul]
        exact mul_le_mul (hmbd t ξ) (hFbd ξ) (norm_nonneg _) hCm0
      · rw [hmsupp t ξ hξ, zero_mul, norm_zero, Set.indicator_of_notMem hξ]
        simp
    have hind : Integrable (fun ξ : Euclidean 2 =>
        (Cm * CF) * S.indicator (fun _ => (1 : ℝ)) ξ) volume := by
      refine Integrable.const_mul ?_ _
      rw [integrable_indicator_iff hSmeas]
      exact integrableOn_const (by simpa using hSfin'.ne)
    calc (∫ ξ : Euclidean 2, ‖m t ξ * F ξ‖) ≤
        ∫ ξ : Euclidean 2, (Cm * CF) * S.indicator (fun _ => (1 : ℝ)) ξ := by
          refine integral_mono ?_ hind hpt
          refine Integrable.mono' hind ?_
            (Filter.Eventually.of_forall fun ξ => by simpa using hpt ξ)
          exact ((hmc.comp (Continuous.prodMk continuous_const continuous_id)).mul
            hFc).norm.aestronglyMeasurable
      _ = K := by
          rw [integral_const_mul, integral_indicator hSmeas, setIntegral_const]
          simp only [hKdef, smul_eq_mul, mul_one, Measure.real]
  -- integrability of the space-time integrand
  have hHcont : Continuous fun p : ℝ × Euclidean 2 =>
      Gb p.2 * ‖𝓕⁻ (fun ξ => m p.1 ξ * F ξ) p.2‖ ^ 2 :=
    (hGc.comp continuous_snd).mul (hjoint.norm.pow 2)
  have hμfin : IsFiniteMeasure (volume.restrict (Ioc a b)) := by
    constructor
    rw [Measure.restrict_apply_univ]
    exact measure_Ioc_lt_top
  have hHint : Integrable (Function.uncurry fun (t : ℝ) (x : Euclidean 2) =>
      Gb x * ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2)
      ((volume.restrict (Ioc a b)).prod volume) := by
    have hmaj : Integrable (fun p : ℝ × Euclidean 2 => (1 : ℝ) * (K ^ 2 * Gb p.2))
        ((volume.restrict (Ioc a b)).prod volume) :=
      Integrable.mul_prod (integrable_const (1 : ℝ)) (hG.const_mul (K ^ 2))
    refine Integrable.mono' hmaj hHcont.aestronglyMeasurable
      (Filter.Eventually.of_forall fun p => ?_)
    show ‖Gb p.2 * ‖𝓕⁻ (fun ξ => m p.1 ξ * F ξ) p.2‖ ^ 2‖ ≤ 1 * (K ^ 2 * Gb p.2)
    rw [one_mul, Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (hGnn p.2)
        (by positivity : (0:ℝ) ≤ ‖𝓕⁻ (fun ξ => m p.1 ξ * F ξ) p.2‖ ^ 2))]
    have hsq : ‖𝓕⁻ (fun ξ => m p.1 ξ * F ξ) p.2‖ ^ 2 ≤ K ^ 2 := by
      have := hunif p.1 p.2
      nlinarith [norm_nonneg (𝓕⁻ (fun ξ => m p.1 ξ * F ξ) p.2)]
    calc Gb p.2 * ‖𝓕⁻ (fun ξ => m p.1 ξ * F ξ) p.2‖ ^ 2 ≤ Gb p.2 * K ^ 2 :=
          mul_le_mul_of_nonneg_left hsq (hGnn p.2)
      _ = K ^ 2 * Gb p.2 := by ring
  -- the space integrand is integrable
  have hxint : Integrable (fun x : Euclidean 2 =>
      Gb x * ∫ t in a..b, ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2) volume := by
    have hswap := hHint.integral_prod_right
    have heq : (fun x : Euclidean 2 => ∫ t : ℝ, Gb x *
        ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2 ∂(volume.restrict (Ioc a b))) =
        fun x : Euclidean 2 => Gb x * ∫ t in a..b,
          ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2 := by
      funext x
      rw [intervalIntegral.integral_of_le hab, ← integral_const_mul]
    rw [← heq]
    exact hswap
  have hnn : 0 ≤ᵐ[volume] fun x : Euclidean 2 =>
      Gb x * ∫ t in a..b, ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2 := by
    refine Filter.Eventually.of_forall fun x => ?_
    have hpos : 0 ≤ ∫ t in a..b, ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2 := by
      rw [intervalIntegral.integral_of_le hab]
      exact integral_nonneg fun t => sq_nonneg _
    exact mul_nonneg (hGnn x) hpos
  rw [← ofReal_integral_eq_lintegral_ofReal hxint hnn]
  have hfub : (∫ x : Euclidean 2, Gb x * ∫ t in a..b,
      ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2) =
      ∫ t in a..b, ∫ x : Euclidean 2, Gb x * ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2 := by
    have hstep : (∫ x : Euclidean 2, Gb x * ∫ t in a..b,
        ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2) =
        ∫ x : Euclidean 2, ∫ t : ℝ, Gb x * ‖𝓕⁻ (fun ξ => m t ξ * F ξ) x‖ ^ 2
          ∂(volume.restrict (Ioc a b)) := by
      refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
      simp only []
      rw [intervalIntegral.integral_of_le hab, ← integral_const_mul]
    rw [hstep, ← integral_integral_swap hHint, intervalIntegral.integral_of_le hab]
  rw [hfub]
  exact dvWeightedSquare_le hGc hG hab hmc hSmeas hSfin hmbd hmsupp hFc hFbd hrow

/-- The dyadic rescaling of the spatial weight profile. -/
def dvGk (Gb : Euclidean 2 → ℝ) (k : ℕ) : Euclidean 2 → ℝ :=
  fun x => (2 : ℝ) ^ k * Gb (((2 : ℝ) ^ k) • x)

theorem dvGk_nonneg {Gb : Euclidean 2 → ℝ} (hGnn : ∀ x, 0 ≤ Gb x) (k : ℕ)
    (x : Euclidean 2) : 0 ≤ dvGk Gb k x := by
  unfold dvGk
  have := hGnn (((2 : ℝ) ^ k) • x)
  positivity

theorem continuous_dvGk {Gb : Euclidean 2 → ℝ} (hGc : Continuous Gb) (k : ℕ) :
    Continuous (dvGk Gb k) := by
  unfold dvGk
  exact continuous_const.mul (hGc.comp (continuous_const_smul _))

theorem integrable_dvGk {Gb : Euclidean 2 → ℝ} (hG : Integrable Gb volume) (k : ℕ) :
    Integrable (dvGk Gb k) volume := by
  unfold dvGk
  refine Integrable.const_mul ?_ _
  have hpos : (0 : ℝ) < (2 : ℝ) ^ k := by positivity
  exact hG.comp_smul (μ := (volume : Measure (Euclidean 2))) (R := ((2 : ℝ) ^ k))
    (by positivity)

theorem fourierInv_dvGk {Gb : Euclidean 2 → ℝ} {Th : Euclidean 2 → ℂ}
    (hTh : 𝓕⁻ (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ)) = Th) (k : ℕ) (ζ : Euclidean 2) :
    𝓕⁻ (fun x : Euclidean 2 => ((dvGk Gb k x : ℝ) : ℂ)) ζ =
      (((2 : ℝ) ^ k)⁻¹ : ℝ) • Th ((((2 : ℝ) ^ k)⁻¹) • ζ) := by
  have hpos : (0 : ℝ) < (((2 : ℝ) ^ k)⁻¹ : ℝ) := by positivity
  have hstep : 𝓕⁻ (fun x : Euclidean 2 =>
      ((Gb (((2 : ℝ) ^ k) • x) : ℝ) : ℂ)) ζ =
      ((((2 : ℝ) ^ k)⁻¹) ^ Module.finrank ℝ (Euclidean 2)) •
        (𝓕⁻ (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ))) ((((2 : ℝ) ^ k)⁻¹) • ζ) := by
    have := Codex.Spherical.FourierRadius.fourierInv_comp_inv_smul
      (fun x : Euclidean 2 => ((Gb x : ℝ) : ℂ))
      (R := (((2 : ℝ) ^ k)⁻¹)) hpos ζ
    simpa using this
  have hrank : Module.finrank ℝ (Euclidean 2) = 2 := by
    simp [Euclidean]
  have hfun : (fun x : Euclidean 2 => ((dvGk Gb k x : ℝ) : ℂ)) =
      fun x : Euclidean 2 => (((2 : ℝ) ^ k : ℝ) : ℂ) *
        ((Gb (((2 : ℝ) ^ k) • x) : ℝ) : ℂ) := by
    funext x
    simp only [dvGk]
    push_cast
    ring
  rw [hfun]
  have hlin : 𝓕⁻ (fun x : Euclidean 2 => (((2 : ℝ) ^ k : ℝ) : ℂ) *
      ((Gb (((2 : ℝ) ^ k) • x) : ℝ) : ℂ)) ζ =
      (((2 : ℝ) ^ k : ℝ) : ℂ) * 𝓕⁻ (fun x : Euclidean 2 =>
        ((Gb (((2 : ℝ) ^ k) • x) : ℝ) : ℂ)) ζ := by
    rw [Real.fourierInv_eq, Real.fourierInv_eq, ← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    simp only [Circle.smul_def, smul_eq_mul]
    ring
  rw [hlin, hstep, hrank, hTh]
  rw [Complex.real_smul, Complex.real_smul]
  push_cast
  field_simp
/-! ### The three space-time multipliers and their radial kernels -/

/-- The three space-time multipliers of the Sobolev decomposition. -/
def dvMulA (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (t : ℝ) (ξ : Euclidean 2) : ℂ :=
  ((dvTcut t : ℝ) : ℂ) * dvSig phi j ‖ξ‖ t * dvFreqCut phi j ξ

def dvMulB (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (t : ℝ) (ξ : Euclidean 2) : ℂ :=
  ((dvSqrtW t : ℝ) : ℂ) * dvSig phi j ‖ξ‖ t * dvFreqCut phi j ξ

def dvMulC (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) (t : ℝ) (ξ : Euclidean 2) : ℂ :=
  ((dvSqrtW t : ℝ) : ℂ) * dvSigDnum phi j ‖ξ‖ t * dvFreqCut phi j ξ

set_option maxHeartbeats 1000000 in
theorem continuous_dvMulA (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) :
    Continuous fun p : ℝ × Euclidean 2 => dvMulA phi j p.1 p.2 := by
  have h1 : Continuous fun p : ℝ × Euclidean 2 => ((dvTcut p.1 : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp (continuous_dvTcut.comp continuous_fst)
  have h2 : Continuous fun p : ℝ × Euclidean 2 => dvSig phi j ‖p.2‖ p.1 := by
    have hmap : Continuous fun p : ℝ × Euclidean 2 => ((‖p.2‖ : ℝ), p.1) :=
      Continuous.prodMk (continuous_norm.comp continuous_snd) continuous_fst
    have h := (continuous_uncurry_dvSig phi j).comp hmap
    simpa [Function.comp_def] using h
  have h3 : Continuous fun p : ℝ × Euclidean 2 => (dvFreqCut phi j) p.2 := by
    have heq : (fun p : ℝ × Euclidean 2 => (dvFreqCut phi j) p.2) =
        fun p : ℝ × Euclidean 2 => phi ((((2 : ℝ) ^ (j + 6))⁻¹) • p.2) := by
      funext p
      exact dvFreqCut_apply phi j p.2
    rw [heq]
    exact phi.continuous.comp ((continuous_const_smul _).comp continuous_snd)
  have hgoal : (fun p : ℝ × Euclidean 2 => dvMulA phi j p.1 p.2) =
      fun p : ℝ × Euclidean 2 =>
        ((dvTcut p.1 : ℝ) : ℂ) * dvSig phi j ‖p.2‖ p.1 * dvFreqCut phi j p.2 := rfl
  rw [hgoal]
  exact (h1.mul h2).mul h3

