/-- **The critical-weight band bound (Phase E).** -/
theorem dvCriticalWeightBandBound (phi : SchwartzMap (Euclidean 2) ℂ)
    (hone : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hzero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hnorm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1)
    (hrad : IsNormRadial (phi : Euclidean 2 → ℂ)) {p : ℝ} (hp : 2 < p) :
    HasCriticalWeightBandBound phi p := by
  obtain ⟨C, hC, hcore⟩ := dvWeightedL2Core hone hzero hnorm hrad
  have hsm : (0 : ℝ) < surfaceMass 2 := surfaceMass_pos (by norm_num)
  have hp0 : (0 : ℝ) < p := by linarith
  set A₁ : ℝ := surfaceMass 2 * dvPsiL1 phi + 1 with hA₁def
  have hA₁0 : 0 < A₁ := by
    have h := mul_nonneg hsm.le (dvPsiL1_nonneg phi)
    rw [hA₁def]; linarith
  have hA₁' : surfaceMass 2 * dvPsiL1 phi ≤ A₁ := by rw [hA₁def]; linarith
  set Am : ℝ := surfaceMass 2 * ((4 : ℝ) * dvPsiL2 phi) *
    Real.sqrt (surfaceMass 2 * (1 / 16)) + 1 with hAmdef
  have hAmpos : 0 < Am := by
    have h : 0 ≤ surfaceMass 2 * ((4 : ℝ) * dvPsiL2 phi) *
        Real.sqrt (surfaceMass 2 * (1 / 16)) :=
      mul_nonneg (mul_nonneg hsm.le (by
        have := dvPsiL2_nonneg phi; linarith)) (Real.sqrt_nonneg _)
    rw [hAmdef]; linarith
  have hA1pow : 0 < A₁ ^ (p - 2) := Real.rpow_pos_of_pos hA₁0 _
  set Cf : ℝ := (C + Am ^ 2) * A₁ ^ (p - 2) + 1 with hCfdef
  have hCf0 : 0 < Cf := by
    have h : 0 < (C + Am ^ 2) * A₁ ^ (p - 2) := by
      refine mul_pos ?_ hA1pow
      nlinarith
    rw [hCfdef]; linarith
  refine ⟨Cf, 2, hCf0, ?_⟩
  intro j E hE f _
  have hjone : (1 : ℝ) ≤ ((j : ℝ) + 1) ^ 2 := by
    have h : (1 : ℝ) ≤ (j : ℝ) + 1 := by
      have : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
      linarith
    nlinarith
  by_cases hj : 3 ≤ j
  · set A₀ : ℝ := Real.sqrt (C * ((j : ℝ) + 1) ^ 2) with hA₀def
    have hA₀0 : 0 < A₀ := Real.sqrt_pos.mpr (by positivity)
    have hA₀sq : A₀ ^ 2 = C * ((j : ℝ) + 1) ^ 2 := Real.sq_sqrt (by positivity)
    refine dvMaximal_set_lp hone hzero hnorm hrad j hE hp0 f _ ?_
    intro n
    refine le_trans (dvMaximal_finset_lp phi j (dvR n) (dvR_subset n) (dvR_nonempty n)
      hp hA₀0 hA₁0 hA₁' ?_ f) ?_
    · intro g
      rw [hA₀sq]
      exact hcore j hj ((dvR n : Finset ℝ) : Set ℝ)
        (fun r hr => dvR_subset n r (by simpa using hr)) g
    · refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      rw [hA₀sq, hCfdef]
      have h1 : C * A₁ ^ (p - 2) ≤ (C + Am ^ 2) * A₁ ^ (p - 2) + 1 := by
        nlinarith [sq_nonneg Am, hA1pow.le]
      calc C * ((j : ℝ) + 1) ^ 2 * A₁ ^ (p - 2)
          = (C * A₁ ^ (p - 2)) * ((j : ℝ) + 1) ^ 2 := by ring
        _ ≤ ((C + Am ^ 2) * A₁ ^ (p - 2) + 1) * ((j : ℝ) + 1) ^ 2 := by
            refine mul_le_mul_of_nonneg_right h1 (by positivity)
  · refine dvMaximal_set_lp hone hzero hnorm hrad j hE hp0 f _ ?_
    intro n
    refine le_trans (dvMaximal_finset_lp phi j (dvR n) (dvR_subset n) (dvR_nonempty n)
      hp hAmpos hA₁0 hA₁' ?_ f) ?_
    · intro g
      refine dvCrudeL2Core phi j (fun r hr => dvR_subset n r (by simpa using hr)) g
        hAmpos.le ?_
      have hjle : ((2 : ℝ) ^ j) ≤ 4 := by
        have hjn : j ≤ 2 := by omega
        calc (2 : ℝ) ^ j ≤ (2 : ℝ) ^ 2 := by
              exact pow_le_pow_right₀ (by norm_num) hjn
          _ = 4 := by norm_num
      have hstep : surfaceMass 2 * ((2 : ℝ) ^ j * dvPsiL2 phi) *
          Real.sqrt (surfaceMass 2 * (1 / 16)) ≤
          surfaceMass 2 * ((4 : ℝ) * dvPsiL2 phi) *
            Real.sqrt (surfaceMass 2 * (1 / 16)) := by
        refine mul_le_mul_of_nonneg_right ?_ (Real.sqrt_nonneg _)
        refine mul_le_mul_of_nonneg_left ?_ hsm.le
        exact mul_le_mul_of_nonneg_right hjle (dvPsiL2_nonneg phi)
      rw [hAmdef]
      linarith
    · refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      rw [hCfdef]
      have h1 : Am ^ 2 * A₁ ^ (p - 2) ≤ (C + Am ^ 2) * A₁ ^ (p - 2) + 1 := by
        nlinarith [hA1pow.le, hC.le]
      calc Am ^ 2 * A₁ ^ (p - 2) ≤ (C + Am ^ 2) * A₁ ^ (p - 2) + 1 := h1
        _ = ((C + Am ^ 2) * A₁ ^ (p - 2) + 1) * 1 := by ring
        _ ≤ ((C + Am ^ 2) * A₁ ^ (p - 2) + 1) * ((j : ℝ) + 1) ^ 2 := by
            refine mul_le_mul_of_nonneg_left hjone ?_
            nlinarith [hA1pow.le, sq_nonneg Am, hC.le]
/-- **Placeholder for the analytic core of Duoandikoetxea--Vega Theorem 10 in
the planar negative range.**

This is the one declaration of the project which is not yet proved.  Its
content is exactly `prop:critical-loss` of
`blueprints/duoandikoetxea_vega_planar_blueprint.tex` after the Phase E
interpolation: the localized `L^p(|x|^{-1})` estimate for the
frequency-localized local circular maximal operator, with a polynomial loss in
the frequency index.

Everything else in the project is proved.  In particular the blueprint's Phase
F (interpolation in the weight) is `hasPlanarNegativeRawBandRate_of_criticalWeight`
and needs no interpolation theorem, and the blueprint's Phase C input is
`exists_relativeCircularBandGeometricDecay`.

The proof route, which is a sharpening of the blueprint's sketch, is:

* pass from the maximal function to the space-time square function by the
  one-dimensional Sobolev estimate on an `r`-interval of length `2^{-j}`
  (blueprint item "Maximal parameter"), so that the two space-time integrals
  enter with the weights `2^{j}` and `2^{-j}`;
* expand `∫ w(r) m_j(r,ξ) conj (m_j(r,η)) dr` using the exact planar
  outgoing/incoming/middle normal form
  `FractalDilations.PlanarTripleWaveNormalForm.planarCoordinateSurfaceWaveSum_eq_three_radialTerms`
  and one integration by parts in `r`, giving the kernel bound
  `C (s⁻¹ + t⁻¹) / (1 + |s - t|)` on the band;
* estimate the resulting quadratic form by Schur's test, localizing the output
  by a Gaussian or a compactly-supported-Fourier bump at each dyadic distance
  `2^{-k}` from the origin (blueprint item "Spatial annuli");
* sum the shells (blueprint item "Annular summation"), the logarithmic factor
  arising exactly as in the source. -/
theorem hasCriticalWeightBandBound (phi : SchwartzMap (Euclidean 2) ℂ)
    (hphi_one : ∀ ξ : Euclidean 2, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ : Euclidean 2, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ : Euclidean 2, ‖phi ξ‖ ≤ 1)
    (hphi_rad : IsNormRadial (phi : Euclidean 2 → ℂ))
    {p : ℝ} (hp : 2 < p) :
    HasCriticalWeightBandBound phi p :=
  dvCriticalWeightBandBound phi hphi_one hphi_zero hphi_norm hphi_rad hp

/-! ## The Duoandikoetxea--Vega estimate on the Schwartz core -/

/-- The planar negative-power circular maximal estimate on the Schwartz core,
for an arbitrary radius set.  Blueprint `thm:direct-missing`, in the internal
normalized formulation used by the Fraccaroli--Roos--Seeger development. -/
theorem hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_planar_negative_of_gt_two
    (E : Set ℝ) {p α : ℝ} (hp : 2 < p) (hlo : -1 < α) (hhi : α < 0) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType 2 E p α := by
  obtain ⟨cut, hcut1, hcut0, hcutn, hcutr⟩ :=
    exists_normRadial_schwartz_frequency_cutoff_norm_le_one 2
  let Ccut : Codex.Spherical.LittlewoodPaley.lpCutoffs 2 := ⟨cut, hcut1, hcut0, hcutn⟩
  have hcompact : HasCompactSupport (Ccut.cutoff : Euclidean 2 → ℂ) := by
    apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclidean 2) (2 : ℝ))
    intro xi hxi
    apply Ccut.cutoff_zero xi
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  have hband :=
    Codex.Spherical.Bourgain.hasRelativeCircularBandGeometricDecay_of_positiveLocalSmoothingGain
      Ccut
      (Codex.Spherical.MSS.p4LocalSmoothing_to_hasPositiveLocalSmoothingGain
        (Codex.Spherical.MSS.p4LocalSmoothing_of_lpCutoffs Ccut) (ρ := (1 / 16 : ℝ))
        (by norm_num) (by norm_num)) hp
  have hcrit := hasCriticalWeightBandBound Ccut.cutoff Ccut.cutoff_one
    Ccut.cutoff_zero Ccut.norm_le_one hcutr hp
  obtain ⟨ε, K, hε, hKtop, hrate⟩ :=
    hasPlanarNegativeRawBandRate_of_criticalWeight E hp hlo hhi Ccut.cutoff
      Ccut.cutoff_one Ccut.cutoff_zero hcrit hband
  have hαLower : 1 - ((2 : ℕ) : ℝ) < α := by
    have h : (1 : ℝ) - ((2 : ℕ) : ℝ) = -1 := by norm_num
    rw [h]
    exact hlo
  exact
    hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_of_uniform_buffered_raw_band_rate_and_unweighted
      (d := 2) (by norm_num) E (lt_trans one_lt_two hp) hαLower hhi hε
      Ccut.cutoff hcompact Ccut.cutoff_one Ccut.cutoff_zero K hKtop hrate
      (hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_zero_planar_of_bourgain E hp)

/-! ## Phase H: extension from the Schwartz core to all of `L^p` -/

/-- The Schwartz-core weighted estimate extends to every `MemLp` input, in the
project's public `M`/`powerWeight` language.  This is the repository's density
and maximal-principle extension, specialized to a power weight which is
locally integrable. -/
theorem exists_powerWeight_bound_of_strongType {d : ℕ} {E : Set ℝ} {p α : ℝ}
    (hd : 1 ≤ d) (hp : 1 ≤ p) (hα : -(d : ℝ) < α)
    (hcore : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : (ℝ^d) → ℂ,
      MemLp f (ENNReal.ofReal p) (powerWeight d α) →
        MemLp (M E f) (ENNReal.ofReal p) (powerWeight d α) ∧
          eLpNorm (M E f) (ENNReal.ofReal p) (powerWeight d α) ≤
            ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) (powerWeight d α) := by
  rcases hcore with ⟨C, hC, hcore⟩
  have hmeasure : powerWeight d α = powerWeightedVolume d α := rfl
  letI : (powerWeightedVolume d α).HasTemperateGrowth :=
    powerWeightedVolume_hasTemperateGrowth hd hα
  letI : IsFiniteMeasureOnCompacts (powerWeightedVolume d α) :=
    powerWeightedVolume_isFiniteMeasureOnCompacts hd hα
  letI : (powerWeightedVolume d α).WeaklyRegular := inferInstance
  letI : SigmaFinite (powerWeightedVolume d α) := inferInstance
  refine ⟨C, hC, ?_⟩
  intro f hf
  have hp0real : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hp0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0real
  have hp' : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal hp
  have hrawcore (φ : SchwartzMap (ℝ^d) ℂ) :
      eLpNorm (M E (φ : (ℝ^d) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume d α) ≤
        ENNReal.ofReal C * eLpNorm (φ : (ℝ^d) → ℂ) (ENNReal.ofReal p)
          (powerWeightedVolume d α) := by
    have hφ := hcore φ (φ.memLp (ENNReal.ofReal p) (powerWeightedVolume d α))
    rw [← restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal] at hφ
    exact hφ.2
  rw [hmeasure] at hf ⊢
  exact memLp_restrictedSphericalMaximal_of_memLp_of_schwartz_bound
    hp' hp0 ENNReal.ofReal_ne_top hrawcore hf

/-! ## The public planar theorems -/

/-- **The planar negative-power circular maximal theorem** (blueprint
`thm:direct-missing`, the negative-weight planar case of Theorem 10 of
Duoandikoetxea and Vega).

For `2 < p` and `-1 < α < 0` the full circular maximal operator is bounded on
`L^p(ℝ², |x|^α dx)`. -/
theorem eLpNorm_circularMaximal_powerWeight_le_of_neg {p : ENNReal} {α : ℝ}
    (hp_top : p ≠ ∞) (hp : (2 : ENNReal) < p) (hlo : -1 < α) (hhi : α < 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : (ℝ^2) → ℂ,
      MemLp f p (powerWeight 2 α) →
        MemLp (M (Ioi (0 : ℝ)) f) p (powerWeight 2 α) ∧
          eLpNorm (M (Ioi (0 : ℝ)) f) p (powerWeight 2 α) ≤
            ENNReal.ofReal C * eLpNorm f p (powerWeight 2 α) := by
  have hpreal : (2 : ℝ) < p.toReal := by
    have h2 : (2 : ENNReal) = ENNReal.ofReal 2 := by
      simp [ENNReal.ofReal_ofNat]
    rw [h2] at hp
    have := (ENNReal.ofReal_lt_iff_lt_toReal (by norm_num) hp_top).mp hp
    exact this
  have hpeq : ENNReal.ofReal p.toReal = p := ENNReal.ofReal_toReal hp_top
  have hα2 : -((2 : ℕ) : ℝ) < α := by
    have : -((2 : ℕ) : ℝ) = -2 := by norm_num
    rw [this]
    linarith
  obtain ⟨C, hC, hbound⟩ :=
    exists_powerWeight_bound_of_strongType (d := 2) (E := Ioi (0 : ℝ))
      (by norm_num) (le_of_lt (lt_trans one_lt_two hpreal)) hα2
      (hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_planar_negative_of_gt_two
        (Ioi (0 : ℝ)) hpreal hlo hhi)
  refine ⟨C, hC, ?_⟩
  intro f hf
  rw [← hpeq] at hf ⊢
  exact hbound f hf

/-- **The restricted-radii planar negative-power circular maximal theorem.**

Blueprint Appendix B: the transfer to an arbitrary set of positive radii is
pointwise monotonicity of the supremum and uses no property of `E`. -/
theorem eLpNorm_restrictedCircularMaximal_powerWeight_le_of_neg {p : ENNReal}
    {α : ℝ} (hp_top : p ≠ ∞) (hp : (2 : ENNReal) < p) (hlo : -1 < α)
    (hhi : α < 0) (E : Set ℝ) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : (ℝ^2) → ℂ,
      MemLp f p (powerWeight 2 α) →
        MemLp (M E f) p (powerWeight 2 α) ∧
          eLpNorm (M E f) p (powerWeight 2 α) ≤
            ENNReal.ofReal C * eLpNorm f p (powerWeight 2 α) := by
  have hpreal : (2 : ℝ) < p.toReal := by
    have h2 : (2 : ENNReal) = ENNReal.ofReal 2 := by
      simp [ENNReal.ofReal_ofNat]
    rw [h2] at hp
    exact (ENNReal.ofReal_lt_iff_lt_toReal (by norm_num) hp_top).mp hp
  have hpeq : ENNReal.ofReal p.toReal = p := ENNReal.ofReal_toReal hp_top
  have hα2 : -((2 : ℕ) : ℝ) < α := by
    have h : -((2 : ℕ) : ℝ) = -2 := by norm_num
    rw [h]
    linarith
  obtain ⟨C, hC, hbound⟩ :=
    exists_powerWeight_bound_of_strongType (d := 2) (E := E)
      (by norm_num) (le_of_lt (lt_trans one_lt_two hpreal)) hα2
      (hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_planar_negative_of_gt_two
        E hpreal hlo hhi)
  refine ⟨C, hC, ?_⟩
  intro f hf
  rw [← hpeq] at hf ⊢
  exact hbound f hf

/-- **The local planar negative-power circular maximal theorem** (blueprint
`thm:minimal-local`), the unit-scale form which the Fraccaroli--Roos--Seeger
globalization lemma consumes. -/
theorem eLpNorm_localCircularMaximal_powerWeight_le_of_neg {p : ENNReal}
    {α : ℝ} (hp_top : p ≠ ∞) (hp : (2 : ENNReal) < p) (hlo : -1 < α)
    (hhi : α < 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : (ℝ^2) → ℂ,
      MemLp f p (powerWeight 2 α) →
        MemLp (localCircularMaximal f) p (powerWeight 2 α) ∧
          eLpNorm (localCircularMaximal f) p (powerWeight 2 α) ≤
            ENNReal.ofReal C * eLpNorm f p (powerWeight 2 α) :=
  eLpNorm_restrictedCircularMaximal_powerWeight_le_of_neg hp_top hp hlo hhi
    (Icc (1 : ℝ) 2)

/-! ## The unweighted planar input

In dimension two the unweighted restricted estimate above the critical
exponent is the Seeger--Wainger--Wright theorem, which the repository already
proves for every dimension at least two.  This replaces the `d ≥ 3` Stein
input used by the higher-dimensional assembly. -/

/-- The planar unweighted restricted strong type, from the
Seeger--Wainger--Wright theorem.  The hypothesis is the strict critical
inequality in the internal `EReal` entropy formulation. -/
theorem hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_zero_planar_of_sww
    (E : Set ℝ) (hE : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ)) {q : ℝ} (hq : 1 < q)
    (hcritical : multiplicativeMinkowskiExponent E <
      (((((2 : ℕ) : ℝ) - 1) * (q - 1) : ℝ) : EReal)) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType 2 E q 0 := by
  have hbot : multiplicativeMinkowskiExponent E ≠ ⊥ :=
    multiplicativeMinkowskiExponent_ne_bot hE hEpos
  have htop : multiplicativeMinkowskiExponent E ≠ ⊤ :=
    multiplicativeMinkowskiExponent_ne_top hE hEpos
  have hcoe : ((multiplicativeMinkowskiExponent E).toReal : EReal) =
      multiplicativeMinkowskiExponent E := EReal.coe_toReal htop hbot
  have hbeta : (multiplicativeMinkowskiExponent E).toReal <
      (((2 : ℕ) : ℝ) - 1) * (q - 1) := by
    rw [← EReal.coe_lt_coe_iff, hcoe]
    exact hcritical
  have hbetaeq : _root_.Spherical.upperMinkowskiExponent E =
      (multiplicativeMinkowskiExponent E).toReal :=
    upperMinkowskiExponent_eq_multiplicativeMinkowskiExponent_toReal E
  have hval : _root_.Spherical.RestrictedDilations.criticalExponent 2 E =
      1 + (multiplicativeMinkowskiExponent E).toReal := by
    unfold _root_.Spherical.RestrictedDilations.criticalExponent
    rw [show _root_.Spherical.β E = (multiplicativeMinkowskiExponent E).toReal from hbetaeq]
    norm_num
  have hcrit : _root_.Spherical.RestrictedDilations.criticalExponent 2 E < q := by
    rw [hval]
    have hden : ((2 : ℕ) : ℝ) - 1 = 1 := by norm_num
    rw [hden, one_mul] at hbeta
    linarith
  have hcritE : ENNReal.ofReal
      (_root_.Spherical.RestrictedDilations.criticalExponent 2 E) <
      ENNReal.ofReal q :=
    ENNReal.ofReal_lt_ofReal_iff (lt_trans zero_lt_one hq) |>.mpr hcrit
  obtain ⟨C, hC⟩ :=
    Codex.Spherical.FractalDilations.DiagonalTheorem.eLpNorm_restrictedSphericalMaximal_le
      (d := 2) (p := ENNReal.ofReal q) (by norm_num) hEpos hcritE
  rw [hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_zero_iff]
  refine ⟨max C 1, lt_of_lt_of_le zero_lt_one (le_max_right _ _), ?_⟩
  intro f hf
  obtain ⟨hmem, hbound⟩ := hC (f : Euclidean 2 → ℂ) hf
  have hmem' : MemLp (restrictedNormalizedSphericalMaximal 2 E (f : Euclidean 2 → ℂ))
      (ENNReal.ofReal q) volume := by
    rw [← restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
    exact hmem
  have hbound' : eLpNorm (restrictedNormalizedSphericalMaximal 2 E (f : Euclidean 2 → ℂ))
      (ENNReal.ofReal q) volume ≤
      ENNReal.ofReal C * eLpNorm (f : Euclidean 2 → ℂ) (ENNReal.ofReal q) volume := by
    rw [← restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
    exact hbound
  refine ⟨hmem', hbound'.trans ?_⟩
  gcongr
  exact le_max_left _ _

/-- Blueprint `prop:high-p-branch`: completion of the finite-`p` sufficiency
proof in dimension two.  At a strictly admissible planar parameter with
`2 < p` and `α < 0` the strict Legendre--Assouad inequality forces
`-1 < α`, so the Duoandikoetxea--Vega range applies. -/
theorem hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_planar_high_p_branch
    (E : Set ℝ) (hE : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ)) {p α : ℝ}
    (hp : 2 < p) (hα : α < 0)
    (hstrict :
      max ((α : EReal) + multiplicativeMinkowskiExponent E)
          (multiplicativeLegendreAssouadExponent E
            ((((2 : ℕ) : ℝ) - 1) * (p - 2) - α)) <
        ((((((2 : ℕ) : ℝ) - 1) * (p - 1)) : ℝ) : EReal)) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType 2 E p α :=
  hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_planar_negative_of_gt_two
    E hp (neg_one_lt_alpha_of_planar_strict hE hEpos hstrict) hα

/-! ## The planar strict upper estimate -/

/-- The planar strict upper estimate at every finite exponent.  This is the
dimension-two analogue of
`Codex.Spherical.PowerWeights.StrictUpper.hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_of_strict_implicit`;
the branch `α < 0`, `2 < p`, which the higher-dimensional parameter reduction
cannot reach in the plane, is supplied by the Duoandikoetxea--Vega estimate. -/
theorem hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_planar_of_strict_implicit
    (E : Set ℝ) (hE : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ)) {p α : ℝ}
    (hp : 1 < p)
    (hstrict :
      max ((α : EReal) + multiplicativeMinkowskiExponent E)
          (multiplicativeLegendreAssouadExponent E
            ((((2 : ℕ) : ℝ) - 1) * (p - 2) - α)) <
        ((((((2 : ℕ) : ℝ) - 1) * (p - 1)) : ℝ) : EReal)) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType 2 E p α := by
  have hunweighted : ∀ ⦃q : ℝ⦄, 1 < q →
      multiplicativeMinkowskiExponent E <
        (((((2 : ℕ) : ℝ) - 1) * (q - 1) : ℝ) : EReal) →
      HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType 2 E q 0 :=
    fun q hq hcrit =>
      hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_zero_planar_of_sww
        E hE hEpos hq hcrit
  have hnegative : ∀ ⦃q a : ℝ⦄, 1 < q → q < 2 → a < 0 →
      max ((a : EReal) + multiplicativeMinkowskiExponent E)
          (multiplicativeLegendreAssouadExponent E
            ((((2 : ℕ) : ℝ) - 1) * (q - 2) - a)) <
        ((((((2 : ℕ) : ℝ) - 1) * (q - 1)) : ℝ) : EReal) →
      HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType 2 E q a := by
    intro q a hq hq2 ha hqstrict
    exact hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_of_strict_negative_subtwo
      (d := 2) (by norm_num) E hE hEpos hq hq2 ha hqstrict
      (hunweighted hq
        (multiplicativeMinkowskiExponent_lt_critical_of_strict_implicit hqstrict))
  by_cases hα : α < 0
  · rcases lt_trichotomy p 2 with hp2 | hp2 | hp2
    · exact hnegative hp hp2 hα hstrict
    · subst hp2
      refine hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_planar_of_strict_negative_two_of_subquadratic
        hE hEpos hα ?_ ?_
      · convert hstrict using 2 <;> norm_num
      · intro q a hq hq2 hq_a hqstrict
        refine hnegative hq hq2 hq_a ?_
        convert hqstrict using 2 <;> norm_num
    · exact hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_planar_high_p_branch
        E hE hEpos hp2 hα hstrict
  · exact hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_of_strict_implicit_nonnegative
      (d := 2) (by norm_num) E hE hEpos hp (le_of_not_gt hα) hstrict hunweighted

/-! ## The planar case of Theorem 1.1 of Fraccaroli--Roos--Seeger -/

/-- The planar main theorem in the internal normalized formulation.  Its two
analytic inputs are the Seeger--Wainger--Wright unweighted estimate and the
Duoandikoetxea--Vega negative-weight estimate; every other ingredient is the
already formalized parameter theory. -/
theorem power_weight_spherical_maximal_main_planar (E : Set ℝ) (hE : E.Nonempty)
    (hEpos : E ⊆ Ioi (0 : ℝ)) :
    closure (restrictedNormalizedSphericalMaximalPowerWeightTypeSet 2 E) =
      powerWeightAdmissibleRegion 2 E := by
  apply powerWeightAdmissibleRegion_eq_closure_of_strict_upper_necessary
    (d := 2) (by norm_num) E hE hEpos
  · intro p α hp hstrong
    exact powerWeightEntropyImplicitCondition_of_restrictedStrongType
      (d := 2) (by norm_num) hE hEpos hp hstrong
  · intro p α hp hstrict
    exact hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_planar_of_strict_implicit
      E hE hEpos hp hstrict

/-! ## Transfer to the public type set

The public `typeSet` is stated for arbitrary `MemLp` inputs and the public
maximal function, whereas the internal type set uses the Schwartz core and the
normalized maximal function.  The two have the same closure. -/

private theorem finite_basic_mem_internal_typeSet {d : ℕ} {E : Set ℝ}
    {q : ℝ × ℝ} {α : ℝ} {p : ENNReal} (hp : 1 ≤ p) (hptop : p ≠ ∞)
    (hq : q = (ENNReal.toReal p⁻¹, α * ENNReal.toReal p⁻¹))
    {C : ℝ} (hC : 0 < C)
    (hbound : ∀ f : (ℝ^d) → ℂ, MemLp f p (powerWeight d α) →
      MemLp (M E f) p (powerWeight d α) ∧
        eLpNorm (M E f) p (powerWeight d α) ≤
          ENNReal.ofReal C * eLpNorm f p (powerWeight d α)) :
    q ∈ restrictedNormalizedSphericalMaximalPowerWeightTypeSet d E := by
  have hp_eq : ENNReal.ofReal p.toReal = p := ENNReal.ofReal_toReal hptop
  have hmeasure : powerWeight d α = powerWeightedVolume d α := rfl
  refine mem_restrictedNormalizedSphericalMaximalPowerWeightTypeSet_iff.mpr
    ⟨p.toReal, α, ?_, ?_, ?_, ?_⟩
  · rw [← ENNReal.toReal_one]
    exact ENNReal.toReal_mono hptop hp
  · calc
      q.1 = (ENNReal.toReal p⁻¹, α * ENNReal.toReal p⁻¹).1 := congrArg Prod.fst hq
      _ = p.toReal⁻¹ := ENNReal.toReal_inv p
  · calc
      q.2 = (ENNReal.toReal p⁻¹, α * ENNReal.toReal p⁻¹).2 := congrArg Prod.snd hq
      _ = α / p.toReal := by rw [ENNReal.toReal_inv, div_eq_mul_inv]
  · refine ⟨C, hC, ?_⟩
    intro f hf
    have hfweight : MemLp (f : (ℝ^d) → ℂ) p (powerWeightedVolume d α) := by
      rw [← hp_eq]
      exact hf
    obtain ⟨hM, hnorm⟩ := hbound (f : (ℝ^d) → ℂ) (by rw [hmeasure]; exact hfweight)
    refine ⟨?_, ?_⟩
    · simpa only [hp_eq, ← restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal,
        ← hmeasure] using hM
    · simpa only [hp_eq, ← restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal,
        ← hmeasure] using hnorm

private theorem typeSet_subset_closure_internal {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} :
    typeSet d E ⊆
      closure (restrictedNormalizedSphericalMaximalPowerWeightTypeSet d E) := by
  intro q hq
  rcases hq with ⟨α, p, hp, hq, C, hC, hbound⟩
  by_cases hptop : p = ∞
  · subst p
    norm_num at hq
    rw [hq]
    exact zero_zero_mem_closure_restrictedNormalizedSphericalMaximalPowerWeightTypeSet hd E
  · exact subset_closure (finite_basic_mem_internal_typeSet hp hptop hq hC hbound)

private theorem internal_subset_typeSet {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ)) :
    restrictedNormalizedSphericalMaximalPowerWeightTypeSet d E ⊆ typeSet d E := by
  intro q hq
  rcases hq with ⟨p, α, hp, hq1, hq2, hcore⟩
  have hE' : ∃ r : ℝ, r ∈ E ∧ 0 < r := by
    rcases hE with ⟨r, hr⟩
    exact ⟨r, hr, hEpos hr⟩
  have hα : -(d : ℝ) < α :=
    neg_dim_lt_alpha_of_restrictedStrongType (by omega : 0 < d) hE' hp hcore
  obtain ⟨C, hC, hraw⟩ :=
    exists_powerWeight_bound_of_strongType (by omega : 1 ≤ d) hp hα hcore
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hqeq : q = (p⁻¹, α / p) := Prod.ext hq1 hq2
  rw [hqeq]
  refine ⟨α, ENNReal.ofReal p, ?_, ?_, C, hC, ?_⟩
  · rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal hp
  · simp only [ENNReal.toReal_inv, ENNReal.toReal_ofReal hp0.le]
    ext <;> field_simp
  · intro f hfvol
    exact hraw f hfvol

/-- **Theorem 1.1 of arXiv:2602.17613 in every dimension at least two.**

The dimension-two case is the new one; it is reduced to the planar
negative-power circular maximal theorem
`eLpNorm_circularMaximal_powerWeight_le_of_neg`. -/
theorem closure_typeSet_eq {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ} (hE : E.Nonempty)
    (hEpos : E ⊆ Ioi 0) :
    closure (typeSet d E) = admissibleRegion d E := by
  have hmain : closure (restrictedNormalizedSphericalMaximalPowerWeightTypeSet d E) =
      powerWeightAdmissibleRegion d E := by
    rcases eq_or_lt_of_le hd with hd2 | hd3
    · have hd2' : d = 2 := hd2.symm
      subst hd2'
      exact power_weight_spherical_maximal_main_planar E hE hEpos
    · exact Codex.Spherical.PowerWeights.Main.power_weight_spherical_maximal_main
        (by omega) E hE hEpos
  calc
    closure (typeSet d E) =
        closure (restrictedNormalizedSphericalMaximalPowerWeightTypeSet d E) := by
      apply Subset.antisymm
      · exact closure_minimal (typeSet_subset_closure_internal hd) isClosed_closure
      · exact closure_mono (internal_subset_typeSet hd hE hEpos)
    _ = powerWeightAdmissibleRegion d E := hmain
    _ = admissibleRegion d E :=
      (legacyAdmissibleRegion_eq_powerWeightAdmissibleRegion hd hE hEpos).symm

end

