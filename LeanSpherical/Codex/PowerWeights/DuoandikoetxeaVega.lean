    have heq : (fun p : ℝ × Euclidean 2 => (dvFreqCut phi j) p.2) =
        fun p : ℝ × Euclidean 2 => phi ((((2 : ℝ) ^ (j + 6))⁻¹) • p.2) := by
      funext p
