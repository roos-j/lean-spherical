/-- **A crude weighted `L²` band estimate**, valid for every frequency index.
Its constant grows like `2^j`, so it is only used for the finitely many small
indices not covered by the stationary-phase core estimate. -/
theorem dvCrudeL2Core (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (f : SchwartzMap (Euclidean 2) ℂ) {A₀ : ℝ}
    (hA₀0 : 0 ≤ A₀)
    (hA₀ : surfaceMass 2 * ((2 : ℝ) ^ j * dvPsiL2 phi) *
      Real.sqrt (surfaceMass 2 * (1 / 16)) ≤ A₀) :
    (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
        radialPowerWeight 2 (-1) x *
          (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ 2) ≤
      ENNReal.ofReal (A₀ ^ 2) *
        ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(f : Euclidean 2 → ℂ) x‖) ^ 2 := by
  have hsm : (0 : ℝ) < surfaceMass 2 := surfaceMass_pos (by norm_num)
  set Nf : ℝ := (eLpNorm (f : Euclidean 2 → ℂ) 2 volume).toReal with hNf
  have hNf0 : 0 ≤ Nf := ENNReal.toReal_nonneg
  have hNftop : eLpNorm (f : Euclidean 2 → ℂ) 2 volume ≠ ⊤ :=
    (f.memLp 2 volume).eLpNorm_ne_top
  set B0 : ℝ := surfaceMass 2 * ((2 : ℝ) ^ j * dvPsiL2 phi * Nf) with hB0
  have hB00 : 0 ≤ B0 := by
    rw [hB0]
    exact mul_nonneg hsm.le (mul_nonneg (mul_nonneg (by positivity)
      (dvPsiL2_nonneg phi)) hNf0)
  -- pointwise bound for the maximal function
  have hptw : ∀ x : Euclidean 2,
      restrictedRelativeBandpassSphericalMaximal 2 E phi j f x ≤ ENNReal.ofReal B0 := by
    intro x
    unfold restrictedRelativeBandpassSphericalMaximal
    refine iSup_le fun s => ?_
    have hs : s.1 ∈ Icc (1 : ℝ) 2 := hE s.2.1
    rw [← dvOp_schwartz phi f j hs.1 x]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [dvOp, hB0]
    refine norm_sphericalAverage_le _ _ _ (fun y => ?_)
    have hcs := enorm_convolution_le_l2 (dvKerS phi j s.1 : Euclidean 2 → ℂ)
      (f : Euclidean 2 → ℂ) (continuous_dvKerS phi j s.1).measurable
      f.continuous.measurable y
    have hkey : ‖((dvKerS phi j s.1 : Euclidean 2 → ℂ)
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : Euclidean 2 → ℂ)) y‖ₑ ≤
        ENNReal.ofReal ((2 : ℝ) ^ j * dvPsiL2 phi * Nf) := by
      refine le_trans hcs ?_
      have h1 : eLpNorm (f : Euclidean 2 → ℂ) 2 volume = ENNReal.ofReal Nf := by
        rw [hNf, ENNReal.ofReal_toReal hNftop]
      have hnn : (0 : ℝ) ≤ (2 : ℝ) ^ j * dvPsiL2 phi :=
        mul_nonneg (by positivity) (dvPsiL2_nonneg phi)
      rw [h1, ENNReal.ofReal_mul hnn]
      exact mul_le_mul' (eLpNorm_dvKerS_le phi j hs.1) le_rfl
    have hfin : ENNReal.ofReal ‖((dvKerS phi j s.1 : Euclidean 2 → ℂ)
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : Euclidean 2 → ℂ)) y‖ ≤
        ENNReal.ofReal ((2 : ℝ) ^ j * dvPsiL2 phi * Nf) := by
      rwa [ofReal_norm]
    exact (ENNReal.ofReal_le_ofReal_iff (mul_nonneg (mul_nonneg (by positivity)
      (dvPsiL2_nonneg phi)) hNf0)).mp hfin
  -- the weight has finite mass on the ball
  have hmass : (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
      radialPowerWeight 2 (-1) x) ≤ ENNReal.ofReal (surfaceMass 2 * (1 / 16)) := by
    have hsub : Metric.closedBall (0 : Euclidean 2) (1 / 32) ⊆
        Metric.ball (0 : Euclidean 2) (1 / 16) := by
      intro x hx
      rw [Metric.mem_closedBall, dist_zero_right] at hx
      rw [Metric.mem_ball, dist_zero_right]
      linarith
    exact le_trans (lintegral_mono_set hsub) (dvBallWeight_le (by norm_num))
  -- the input square integral
  have hinput : (∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(f : Euclidean 2 → ℂ) x‖) ^ 2) =
      ENNReal.ofReal (Nf ^ 2) := by
    have h1 : (∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(f : Euclidean 2 → ℂ) x‖) ^ 2) =
        (eLpNorm (f : Euclidean 2 → ℂ) 2 volume) ^ 2 := by
      rw [← dvL2sqM]
      refine lintegral_congr fun x => ?_
      rw [ofReal_norm]
    rw [h1, hNf, ENNReal.ofReal_pow ENNReal.toReal_nonneg,
      ENNReal.ofReal_toReal hNftop]
  calc (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
        radialPowerWeight 2 (-1) x *
          (restrictedRelativeBandpassSphericalMaximal 2 E phi j f x) ^ 2)
      ≤ ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
          radialPowerWeight 2 (-1) x * (ENNReal.ofReal B0) ^ 2 := by
        refine lintegral_mono fun x => ?_
        exact mul_le_mul' le_rfl (pow_le_pow_left' (hptw x) 2)
    _ = (ENNReal.ofReal B0) ^ 2 * ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
          radialPowerWeight 2 (-1) x := by
        have hne : (ENNReal.ofReal B0) ^ 2 ≠ ⊤ := by
          simp [ENNReal.pow_eq_top_iff]
        have hc : (∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
            radialPowerWeight 2 (-1) x * (ENNReal.ofReal B0) ^ 2) =
            ∫⁻ x in Metric.closedBall (0 : Euclidean 2) (1 / 32),
              (ENNReal.ofReal B0) ^ 2 * radialPowerWeight 2 (-1) x :=
          lintegral_congr fun x => mul_comm _ _
        rw [hc, lintegral_const_mul' _ _ hne]
    _ ≤ (ENNReal.ofReal B0) ^ 2 * ENNReal.ofReal (surfaceMass 2 * (1 / 16)) :=
        mul_le_mul' le_rfl hmass
    _ = ENNReal.ofReal (B0 ^ 2 * (surfaceMass 2 * (1 / 16))) := by
        rw [← ENNReal.ofReal_pow hB00, ← ENNReal.ofReal_mul (by positivity)]
    _ ≤ ENNReal.ofReal (A₀ ^ 2) * ENNReal.ofReal (Nf ^ 2) := by
        rw [← ENNReal.ofReal_mul (by positivity)]
        refine ENNReal.ofReal_le_ofReal ?_
        have hexp : B0 ^ 2 * (surfaceMass 2 * (1 / 16)) =
            (surfaceMass 2 * ((2 : ℝ) ^ j * dvPsiL2 phi) *
              Real.sqrt (surfaceMass 2 * (1 / 16))) ^ 2 * Nf ^ 2 := by
          have hs : Real.sqrt (surfaceMass 2 * (1 / 16)) ^ 2 =
              surfaceMass 2 * (1 / 16) := Real.sq_sqrt (by positivity)
          rw [hB0]
          ring_nf
          rw [hs]
          ring
        rw [hexp]
        refine mul_le_mul_of_nonneg_right ?_ (by positivity)
        refine pow_le_pow_left₀ ?_ hA₀ 2
        exact mul_nonneg (mul_nonneg hsm.le (mul_nonneg (by positivity)
          (dvPsiL2_nonneg phi))) (Real.sqrt_nonneg _)
    _ = ENNReal.ofReal (A₀ ^ 2) *
          ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖(f : Euclidean 2 → ℂ) x‖) ^ 2 := by
        rw [hinput]

