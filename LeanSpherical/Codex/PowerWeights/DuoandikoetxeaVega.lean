theorem continuous_dvMulC (phi : SchwartzMap (Euclidean 2) ℂ) (j : ℕ) :
    Continuous fun p : ℝ × Euclidean 2 => dvMulC phi j p.1 p.2 := by
  have h1 : Continuous fun p : ℝ × Euclidean 2 => ((dvSqrtW p.1 : ℝ) : ℂ) :=
