  have hnn : ∀ n : ℕ, 0 ≤ ((n : ℝ)) ^ m * c ^ n := fun n => by positivity
  set S : ℝ := ∑' n : ℕ, ((n : ℝ)) ^ m * c ^ n with hSdef
  have hS0 : 0 ≤ S := tsum_nonneg hnn
  have hterm : ∀ j : ℕ, ((j : ℝ)) ^ m * c ^ j ≤ S := fun j =>
